# ==============================================================================
# feliperiquel.me - Configuration & GitHub Student Developer Pack Integrations
# ==============================================================================

# Public Site URL
PUBLIC_SITE_URL=https://feliperiquel.me

# Contact & Lead Notification Gateway
# Can use Web3Forms, Formspree, or Resend
PUBLIC_CONTACT_ACCESS_KEY=your_web3forms_or_formspree_key_here
PUBLIC_WHATSAPP_NUMBER=+56912345678

# GitHub Student Pack Integration: Stripe (Fee waiver on first $1,000 processed)
# Use your Stripe Publishable Key for checkout or payment links
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

# GitHub Student Pack Integration: Testmail.app (Testing transactional emails in dev)
# API key and namespace provided by Testmail
TESTMAIL_API_KEY=your_testmail_api_key_here
TESTMAIL_NAMESPACE=your_testmail_namespace_here
