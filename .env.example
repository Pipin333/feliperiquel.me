# ==============================================================================
# feliperiquel.me - Variables de Entorno & Integraciones
# ==============================================================================

# URL publica del sitio
PUBLIC_SITE_URL=https://feliperiquel.me

# ------------------------------------------------------------------------------
# 1. Supabase (PostgreSQL Serverless - GitHub Student Developer Pack)
# ------------------------------------------------------------------------------
# Proyecto en supabase.com -> Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# 2. Resend (Email API & AutoMailer Transaccional)
# ------------------------------------------------------------------------------
# API Key en resend.com -> API Keys
RESEND_API_KEY=re_your_resend_api_key_here

# Remitente de envio (debe ser un dominio verificado en Resend o onboarding@resend.dev para pruebas)
RESEND_FROM_EMAIL=Felipe Riquelme <contacto@mail.feliperiquel.me>

# Correo donde recibiras las notificaciones de nuevos mensajes
CONTACT_NOTIFICATION_EMAIL=f.riquelmesalvo@uandresbello.edu

# ------------------------------------------------------------------------------
# 3. Canales Directos y Redes
# ------------------------------------------------------------------------------
PUBLIC_WHATSAPP_NUMBER=+56912345678
