# ==============================================================================
# feliperiquel.me - Variables de Entorno & Integraciones
# ==============================================================================

# URL publica del sitio
PUBLIC_SITE_URL=https://feliperiquel.me

# ------------------------------------------------------------------------------
# 1. Supabase (PostgreSQL Serverless - GitHub Student Developer Pack)
# ------------------------------------------------------------------------------
# Proyecto en supabase.com -> Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# 2. Resend (Email API & AutoMailer Transaccional)
# ------------------------------------------------------------------------------
# API Key en resend.com -> API Keys
RESEND_API_KEY=re_your_resend_api_key_here

# Remitente de envio (debe ser un dominio verificado en Resend o onboarding@resend.dev para pruebas)
RESEND_FROM_EMAIL=Felipe Riquelme <contacto@mail.feliperiquel.me>

# Correo donde recibiras las notificaciones de nuevos mensajes
CONTACT_NOTIFICATION_EMAIL=f.riquelmesalvo@uandresbello.edu

# ------------------------------------------------------------------------------
# 3. Canales Directos y Redes
# ------------------------------------------------------------------------------
PUBLIC_WHATSAPP_NUMBER=+56912345678

# ------------------------------------------------------------------------------
# 4. MicroToodles Audio Streamer
# ------------------------------------------------------------------------------
# URL del servicio MicroToodles (http://localhost:8080 en local, o https://radio.feliperiquel.me en produccion)
PUBLIC_RADIO_API_URL=http://localhost:8080


# ------------------------------------------------------------------------------
# 5. Easytaciones - Matcher Semántico Mercado Público (Privado / No-Index)
# ------------------------------------------------------------------------------
# Token secreto para autenticación y acceso a la consola y API de Easytaciones
EASYTACIONES_ACCESS_TOKEN=tu_token_secreto_easytaciones_aqui

# URL del backend Python de Easytaciones (FastAPI)
EASYTACIONES_API_URL=http://localhost:8000

# Ticket oficial de Mercado Público (ChileCompra) obtenido en desarrolladores.mercadopublico.cl
# Si se deja vacío o no configurado, el motor utiliza automáticamente el catálogo mock realista
MP_TICKET=
