# =====================================================================
# CONFIGURACIÓN DE INTEGRACIÓN MERCADO PÚBLICO (CHILECOMPRA) + TRANSFORMERS
# =====================================================================

# 1. API Mercado Público:
# Para obtener un ticket oficial gratuito:
# Regístrate en https://desarrolladores.mercadopublico.cl/
# Si lo dejas vacío o usas mp_use_mock=True, el sistema utilizará datos simulados realistas.
MP_TICKET=
MP_BASE_URL=https://api.mercadopublico.cl/servicios/v1/publico
MP_USE_MOCK=false
MP_TIMEOUT_SECONDS=25.0

# 2. Configuración del Transformer y Aceleración por Hardware:
# Modelo multilingüe optimizado para búsqueda semántica en español:
TRANSFORMER_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Dispositivo: "auto" (detecta CUDA o CPU automáticamente), "cuda" o "cpu"
DEVICE=auto
# Aceleración Tensor Cores en GPUs NVIDIA RTX / GTX (precisión media FP16 y TF32):
USE_FP16=true
BATCH_SIZE_CUDA=128
BATCH_SIZE_CPU=32

# 3. Parámetros de matching:
DEFAULT_MIN_SCORE=50.0
TOP_K_DEFAULT=20
CACHE_TTL_SECONDS=1800

