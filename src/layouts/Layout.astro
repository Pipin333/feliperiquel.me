---
// src/layouts/Layout.astro
import '../styles/global.css';
import DynamicDock from '../components/DynamicDock.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
}

const {
  title = "Felipe Riquelme | Software Engineer & Builder",
  description = "Portafolio y laboratorio interactivo de software. Audio DSP en el navegador, micro-aplicaciones en tiempo real, orquestación homelab y optimización de algoritmos.",
  image = "/og-image.png",
  imageAlt = "feliperiquel.me: portafolio y laboratorio de software de Felipe Riquelme"
} = Astro.props;

const siteOrigin = (Astro.site ?? new URL('https://feliperiquel.me')).origin;
const canonicalURL = new URL(Astro.url.pathname, siteOrigin);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${siteOrigin}/#felipe`,
      "name": "Felipe Riquelme",
      "jobTitle": "Ingeniero Civil en Informática",
      "url": siteOrigin,
      "image": `${siteOrigin}/og-image.png`,
      "sameAs": ["https://github.com/Pipin333"],
      "knowsAbout": [
        "Ingeniería de software",
        "Web Audio API",
        "Procesamiento digital de señales",
        "Sistemas de recomendación",
        "Docker",
        "TypeScript",
        "Python"
      ],
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Santiago",
        "addressCountry": "CL"
      }
    },
    {
      "@type": "WebSite",
      "@id": `${siteOrigin}/#website`,
      "url": siteOrigin,
      "name": "feliperiquel.me",
      "description": description,
      "inLanguage": "es",
      "publisher": { "@id": `${siteOrigin}/#felipe` }
    }
  ]
};
---

<!doctype html>
<html lang="es" class="scroll-smooth bg-canvas text-canvas-text">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts: Space Grotesk, Inter, Fira Code (Carga Asincrona No Bloqueante con Swap) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@600;700;800&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@600;700;800&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@600;700;800&display=swap"
      />
    </noscript>

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Felipe Riquelme" />
    <meta name="theme-color" content="#07090E" />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="feliperiquel.me" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonicalURL)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, canonicalURL)} />
    <meta property="twitter:image:alt" content={imageAlt} />

    <!-- LLM & AI Agents Context Pointer -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM Context & Portfolio Summary" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-canvas text-slate-100 flex flex-col min-h-screen selection:bg-telemetry/20 selection:text-white">
    <slot />
    <DynamicDock />

    <!-- Global Mouse Spotlight Controller (Optimizado con rAF y listeners locales sin forced reflow) -->
    <script>
      function initSpotlight() {
        if (!window.matchMedia('(pointer: fine)').matches || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          return;
        }

        const cards = document.querySelectorAll<HTMLElement>('.spotlight-card');
        if (cards.length === 0) return;

        cards.forEach((card) => {
          let rect: DOMRect | null = null;
          let ticking = false;

          const updateRect = () => {
            rect = card.getBoundingClientRect();
          };

          card.addEventListener('pointerenter', () => {
            updateRect();
          }, { passive: true });

          card.addEventListener('pointermove', (e: PointerEvent) => {
            if (!rect) updateRect();
            if (!ticking && rect) {
              ticking = true;
              requestAnimationFrame(() => {
                if (rect) {
                  const x = e.clientX - rect.left;
                  const y = e.clientY - rect.top;
                  card.style.setProperty('--mouse-x', `${x}px`);
                  card.style.setProperty('--mouse-y', `${y}px`);
                }
                ticking = false;
              });
            }
          }, { passive: true });

          card.addEventListener('pointerleave', () => {
            rect = null;
          }, { passive: true });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSpotlight);
      } else {
        initSpotlight();
      }
    </script>
  </body>
</html>
