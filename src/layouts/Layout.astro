---
// src/layouts/Layout.astro
import '../styles/global.css';
import DynamicDock from '../components/DynamicDock.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  robots?: string;
}

const {
  title = "Felipe Riquelme | Ingeniero Civil en Informática",
  description = "Portafolio y laboratorio interactivo de software. Audio DSP en el navegador, micro-aplicaciones en tiempo real, orquestación homelab y optimización de algoritmos.",
  image = "/og-image.png",
  imageAlt = "feliperiquel.me: portafolio y laboratorio de software de Felipe Riquelme",
  robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
} = Astro.props;

const siteOrigin = (Astro.site ?? new URL('https://feliperiquel.me')).origin;
const canonicalURL = new URL(Astro.url.pathname, siteOrigin);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${siteOrigin}/#felipe`,
      "name": "Felipe Riquelme",
      "jobTitle": "Ingeniero Civil en Informática",
      "url": siteOrigin,
      "image": `${siteOrigin}/og-image.png`,
      "sameAs": ["https://github.com/Pipin333", "https://linkedin.com/in/friquelmes"],
      "knowsAbout": [
        "Ingeniería de software",
        "Web Audio API",
        "Procesamiento digital de señales",
        "Sistemas de recomendación",
        "Docker",
        "TypeScript",
        "Python"
      ],
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Santiago",
        "addressCountry": "CL"
      }
    },
    {
      "@type": "WebSite",
      "@id": `${siteOrigin}/#website`,
      "url": siteOrigin,
      "name": "feliperiquel.me",
      "description": description,
      "inLanguage": "es",
      "publisher": { "@id": `${siteOrigin}/#felipe` }
    }
  ]
};
---

<!doctype html>
<html lang="es" class="scroll-smooth bg-canvas text-canvas-text">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />

    <!-- Fuentes autohospedadas (cero llamadas de terceros, compatible con CSP estricta) -->
    <link rel="preload" href="/fonts/UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa1ZL7.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/V8mDoQDjQSkFtoMM3T6r8E7mPbF4Cw.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Canonical URL & Search Indexing -->
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content={robots} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Felipe Riquelme" />
    <meta name="theme-color" content="#07090E" />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="feliperiquel.me" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonicalURL)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, canonicalURL)} />
    <meta property="twitter:image:alt" content={imageAlt} />

    <!-- LLM & AI Agents Context Pointer -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Contexto para LLMs y Resumen de Portafolio" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-canvas text-slate-100 flex flex-col min-h-screen selection:bg-telemetry/20 selection:text-white">
    <slot />
    <DynamicDock />

    <!-- Cursor Spotlight Controller (script externo, compatible con CSP estricta) -->
    <script src="../scripts/spotlight.ts"></script>
  </body>
</html>
