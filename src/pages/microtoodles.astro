---
// src/pages/microtoodles.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';

const pageTitle = "MicroToodles // Arquitectura de Streaming, HTTP 206 y Telemetría en Vivo | Felipe Riquelme";
const pageDescription = "Arquitectura técnica, flujo de paquetes y telemetría en tiempo real del microservicio de audio MicroToodles (OCI Always Free + FastAPI + Cloudflare Edge CDN).";
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />

  <main class="min-h-screen bg-canvas text-slate-100 font-sans antialiased pb-28">
    
    <!-- Hero Section -->
    <section class="border-b border-canvas-border bg-gradient-to-b from-[#080D17] via-canvas to-canvas px-4 sm:px-6 lg:px-8 pt-10 sm:pt-14 pb-10">
      <div class="max-w-7xl mx-auto space-y-4">
        
        <!-- Breadcrumbs & Status Tag -->
        <div class="flex flex-wrap items-center justify-between gap-3 text-xs font-mono">
          <div class="flex items-center gap-2 text-slate-400">
            <a href="/" class="hover:text-telemetry transition-colors">inicio</a>
            <span>/</span>
            <a href="/lab" class="hover:text-telemetry transition-colors">lab</a>
            <span>/</span>
            <span class="text-telemetry font-semibold">microtoodles</span>
          </div>

          <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-950/70 text-emerald-400 border border-emerald-500/30 text-[11px]">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              <span>ISLA DINÁMICA CONECTADA</span>
            </span>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-cyan-950/70 text-cyan-300 border border-cyan-500/30 text-[11px]">
              <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
              <span>HTTP 206 PARTIAL CONTENT</span>
            </span>
          </div>
        </div>

        <!-- Main Heading -->
        <div class="space-y-2">
          <h1 class="text-2xl sm:text-4xl lg:text-5xl font-display font-bold tracking-tight text-white flex flex-wrap items-center gap-3">
            <span>MicroToodles</span>
            <span class="text-slate-600">//</span>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-telemetry via-cyan-300 to-emerald-400">
              Arquitectura de Streaming & I/O
            </span>
          </h1>
          <p class="max-w-4xl text-sm sm:text-base text-slate-300 leading-relaxed font-sans pt-1">
            Microservicio desacoplado de streaming y distribución multimedia para la radio en segundo plano de <code class="text-telemetry font-mono text-xs">feliperiquel.me</code>. Elimina el scraping reactivo mediante precaché atómica en NVMe dentro de Oracle Cloud, responde con solicitudes parciales HTTP 206 para scrubbing instantáneo y mitiga la latencia a través de Cloudflare Edge CDN.
          </p>
        </div>

        <!-- Live Sync Ribbon (Dock Radio Bridge) -->
        <div class="mt-6 p-4 rounded-xl border border-canvas-border bg-[#0C1220]/90 backdrop-blur-md flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4 font-mono text-xs">
          <div class="flex flex-wrap items-center gap-4">
            <div class="flex items-center gap-2.5">
              <span id="page-radio-indicator" class="w-3 h-3 rounded-full bg-slate-600 transition-colors"></span>
              <span class="text-slate-400 font-medium">Estado Radio:</span>
              <strong id="page-radio-state-text" class="text-slate-200">En Pausa (Dock)</strong>
            </div>

            <div class="h-4 w-[1px] bg-canvas-border hidden sm:block"></div>

            <div class="flex items-center gap-2 min-w-0">
              <span class="text-slate-400">Pista:</span>
              <strong id="page-radio-track-text" class="text-emerald-400 truncate max-w-[240px] sm:max-w-xs">Toodles Radio Offline</strong>
            </div>

            <div class="h-4 w-[1px] bg-canvas-border hidden sm:block"></div>

            <div class="flex items-center gap-2">
              <span class="text-slate-400">Playhead:</span>
              <span id="page-radio-time-text" class="text-cyan-300 tabular-nums">00:00 / 00:00</span>
            </div>
          </div>

          <!-- Controls to trigger playback in dock directly from here -->
          <div class="flex items-center gap-2 shrink-0">
            <button
              type="button"
              id="page-radio-toggle-btn"
              class="px-3.5 py-1.5 rounded-tech-sm font-semibold text-xs text-slate-950 bg-gradient-to-r from-emerald-400 to-cyan-400 hover:brightness-110 active:scale-98 transition-all flex items-center gap-2 shadow-sm focus-visible:ring-2 focus-visible:ring-emerald-400"
            >
              <svg id="page-radio-play-icon" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
              <svg id="page-radio-pause-icon" class="w-3.5 h-3.5 hidden" viewBox="0 0 24 24" fill="currentColor">
                <rect x="6" y="4" width="4" height="16"></rect>
                <rect x="14" y="4" width="4" height="16"></rect>
              </svg>
              <span id="page-radio-btn-text">Reproducir en la Isla</span>
            </button>

            <button
              type="button"
              id="page-radio-skip-btn"
              class="px-2.5 py-1.5 rounded-tech-sm font-mono text-xs text-slate-300 bg-canvas-raised hover:bg-canvas-subtle border border-canvas-border hover:text-white transition-colors flex items-center gap-1"
              title="Siguiente pista"
            >
              <span>Skip</span>
              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor">
                <polygon points="5 4 15 12 5 20 5 4"></polygon>
                <line x1="19" y1="5" x2="19" y2="19" stroke="currentColor" stroke-width="2.5"></line>
              </svg>
            </button>
          </div>
        </div>

      </div>
    </section>

    <!-- Main Content Container -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 space-y-10">

      <!-- ===================================================================== -->
      <!-- SECTION 1: TOPOLOGY & ANIMATED SVG DATA HIGHWAY -->
      <!-- ===================================================================== -->
      <section class="space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-3 select-none">
          <div>
            <h2 class="text-lg sm:text-xl font-display font-bold text-white flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-telemetry animate-pulse"></span>
              <span>1. Pipeline de Arquitectura & Data Highway</span>
            </h2>
            <p class="text-xs sm:text-sm text-slate-400 font-mono mt-0.5">
              Haz clic en cualquier nodo para inspeccionar sus invariantes, código fuente y métricas de producción.
            </p>
          </div>

          <div class="flex items-center gap-2 text-xs font-mono">
            <button
              type="button"
              id="highway-toggle-flow-btn"
              class="flex items-center gap-1.5 px-3 py-1 bg-canvas-raised hover:bg-canvas-subtle text-slate-300 hover:text-white rounded-tech-sm border border-canvas-border transition-colors cursor-pointer"
            >
              <svg id="highway-flow-icon" class="w-3.5 h-3.5 text-emerald-400" fill="currentColor" viewBox="0 0 24 24">
                <path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z"/>
              </svg>
              <span id="highway-flow-text">Pausar Animación</span>
            </button>
          </div>
        </div>

        <!-- 5 Nodes Pipeline Stepper Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-3" id="pipelineGrid">
          
          <!-- Node 0: Worker Sync -->
          <div
            onclick="window.selectNode && window.selectNode(0)"
            class="pipeline-card cursor-pointer group p-3.5 rounded-xl border border-canvas-border bg-canvas-surface/80 hover:border-emerald-500/70 transition-all relative overflow-hidden"
            data-node="0"
          >
            <div class="absolute top-2 right-2 text-[10px] font-mono text-slate-500 group-hover:text-emerald-400 font-bold">01</div>
            <div class="w-8 h-8 rounded-lg bg-emerald-950/60 border border-emerald-500/30 flex items-center justify-center text-emerald-400 mb-2.5 group-hover:scale-105 transition-transform">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
              </svg>
            </div>
            <div class="text-[10px] font-mono uppercase tracking-wider text-emerald-400 font-semibold">Cron & Sync</div>
            <div class="text-xs font-semibold text-slate-100 mt-0.5">Playlist Resolver</div>
            <p class="text-[11px] text-slate-400 mt-1 leading-snug">Worker batch asíncrono con `apscheduler`. Previene scraping reactivo de URLs.</p>
          </div>

          <!-- Node 1: OCI NVMe Storage -->
          <div
            onclick="window.selectNode && window.selectNode(1)"
            class="pipeline-card cursor-pointer group p-3.5 rounded-xl border border-canvas-border bg-canvas-surface/80 hover:border-cyan-500/70 transition-all relative overflow-hidden"
            data-node="1"
          >
            <div class="absolute top-2 right-2 text-[10px] font-mono text-slate-500 group-hover:text-cyan-400 font-bold">02</div>
            <div class="w-8 h-8 rounded-lg bg-cyan-950/60 border border-cyan-500/30 flex items-center justify-center text-cyan-400 mb-2.5 group-hover:scale-105 transition-transform">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"/>
              </svg>
            </div>
            <div class="text-[10px] font-mono uppercase tracking-wider text-cyan-400 font-semibold">OCI NVMe Disk</div>
            <div class="text-xs font-semibold text-slate-100 mt-0.5">Storage Local</div>
            <p class="text-[11px] text-slate-400 mt-1 leading-snug">Pool NVMe 45GB OCI Always Free. Lecturas secuenciales de alta velocidad (&lt;1ms).</p>
          </div>

          <!-- Node 2: FastAPI Engine (Active default) -->
          <div
            onclick="window.selectNode && window.selectNode(2)"
            class="pipeline-card cursor-pointer group p-3.5 rounded-xl border border-emerald-400 bg-canvas-surface ring-1 ring-emerald-400/40 transition-all relative overflow-hidden"
            data-node="2"
          >
            <div class="absolute top-2 right-2 text-[10px] font-mono text-emerald-400 font-bold">03 ACTIVO</div>
            <div class="w-8 h-8 rounded-lg bg-emerald-950/70 border border-emerald-400 flex items-center justify-center text-emerald-400 mb-2.5 group-hover:scale-105 transition-transform">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
            </div>
            <div class="text-[10px] font-mono uppercase tracking-wider text-emerald-400 font-semibold">FastAPI Engine</div>
            <div class="text-xs font-semibold text-slate-100 mt-0.5">Async Range Server</div>
            <p class="text-[11px] text-slate-400 mt-1 leading-snug">Starlette asíncrono con soporte `Range: bytes=` y códigos HTTP 206.</p>
          </div>

          <!-- Node 3: Cloudflare Edge -->
          <div
            onclick="window.selectNode && window.selectNode(3)"
            class="pipeline-card cursor-pointer group p-3.5 rounded-xl border border-canvas-border bg-canvas-surface/80 hover:border-sky-500/70 transition-all relative overflow-hidden"
            data-node="3"
          >
            <div class="absolute top-2 right-2 text-[10px] font-mono text-slate-500 group-hover:text-sky-400 font-bold">04</div>
            <div class="w-8 h-8 rounded-lg bg-sky-950/60 border border-sky-500/30 flex items-center justify-center text-sky-400 mb-2.5 group-hover:scale-105 transition-transform">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 00-9.78 2.096A4.001 4.001 0 003 15z"/>
              </svg>
            </div>
            <div class="text-[10px] font-mono uppercase tracking-wider text-sky-400 font-semibold">Cloudflare CDN</div>
            <div class="text-xs font-semibold text-slate-100 mt-0.5">Perimeter Edge</div>
            <p class="text-[11px] text-slate-400 mt-1 leading-snug">Caché perimetral de chunks iniciales, SSL Termination y protección del origen.</p>
          </div>

          <!-- Node 4: Toodles Client UI -->
          <div
            onclick="window.selectNode && window.selectNode(4)"
            class="pipeline-card cursor-pointer group p-3.5 rounded-xl border border-canvas-border bg-canvas-surface/80 hover:border-emerald-400/70 transition-all relative overflow-hidden"
            data-node="4"
          >
            <div class="absolute top-2 right-2 text-[10px] font-mono text-slate-500 group-hover:text-emerald-400 font-bold">05</div>
            <div class="w-8 h-8 rounded-lg bg-emerald-950/60 border border-emerald-500/30 flex items-center justify-center text-emerald-400 mb-2.5 group-hover:scale-105 transition-transform">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/>
              </svg>
            </div>
            <div class="text-[10px] font-mono uppercase tracking-wider text-emerald-400 font-semibold">Toodles Web UI</div>
            <div class="text-xs font-semibold text-slate-100 mt-0.5">HTML5 Audio & DSP</div>
            <p class="text-[11px] text-slate-400 mt-1 leading-snug">Dock flotante persistente con buffer adaptable y conexión con SonicRip DSP.</p>
          </div>

        </div>

        <!-- The Animated SVG Highway Canvas -->
        <div class="w-full bg-[#05080E] border border-canvas-border rounded-xl p-4 sm:p-6 relative overflow-hidden">
          <div class="flex items-center justify-between text-xs font-mono text-slate-400 mb-3 select-none">
            <span class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
              <span>DATA HIGHWAY // STREAM DISPATCH PIPELINE</span>
            </span>
            <span id="highway-state-badge" class="text-emerald-400 font-semibold flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              <span>STREAMING FLUIDO (206 OK)</span>
            </span>
          </div>

          <svg viewBox="0 0 1000 130" class="w-full h-28 sm:h-32 overflow-visible">
            <defs>
              <linearGradient id="streamGrad3" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#00e5a3" stop-opacity="0.3"/>
                <stop offset="50%" stop-color="#00e5ff" stop-opacity="0.9"/>
                <stop offset="100%" stop-color="#00e5a3" stop-opacity="0.3"/>
              </linearGradient>

              <filter id="svgHighwayGlow" x="-20%" y="-20%" width="140%" height="140%">
                <feGaussianBlur stdDeviation="3.5" result="blur" />
                <feComposite in="SourceGraphic" in2="blur" operator="over" />
              </filter>
            </defs>

            <!-- Background Track -->
            <path d="M 60 65 C 250 65, 250 65, 500 65 C 750 65, 750 65, 940 65" 
                  fill="none" stroke="#121D2C" stroke-width="8" stroke-linecap="round"/>

            <path d="M 60 65 C 250 65, 250 65, 500 65 C 750 65, 750 65, 940 65" 
                  fill="none" stroke="url(#streamGrad3)" stroke-width="2.5" stroke-dasharray="6,6"/>

            <!-- Anchor Nodes -->
            <circle cx="60" cy="65" r="9" fill="#0A0E17" stroke="#00e5a3" stroke-width="3"/>
            <circle cx="280" cy="65" r="9" fill="#0A0E17" stroke="#00e5ff" stroke-width="3"/>
            <circle cx="500" cy="65" r="13" fill="#0A0E17" stroke="#00e5a3" stroke-width="4" filter="url(#svgHighwayGlow)"/>
            <circle cx="720" cy="65" r="9" fill="#0A0E17" stroke="#38bdf8" stroke-width="3"/>
            <circle cx="940" cy="65" r="9" fill="#0A0E17" stroke="#00e5a3" stroke-width="3"/>

            <!-- Node Text Labels -->
            <text x="60" y="102" fill="#64748B" font-size="11" font-family="JetBrains Mono, monospace" text-anchor="middle">Cron/Sync</text>
            <text x="280" y="102" fill="#64748B" font-size="11" font-family="JetBrains Mono, monospace" text-anchor="middle">OCI Disk</text>
            <text x="500" y="104" fill="#00e5a3" font-size="12" font-family="JetBrains Mono, monospace" text-anchor="middle" font-weight="bold">FastAPI I/O</text>
            <text x="720" y="102" fill="#64748B" font-size="11" font-family="JetBrains Mono, monospace" text-anchor="middle">Edge CDN</text>
            <text x="940" y="102" fill="#64748B" font-size="11" font-family="JetBrains Mono, monospace" text-anchor="middle">Client UI</text>

            <!-- Packets along offset-path -->
            <circle id="pkt-stream-1" r="5.5" fill="#00e5a3" filter="url(#svgHighwayGlow)" class="highway-pkt" style="--track-path: path('M 60 65 C 250 65, 250 65, 500 65 C 750 65, 750 65, 940 65'); animation-delay: 0s;"/>
            <circle id="pkt-stream-2" r="6.5" fill="#00e5ff" filter="url(#svgHighwayGlow)" class="highway-pkt" style="--track-path: path('M 60 65 C 250 65, 250 65, 500 65 C 750 65, 750 65, 940 65'); animation-delay: 0.9s;"/>
            <circle id="pkt-stream-3" r="5.5" fill="#38bdf8" filter="url(#svgHighwayGlow)" class="highway-pkt" style="--track-path: path('M 60 65 C 250 65, 250 65, 500 65 C 750 65, 750 65, 940 65'); animation-delay: 1.8s;"/>
            <circle id="pkt-stream-4" r="5.0" fill="#a7f3d0" filter="url(#svgHighwayGlow)" class="highway-pkt" style="--track-path: path('M 60 65 C 250 65, 250 65, 500 65 C 750 65, 750 65, 940 65'); animation-delay: 2.7s;"/>
          </svg>
        </div>

        <!-- Node Inspector & HTTP 206 Simulator (Split Columns) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 pt-2">
          
          <!-- Left 7 cols: Detailed Node Inspector -->
          <div class="lg:col-span-7 bg-canvas-surface border border-canvas-border rounded-xl p-5 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between pb-3 border-b border-canvas-border">
                <div class="flex items-center gap-2">
                  <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
                  <span id="inspect-subtitle" class="text-xs font-mono text-emerald-400 font-semibold uppercase tracking-wider">MÓDULO 03 // GATEWAY</span>
                </div>
                <span id="inspect-tag" class="text-[11px] font-mono px-2 py-0.5 rounded-tech-sm bg-canvas-raised text-slate-300 border border-canvas-border">STARLETTE_ASYNC</span>
              </div>

              <h3 id="inspect-title" class="text-lg font-bold text-slate-100 mt-3 font-mono">FastAPI Byte-Range Engine</h3>
              <p id="inspect-description" class="text-xs sm:text-sm text-slate-300 mt-2 leading-relaxed">
                Resuelve peticiones con cabecera <code class="text-cyan-300 font-mono">Range: bytes=start-end</code>, emitiendo códigos de estado <strong class="text-emerald-400">206 Partial Content</strong> con soporte de scrubbing instantáneo sin bloquear el bucle de eventos.
              </p>

              <!-- Code Snippet Display -->
              <div class="mt-4 bg-[#05080E] border border-canvas-border rounded-lg p-3 font-mono text-xs overflow-x-auto text-slate-300">
                <div class="text-[10px] text-slate-400 uppercase mb-1.5 flex items-center justify-between">
                  <span>Implementación en Producción</span>
                  <button type="button" id="copy-code-btn" class="text-cyan-400 hover:text-cyan-300 text-[10px] transition-colors focus-visible:ring-1 focus-visible:ring-cyan-400">Copiar</button>
                </div>
                <pre id="inspect-code" class="text-emerald-300/90 leading-relaxed text-[11px] sm:text-xs"><code>@app.get("/api/media/&#123;track_id&#125;")
async def get_media_track(track_id: str) -&gt; FileResponse:
    file_path = os.path.join(settings.MEDIA_DIR, f"&#123;clean_id&#125;.mp3")
    return FileResponse(
        file_path,
        media_type="audio/mpeg",
        headers=&#123;"Accept-Ranges": "bytes", "Cache-Control": "public, max-age=86400"&#125;
    )</code></pre>
              </div>
            </div>

            <!-- Live Metrics Mini-Bar -->
            <div class="mt-4 pt-3 border-t border-canvas-border grid grid-cols-3 gap-2 text-center font-mono">
              <div class="bg-[#070B12] p-2.5 rounded-tech-sm border border-canvas-border">
                <div class="text-[10px] text-slate-400">Tamaño Chunk</div>
                <div id="metric-chunk" class="text-xs sm:text-sm font-semibold text-cyan-400">1024 KB</div>
              </div>
              <div class="bg-[#070B12] p-2.5 rounded-tech-sm border border-canvas-border">
                <div class="text-[10px] text-slate-400">Latencia Edge</div>
                <div id="metric-latency" class="text-xs sm:text-sm font-semibold text-emerald-400">14 ms</div>
              </div>
              <div class="bg-[#070B12] p-2.5 rounded-tech-sm border border-canvas-border">
                <div class="text-[10px] text-slate-400">Codec Destino</div>
                <div id="metric-codec" class="text-xs sm:text-sm font-semibold text-slate-200">192k MP3</div>
              </div>
            </div>
          </div>

          <!-- Right 5 cols: Interactive Range Request Terminal -->
          <div class="lg:col-span-5 bg-[#06090F] border border-canvas-border rounded-xl p-5 flex flex-col justify-between font-mono">
            <div>
              <div class="flex items-center justify-between pb-2 border-b border-canvas-border text-xs text-slate-400">
                <span class="flex items-center gap-1.5 text-slate-200 font-semibold">
                  <span class="w-2.5 h-2.5 rounded-full bg-amber-400/80 inline-block"></span>
                  <span>Range Request Terminal</span>
                </span>
                <span class="text-[10px] text-slate-500">HTTP/1.1 206</span>
              </div>

              <p class="text-xs text-slate-400 mt-2.5 leading-relaxed font-sans">
                Simula el scrubbing o salto temporal enviando un rango parcial de bytes al motor:
              </p>

              <!-- Controls -->
              <div class="mt-3 flex gap-2 font-mono text-xs">
                <select id="sim-range-select" class="bg-canvas-surface border border-canvas-border rounded-tech-sm px-2.5 py-1.5 text-slate-200 text-xs focus:border-cyan-400 outline-none flex-1">
                  <option value="0-1048575">00:00 (Bytes 0 - 1MB)</option>
                  <option value="1048576-2097151">00:43 (Bytes 1MB - 2MB)</option>
