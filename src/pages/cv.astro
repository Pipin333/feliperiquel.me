  const toggleFilterChevron = document.getElementById('toggle-filter-chevron');

  function isVisible(id: string): boolean {
    const el = document.getElementById(id);
    return el !== null && !el.classList.contains('cv-item-hidden');
  }

  function updateMetrics() {
    const projectCbs = Array.from(checkboxes).filter(cb => cb.getAttribute('data-target')?.startsWith('project-'));
    const visibleProjects = projectCbs.filter(cb => cb.checked).length;

    if (selectedProjectsCount) {
      selectedProjectsCount.textContent = String(visibleProjects);
    }

    if (pageEstimateBadge && pageEstimateText) {
      if (visibleProjects <= 3) {
        pageEstimateBadge.className = 'inline-flex items-center gap-1.5 px-2 py-0.5 rounded-tech font-mono text-[11px] font-medium bg-emerald-950/60 text-emerald-400 border border-emerald-500/30';
        pageEstimateText.textContent = '~1 Página para imprimir';
      } else {
        pageEstimateBadge.className = 'inline-flex items-center gap-1.5 px-2 py-0.5 rounded-tech font-mono text-[11px] font-medium bg-sky-950/60 text-sky-400 border border-sky-500/30';
        pageEstimateText.textContent = '~2 Páginas completas';
      }
    }
  }

  function applyPreset(presetKey: string) {
    const targets = new Set(presets[presetKey] || presets['one-page']);
    checkboxes.forEach((cb) => {
      const target = cb.getAttribute('data-target');
      if (!target) return;
      const isChecked = targets.has(target);
      cb.checked = isChecked;
      const el = document.getElementById(target);
      if (el) {
        if (isChecked) {
          el.classList.remove('cv-item-hidden');
        } else {
          el.classList.add('cv-item-hidden');
        }
      }
    });

    presetBtns.forEach((btn) => {
      if (btn.getAttribute('data-preset') === presetKey) {
        btn.className = 'cv-preset-btn px-2.5 py-1 text-[11px] font-mono rounded-tech transition-colors font-medium bg-telemetry/15 text-telemetry border border-telemetry/30';
      } else {
        btn.className = 'cv-preset-btn px-2.5 py-1 text-[11px] font-mono rounded-tech transition-colors font-medium text-slate-400 hover:text-white';
      }
    });

    updateMetrics();
  }

  // Drawer toggle
  if (toggleFilterDrawer && filterDrawerContent && toggleFilterChevron) {
    toggleFilterDrawer.addEventListener('click', () => {
      const isExpanded = toggleFilterDrawer.getAttribute('aria-expanded') === 'true';
      toggleFilterDrawer.setAttribute('aria-expanded', String(!isExpanded));
      filterDrawerContent.classList.toggle('hidden', isExpanded);
      toggleFilterChevron.classList.toggle('rotate-180', !isExpanded);
    });
  }

  // Preset button listeners
  presetBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const presetKey = btn.getAttribute('data-preset');
      if (presetKey) {
        applyPreset(presetKey);
      }
    });
  });

  // Individual checkbox listeners
  checkboxes.forEach((cb) => {
    cb.addEventListener('change', () => {
      const target = cb.getAttribute('data-target');
      if (!target) return;
      const el = document.getElementById(target);
      if (el) {
        if (cb.checked) {
          el.classList.remove('cv-item-hidden');
        } else {
          el.classList.add('cv-item-hidden');
        }
      }
      // Clear preset highlight when manual change happens
      presetBtns.forEach((btn) => {
        btn.className = 'cv-preset-btn px-2.5 py-1 text-[11px] font-mono rounded-tech transition-colors font-medium text-slate-400 hover:text-white';
      });
      updateMetrics();
    });
  });

  // Print button handler
  const printBtn = document.getElementById('print-cv-btn');
  if (printBtn) {
    printBtn.addEventListener('click', () => {
      window.print();
    });
  }

