      text += `EXPERIENCIA LABORAL\n`;
      if (hasJej) {
        text += `J.E.J. INGENIERÍA S.A. | Gerencia de Innovación y Transformación Digital\nPracticante de Soluciones Digitales & TI | Julio 2026 - Agosto 2026 | Santiago, Chile\n- Levantamiento & Especificación Funcional: Lideró el levantamiento de requerimientos corporativos y redactó especificaciones funcionales y técnicas estructuradas como única fuente de verdad previo a la construcción en Power Platform, traduciendo necesidades de negocio a modelos de datos relacionales y flujos de ejecución.\n- Arquitectura Lógica & Reglas de Negocio: Diseñó matrices tridimensionales de acceso por Centro de Costos, motores de urgencia automática y asignación ponderada de desarrolladores para el sistema de solicitudes corporativas.\n- SLA & Deflexión Activa: Modeló flujos BPMN con tiempos de respuesta estructurados, trazabilidad integral de estados y mecanismos de deflexión activa de requerimientos mediante bases de conocimiento corporativas.\n\n`;
      }
      if (hasDunkin) {
        text += `DUNKIN' CHILE | Operaciones & Retail\nSegundo Subgerente (Sept. 2025 - Ene. 2026) | Colaborador (Abr. 2023 - Sept. 2025) | Santiago, Chile\n- Liderazgo Operativo: Dirigió la operación de turnos críticos y supervisó equipos de hasta 12 colaboradores bajo alta afluencia de público, resolviendo incidencias técnicas, administrativas y de atención en tiempo real.\n- Control de Inventarios & BPM: Lideró auditorías de existencias, control de mermas y recepción de materias primas bajo estrictos estándares BPM. Distinguido como Empleado del Mes y seleccionado para el programa de formación gerencial.\n\n`;
      }
    }

    if (isVisible('sec-educacion')) {
      text += `EDUCACIÓN\nUNIVERSIDAD ANDRÉS BELLO (UNAB)\nIngeniería Civil Informática (Grado en Ingeniería) | 2021 - 2027 (Estimada) | Santiago, Chile\n- Enfoque: Algoritmos Avanzados, Estructuras de Datos, Computación Científica, Inteligencia Artificial, Redes y Sistemas Distribuidos, Bases de Datos Relacionales y Arquitectura de Software.\n\n`;
    }

    const activeProjects: string[] = [];
    if (isVisible('project-adbsa')) {
      activeProjects.push(`- AD-BSA: Algoritmo de Optimización Global Heurística & Auditoría Científica | Python, NumPy, SciPy (Apache 2.0)\n  Investigación exploratoria en metaheurísticas continuas sobre L-SHADE/jSO con aprendizaje negativo activo, anti-atractores y escape cosecante. Telemetría mecanicista de dimensionalidad (concentración de medida en D >= 20), PoC pareado de 360 corridas con Wilcoxon y detección de defecto crítico en opfunu.`);
    }
    if (isVisible('project-cuanto-rinde')) {
      activeProjects.push(`- Cuánto Rinde: PWA de Optimización Combinatoria & Data Pipeline | JavaScript, Python, Firebase\n  Motor de optimización Knapsack DP en JS (pipin333.github.io/calculadoracopete). Pipeline ETL en Python con Playwright Stealth y matriz paralela de 6 runners en GitHub Actions.`);
    }
    if (isVisible('project-toodles')) {
      activeProjects.push(`- Toodles: Bot de Streaming de Audio, Concurrencia & RecSys | Python, Asyncio, PostgreSQL\n  github.com/Pipin333/Toodles - Streaming de baja latencia con FFmpeg y Asyncio en Linux ARM64. Persistencia relacional en PostgreSQL con transacciones atómicas en SQLAlchemy ORM y RecSys musical.`);
    }
    if (isVisible('project-whatsarr')) {
      activeProjects.push(`- Whatsarr: Hub Domótico & Bot de Automatización de Medios | Node.js, TypeScript, Docker\n  github.com/Pipin333/Whatsarr - Bot en TypeScript con Baileys para control remoto del stack *Arr. Despliegue multi-instancia en Docker.`);
    }
    if (isVisible('project-jdwatch')) {
      activeProjects.push(`- JD Watch Controller: Telemetría Inercial Wearable a 50 Hz | Kotlin, Wear OS, Android Jetpack\n  Fusión sensorial IMU de 6 ejes a 50 Hz continuos por UDP/WebSocket sin pérdida para reconocimiento cinemático de bailes.`);
    }
    if (isVisible('project-niidea')) {
      activeProjects.push(`- Ni Idea: Consola de Party Game Multijugador en Tiempo Real | TypeScript, WebSockets, Cloudflare Durable Objects\n  github.com/Pipin333/niideaapp - Consola web para 16 jugadores en salas con PIN de 4 caracteres. Motor determinista de juego en tiempo real con Trivia Rush, Ese Eres Tú y Pinturillo en Canvas.`);
    }
    if (isVisible('project-sonicrip')) {
      activeProjects.push(`- SonicRip Studio & Retórica y Descalabro (RyD) | Web Audio API, Canvas API, NLP Cliente\n  Micro-apps cliente en feliperiquel.me/lab: procesamiento de audio DSP con ecualizador de 8 bandas y FFT en tiempo real, junto a motor heurístico NLP de transmutación estilística.`);
    }

    if (activeProjects.length > 0) {
      text += `PROYECTOS TÉCNICOS DESTACADOS\n` + activeProjects.join('\n') + `\n\n`;
    }

    if (isVisible('sec-habilidades')) {
      text += `HABILIDADES TÉCNICAS\n- Lenguajes: Python 3.11+ (Avanzado: NumPy, SciPy, Asyncio, Pytest), JavaScript (ES6+), TypeScript, SQL (PostgreSQL), Kotlin, HTML5/CSS3.\n- Algoritmos, Computación & Datos: Metaheurísticas (DE, L-SHADE, CMA-ES, PSO), Programación Dinámica, Vectorización Matricial, Estadística No Paramétrica, Web Scraping (Playwright Stealth), Pipelines ETL, HPC.\n- Cloud & DevOps: Linux (Ubuntu Server), Docker, PostgreSQL, Supabase, Firebase RTDB, SQLAlchemy ORM, Oracle Cloud (ARM64), Git, GitHub Actions, Vercel.\n- Frameworks Web: Astro 5, React / Next.js, Tailwind CSS, FastAPI, Node.js, Web Audio API, Cloudflare Durable Objects.\n- Idiomas: Español (Nativo) | Inglés: C1 Avanzado.\n- Certificaciones: Fundamentos de IA & Machine Learning (LinkedIn Learning, 2025) | Liderazgo y Resolución de Conflictos (SENCE, 2025).`;
    }

    return text.trim();
  }

  // Copy plain text handler
  const copyBtn = document.getElementById('copy-text-btn');
  const copyLabel = document.getElementById('copy-btn-label');

  if (copyBtn && copyLabel) {
    copyBtn.addEventListener('click', async () => {
      const plainText = buildSelectedPlainText();
      try {
        await navigator.clipboard.writeText(plainText);
        const originalText = copyLabel.textContent;
        copyLabel.textContent = "¡Copiado!";
        copyBtn.classList.add("border-telemetry", "text-telemetry");
        setTimeout(() => {
          copyLabel.textContent = originalText;
          copyBtn.classList.remove("border-telemetry", "text-telemetry");
        }, 2000);
      } catch (err) {
        console.error("Error al copiar texto:", err);
      }
    });
  }

  // Apply default 1-page selection on page load
  applyPreset('one-page');
</script>
