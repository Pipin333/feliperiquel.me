---
// src/pages/cv.astro
import Layout from '../layouts/Layout.astro';

const pageTitle = "Currículum Vitae | Felipe Riquelme - Ingeniero Civil en Informática";
const pageDescription = "Currículum Vitae oficial de Felipe Riquelme Salvo. Ingeniero Civil en Informática especializado en desarrollo backend, algoritmos de optimización continua, computación científica y sistemas distribuidos. Formato profesional optimizado para lectura y exportación personalizable.";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image="/og/og-cv.png"
  imageAlt="Currículum Vitae Profesional de Felipe Riquelme - Ingeniero Civil en Informática"
>
  <!-- Top Navigation / Action Bar for Recruiters (Hidden on print) -->
  <header class="no-print sticky top-0 z-40 w-full border-b border-canvas-border bg-canvas/95 backdrop-blur-md">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
      <!-- Back to site link -->
      <a
        href="/"
        class="inline-flex items-center gap-2 font-mono text-xs font-medium text-slate-300 hover:text-white transition-colors group focus-visible:rounded-tech px-2 py-1"
      >
        <svg class="w-4 h-4 text-telemetry group-hover:-translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>Volver a <span class="text-white font-bold">feliperiquel<span class="text-telemetry">.me</span></span></span>
      </a>

      <!-- Recruiter Actions -->
      <div class="flex items-center gap-2 sm:gap-3">
        <!-- Copy Plaintext Button -->
        <button
          type="button"
          id="copy-text-btn"
          class="hidden md:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-tech font-mono text-xs font-medium text-slate-300 bg-canvas-surface hover:bg-canvas-raised border border-canvas-border hover:border-slate-500 transition-colors"
          title="Copiar texto plano con el contenido actualmente seleccionado"
        >
          <svg class="w-3.5 h-3.5 text-telemetry" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <span id="copy-btn-label">Copiar Texto Plano</span>
        </button>

        <!-- Native Print / Save PDF Button -->
        <button
          type="button"
          id="print-cv-btn"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-tech font-mono text-xs font-medium text-slate-300 bg-canvas-surface hover:bg-canvas-raised border border-canvas-border hover:border-telemetry/50 transition-colors"
          title="Imprimir o guardar selección actual como PDF mediante el navegador"
        >
          <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          <span>Imprimir / PDF</span>
        </button>

        <!-- Direct PDF Download (Master Official PDF) -->
        <a
          href="/cv-felipe-riquelme.pdf"
          download="CV-Felipe-Riquelme-Salvo.pdf"
          class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-tech font-mono text-xs font-bold text-telemetry-dark bg-telemetry hover:bg-telemetry-hover shadow-glow-cyan transition-all duration-140 hover:-translate-y-0.5"
          title="Descargar PDF oficial completo de 2 páginas (8.7 KB)"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span class="hidden sm:inline">Descargar</span> PDF Oficial
        </a>
      </div>
    </div>
  </header>

  <!-- CV Customization & Export Toolbar (No-print) -->
  <aside aria-label="Controles de exportación de CV" class="no-print bg-[#0B101D] border-b border-canvas-border py-3 px-4 sm:px-6">
    <div class="max-w-5xl mx-auto space-y-2.5">
      <!-- Top Row: Preset selector + Estimated pages badge + Toggle drawer button -->
      <div class="flex flex-wrap items-center justify-between gap-3 text-xs">
        <div class="flex flex-wrap items-center gap-2 sm:gap-3">
          <span class="font-mono text-slate-300 font-semibold flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-telemetry" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
            </svg>
            <span>Filtro de exportación:</span>
          </span>

          <!-- Preset Buttons -->
          <div class="inline-flex rounded-tech p-0.5 bg-canvas-surface border border-canvas-border" role="group" aria-label="Perfiles predefinidos de exportación">
            <button
              type="button"
              class="cv-preset-btn px-2.5 py-1 text-[11px] font-mono rounded-tech transition-colors font-medium bg-telemetry/15 text-telemetry border border-telemetry/30"
              data-preset="one-page"
            >
              1 Página (General)
            </button>
            <button
              type="button"
              class="cv-preset-btn px-2.5 py-1 text-[11px] font-mono rounded-tech transition-colors font-medium text-slate-400 hover:text-white"
              data-preset="backend"
            >
              Backend & Algoritmos
            </button>
            <button
              type="button"
              class="cv-preset-btn px-2.5 py-1 text-[11px] font-mono rounded-tech transition-colors font-medium text-slate-400 hover:text-white"
              data-preset="fullstack"
            >
              Fullstack & Web
            </button>
            <button
              type="button"
              class="cv-preset-btn px-2.5 py-1 text-[11px] font-mono rounded-tech transition-colors font-medium text-slate-400 hover:text-white"
              data-preset="all"
            >
              Completo
            </button>
          </div>
        </div>

        <div class="flex items-center gap-2 sm:gap-3">
          <!-- Page density badge -->
          <span
            id="page-estimate-badge"
            class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-tech font-mono text-[11px] font-medium bg-emerald-950/60 text-emerald-400 border border-emerald-500/30"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span id="page-estimate-text">~1 Página para imprimir</span>
          </span>

          <!-- Toggle details button -->
          <button
            type="button"
            id="toggle-filter-drawer"
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-tech font-mono text-[11px] text-slate-300 hover:text-white bg-canvas-surface hover:bg-canvas-raised border border-canvas-border hover:border-slate-500 transition-colors"
            aria-expanded="false"
            aria-controls="filter-drawer-content"
          >
            <span id="toggle-filter-label">Personalizar partes (<span id="selected-projects-count">3</span>/7)</span>
            <svg id="toggle-filter-chevron" class="w-3 h-3 text-slate-400 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Expandable Checklist Drawer -->
      <div id="filter-drawer-content" class="hidden pt-2 border-t border-canvas-border/70 space-y-3">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <!-- Column 1: Proyectos Técnicos (Selección individual) -->
          <div class="space-y-1.5 md:col-span-2">
            <div class="flex items-center justify-between text-[11px] font-mono font-semibold text-slate-300 pb-0.5">
              <span>Proyectos Técnicos a incluir:</span>
              <span class="text-slate-400 font-normal">Marca los más relevantes para tu búsqueda</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 text-xs">
              <label class="flex items-center gap-2 p-1.5 rounded bg-canvas-surface/70 border border-canvas-border hover:border-telemetry/40 cursor-pointer">
                <input type="checkbox" class="cv-checkbox accent-telemetry w-3.5 h-3.5" data-target="project-adbsa" checked />
                <span class="text-slate-200 font-medium">AD-BSA <span class="text-[10px] font-mono text-slate-400">(Optimización & HPC)</span></span>
              </label>
              <label class="flex items-center gap-2 p-1.5 rounded bg-canvas-surface/70 border border-canvas-border hover:border-telemetry/40 cursor-pointer">
                <input type="checkbox" class="cv-checkbox accent-telemetry w-3.5 h-3.5" data-target="project-cuanto-rinde" checked />
                <span class="text-slate-200 font-medium">Cuánto Rinde <span class="text-[10px] font-mono text-slate-400">(Knapsack DP & ETL)</span></span>
              </label>
              <label class="flex items-center gap-2 p-1.5 rounded bg-canvas-surface/70 border border-canvas-border hover:border-telemetry/40 cursor-pointer">
                <input type="checkbox" class="cv-checkbox accent-telemetry w-3.5 h-3.5" data-target="project-toodles" checked />
                <span class="text-slate-200 font-medium">Toodles <span class="text-[10px] font-mono text-slate-400">(Audio Streaming & RecSys)</span></span>
              </label>
              <label class="flex items-center gap-2 p-1.5 rounded bg-canvas-surface/70 border border-canvas-border hover:border-telemetry/40 cursor-pointer">
                <input type="checkbox" class="cv-checkbox accent-telemetry w-3.5 h-3.5" data-target="project-whatsarr" />
                <span class="text-slate-200 font-medium">Whatsarr <span class="text-[10px] font-mono text-slate-400">(WhatsApp & Media Server)</span></span>
              </label>
              <label class="flex items-center gap-2 p-1.5 rounded bg-canvas-surface/70 border border-canvas-border hover:border-telemetry/40 cursor-pointer">
                <input type="checkbox" class="cv-checkbox accent-telemetry w-3.5 h-3.5" data-target="project-jdwatch" />
                <span class="text-slate-200 font-medium">JD Watch <span class="text-[10px] font-mono text-slate-400">(Wear OS & IMU 50Hz)</span></span>
              </label>
              <label class="flex items-center gap-2 p-1.5 rounded bg-canvas-surface/70 border border-canvas-border hover:border-telemetry/40 cursor-pointer">
                <input type="checkbox" class="cv-checkbox accent-telemetry w-3.5 h-3.5" data-target="project-niidea" />
                <span class="text-slate-200 font-medium">Ni Idea <span class="text-[10px] font-mono text-slate-400">(Party Game & Durable Objects)</span></span>
              </label>
              <label class="flex items-center gap-2 p-1.5 rounded bg-canvas-surface/70 border border-canvas-border hover:border-telemetry/40 cursor-pointer sm:col-span-2">
                <input type="checkbox" class="cv-checkbox accent-telemetry w-3.5 h-3.5" data-target="project-sonicrip" />
                <span class="text-slate-200 font-medium">SonicRip Studio & Retórica y Descalabro <span class="text-[10px] font-mono text-slate-400">(Web Audio DSP & NLP)</span></span>
              </label>
            </div>
          </div>

          <!-- Column 2: Secciones & Experiencias -->
          <div class="space-y-1.5">
            <div class="text-[11px] font-mono font-semibold text-slate-300 pb-0.5">
              <span>Secciones & Trayectoria:</span>
            </div>
            <div class="space-y-1 text-xs">
              <label class="flex items-center gap-2 p-1 rounded bg-canvas-surface/70 border border-canvas-border hover:border-telemetry/40 cursor-pointer">
                <input type="checkbox" class="cv-checkbox accent-telemetry w-3.5 h-3.5" data-target="sec-resumen" checked />
                <span class="text-slate-200">Resumen Profesional</span>
              </label>
              <label class="flex items-center gap-2 p-1 rounded bg-canvas-surface/70 border border-canvas-border hover:border-telemetry/40 cursor-pointer">
                <input type="checkbox" class="cv-checkbox accent-telemetry w-3.5 h-3.5" data-target="exp-jej" checked />
                <span class="text-slate-200">J.E.J. Ingeniería <span class="text-[10px] font-mono text-slate-400">(Soluciones Digitales)</span></span>
              </label>
              <label class="flex items-center gap-2 p-1 rounded bg-canvas-surface/70 border border-canvas-border hover:border-telemetry/40 cursor-pointer">
                <input type="checkbox" class="cv-checkbox accent-telemetry w-3.5 h-3.5" data-target="exp-dunkin" checked />
                <span class="text-slate-200">Dunkin' Chile <span class="text-[10px] font-mono text-slate-400">(Subgerencia)</span></span>
              </label>
              <label class="flex items-center gap-2 p-1 rounded bg-canvas-surface/70 border border-canvas-border hover:border-telemetry/40 cursor-pointer">
                <input type="checkbox" class="cv-checkbox accent-telemetry w-3.5 h-3.5" data-target="sec-educacion" checked />
                <span class="text-slate-200">Educación (UNAB)</span>
              </label>
              <label class="flex items-center gap-2 p-1 rounded bg-canvas-surface/70 border border-canvas-border hover:border-telemetry/40 cursor-pointer">
                <input type="checkbox" class="cv-checkbox accent-telemetry w-3.5 h-3.5" data-target="sec-habilidades" checked />
                <span class="text-slate-200">Habilidades Técnicas</span>
              </label>
            </div>
          </div>
        </div>

        <p class="text-[11px] text-slate-400 font-sans italic pt-1">
          * Datos de contacto y perfil técnico siempre se incluyen. Al presionar <strong>Imprimir / PDF</strong>, se renderiza exactamente esta selección.
        </p>
      </div>
    </div>
  </aside>

  <!-- MAIN CV DOCUMENT CONTAINER -->
  <main class="flex-1 py-8 sm:py-12 px-4 sm:px-6">
    <div class="max-w-4xl mx-auto">

      <!-- The Resume Paper Container -->
      <article
        id="cv-paper"
        class="cv-document relative bg-[#090D17] border border-canvas-border rounded-tech p-6 sm:p-10 lg:p-12 shadow-2xl text-slate-200 transition-colors"
      >
        <!-- 1. HEADER SECTION -->
        <header class="border-b border-canvas-border pb-6 mb-6">
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-2 mb-2">
            <h1 class="text-2xl sm:text-3xl font-display font-extrabold text-white tracking-tight">
              FELIPE SEBASTIÁN RIQUELME SALVO
            </h1>
            <span class="font-mono text-xs font-semibold text-domain-audio uppercase tracking-wider">
              Inglés: C1 Avanzado
            </span>
          </div>

          <div class="font-mono text-xs sm:text-sm font-semibold text-telemetry mb-3">
            Ingeniero Civil en Informática | Backend, Algoritmos & Sistemas Distribuidos
          </div>

          <!-- Contact Details -->
          <div class="flex flex-wrap items-center gap-y-1.5 gap-x-3 text-xs font-mono text-slate-400 pt-1">
            <span class="text-slate-300">Santiago, Chile</span>
            <span class="text-canvas-border">|</span>
            <a href="mailto:feliperiquelme34@gmail.com" class="text-slate-300 hover:text-telemetry transition-colors underline decoration-slate-600 underline-offset-2">
              feliperiquelme34@gmail.com
            </a>
            <span class="text-canvas-border">|</span>
            <span class="text-slate-300">+56 9 7520 0121</span>
            <span class="text-canvas-border">|</span>
            <a href="https://feliperiquel.me" class="text-slate-300 hover:text-telemetry transition-colors underline decoration-slate-600 underline-offset-2">
              feliperiquel.me
            </a>
            <span class="text-canvas-border">|</span>
            <a href="https://linkedin.com/in/friquelmes" target="_blank" rel="noopener noreferrer" class="text-slate-300 hover:text-telemetry transition-colors underline decoration-slate-600 underline-offset-2">
              linkedin.com/in/friquelmes
            </a>
            <span class="text-canvas-border">|</span>
            <a href="https://github.com/Pipin333" target="_blank" rel="noopener noreferrer" class="text-slate-300 hover:text-telemetry transition-colors underline decoration-slate-600 underline-offset-2">
              github.com/Pipin333
            </a>
          </div>
        </header>

        <!-- 2. RESUMEN PROFESIONAL -->
        <section id="sec-resumen" class="cv-item mb-7" data-cv-item="sec-resumen" aria-labelledby="heading-resumen">
          <h2 id="heading-resumen" class="section-title text-sm font-mono font-bold text-white uppercase tracking-wider mb-2 flex items-center gap-2">
            <span class="text-telemetry font-mono">&gt;</span> Resumen Profesional
          </h2>
          <div class="w-full h-px bg-canvas-border mb-3"></div>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed font-sans text-justify">
            Estudiante de Ingeniería Civil Informática (UNAB) con sólida preparación práctica en desarrollo backend con Python, computación científica de alto rendimiento (HPC), optimización continua y arquitectura de sistemas distribuidos. Creador de <strong class="text-white font-semibold">AD-BSA</strong>, prototipo de algoritmo metaheurístico basado en la familia SHADE (L-SHADE/jSO), con enfoque en el aprendizaje negativo explícito como motor, telemetría mecanicista de dimensionalidad (20D) y rigurosa auditoría científica sobre la suite IEEE CEC 2020. Experiencia demostrada en la industria formulando especificaciones técnicas estructuradas y matrices de lógica de negocio en J.E.J. Ingeniería, así como liderazgo de equipos de hasta 12 colaboradores bajo alta demanda operativa en Dunkin' Chile. Orientado al código limpio, observabilidad, rigor analítico y testing en terreno.
          </p>
        </section>

        <!-- 3. EXPERIENCIA LABORAL -->
        <section id="sec-experiencia" class="mb-7" aria-labelledby="heading-experiencia">
          <h2 id="heading-experiencia" class="section-title text-sm font-mono font-bold text-white uppercase tracking-wider mb-2 flex items-center gap-2">
            <span class="text-telemetry font-mono">&gt;</span> Experiencia Laboral
          </h2>
          <div class="w-full h-px bg-canvas-border mb-3"></div>

          <div class="space-y-5">
            <!-- J.E.J. Ingenieria -->
            <article id="exp-jej" class="cv-item space-y-1.5" data-cv-item="exp-jej">
              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
                <h3 class="text-sm font-display font-bold text-white">
                  J.E.J. INGENIERÍA S.A. | Gerencia de Innovación y Transformación Digital
                </h3>
                <span class="font-mono text-xs text-slate-400">Santiago, Chile</span>
              </div>
              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 text-xs font-mono text-telemetry">
                <span>Practicante de Soluciones Digitales & TI</span>
                <span class="text-slate-400">Julio 2026 - Agosto 2026</span>
              </div>
              <ul class="list-disc list-outside pl-4 space-y-1 text-xs text-slate-300 font-sans leading-relaxed pt-1">
                <li>
                  <strong class="text-white">Levantamiento & Especificación Funcional:</strong> Lideró el levantamiento de requerimientos corporativos y redactó especificaciones funcionales y técnicas estructuradas como única fuente de verdad previo a la construcción en Power Platform, traduciendo necesidades de negocio a modelos de datos relacionales y flujos de ejecución.
                </li>
                <li>
                  <strong class="text-white">Arquitectura Lógica & Reglas de Negocio:</strong> Diseñó matrices tridimensionales de acceso por Centro de Costos, motores de urgencia automática y asignación ponderada de desarrolladores para el sistema de solicitudes corporativas.
                </li>
                <li>
                  <strong class="text-white">SLA & Deflexión Activa:</strong> Modeló flujos BPMN con tiempos de respuesta estructurados, trazabilidad integral de estados y mecanismos de deflexión activa de requerimientos mediante bases de conocimiento corporativas.
                </li>
              </ul>
            </article>

            <!-- Dunkin' Chile -->
            <article id="exp-dunkin" class="cv-item space-y-1.5 pt-2" data-cv-item="exp-dunkin">
              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
                <h3 class="text-sm font-display font-bold text-white">
                  DUNKIN' CHILE | Operaciones & Retail
                </h3>
                <span class="font-mono text-xs text-slate-400">Santiago, Chile</span>
              </div>
              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 text-xs font-mono text-telemetry">
                <span>Segundo Subgerente (Sept. 2025 - Ene. 2026) | Colaborador (Abr. 2023 - Sept. 2025)</span>
                <span class="text-slate-400">Abril 2023 - Enero 2026</span>
              </div>
              <ul class="list-disc list-outside pl-4 space-y-1 text-xs text-slate-300 font-sans leading-relaxed pt-1">
                <li>
                  <strong class="text-white">Liderazgo Operativo:</strong> Dirigió la operación de turnos críticos y supervisó equipos de hasta 12 colaboradores bajo alta afluencia de público, resolviendo incidencias técnicas, administrativas y de atención en tiempo real.
                </li>
                <li>
                  <strong class="text-white">Control de Inventarios & BPM:</strong> Lideró auditorías de existencias, control de mermas y recepción de materias primas bajo estrictos estándares BPM. Distinguido como Empleado del Mes y seleccionado para el programa de formación gerencial.
                </li>
              </ul>
            </article>
          </div>
        </section>

        <!-- 4. EDUCACIÓN -->
        <section id="sec-educacion" class="cv-item mb-7" data-cv-item="sec-educacion" aria-labelledby="heading-educacion">
          <h2 id="heading-educacion" class="section-title text-sm font-mono font-bold text-white uppercase tracking-wider mb-2 flex items-center gap-2">
            <span class="text-telemetry font-mono">&gt;</span> Educación
          </h2>
          <div class="w-full h-px bg-canvas-border mb-3"></div>

          <article class="space-y-1">
            <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
              <h3 class="text-sm font-display font-bold text-white">
                UNIVERSIDAD ANDRÉS BELLO (UNAB)
              </h3>
              <span class="font-mono text-xs text-slate-400">Santiago, Chile</span>
            </div>
            <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 text-xs font-mono text-telemetry">
              <span>Ingeniería Civil Informática (Grado en Ingeniería)</span>
              <span class="text-slate-400">2021 - 2027 (Estimada)</span>
            </div>
            <p class="text-xs text-slate-300 font-sans leading-relaxed pt-0.5">
              Enfoque de malla: Algoritmos Avanzados, Estructuras de Datos Complejas, Computación Científica, Inteligencia Artificial, Redes y Sistemas Distribuidos, Bases de Datos Relacionales y Arquitectura de Software.
            </p>
          </article>
        </section>

        <!-- 5. PROYECTOS TÉCNICOS DESTACADOS -->
