---
// src/pages/404.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="404: Subrutina No Encontrada | Felipe Riquelme"
  description="La ruta solicitada no existe o fue reubicada en el servidor de feliperiquel.me."
  robots="noindex, nofollow"
>
  <Header />

  <main id="main-content" class="flex-1 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 flex flex-col items-center justify-center text-center">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 font-mono text-xs text-slate-400 mb-8" aria-label="Ruta de navegación">
      <a href="/" class="hover:text-white transition-colors">Inicio</a>
      <span aria-hidden="true">/</span>
      <span class="text-rose-400 font-medium" aria-current="page">Error 404</span>
    </nav>

    <!-- Main Heading -->
    <h1 class="text-4xl sm:text-6xl font-display font-extrabold text-white tracking-tight mb-4">
      Subrutina no encontrada
    </h1>

    <p class="text-sm sm:text-base text-slate-300 max-w-xl mx-auto leading-relaxed mb-10 font-sans">
      El recurso solicitado no se encuentra indexado en este cluster o fue migrado a otra partición. Verifica la URL o regresa a una zona segura del sistema.
    </p>

    <!-- Simulated Terminal Diagnostic Block -->
    <div class="w-full max-w-lg spotlight-card bg-canvas-surface border border-canvas-border rounded-tech overflow-hidden text-left font-mono text-xs mb-10 shadow-2xl">
      <div class="bg-canvas border-b border-canvas-border px-3.5 py-2 flex items-center justify-between text-slate-500 text-[11px]">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
          <span class="ml-1 text-slate-400">kernel-trace.log</span>
        </div>
        <span>DIAGNOSTIC</span>
      </div>
      <div class="p-4 space-y-1.5 text-slate-300 text-[11px] leading-relaxed">
        <div class="text-slate-500">&gt; probing request route...</div>
        <div><span class="text-rose-400 font-bold">[FAIL]</span> 0 matches found for path</div>
        <div><span class="text-telemetry font-bold">[INFO]</span> suggested action: return to / or /lab</div>
        <div class="text-slate-500 pt-1 border-t border-canvas-border/60">
          host: feliperiquel.me | status: 404 Not Found
        </div>
      </div>
    </div>

    <!-- Recovery CTAs -->
    <div class="flex flex-col sm:flex-row items-center gap-3 w-full sm:w-auto">
      <a
        href="/"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-tech font-mono text-xs font-bold text-telemetry-dark bg-telemetry hover:bg-telemetry-hover shadow-glow-cyan transition-all duration-140 hover:-translate-y-0.5"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        <span>Volver a la raíz</span>
      </a>

      <a
        href="/lab"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-tech font-mono text-xs font-semibold text-slate-200 bg-canvas-surface hover:bg-canvas-raised border border-canvas-border hover:border-slate-500 transition-all duration-140 hover:-translate-y-0.5"
      >
        <span>Explorar el Laboratorio</span>
        <svg class="w-4 h-4 text-telemetry" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </main>

  <Footer />
</Layout>
