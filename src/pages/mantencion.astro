---
// src/pages/mantencion.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
---

<Layout
  title="Mantenimiento Programado | Felipe Riquelme"
  description="Plataforma temporalmente en mantenimiento para calibración de infraestructura y actualización en feliperiquel.me."
  robots="noindex, nofollow"
>
  <Header />

  <main id="main-content" class="flex-1 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20 flex flex-col items-center justify-center text-center">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 font-mono text-xs text-slate-400 mb-6" aria-label="Ruta de navegación">
      <a href="/" class="hover:text-white transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-telemetry rounded-sm">Inicio</a>
      <span aria-hidden="true">/</span>
      <span class="text-amber-400 font-medium" aria-current="page">Mantenimiento</span>
    </nav>

    <!-- Status Pulse Badge -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 font-mono text-xs mb-5 shadow-sm">
      <span class="relative flex h-2 w-2" aria-hidden="true">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
      </span>
      <span>ESTADO: SERVICIOS EN PAUSA TÉCNICA</span>
    </div>

    <!-- Main Heading -->
    <h1 class="text-3xl sm:text-5xl font-display font-extrabold text-white tracking-tight mb-3">
      Plataforma en Mantenimiento
    </h1>

    <p class="text-sm sm:text-base text-slate-300 max-w-xl mx-auto leading-relaxed mb-8 font-sans">
      Se están ejecutando tareas de actualización y despliegue de infraestructura en <strong class="text-white font-semibold">feliperiquel.me</strong>. Las rutas públicas y APIs se encuentran temporalmente pausadas. El servicio se reanudará en breve.
    </p>

    <!-- Diagnostic & Evidence Grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-5 items-start max-w-4xl mx-auto mb-10 w-full text-left">
      <!-- Columna Izquierda: Terminal Log -->
      <div class="md:col-span-7 spotlight-card bg-canvas-surface border border-canvas-border rounded-tech overflow-hidden font-mono text-xs shadow-2xl">
        <div class="bg-canvas border-b border-canvas-border px-3.5 py-2.5 flex items-center justify-between text-slate-400 text-[11px]">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80" aria-hidden="true"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80" aria-hidden="true"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80" aria-hidden="true"></span>
            <span class="ml-1 text-slate-300 font-semibold">maintenance-trace.log</span>
          </div>
          <span class="text-[10px] tracking-wider text-amber-400 font-semibold uppercase">503 Interrupted</span>
        </div>
        <div class="p-4 space-y-2 text-slate-300 text-[11px] leading-relaxed">
          <div class="text-slate-400">&gt; probing cluster power telemetry...</div>
          <div><span class="text-rose-400 font-bold">[CRIT]</span> unexpected physical power disconnection detected</div>
          <div><span class="text-amber-400 font-bold">[RCA]</span> root cause: domestic avian interference with extension cord</div>
          <div><span class="text-rose-400 font-bold">[LOCK]</span> write operations blocked to prevent data loss</div>
          <div><span class="text-telemetry font-bold">[INFO]</span> re-engaging primary switch and restarting services</div>
          <div><span class="text-slate-400 font-bold">[RETRY]</span> check back in a few minutes</div>
          <div class="text-slate-400 pt-2 border-t border-canvas-border/80 flex flex-wrap items-center justify-between gap-2">
            <span>host: feliperiquel.me</span>
            <span class="text-amber-300 font-medium">status: 503 Maintenance</span>
          </div>
        </div>
      </div>

      <!-- Columna Derecha: Evidencia Fotográfica (Meme) -->
      <div class="md:col-span-5 spotlight-card bg-canvas-surface border border-canvas-border rounded-tech overflow-hidden shadow-2xl">
        <div class="bg-canvas border-b border-canvas-border px-3.5 py-2 flex items-center justify-between font-mono text-[11px] text-slate-400">
          <span class="flex items-center gap-1.5">
            <Icon name="camera" class="w-3.5 h-3.5 text-amber-400" />
            <span class="text-slate-300 font-semibold">evidencia-rca.png</span>
          </span>
          <span class="text-[10px] text-rose-400 font-semibold uppercase">Hardware Fail</span>
        </div>
        <div class="p-3 bg-canvas/60">
          <div class="relative overflow-hidden rounded-tech-sm border border-canvas-border/80 bg-black/40">
            <img
              src="/images/gallina-alargador.png"
              alt="Meme: gallina apagando el interruptor del alargador con la pata"
              width="648"
              height="772"
              class="w-full h-auto object-contain max-h-[300px] sm:max-h-[320px] mx-auto select-none"
              loading="eager"
            />
          </div>
          <div class="mt-2.5 p-2.5 rounded-tech-sm bg-canvas border border-canvas-border/60">
            <p class="font-mono text-xs font-semibold text-slate-200 leading-snug">
              "Qué rabia, estaba en pleno deploy y la gallina me apagó el alargador."
            </p>
            <div class="mt-1.5 flex items-center justify-between font-mono text-[10px] text-slate-400">
              <span>FIG. I: CORTE FÍSICO</span>
              <span class="text-amber-400 font-medium">RCA CONFIRMADO</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Recovery CTAs & Contingency Channels -->
    <div class="flex flex-col sm:flex-row items-center gap-3 w-full sm:w-auto">
      <a
        href="/mantencion"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-tech font-mono text-xs font-bold text-telemetry-dark bg-telemetry hover:bg-telemetry-hover shadow-glow-cyan transition-all duration-140 hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white cursor-pointer"
      >
        <Icon name="arrow-clockwise" class="w-4 h-4" />
        <span>Comprobar si ya volvió</span>
      </a>

      <a
        href="https://www.linkedin.com/in/felipe-riquelme-developer/"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-tech font-mono text-xs font-semibold text-slate-200 bg-canvas-surface hover:bg-canvas-raised border border-canvas-border hover:border-slate-500 transition-all duration-140 hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-telemetry"
        aria-label="Contactar a Felipe Riquelme vía LinkedIn (canal externo, abre en pestaña nueva)"
      >
        <Icon name="linkedin" class="w-4 h-4 text-[#0A66C2]" />
        <span>Canal externo (LinkedIn)</span>
      </a>
    </div>
  </main>

  <Footer />
</Layout>
