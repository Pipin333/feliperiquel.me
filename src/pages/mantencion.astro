---
// src/pages/mantencion.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
---

<Layout
  title="Mantenimiento Programado | Felipe Riquelme"
  description="Plataforma temporalmente en mantenimiento para calibración de infraestructura y actualización en feliperiquel.me."
>
  <Header />

  <main id="main-content" class="flex-1 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 flex flex-col items-center justify-center text-center">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 font-mono text-xs text-slate-400 mb-8" aria-label="Ruta de navegación">
      <a href="/" class="hover:text-white transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-telemetry rounded-sm">Inicio</a>
      <span aria-hidden="true">/</span>
      <span class="text-amber-400 font-medium" aria-current="page">Mantenimiento</span>
    </nav>

    <!-- Status Pulse Badge -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 font-mono text-xs mb-6 shadow-sm">
      <span class="relative flex h-2 w-2" aria-hidden="true">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
      </span>
      <span>ESTADO: SERVICIOS EN PAUSA TÉCNICA</span>
    </div>

    <!-- Main Heading -->
    <h1 class="text-4xl sm:text-6xl font-display font-extrabold text-white tracking-tight mb-4">
      Plataforma en Mantenimiento
    </h1>

    <p class="text-sm sm:text-base text-slate-300 max-w-xl mx-auto leading-relaxed mb-10 font-sans">
      Se están ejecutando tareas de actualización y despliegue de infraestructura en <strong class="text-white font-semibold">feliperiquel.me</strong>. Las rutas públicas y APIs se encuentran temporalmente pausadas. El servicio se reanudará en breve.
    </p>

    <!-- Simulated Terminal Diagnostic Block -->
    <div class="w-full max-w-lg spotlight-card bg-canvas-surface border border-canvas-border rounded-tech overflow-hidden text-left font-mono text-xs mb-10 shadow-2xl">
      <div class="bg-canvas border-b border-canvas-border px-3.5 py-2.5 flex items-center justify-between text-slate-400 text-[11px]">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80" aria-hidden="true"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80" aria-hidden="true"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80" aria-hidden="true"></span>
          <span class="ml-1 text-slate-300 font-semibold">maintenance-trace.log</span>
        </div>
        <span class="text-[10px] tracking-wider text-amber-400 font-semibold uppercase">503 Service Unavailable</span>
      </div>
      <div class="p-4 space-y-2 text-slate-300 text-[11px] leading-relaxed">
        <div class="text-slate-400">&gt; checking cluster status...</div>
        <div><span class="text-amber-400 font-bold">[HALT]</span> web gateway &amp; public APIs: paused</div>
        <div><span class="text-rose-400 font-bold">[LOCK]</span> write operations blocked to prevent data loss</div>
        <div><span class="text-telemetry font-bold">[INFO]</span> deployment pipeline running in background</div>
        <div><span class="text-slate-400 font-bold">[RETRY]</span> check back in a few minutes</div>
        <div class="text-slate-400 pt-2 border-t border-canvas-border/80 flex flex-wrap items-center justify-between gap-2">
          <span>host: feliperiquel.me</span>
          <span class="text-amber-300 font-medium">status: 503 Maintenance Mode</span>
        </div>
      </div>
    </div>

    <!-- Recovery CTAs & Contingency Channels -->
    <div class="flex flex-col sm:flex-row items-center gap-3 w-full sm:w-auto">
      <a
        href="/mantencion/"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-tech font-mono text-xs font-bold text-telemetry-dark bg-telemetry hover:bg-telemetry-hover shadow-glow-cyan transition-all duration-140 hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white cursor-pointer"
      >
        <Icon name="arrow-clockwise" class="w-4 h-4" />
        <span>Comprobar si ya volvió</span>
      </a>

      <a
        href="https://www.linkedin.com/in/felipe-riquelme-developer/"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-tech font-mono text-xs font-semibold text-slate-200 bg-canvas-surface hover:bg-canvas-raised border border-canvas-border hover:border-slate-500 transition-all duration-140 hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-telemetry"
        aria-label="Contactar a Felipe Riquelme vía LinkedIn (canal externo, abre en pestaña nueva)"
      >
        <Icon name="linkedin" class="w-4 h-4 text-[#0A66C2]" />
        <span>Canal externo (LinkedIn)</span>
      </a>
    </div>
  </main>

  <Footer />
</Layout>
