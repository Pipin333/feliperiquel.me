---
// src/pages/mantencion.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
---

<Layout
  title="Mantenimiento Programado | Felipe Riquelme"
  description="Plataforma temporalmente en mantenimiento para calibración de infraestructura, despliegue de módulos y optimización de seguridad en feliperiquel.me."
>
  <Header />

  <main id="main-content" class="flex-1 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 flex flex-col items-center justify-center text-center">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 font-mono text-xs text-slate-400 mb-8" aria-label="Ruta de navegación">
      <a href="/" class="hover:text-white transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-telemetry rounded-sm">Inicio</a>
      <span aria-hidden="true">/</span>
      <span class="text-amber-400 font-medium" aria-current="page">Mantenimiento Programado</span>
    </nav>

    <!-- Status Pulse Badge -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 font-mono text-xs mb-6 shadow-sm">
      <span class="relative flex h-2 w-2" aria-hidden="true">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
      </span>
      <span>ESTADO: RECALIBRACIÓN EN CURSO</span>
    </div>

    <!-- Main Heading -->
    <h1 class="text-4xl sm:text-6xl font-display font-extrabold text-white tracking-tight mb-4">
      Plataforma en Mantenimiento
    </h1>

    <p class="text-sm sm:text-base text-slate-300 max-w-2xl mx-auto leading-relaxed mb-10 font-sans">
      Estamos realizando tareas de calibración de infraestructura, actualización de dependencias y despliegue de nuevas capacidades en <strong class="text-white font-semibold">feliperiquel.me</strong>. Todos los servicios volverán a estar operativos en breve.
    </p>

    <!-- Simulated Terminal Diagnostic Block -->
    <div class="w-full max-w-xl spotlight-card bg-canvas-surface border border-canvas-border rounded-tech overflow-hidden text-left font-mono text-xs mb-10 shadow-2xl">
      <div class="bg-canvas border-b border-canvas-border px-3.5 py-2.5 flex items-center justify-between text-slate-400 text-[11px]">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80" aria-hidden="true"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80" aria-hidden="true"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80" aria-hidden="true"></span>
          <span class="ml-1 text-slate-300 font-semibold">system-maintenance.log</span>
        </div>
        <span class="text-[10px] tracking-wider text-amber-400 font-semibold uppercase">Maintenance Mode</span>
      </div>
      <div class="p-4 space-y-2 text-slate-300 text-[11px] leading-relaxed">
        <div class="text-slate-400">&gt; initiating scheduled maintenance routine...</div>
        <div><span class="text-emerald-400 font-bold">[SYNC]</span> database snapshot: integrity verified (100% OK)</div>
        <div><span class="text-telemetry font-bold">[LOAD]</span> propagating edge-worker updates &amp; security patches</div>
        <div><span class="text-amber-400 font-bold">[LOCK]</span> public endpoints paused to prevent race conditions</div>
        <div><span class="text-telemetry font-bold">[INFO]</span> estimated time of restoration: en curso / shortly</div>
        <div class="text-slate-400 pt-2 border-t border-canvas-border/80 flex flex-wrap items-center justify-between gap-2">
          <span>host: feliperiquel.me</span>
          <span class="text-amber-300 font-medium">status: 503 Planned Service Maintenance</span>
        </div>
      </div>
    </div>

    <!-- Subsystems Status Grid -->
    <section class="w-full max-w-xl grid grid-cols-1 sm:grid-cols-2 gap-3 mb-10 text-left" aria-label="Estado de los subsistemas">
      <div class="p-3.5 bg-canvas-surface/80 border border-canvas-border rounded-tech">
        <div class="flex items-center justify-between mb-1">
          <span class="font-mono text-xs font-semibold text-white flex items-center gap-1.5">
            <Icon name="hdd-network" class="w-3.5 h-3.5 text-telemetry" />
            Gateway &amp; Edge
          </span>
          <span class="font-mono text-[10px] px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300 border border-amber-500/30">
            Actualizando
          </span>
        </div>
        <p class="text-xs text-slate-300 leading-snug">
          Despliegue de nuevas reglas de caché y rendimiento CDN.
        </p>
      </div>

      <div class="p-3.5 bg-canvas-surface/80 border border-canvas-border rounded-tech">
        <div class="flex items-center justify-between mb-1">
          <span class="font-mono text-xs font-semibold text-white flex items-center gap-1.5">
            <Icon name="shield-check" class="w-3.5 h-3.5 text-emerald-400" />
            Persistencia
          </span>
          <span class="font-mono text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
            Seguro
          </span>
        </div>
        <p class="text-xs text-slate-300 leading-snug">
          Bases de datos y esquemas de datos respaldados e intactos.
        </p>
      </div>

      <div class="p-3.5 bg-canvas-surface/80 border border-canvas-border rounded-tech">
        <div class="flex items-center justify-between mb-1">
          <span class="font-mono text-xs font-semibold text-white flex items-center gap-1.5">
            <Icon name="tools" class="w-3.5 h-3.5 text-domain-beer" />
            El Laboratorio
          </span>
          <span class="font-mono text-[10px] px-1.5 py-0.5 rounded bg-telemetry/20 text-telemetry border border-telemetry/30">
            Standby
          </span>
        </div>
        <p class="text-xs text-slate-300 leading-snug">
          Micro-aplicaciones y DSP aislados en modo seguro.
        </p>
      </div>

      <div class="p-3.5 bg-canvas-surface/80 border border-canvas-border rounded-tech">
        <div class="flex items-center justify-between mb-1">
          <span class="font-mono text-xs font-semibold text-white flex items-center gap-1.5">
            <Icon name="envelope" class="w-3.5 h-3.5 text-telemetry" />
            Canal de Contacto
          </span>
          <span class="font-mono text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
            Operativo
          </span>
        </div>
        <p class="text-xs text-slate-300 leading-snug">
          Respuestas prioritarias y consultas disponibles vía correo.
        </p>
      </div>
    </section>

    <!-- Recovery CTAs & Contact Channels -->
    <div class="flex flex-col sm:flex-row items-center gap-3 w-full sm:w-auto">
      <button
        type="button"
        onclick="window.location.reload()"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-tech font-mono text-xs font-bold text-telemetry-dark bg-telemetry hover:bg-telemetry-hover shadow-glow-cyan transition-all duration-140 hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white cursor-pointer"
      >
        <Icon name="arrow-clockwise" class="w-4 h-4" />
        <span>Comprobar estado</span>
      </button>

      <a
        href="mailto:contacto@feliperiquel.me"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-tech font-mono text-xs font-semibold text-slate-200 bg-canvas-surface hover:bg-canvas-raised border border-canvas-border hover:border-slate-500 transition-all duration-140 hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-telemetry"
      >
        <Icon name="envelope" class="w-4 h-4 text-telemetry" />
        <span>Escribir por correo</span>
      </a>

      <a
        href="https://www.linkedin.com/in/felipe-riquelme-developer/"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3 rounded-tech font-mono text-xs font-medium text-slate-300 hover:text-white bg-transparent hover:bg-canvas-surface border border-canvas-border/80 hover:border-slate-400 transition-all duration-140 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-telemetry"
        aria-label="Perfil de LinkedIn de Felipe Riquelme (se abre en pestaña nueva)"
      >
        <Icon name="linkedin" class="w-4 h-4 text-[#0A66C2]" />
        <span>LinkedIn</span>
      </a>
    </div>
  </main>

  <Footer />
</Layout>
