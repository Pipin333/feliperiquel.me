---
// src/pages/sobre-mi.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "Sobre mí | Felipe Riquelme";
const pageDescription = "Felipe Riquelme, Ingeniero Civil en Informática en Santiago, Chile. Trayectoria en cocinas, práctica en la Gerencia de Innovación y TD de JEJ Ingeniería, audio y la conexión con el laboratorio SonicRip.";

const hardware = [
  {
    nombre: "Galaxy Buds FE",
    uso: "Uso diario: transporte, llamadas y caminatas."
  },
  {
    nombre: "Samson SR850",
    uso: "Semiabiertos. Referencia para ajustar EQ y revisar mezclas."
  },
  {
    nombre: "AKG K52",
    uso: "Cerrados y livianos. Sesiones de escucha largas."
  },
  {
    nombre: "NiceHCK EB2S Pro",
    uso: "Earbuds clásicos de formato abierto. Buena respuesta en bajos, sonido equilibrado y descanso para sesiones prolongadas."
  },
  {
    nombre: "Logitech X540",
    uso: "Sistema 5.1 de escritorio."
  },
  {
    nombre: "Behringer UMC22",
    uso: "Interfaz de entrada con previo Midas y monitoreo directo."
  }
];

const artistas = [
  "Michael Jackson",
  "Bad Bunny",
  "Luis Miguel",
  "Guns N' Roses"
];

const albumes = [
  {
    titulo: "Thriller",
    artista: "Michael Jackson",
    anio: "1982",
    portada: "/images/albums/thriller.jpg",
    spotify: "https://open.spotify.com/album/2ANVost0y2y52ema1E9xAZ",
    nota: "Producción en capas, cada elemento con su sitio."
  },
  {
    titulo: "20 Años",
    artista: "Luis Miguel",
    anio: "1990",
    portada: "/images/albums/20-anos.jpg",
    spotify: "https://open.spotify.com/album/3D9NENGfg4DFmYJrEaxRHd",
    nota: "Dinámica, fraseo y control vocal."
  },
  {
    titulo: "Chinese Democracy",
    artista: "Guns N' Roses",
    anio: "2008",
    portada: "/images/albums/chinese-democracy.jpg",
    spotify: "https://open.spotify.com/album/0suNLpB9xraAv1FcdlITjQ",
    nota: "Guitarras superpuestas y un estudio que se extendió por años."
  },
  {
    titulo: "POST MORTEM",
    artista: "Dillom",
    anio: "2021",
    portada: "/images/albums/post-mortem.jpg",
    spotify: "https://open.spotify.com/album/39g3CsFBc9YK9Z6AbvvkgF",
    nota: "Sampleo y ruido tratados como material de mezcla."
  },
  {
    titulo: "Debí Tirar Más Fotos",
    artista: "Bad Bunny",
    anio: "2025",
    portada: "/images/albums/debi-tirar-mas-fotos.png",
    spotify: "https://open.spotify.com/album/5K79FLRUCSysQnVESLcTdb",
    nota: "Plena, protesta y producción contemporánea."
  }
];
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />

  <main id="main-content" class="flex-1 bg-canvas">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
      <nav class="mb-10 flex items-center gap-2 font-mono text-xs text-slate-400" aria-label="Ruta de navegación">
        <a href="/" class="transition-colors hover:text-white">Inicio</a>
        <span aria-hidden="true">/</span>
        <span class="font-medium text-telemetry" aria-current="page">Sobre mí</span>
      </nav>

      <!-- Bloque 1: cabecera y retrato editorial -->
      <section aria-labelledby="perfil-title" class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-16">
        <figure class="mx-auto w-full max-w-sm lg:col-span-5 lg:mx-0 lg:max-w-none">
          <img
            src="/images/felipe-riquelme.jpg"
            alt="Retrato de Felipe Riquelme"
            width="800"
            height="800"
            loading="eager"
            decoding="async"
            class="aspect-square w-full rounded-tech border border-canvas-border bg-canvas-surface object-cover"
          />
          <figcaption class="mt-5 border-l-2 border-telemetry pl-4">
            <blockquote class="font-display text-lg italic leading-snug text-white sm:text-xl">
              <p>“Ícaro se rió mientras caía, porque sabía que había tocado el sol.”</p>
            </blockquote>
            <p class="mt-2 font-mono text-[11px] uppercase tracking-[0.16em] text-slate-500">
              Epígrafe
            </p>
          </figcaption>
        </figure>

        <div class="lg:col-span-7 lg:pt-2">
          <p class="font-mono text-xs uppercase tracking-[0.18em] text-telemetry">
            Perfil / 001
          </p>
          <h1 id="perfil-title" class="mt-3 font-display text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
            Felipe Riquelme
          </h1>
          <p class="mt-3 font-mono text-sm text-slate-300">
            Ingeniero Civil en Informática. Santiago, Chile.
          </p>

          <div class="mt-8 space-y-4 text-sm leading-relaxed text-slate-300 sm:text-base">
            <p>
              Felipe Riquelme, Ingeniero Civil en Informática en Santiago, Chile. Trabajo en software con foco en detalle, rendimiento y utilidad concreta. Me interesan los problemas que no ceden con la primera respuesta, las herramientas que corren en el navegador y el audio como campo de prueba.
            </p>
            <p>
              Fuera del código pasé por cocinas de comida rápida y por una práctica corporativa. Ese recorrido explica buena parte de cómo trabajo: turnos con presión, prioridades que cambian y la costumbre de revisar el trabajo antes de cerrar.
            </p>
          </div>

          <dl class="mt-8 grid grid-cols-1 gap-px overflow-hidden rounded-tech border border-canvas-border bg-canvas-border sm:grid-cols-3">
            <div class="bg-canvas-surface px-4 py-3">
              <dt class="font-mono text-[10px] uppercase tracking-[0.16em] text-slate-500">Base</dt>
              <dd class="mt-1 font-display text-sm font-semibold text-white">Santiago, Chile</dd>
            </div>
            <div class="bg-canvas-surface px-4 py-3">
              <dt class="font-mono text-[10px] uppercase tracking-[0.16em] text-slate-500">Formación</dt>
              <dd class="mt-1 font-display text-sm font-semibold text-white">Ingeniería Civil en Informática</dd>
            </div>
            <div class="bg-canvas-surface px-4 py-3">
              <dt class="font-mono text-[10px] uppercase tracking-[0.16em] text-slate-500">Foco</dt>
              <dd class="mt-1 font-display text-sm font-semibold text-white">Software, datos y audio</dd>
            </div>
          </dl>
        </div>
      </section>

      <!-- Bloque 2: trayectoria real y temple -->
      <section aria-labelledby="trayectoria-title" class="mt-16 border-t border-canvas-border pt-12 sm:mt-24 sm:pt-16">
        <header class="grid gap-4 md:grid-cols-12 md:items-end">
          <div class="md:col-span-8">
            <p class="font-mono text-xs uppercase tracking-[0.18em] text-telemetry">
              01 / Trayectoria
            </p>
            <h2 id="trayectoria-title" class="mt-3 font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">
              Trayectoria real y temple
            </h2>
          </div>
          <p class="text-sm leading-relaxed text-slate-400 md:col-span-4">
            Dos cocinas, una práctica corporativa y una costumbre: revisar el problema desde otro ángulo.
          </p>
        </header>

        <div class="mt-8 grid grid-cols-1 gap-4 lg:grid-cols-2">
          <article class="spotlight-card rounded-tech border border-canvas-border bg-canvas-surface p-6 sm:p-7">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="font-display text-xl font-bold text-white">Dunkin'</h3>
              <span class="font-mono text-[11px] uppercase tracking-wider text-telemetry">crew a sub2</span>
            </div>
            <p class="mt-4 text-sm leading-relaxed text-slate-300">
              Entré como crew y terminé como subgerente 2. Aperturas, horas punta con fila hasta la calle, control de merma e inventario. Éramos hasta cuatro personas por turno en un equipo de diez a doce en el local. La operación no perdona el desorden: si falta un insumo, la venta se detiene.
            </p>
          </article>

          <article class="spotlight-card rounded-tech border border-canvas-border bg-canvas-surface p-6 sm:p-7">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="font-display text-xl font-bold text-white">KFC</h3>
              <span class="font-mono text-[11px] uppercase tracking-wider text-telemetry">crew</span>
            </div>
            <p class="mt-4 text-sm leading-relaxed text-slate-300">
              Crew en freidora, ventana de despacho y cierre. Cada pedido tiene un tiempo, una temperatura y un orden. Aprendí a moverme rápido sin saltarme pasos, incluso cuando la fila no daba tregua.
            </p>
          </article>

          <article class="rounded-tech border border-telemetry/25 bg-telemetry/[0.04] p-6 sm:p-7 lg:col-span-2">
            <h3 class="font-mono text-xs font-bold uppercase tracking-wider text-telemetry">
              La escuela de las cocinas
            </h3>
            <p class="mt-3 max-w-3xl text-sm leading-relaxed text-slate-300">
              Ahí se aprende calma bajo presión, ética de trabajo y prolijidad. Un cierre bien hecho se parece a un commit bien escrito: nadie lo aplaude, pero se nota cuando falta. Esa base sigue apareciendo en el laboratorio y en los proyectos: revisar dos veces antes de dar algo por terminado.
            </p>
          </article>
        </div>

        <div class="mt-4 grid grid-cols-1 gap-4 lg:grid-cols-2">
          <article class="spotlight-card rounded-tech border border-canvas-border bg-canvas-surface p-6 sm:p-7">
            <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-slate-500">02 / Corporativo</p>
            <h3 class="mt-2 font-display text-xl font-bold text-white">JEJ Ingeniería</h3>
            <p class="mt-1 font-mono text-xs text-telemetry">Práctica / Gerencia de Innovación y TD</p>
            <p class="mt-4 text-sm leading-relaxed text-slate-300">
              Práctica en JEJ Ingeniería, en la Gerencia de Innovación y Transformación Digital. Vi de cerca la dinámica corporativa: prioridades que compiten, alcances que cambian y reuniones donde la misma palabra significa cosas distintas según quién habla. Aprendí a preguntar antes de asumir y a moverme dentro de un equipo multidisciplinario.
            </p>
          </article>

          <article class="rounded-tech border border-canvas-border bg-canvas-surface p-6 sm:p-7">
            <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-slate-500">03 / Método</p>
            <h3 class="mt-2 font-display text-xl font-bold text-white">La quinta pata al gato</h3>
            <p class="mt-1 font-mono text-xs text-telemetry">Problemas no convencionales</p>
            <p class="mt-4 text-sm leading-relaxed text-slate-300">
              Cuando la solución directa no aparece, reviso los supuestos, mido el comportamiento real y pruebo una ruta distinta. Esa costumbre está detrás de los tres por qué de cada proyecto del sitio: origen, arquitectura y presencia.
            </p>
            <a href="/proyectos" class="mt-5 inline-flex items-center gap-2 font-mono text-xs font-semibold text-telemetry transition-colors hover:text-telemetry-hover">
              Ver los proyectos
              <span aria-hidden="true">-&gt;</span>
            </a>
          </article>
        </div>
      </section>

      <!-- Bloque 3: audio y música -->
      <section aria-labelledby="audio-title" class="mt-16 border-t border-canvas-border pt-12 sm:mt-24 sm:pt-16">
        <header class="grid gap-4 md:grid-cols-12 md:items-end">
          <div class="md:col-span-8">
            <p class="font-mono text-xs uppercase tracking-[0.18em] text-telemetry">
              02 / Audio
            </p>
            <h2 id="audio-title" class="mt-3 font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">
              Audio y música
            </h2>
          </div>
          <p class="text-sm leading-relaxed text-slate-400 md:col-span-4">
            Hardware concreto, discos que vuelvo a escuchar y el origen de SonicRip.
          </p>
        </header>

        <article class="spotlight-card mt-8 rounded-tech border border-canvas-border bg-canvas-surface p-6 sm:p-8">
          <div class="grid gap-6 md:grid-cols-12 md:items-start">
            <div class="md:col-span-5">
              <h3 class="font-display text-xl font-bold text-white">SonicRip nació de esta costumbre</h3>
              <p class="mt-1 font-mono text-xs text-telemetry">Audio DSP en el navegador</p>
            </div>
            <div class="space-y-4 text-sm leading-relaxed text-slate-300 md:col-span-7">
              <p>
                La música está presente casi todo el día. Escuchar con atención me llevó a preguntar cómo funciona una cadena de señal: muestreo, filtros, dinámica. De esa curiosidad salió SonicRip Studio, el procesador de audio del laboratorio.
              </p>
              <p>
                Corre en el navegador y permite ecualizar, saturar y ver el espectro sin instalar nada. Lo construí para escuchar mi propia música con mis propios filtros.
              </p>
              <a href="/lab/sonicrip" class="inline-flex items-center gap-2 font-mono text-xs font-semibold text-telemetry transition-colors hover:text-telemetry-hover">
                Abrir SonicRip Studio
                <span aria-hidden="true">-&gt;</span>
              </a>
            </div>
          </div>
        </article>

        <article class="mt-4 rounded-tech border border-canvas-border bg-canvas-surface p-6 sm:p-8">
          <h3 class="font-mono text-xs font-bold uppercase tracking-wider text-telemetry">
            Hardware en uso
          </h3>
          <dl class="mt-5 grid grid-cols-1 gap-px overflow-hidden rounded-tech border border-canvas-border bg-canvas-border sm:grid-cols-2 lg:grid-cols-3">
            {hardware.map((item) => (
              <div class="bg-canvas px-4 py-4">
                <dt class="font-display text-sm font-semibold text-white">{item.nombre}</dt>
                <dd class="mt-1 text-xs leading-relaxed text-slate-400">{item.uso}</dd>
              </div>
            ))}
          </dl>
        </article>

        <!-- En rotación: compacto, sin espacio en blanco desperdiciado -->
        <article class="mt-4 rounded-tech border border-canvas-border bg-canvas-surface p-5 sm:p-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <h3 class="font-mono text-xs font-bold uppercase tracking-wider text-telemetry">
              En rotación
            </h3>
            <p class="mt-1 text-xs text-slate-400">
              Cuatro nombres que aparecen seguido en la biblioteca, sin orden de importancia.
            </p>
          </div>
          <ul class="flex flex-wrap items-center gap-2" role="list">
            {artistas.map((artista) => (
              <li class="rounded-tech-sm border border-canvas-border bg-canvas px-3 py-1.5 font-mono text-xs text-slate-200">
                {artista}
              </li>
            ))}
          </ul>
        </article>

        <!-- Álbumes emblemáticos ordenados cronológicamente con carátulas -->
        <article class="mt-4 rounded-tech border border-canvas-border bg-canvas-surface p-6 sm:p-8">
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 mb-6">
            <h3 class="font-mono text-xs font-bold uppercase tracking-wider text-telemetry">
              Álbumes emblemáticos
            </h3>
            <span class="font-mono text-[11px] text-slate-500">
              Orden cronológico por año de lanzamiento
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-4">
            {albumes.map((album, index) => (
              <a
                href={album.spotify}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex flex-col rounded-tech-sm border border-canvas-border bg-canvas p-3.5 transition-all duration-140 hover:border-telemetry/60 hover:-translate-y-0.5 focus-visible:rounded-tech-sm"
                title={`Escuchar ${album.titulo} de ${album.artista} en Spotify`}
              >
                <div class="relative aspect-square w-full overflow-hidden rounded-tech-sm bg-canvas-surface border border-canvas-border">
                  <img
                    src={album.portada}
                    alt={`Carátula del álbum ${album.titulo} de ${album.artista}`}
                    width="400"
                    height="400"
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  />
                  <span class="absolute top-2 right-2 rounded-tech-sm bg-canvas/90 px-2 py-0.5 font-mono text-[11px] font-bold text-telemetry backdrop-blur-sm border border-canvas-border">
                    {album.anio}
                  </span>
                  <span class="absolute bottom-2 left-2 rounded-tech-sm bg-canvas/90 px-1.5 py-0.5 font-mono text-[10px] text-slate-400 backdrop-blur-sm border border-canvas-border">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                </div>

                <div class="mt-3 flex-1 flex flex-col justify-between">
                  <div>
                    <div class="flex items-start justify-between gap-1.5">
                      <h4 class="font-display text-sm font-bold text-white tracking-tight group-hover:text-telemetry transition-colors line-clamp-1" title={album.titulo}>
                        {album.titulo}
                      </h4>
                      <svg class="w-3.5 h-3.5 text-slate-500 group-hover:text-telemetry transition-colors shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                        <polyline points="15 3 21 3 21 9"></polyline>
                        <line x1="10" y1="14" x2="21" y2="3"></line>
                      </svg>
                    </div>
                    <p class="mt-0.5 font-mono text-xs text-slate-400 truncate">
                      {album.artista}
                    </p>
                  </div>
                  <p class="mt-2.5 text-xs leading-relaxed text-slate-300">
                    {album.nota}
                  </p>
                  <div class="mt-3 pt-2.5 border-t border-canvas-border/60 flex items-center justify-between text-[11px] font-mono text-slate-400 group-hover:text-telemetry transition-colors">
                    <span>Spotify</span>
                    <span aria-hidden="true">-&gt;</span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </article>

        <p class="mt-8 font-mono text-[11px] text-slate-500">
          El laboratorio está abierto en <a href="/lab" class="text-telemetry transition-colors hover:text-telemetry-hover">/lab</a>. Sin registro ni formularios.
        </p>
      </section>
    </div>
  </main>

  <Footer />
</Layout>
