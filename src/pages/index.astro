---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import LabShowcase from '../components/LabShowcase.astro';
import WorkShowcase from '../components/WorkShowcase.astro';
import AboutMe from '../components/AboutMe.astro';
import ContactGateway from '../components/ContactGateway.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Felipe Riquelme | Software Engineer & Builder"
  description="Portafolio y laboratorio de software interactivo. Audio DSP en el navegador, micro-aplicaciones en tiempo real, orquestación homelab y optimización de algoritmos."
>
  <Header />
  <main id="main-content" class="flex-1">
    <Hero />
    <LabShowcase />
    <WorkShowcase />
    <AboutMe />
    <ContactGateway />
  </main>
  <Footer />
</Layout>
