---
// src/pages/lab/enel-ux.astro
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
---

<Layout
  title="Autopsia UX & Rediseño: Checkout Móvil Enel | El Laboratorio"
  description="Desglose heurístico, evidencia visual y simulador interactivo del embudo de pago móvil de Enel. De un flujo bloqueado por pop-ups y fallos de accesibilidad a un checkout rápido en 2 pasos (~20s)."
  image="/images/lab/enel-ux/enel-desktop-glitch.jpg"
  imageAlt="Autopsia de Experiencia de Usuario y Rediseño del Checkout Móvil de Enel"
  robots="noindex, nofollow"
>
  <Header />

  <main id="main-content" class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 font-mono text-xs text-slate-400 mb-8" aria-label="Ruta de navegación">
      <a href="/" class="hover:text-white transition-colors">Inicio</a>
      <span aria-hidden="true" class="text-slate-600">/</span>
      <a href="/lab" class="hover:text-white transition-colors">Lab</a>
      <span aria-hidden="true" class="text-slate-600">/</span>
      <span class="text-amber-400 font-medium" aria-current="page">Enel UX Autopsy</span>
    </nav>

    <!-- Header / Hero Section -->
    <header class="mb-10">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white mb-4">
        Autopsia & Rediseño: <span class="bg-gradient-to-r from-amber-400 via-yellow-300 to-amber-500 bg-clip-text text-transparent">Checkout Móvil Enel</span>
      </h1>
      <p class="text-base sm:text-lg text-slate-300 max-w-3xl leading-relaxed">
        Cuando un usuario entra a <strong class="text-white font-medium">su</strong> portal para pagar una cuenta básica, cada segundo y cada capa de fricción cuesta dinero real en soporte y morosidad. Aquí analizamos por qué el flujo actual colapsa en dispositivos móviles y cómo transformarlo en un <strong class="text-white font-medium">Pago Rápido en 2 pasos (~20 segundos)</strong>.
      </p>
    </header>

    <!-- Main Navigation Tabs -->
    <div class="flex items-center gap-2 border-b border-slate-800 mb-8 pb-px" role="tablist" aria-label="Secciones del laboratorio">
      <button
        type="button"
        id="tab-btn-simulator"
        role="tab"
        aria-selected="true"
        aria-controls="panel-simulator"
        class="tab-btn px-4 py-2.5 font-medium text-sm border-b-2 border-amber-400 text-amber-300 flex items-center gap-2 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 rounded-t-tech"
      >
        <Icon name="phone" class="w-4 h-4 text-amber-400" />
        <span>1. Simulador Interactivo (Antes vs. Después)</span>
      </button>

      <button
        type="button"
        id="tab-btn-audit"
        role="tab"
        aria-selected="false"
        aria-controls="panel-audit"
        class="tab-btn px-4 py-2.5 font-medium text-sm border-b-2 border-transparent text-slate-400 hover:text-slate-200 flex items-center gap-2 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 rounded-t-tech"
      >
        <Icon name="exclamation-triangle" class="w-4 h-4 text-slate-400" />
        <span>2. Auditoría Heurística & Evidencia</span>
      </button>

      <button
        type="button"
        id="tab-btn-pitch"
        role="tab"
        aria-selected="false"
        aria-controls="panel-pitch"
        class="tab-btn px-4 py-2.5 font-medium text-sm border-b-2 border-transparent text-slate-400 hover:text-slate-200 flex items-center gap-2 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 rounded-t-tech"
      >
        <Icon name="check2-circle" class="w-4 h-4 text-slate-400" />
        <span>3. Problema → Solución & Contacto</span>
      </button>
    </div>

    <!-- ========================================== -->
    <!-- TAB 1: SIMULADOR INTERACTIVO               -->
    <!-- ========================================== -->
    <section id="panel-simulator" role="tabpanel" aria-labelledby="tab-btn-simulator" class="space-y-8">
      
      <!-- Simulator Controls -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 rounded-tech bg-slate-900/80 border border-slate-800">
        <div>
          <h2 class="text-base font-semibold text-white">Prueba ambos flujos en el emulador móvil</h2>
          <p class="text-xs text-slate-400">Alterna entre la experiencia real de Enel y la propuesta de checkout rediseñada.</p>
        </div>

        <div class="inline-flex p-1 rounded-tech bg-slate-950 border border-slate-800 self-start sm:self-auto" role="group" aria-label="Selector de experiencia">
          <button
            type="button"
            id="sim-mode-before"
            class="px-3.5 py-1.5 rounded-tech text-xs font-mono font-medium transition-all text-white bg-rose-600/90 shadow-sm focus-visible:ring-2 focus-visible:ring-rose-400"
            aria-pressed="true"
          >
            ⚠️ El Desastre Real (Antes)
          </button>
          <button
            type="button"
            id="sim-mode-after"
            class="px-3.5 py-1.5 rounded-tech text-xs font-mono font-medium transition-all text-slate-400 hover:text-white focus-visible:ring-2 focus-visible:ring-emerald-400"
            aria-pressed="false"
          >
            ✨ Propuesta Limpia (Después)
          </button>
        </div>
      </div>

      <!-- Simulator Layout: Phone Mockup (Center) + Live Annotations (Sides) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Interactive Phone Chassis (6 cols on lg) -->
        <div class="lg:col-span-6 flex justify-center">
          <div class="w-full max-w-[360px] rounded-[38px] p-3 bg-slate-950 border-4 border-slate-700 shadow-2xl relative overflow-hidden ring-1 ring-slate-800">
            <!-- Phone Notch / Camera -->
            <div class="absolute top-4 left-1/2 -translate-x-1/2 w-28 h-4 bg-slate-900 rounded-full z-30 flex items-center justify-center">
              <div class="w-2.5 h-2.5 rounded-full bg-slate-800"></div>
            </div>

            <!-- Screen Area (18.5:9 ratio container) -->
            <div class="w-full min-h-[580px] max-h-[640px] rounded-[28px] bg-white text-slate-900 overflow-y-auto relative pt-7 flex flex-col font-sans select-none border border-slate-200" id="phone-screen">
              
              <!-- ============================================== -->
              <!-- VISTA ANTES: EL DESASTRE REAL                   -->
              <!-- ============================================== -->
              <div id="sim-view-before" class="flex flex-col flex-1 w-full text-[12px] relative">
                <!-- 1. Skip-link desnudado -->
                <div class="w-full text-center py-2 bg-white border-b border-rose-300">
                  <a href="#main" class="text-rose-600 font-bold underline text-xs">
                    Saltar al contenido principal
                  </a>
                </div>

                <!-- Enel Header Azul -->
                <div class="w-full bg-[#0055ff] text-white px-3 py-2 flex items-center justify-between shadow-sm">
                  <span class="font-bold text-sm tracking-tight font-sans">enel</span>
                  <div class="flex items-center gap-2 text-xs">
                    <Icon name="phone" class="w-3.5 h-3.5 opacity-80" />
                    <span class="text-xs">≡</span>
                  </div>
                </div>

                <!-- 2-column layout aplastado -->
                <div class="p-2.5 border-b border-slate-200 flex items-center justify-between gap-1 bg-slate-50">
                  <div class="space-y-1 text-[8px] leading-tight text-slate-600 max-w-[150px]">
                    <p class="text-orange-600">Si aún no estás registrado en Sucursal Virtual...</p>
                    <p class="text-pink-600">¿Olvidaste tu contraseña? Recupérala</p>
                    <p class="text-blue-600">¿Copia de boleta? Pídela aquí</p>
                    <p class="text-green-600">¿Otra forma de pagar? Conoce medios</p>
                  </div>
                  <!-- Mini sliced woman graphic -->
                  <div class="w-16 h-14 bg-gradient-to-b from-blue-100 to-indigo-100 rounded border border-slate-300 flex flex-col justify-around p-0.5 overflow-hidden relative">
                    <div class="h-1 bg-white opacity-90"></div>
                    <div class="h-1 bg-white opacity-90"></div>
                    <div class="h-1 bg-white opacity-90"></div>
                    <span class="text-[7px] text-center text-slate-400 font-mono">[Arte Roto]</span>
                  </div>
                </div>

                <!-- Main Form (Debajo) -->
                <div class="p-3 space-y-3 flex-1 bg-white">
                  <div class="flex items-center gap-1.5">
                    <span class="w-4 h-4 rounded-full border border-slate-800 text-[10px] flex items-center justify-center font-bold">1</span>
                    <h3 class="font-bold text-xs text-slate-800">Consultar y pagar cuenta</h3>
                  </div>

                  <div class="space-y-1">
                    <label for="sim-input-client" class="block text-[10px] text-slate-600 font-medium">
                      Ingresa el número de cliente, con dígito verificador:
                    </label>
                    <input
                      id="sim-input-client"
                      type="text"
                      placeholder="Ej: 33683356-K"
                      value="33683356-K"
                      class="w-full px-2 py-1 text-xs border border-slate-300 rounded bg-slate-50 text-slate-700"
                    />
                    <p class="text-[8px] text-slate-500">Si no lo sabes puedes Busca aquí tu número</p>
                  </div>

                  <!-- Botón Gris (Parece desactivado) -->
                  <button
                    type="button"
                    id="sim-btn-consultar"
                    class="w-full py-2 bg-slate-500 text-white font-bold text-xs rounded hover:bg-slate-600 uppercase tracking-wide"
                  >
                    Consultar Deuda
                  </button>

                  <div class="pt-2 text-[9px] text-slate-400 border-t border-slate-100 space-y-1">
                    <p>• Paso 2: Selección de medio</p>
                    <p>• Paso 3: Confirmación</p>
                    <p>• Paso 4: Comprobante</p>
                  </div>
                </div>

                <!-- EL MODAL INVASIVO (CUBRE EL 65% DEL VIEWPORT) -->
                <div id="sim-modal-survey" class="absolute inset-x-2 bottom-6 top-24 bg-[#0055ff] text-white p-4 rounded-xl shadow-2xl flex flex-col justify-center items-center text-center z-20 border border-blue-400 animate-pulse-subtle">
                  <button
                    type="button"
                    id="sim-modal-close"
                    class="absolute top-2 right-2 text-white hover:text-rose-200 text-sm font-bold w-6 h-6 rounded-full bg-blue-700 flex items-center justify-center"
                    aria-label="Cerrar modal de encuesta"
                  >
                    ×
                  </button>
                  <p class="text-sm font-semibold mb-4 text-white">Danos tu opinión</p>
                  <button
                    type="button"
                    class="px-6 py-2 bg-[#ff007f] hover:bg-[#e00070] text-white font-bold text-xs rounded-tech shadow-md uppercase tracking-wider"
                  >
                    Encuesta
                  </button>
                  <p class="text-[9px] text-blue-200 mt-4 max-w-[200px]">
                    (Este modal tapa el campo de pago hasta que encuentras la diminuta 'x')
                  </p>
                </div>

                <!-- Floating Chat Bubble -->
                <div class="absolute bottom-2 right-2 w-8 h-8 rounded-full bg-[#0055ff] text-white flex items-center justify-center shadow-lg z-10">
                  <Icon name="chat-quote" class="w-4 h-4 text-white" />
                </div>
              </div>

              <!-- ============================================== -->
              <!-- VISTA DESPUÉS: CHECKOUT RÁPIDO Y FLUIDO        -->
              <!-- Con paleta de producción Enel (Azul #0055ff)    -->
              <!-- ============================================== -->
              <div id="sim-view-after" class="hidden flex-col flex-1 w-full text-[12px] bg-slate-50 text-slate-800 relative">
                <!-- Header Enel Oficial -->
                <div class="w-full bg-[#0055ff] text-white px-3.5 py-2.5 flex items-center justify-between shadow-sm">
                  <div class="flex items-center gap-2">
                    <span class="font-black text-sm tracking-tight font-sans">enel</span>
                    <span class="text-[9px] font-mono px-2 py-0.5 rounded-full bg-white/20 text-white font-semibold border border-white/30">
                      Pago Rápido
                    </span>
                  </div>
                  <div class="flex items-center gap-1 text-[10px] text-white/90 font-mono">
                    <Icon name="shield-check" class="w-3.5 h-3.5 text-white" />
                    <span>Transacción Segura</span>
                  </div>
                </div>

                <!-- Estado 1: Formulario de Pago Rápido -->
                <div id="sim-after-form" class="p-3.5 space-y-3.5 flex-1 overflow-y-auto bg-slate-50">
                  
                  <!-- Banner de Cliente Identificado -->
                  <div class="p-2.5 rounded-tech bg-white border border-slate-200 shadow-sm flex items-center justify-between">
                    <div>
                      <span class="text-[9px] font-mono text-slate-500 uppercase tracking-wider block">Cuenta Identificada</span>
                      <strong class="text-xs font-mono text-slate-900 font-bold">#33683356-K</strong>
                      <span class="text-[10px] text-slate-600 block">Av. Providencia 1240, Dpto 402</span>
                    </div>
                    <button type="button" class="text-[10px] text-[#0055ff] hover:underline font-mono font-medium">Cambiar</button>
                  </div>

                  <!-- Tarjeta de Saldo a Pagar (Estilo Enel) -->
                  <div class="p-3.5 rounded-tech bg-gradient-to-b from-[#f0f5ff] to-white border border-[#0055ff]/30 shadow-sm">
                    <div class="flex justify-between items-start mb-1">
                      <span class="text-[10px] font-mono uppercase tracking-wider text-[#0055ff] font-bold">Total a Pagar</span>
                      <span class="px-2 py-0.5 rounded text-[9px] font-mono font-bold bg-emerald-100 text-emerald-800 border border-emerald-300">Al Día</span>
                    </div>
                    <div class="text-2xl font-black text-slate-900 font-mono mb-2">
                      $24.590 <span class="text-xs font-medium text-slate-500">CLP</span>
                    </div>

                    <!-- Mini desglose expandible -->
                    <details class="text-[10px] text-slate-700 border-t border-slate-200/80 pt-2">
                      <summary class="cursor-pointer text-[#0055ff] hover:text-[#0047d9] font-mono font-medium flex items-center justify-between">
                        <span>Ver detalle boleta (142 kWh)</span>
                        <span>▾</span>
                      </summary>
                      <div class="mt-2 space-y-1 text-slate-600 font-mono text-[9px] pl-1">
                        <div class="flex justify-between"><span>Consumo del mes (142 kWh):</span> <span class="font-semibold text-slate-800">$18.200</span></div>
                        <div class="flex justify-between"><span>Cargo por servicio y transporte:</span> <span class="font-semibold text-slate-800">$4.100</span></div>
                        <div class="flex justify-between"><span>IVA 19%:</span> <span class="font-semibold text-slate-800">$2.290</span></div>
                      </div>
                    </details>
                  </div>

                  <!-- Selección de Medio de Pago -->
                  <div class="space-y-1.5">
                    <label class="block text-[11px] font-semibold text-slate-800">Medio de pago:</label>
                    <div class="grid grid-cols-2 gap-2">
                      <label class="flex items-center gap-2 p-2 rounded-tech border-2 border-[#0055ff] bg-[#f0f5ff] cursor-pointer shadow-xs">
                        <input type="radio" name="pay-method" value="webpay" checked class="accent-[#0055ff]" />
                        <span class="text-[10px] font-bold text-[#0055ff]">Webpay Plus</span>
                      </label>
                      <label class="flex items-center gap-2 p-2 rounded-tech border border-slate-200 bg-white hover:border-slate-300 cursor-pointer">
                        <input type="radio" name="pay-method" value="cuenta-rut" class="accent-[#0055ff]" />
                        <span class="text-[10px] font-medium text-slate-700">CuentaRUT</span>
                      </label>
                    </div>
                  </div>

                  <!-- Email para Comprobante -->
                  <div class="space-y-1">
                    <label for="sim-input-email" class="block text-[10px] font-mono text-slate-600">Comprobante de pago a:</label>
                    <input
                      id="sim-input-email"
                      type="email"
                      value="cliente@ejemplo.cl"
                      class="w-full px-2.5 py-1.5 rounded-tech text-xs bg-white border border-slate-300 text-slate-900 focus:outline-none focus:border-[#0055ff] focus:ring-1 focus:ring-[#0055ff]"
                    />
                  </div>

                  <!-- Casilla de Términos (Copy Legal Blindado) -->
                  <div class="flex items-start gap-2 pt-1">
                    <input type="checkbox" id="sim-check-terms" checked class="mt-0.5 rounded accent-[#0055ff]" />
                    <label for="sim-check-terms" class="text-[9px] text-slate-600 leading-tight">
                      He leído y <strong class="text-slate-900 font-bold">acepto</strong> los Términos del Servicio y Política de Privacidad.
                    </label>
                  </div>

                  <!-- Botón Primario de Pago (Enel Blue #0055ff de Alta Conversión) -->
                  <button
                    type="button"
                    id="sim-btn-pay"
                    class="w-full py-2.5 rounded-tech bg-[#0055ff] hover:bg-[#0047d9] text-white font-bold text-xs uppercase tracking-wider shadow-md shadow-blue-500/20 active:scale-[0.99] transition-all flex items-center justify-center gap-1.5"
                  >
                    <span>Pagar $24.590 con Webpay</span>
                    <Icon name="arrow-right" class="w-3.5 h-3.5 text-white" />
                  </button>
                </div>

                <!-- Estado 2: Pantalla de Éxito & Encuesta Reubicada -->
                <div id="sim-after-success" class="hidden p-4 space-y-4 flex-1 overflow-y-auto bg-slate-50 text-center">
                  <div class="w-12 h-12 mx-auto rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center shadow-inner mt-2">
                    <Icon name="check2-circle" class="w-7 h-7 text-emerald-600" />
                  </div>
                  <div>
                    <span class="text-[10px] font-mono text-emerald-700 font-bold uppercase tracking-wider">Pago Procesado con Éxito</span>
                    <h4 class="text-xl font-black text-slate-900 font-mono mt-0.5">$24.590 CLP</h4>
                    <p class="text-[10px] text-slate-500 mt-1">Comprobante #TRX-839210 enviado a cliente@ejemplo.cl</p>
                  </div>

                  <!-- LA ENCUESTA REUBICADA POST-TRANSACCIÓN -->
                  <div class="p-3.5 rounded-tech bg-white border border-slate-200 shadow-sm text-left space-y-2 mt-4">
                    <div class="flex items-center justify-between">
                      <span class="text-[9px] font-mono font-bold text-[#0055ff] uppercase tracking-wider">Encuesta de Experiencia</span>
                      <span class="text-[9px] font-mono text-slate-400">Opcional</span>
                    </div>
                    <p class="text-xs font-bold text-slate-800 leading-snug">¿Qué tan fácil te resultó pagar tu cuenta hoy?</p>
                    <div class="grid grid-cols-5 gap-1 pt-1" id="sim-rating-group">
                      <button type="button" class="py-1.5 rounded border border-slate-200 hover:border-[#0055ff] hover:bg-[#f0f5ff] text-xs font-mono font-bold text-slate-600">1</button>
                      <button type="button" class="py-1.5 rounded border border-slate-200 hover:border-[#0055ff] hover:bg-[#f0f5ff] text-xs font-mono font-bold text-slate-600">2</button>
                      <button type="button" class="py-1.5 rounded border border-slate-200 hover:border-[#0055ff] hover:bg-[#f0f5ff] text-xs font-mono font-bold text-slate-600">3</button>
                      <button type="button" class="py-1.5 rounded border border-slate-200 hover:border-[#0055ff] hover:bg-[#f0f5ff] text-xs font-mono font-bold text-slate-600">4</button>
                      <button type="button" class="py-1.5 rounded border-2 border-[#0055ff] bg-[#f0f5ff] text-xs font-mono font-black text-[#0055ff]">5</button>
                    </div>
                    <p class="text-[9px] text-emerald-700 bg-emerald-50 p-1.5 rounded border border-emerald-200 leading-tight">
                      ✓ <strong>Timing Correcto:</strong> La encuesta se presenta después de resolver la necesidad del usuario, sin secuestrar la pantalla ni bloquear el pago.
                    </p>
                  </div>

                  <button
                    type="button"
                    id="sim-btn-restart"
                    class="w-full py-2 rounded-tech border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 text-xs font-mono font-medium transition-colors"
                  >
                    ↺ Reiniciar simulación
                  </button>
                </div>
              </div>

            </div>
          </div>
        </div>

        <!-- Dynamic Explanations Column (6 cols on lg) -->
        <div class="lg:col-span-6 space-y-6">
          <div id="sim-annotation-card" class="p-6 rounded-tech border border-rose-500/40 bg-rose-950/20 text-slate-200 shadow-xl">
            <div class="flex items-center gap-2 mb-3">
              <span class="w-2.5 h-2.5 rounded-full bg-rose-500 animate-ping"></span>
              <h3 class="text-sm font-mono font-bold uppercase tracking-wider text-rose-300" id="annotation-title">
                Anti-Patrón Activo: Modal Interceptor
              </h3>
            </div>
            <p class="text-sm leading-relaxed text-slate-300 mb-4" id="annotation-desc">
              El modal de encuesta bloquea el 65% de la pantalla táctil justo sobre los campos necesarios para consultar o pagar. El usuario se ve obligado a cazar una 'X' minúscula antes de poder completar su trámite.
            </p>
            <div class="p-3 rounded bg-slate-950/80 border border-slate-800 text-xs font-mono text-slate-400" id="annotation-tip">
              💡 <strong>Regla de oro:</strong> Nunca pidas feedback de un servicio antes de que el usuario lo haya podido utilizar. Las encuestas de NPS van en la pantalla de éxito post-pago.
            </div>
          </div>

          <!-- Feature Matrix Comparison -->
          <div class="p-6 rounded-tech border border-slate-800 bg-slate-900/60 space-y-4">
            <h3 class="text-sm font-mono font-semibold text-white uppercase tracking-wider">
              Comparativa de Arquitectura del Flujo
            </h3>

            <div class="space-y-3 text-xs">
              <div class="flex items-start justify-between gap-4 pb-2.5 border-b border-slate-800/80">
                <span class="text-slate-400">Modal de Encuesta:</span>
                <span class="font-mono text-rose-400 text-right">Interrumpe al inicio (Antes)</span>
                <span class="font-mono text-emerald-400 text-right">En pantalla de éxito (Después)</span>
              </div>

              <div class="flex items-start justify-between gap-4 pb-2.5 border-b border-slate-800/80">
                <span class="text-slate-400">Requerimiento de Registro:</span>
                <span class="font-mono text-rose-400 text-right">Obligatorio (Antes)</span>
                <span class="font-mono text-emerald-400 text-right">Guest Checkout (Después)</span>
              </div>

              <div class="flex items-start justify-between gap-4 pb-2.5 border-b border-slate-800/80">
                <span class="text-slate-400">Verificación por SMS (OTP):</span>
                <span class="font-mono text-rose-400 text-right">Cuello de botella (Antes)</span>
                <span class="font-mono text-emerald-400 text-right">Innecesario p/ pagar (Después)</span>
              </div>

              <div class="flex items-start justify-between gap-4">
                <span class="text-slate-400">Accesibilidad & Skip-link:</span>
                <span class="font-mono text-rose-400 text-right">Desajustado en móvil (Antes)</span>
                <span class="font-mono text-emerald-400 text-right">Cumple WCAG 2.2 AA (Después)</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- ========================================== -->
    <!-- TAB 2: AUDITORÍA HEURÍSTICA Y EVIDENCIA     -->
    <!-- ========================================== -->
    <section id="panel-audit" role="tabpanel" aria-labelledby="tab-btn-audit" class="hidden space-y-10">
      
