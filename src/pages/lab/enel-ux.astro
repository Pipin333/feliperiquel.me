<script>
  function initEnelLab() {
    // Tab switching logic
    const tabBtns = document.querySelectorAll('.tab-btn');
    const panelSimulator = document.getElementById('panel-simulator');
    const panelAudit = document.getElementById('panel-audit');
    const panelPitch = document.getElementById('panel-pitch');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        tabBtns.forEach(b => {
          b.setAttribute('aria-selected', 'false');
          b.classList.remove('border-amber-400', 'text-amber-300');
          b.classList.add('border-transparent', 'text-slate-400');
        });
        btn.setAttribute('aria-selected', 'true');
        btn.classList.add('border-amber-400', 'text-amber-300');
        btn.classList.remove('border-transparent', 'text-slate-400');

        panelSimulator?.classList.add('hidden');
        panelAudit?.classList.add('hidden');
        panelPitch?.classList.add('hidden');

        if (btn.id === 'tab-btn-simulator') panelSimulator?.classList.remove('hidden');
        if (btn.id === 'tab-btn-audit') panelAudit?.classList.remove('hidden');
        if (btn.id === 'tab-btn-pitch') panelPitch?.classList.remove('hidden');
      });
    });

    // Simulator mode toggling (Before vs After)
    const btnBefore = document.getElementById('sim-mode-before');
    const btnAfter = document.getElementById('sim-mode-after');
    const viewBefore = document.getElementById('sim-view-before');
    const viewAfter = document.getElementById('sim-view-after');
    const annotationTitle = document.getElementById('annotation-title');
    const annotationDesc = document.getElementById('annotation-desc');
    const annotationCard = document.getElementById('sim-annotation-card');

    btnBefore?.addEventListener('click', () => {
      btnBefore.classList.add('bg-rose-600/90', 'text-white');
      btnBefore.classList.remove('text-slate-400');
      btnBefore.setAttribute('aria-pressed', 'true');

      btnAfter?.classList.remove('bg-emerald-600/90', 'text-white');
      btnAfter?.classList.add('text-slate-400');
      btnAfter?.setAttribute('aria-pressed', 'false');

      viewBefore?.classList.remove('hidden');
      viewAfter?.classList.add('hidden');

      if (annotationCard && annotationTitle && annotationDesc) {
        annotationCard.className = 'p-6 rounded-tech border border-rose-500/40 bg-rose-950/20 text-slate-200 shadow-xl';
        annotationTitle.className = 'text-sm font-mono font-bold uppercase tracking-wider text-rose-300';
        annotationTitle.textContent = 'Anti-Patrón Activo: Modal Interceptor';
        annotationDesc.textContent = 'El modal de encuesta bloquea el 65% de la pantalla táctil justo sobre los campos necesarios para consultar o pagar. El usuario se ve obligado a cazar una "X" minúscula antes de poder completar su trámite.';
      }
    });

    btnAfter?.addEventListener('click', () => {
      btnAfter.classList.add('bg-[#0055ff]', 'text-white');
      btnAfter.classList.remove('text-slate-400');
      btnAfter.setAttribute('aria-pressed', 'true');

      btnBefore?.classList.remove('bg-rose-600/90', 'text-white');
      btnBefore?.classList.add('text-slate-400');
      btnBefore?.setAttribute('aria-pressed', 'false');

      viewBefore?.classList.add('hidden');
      viewAfter?.classList.remove('hidden');

      if (annotationCard && annotationTitle && annotationDesc) {
        annotationCard.className = 'p-6 rounded-tech border border-blue-500/40 bg-blue-950/20 text-slate-200 shadow-xl';
        annotationTitle.className = 'text-sm font-mono font-bold uppercase tracking-wider text-blue-300';
        annotationTitle.textContent = 'Flujo Optimizado: Guest Checkout en 2 Pasos';
        annotationDesc.textContent = 'El cliente ingresa con su número ya precargado. Ve el monto transparente de forma inmediata ($24.590 CLP), selecciona su medio de pago preferido y confirma con un solo toque.';
      }
    });

    // Close survey modal in the "Before" simulator
    const modalClose = document.getElementById('sim-modal-close');
    const surveyModal = document.getElementById('sim-modal-survey');
    modalClose?.addEventListener('click', () => {
      if (surveyModal) {
        surveyModal.style.display = 'none';
      }
    });

    // Simulated payment in the "After" view
    const payBtn = document.getElementById('sim-btn-pay');
    const formAfter = document.getElementById('sim-after-form');
    const successAfter = document.getElementById('sim-after-success');
    const restartBtn = document.getElementById('sim-btn-restart');

    payBtn?.addEventListener('click', () => {
      const originalText = payBtn.innerHTML;
      payBtn.innerHTML = '<span>Procesando con Webpay...</span>';
      payBtn.setAttribute('disabled', 'true');

      setTimeout(() => {
        payBtn.innerHTML = originalText;
        payBtn.removeAttribute('disabled');
        formAfter?.classList.add('hidden');
        successAfter?.classList.remove('hidden');
      }, 900);
    });

    restartBtn?.addEventListener('click', () => {
      successAfter?.classList.add('hidden');
      formAfter?.classList.remove('hidden');
    });

    // Interactive rating buttons in post-payment survey
    const ratingBtns = document.querySelectorAll('#sim-rating-group button');
    ratingBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        ratingBtns.forEach(b => {
          b.className = 'py-1.5 rounded border border-slate-200 hover:border-[#0055ff] hover:bg-[#f0f5ff] text-xs font-mono font-bold text-slate-600';
        });
        btn.className = 'py-1.5 rounded border-2 border-[#0055ff] bg-[#f0f5ff] text-xs font-mono font-black text-[#0055ff]';
      });
    });

    // Copy direct email logic
    const copyDirectBtn = document.getElementById('copy-direct-email-btn');
    const copyDirectText = document.getElementById('copy-direct-email-text');
    copyDirectBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('f.riquelmesalvo@uandresbello.edu');
        if (copyDirectText) copyDirectText.textContent = '¡Copiado!';
        setTimeout(() => {
          if (copyDirectText) copyDirectText.textContent = 'Copiar';
        }, 2000);
      } catch (err) {
        console.error('Error al copiar correo:', err);
      }
    });
  }

  initEnelLab();
  document.addEventListener('astro:page-load', initEnelLab);
</script>
