---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
---

<Layout
  title="Retórica y Descalabro | Transmutador Ontológico de Jerga Callejera"
  description="Herramienta heurística y lingüística para la transmutación de enunciados callejeros, modismos y letras urbanas en tratados ontológicos y prosa académica del siglo XIX."
>
  <Header />

  <main id="main-content" class="flex-1 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-400 mb-8" aria-label="Ruta de navegación">
      <a href="/" class="hover:text-white transition-colors">Inicio</a>
      <span aria-hidden="true">/</span>
      <a href="/lab" class="hover:text-white transition-colors">Lab</a>
      <span aria-hidden="true">/</span>
      <span class="text-brand-400 font-medium" aria-current="page">Retórica y Descalabro</span>
    </nav>

    <!-- Header -->
    <div class="mb-10">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-tech border border-emerald-500/30 bg-emerald-500/10 text-emerald-300 font-mono text-xs font-semibold">
          <Icon name="mortarboard" class="w-3.5 h-3.5" />
          <span>NLP Heurístico & Deriva Semántica</span>
        </div>
        <a
          href="https://github.com/Pipin333/retorica-y-descalabro"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1 rounded-tech font-mono text-xs font-medium text-slate-300 hover:text-white bg-canvas-surface border border-canvas-border hover:border-emerald-400/50 transition-colors"
          title="Ver repositorio canónico retorica-y-descalabro en GitHub"
        >
          <svg class="w-3.5 h-3.5 text-slate-400" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          <span>Repo: retorica-y-descalabro</span>
          <svg class="w-3 h-3 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white mb-3">
        Retórica y Descalabro
      </h1>
      <p class="text-base text-slate-300 leading-relaxed max-w-3xl">
        Transmuta cualquier enunciado coloquial, jerga callejera o letra de reggaetón en un denso tratado ontológico del siglo XIX, correspondencia diplomática de cancillería o en un ejercicio de entropía semántica multilingüe.
      </p>
    </div>

    <!-- Presets bar -->
    <section class="mb-8" aria-labelledby="presets-heading">
      <h2 id="presets-heading" class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-3">
        Enunciados de prueba rápida:
      </h2>
      <div class="flex flex-wrap gap-2">
        <button
          type="button"
          class="preset-chip inline-flex items-center gap-1.5 text-xs px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:text-white hover:border-brand-500/50 hover:bg-slate-800/80 transition-all text-left"
          data-text="Sigue tu camino que sin ti me va mejor, ahora tengo otras que me lo hacen mejor."
        >
          <Icon name="music-note-beamed" class="w-3.5 h-3.5 text-brand-400" />
          <span>"Sigue tu camino que sin ti me va mejor..."</span>
        </button>
        <button
          type="button"
          class="preset-chip inline-flex items-center gap-1.5 text-xs px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:text-white hover:border-brand-500/50 hover:bg-slate-800/80 transition-all text-left"
          data-text="Hermano, me dio la pálida brígida con el terremoto y me fui a acostar a la mala."
        >
          <Icon name="emoji-dizzy" class="w-3.5 h-3.5 text-amber-400" />
          <span>"Me dio la pálida brígida con el terremoto..."</span>
        </button>
        <button
          type="button"
          class="preset-chip inline-flex items-center gap-1.5 text-xs px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:text-white hover:border-brand-500/50 hover:bg-slate-800/80 transition-all text-left"
          data-text="No me hables de pega que ando entero estresado y quiero puro tomarme una piscola bien cargada."
        >
          <Icon name="cup-straw" class="w-3.5 h-3.5 text-emerald-400" />
          <span>"No me hables de pega que ando entero estresado..."</span>
        </button>
        <button
          type="button"
          class="preset-chip inline-flex items-center gap-1.5 text-xs px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:text-white hover:border-brand-500/50 hover:bg-slate-800/80 transition-all text-left"
          data-text="El certamen estuvo terrible peludo y nadie cachó una sola pregunta."
        >
          <Icon name="pencil-square" class="w-3.5 h-3.5 text-sky-400" />
          <span>"El certamen estuvo terrible peludo y nadie cachó..."</span>
        </button>
      </div>
    </section>

    <!-- Interactive Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
      <!-- Input Panel -->
      <section class="flex flex-col justify-between p-6 sm:p-8 rounded-2xl border border-slate-800 bg-slate-900/60 shadow-xl" aria-labelledby="input-heading">
        <div>
          <div class="flex items-center justify-between gap-4 mb-4">
            <h2 id="input-heading" class="text-sm font-semibold uppercase tracking-wider text-slate-400">
              Enunciado Coloquial de Entrada
            </h2>
            <button
              id="clear-btn"
              type="button"
              class="text-xs text-slate-500 hover:text-slate-300 transition-colors"
            >
              Limpiar
            </button>
          </div>

          <label for="source-text" class="sr-only">Texto coloquial para transmutar</label>
          <textarea
            id="source-text"
            rows="6"
            class="w-full rounded-xl bg-slate-950 border border-slate-800 p-4 text-slate-100 placeholder-slate-600 focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-colors resize-y text-sm leading-relaxed"
            placeholder="Escribe o pega aquí cualquier modismo callejero, frase urbana o reclamo cotidiano..."
          >Sigue tu camino que sin ti me va mejor, ahora tengo otras que me lo hacen mejor.</textarea>

          <!-- Motor de Inferencia Selector -->
          <div class="mt-6 p-4 rounded-xl border border-slate-800 bg-slate-950/80">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-semibold uppercase tracking-wider text-slate-300 flex items-center gap-1.5">
                <Icon name="cpu" class="w-3.5 h-3.5 text-brand-400" />
                <span>Motor de Inferencia</span>
              </span>
              <button
                id="toggle-engine-config-btn"
                type="button"
                class="hidden text-[11px] font-mono text-brand-400 hover:text-brand-300 flex items-center gap-1 transition-colors"
                aria-expanded="false"
              >
                <Icon name="gear" class="w-3 h-3" />
                <span>Configurar BYOK</span>
              </button>
            </div>

            <div class="grid grid-cols-2 gap-2">
              <label id="engine-card-heuristic" class="engine-card flex items-center gap-2 p-2.5 rounded-lg border border-brand-500/50 bg-brand-500/10 cursor-pointer text-xs font-medium text-white transition-all">
                <input type="radio" name="engine-mode" value="heuristic" checked class="text-brand-500 focus:ring-brand-400" />
                <span class="truncate">Heurístico (Local)</span>
              </label>

              <label id="engine-card-llm" class="engine-card flex items-center gap-2 p-2.5 rounded-lg border border-slate-800 bg-slate-900/40 cursor-pointer text-xs font-medium text-slate-300 hover:text-white transition-all">
                <input type="radio" name="engine-mode" value="llm" class="text-brand-500 focus:ring-brand-400" />
                <span class="flex items-center gap-1.5 truncate">
                  <span>Neuronal LLM</span>
                  <span class="text-[9px] px-1 py-0.5 rounded bg-brand-500/20 text-brand-300 font-mono font-bold">BYOK</span>
                </span>
              </label>
            </div>

            <!-- Panel de Configuración BYOK (Collapsible) -->
            <div id="byok-settings-panel" class="hidden mt-4 pt-3 border-t border-slate-800/80 space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 flex items-center gap-1">
                  <Icon name="key" class="w-3 h-3 text-amber-400" />
                  <span>Ajustes del Proveedor LLM</span>
                </span>
                <a
                  href="https://console.groq.com/keys"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[10px] text-brand-400 hover:text-brand-300 underline"
                >
                  Obtener API Key gratis en Groq &rarr;
                </a>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label for="llm-provider" class="block text-[11px] text-slate-400 mb-1">Proveedor:</label>
                  <select
                    id="llm-provider"
                    class="w-full text-xs rounded-lg bg-slate-900 border border-slate-700/80 p-2 text-slate-200 focus:border-brand-500 focus:ring-1 focus:ring-brand-500"
                  >
                    <option value="groq" selected>Groq (Llama 3.3 70B - Rápido y Gratis)</option>
                    <option value="openrouter">OpenRouter (Multi-modelo)</option>
                    <option value="ollama">Ollama (Localhost / Sin clave)</option>
                    <option value="custom">Personalizado (OpenAI compatible)</option>
                  </select>
                </div>

                <div>
                  <label for="llm-model" class="block text-[11px] text-slate-400 mb-1">Modelo:</label>
                  <input
                    id="llm-model"
                    type="text"
                    value="llama-3.3-70b-versatile"
                    class="w-full text-xs rounded-lg bg-slate-900 border border-slate-700/80 p-2 text-slate-200 focus:border-brand-500 focus:ring-1 focus:ring-brand-500"
                    placeholder="llama-3.3-70b-versatile"
                  />
                </div>
              </div>

              <div>
                <label for="llm-api-key" class="block text-[11px] text-slate-400 mb-1">API Key (BYOK):</label>
                <div class="relative">
                  <input
                    id="llm-api-key"
                    type="password"
                    autocomplete="off"
                    class="w-full text-xs rounded-lg bg-slate-900 border border-slate-700/80 p-2 pr-16 text-slate-200 placeholder-slate-600 focus:border-brand-500 focus:ring-1 focus:ring-brand-500 font-mono"
                    placeholder="gsk_..."
                  />
                  <button
                    id="toggle-key-visibility-btn"
                    type="button"
                    class="absolute right-2 top-1/2 -translate-y-1/2 text-[10px] text-slate-400 hover:text-slate-200 px-1.5 py-0.5 rounded bg-slate-800"
                  >
                    Ver
                  </button>
                </div>
              </div>

              <div>
                <label for="llm-base-url" class="block text-[11px] text-slate-400 mb-1">Base URL (API OpenAI compatible):</label>
                <input
                  id="llm-base-url"
                  type="url"
                  value="https://api.groq.com/openai/v1"
                  class="w-full text-xs rounded-lg bg-slate-900 border border-slate-700/80 p-2 text-slate-200 focus:border-brand-500 focus:ring-1 focus:ring-brand-500 font-mono"
                  placeholder="https://api.groq.com/openai/v1"
                />
              </div>

              <div class="p-2.5 rounded-lg bg-slate-900/60 border border-slate-800 text-[10px] text-slate-400 leading-relaxed">
                🔒 <strong>Privacidad BYOK:</strong> Tu clave se conserva exclusivamente en el <code>localStorage</code> de tu navegador y nunca se persiste en ningún servidor. Se envía a través de un proxy serverless seguro con defensa anti-SSRF para conectarse a tu proveedor.
              </div>
            </div>
          </div>

          <!-- Style Register Selector -->
          <fieldset class="mt-6">
            <legend class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-3">
              Registro de Transmutación Deseado:
            </legend>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="style-options">
              <label class="style-card flex items-start gap-3 p-3 rounded-xl border border-brand-500/50 bg-brand-500/10 cursor-pointer transition-all">
                <input type="radio" name="style-mode" value="ontologico" checked class="mt-1 text-brand-500 focus:ring-brand-400" />
                <div>
                  <span class="flex items-center gap-1.5 text-xs font-bold text-white">
                    <Icon name="journal-richtext" class="w-3.5 h-3.5 text-brand-400" />
                    <span>Tratado Ontológico</span>
                  </span>
                  <span class="block text-[11px] text-slate-400 mt-0.5">Filosofía densa del siglo XIX, perífrasis y latinizaciones.</span>
                </div>
              </label>

              <label class="style-card flex items-start gap-3 p-3 rounded-xl border border-slate-800 bg-slate-950/60 hover:bg-slate-950 cursor-pointer transition-all">
                <input type="radio" name="style-mode" value="diplomatico" class="mt-1 text-brand-500 focus:ring-brand-400" />
                <div>
                  <span class="flex items-center gap-1.5 text-xs font-bold text-white">
                    <Icon name="file-earmark-text" class="w-3.5 h-3.5 text-emerald-400" />
                    <span>Diplomacia Solemne</span>
                  </span>
                  <span class="block text-[11px] text-slate-400 mt-0.5">Cancillería institucional, cortesía pomposa y eufemismos.</span>
                </div>
              </label>

              <label class="style-card flex items-start gap-3 p-3 rounded-xl border border-slate-800 bg-slate-950/60 hover:bg-slate-950 cursor-pointer transition-all">
                <input type="radio" name="style-mode" value="barroco" class="mt-1 text-brand-500 focus:ring-brand-400" />
                <div>
                  <span class="flex items-center gap-1.5 text-xs font-bold text-white">
                    <Icon name="feather" class="w-3.5 h-3.5 text-amber-400" />
                    <span>Culteranismo Barroco</span>
                  </span>
                  <span class="block text-[11px] text-slate-400 mt-0.5">Estilo Luis de Góngora, hipérbaton y ornamentación mítica.</span>
                </div>
              </label>

              <label class="style-card flex items-start gap-3 p-3 rounded-xl border border-slate-800 bg-slate-950/60 hover:bg-slate-950 cursor-pointer transition-all">
                <input type="radio" name="style-mode" value="whispers" class="mt-1 text-brand-500 focus:ring-brand-400" />
                <div>
                  <span class="flex items-center gap-1.5 text-xs font-bold text-white">
                    <Icon name="arrow-repeat" class="w-3.5 h-3.5 text-sky-400" />
                    <span>Teléfono Descompuesto</span>
                  </span>
                  <span class="block text-[11px] text-slate-400 mt-0.5">Deriva semántica multilingüe a través de traducción encadenada o malentendido acústico.</span>
                </div>
              </label>
            </div>
          </fieldset>
        </div>

        <div class="mt-6 pt-4 border-t border-slate-800/80 flex items-center justify-between gap-4">
          <div class="text-xs text-slate-400">
            <span id="word-count">16 palabras</span>
          </div>
          <button
            id="transmute-btn"
            type="button"
            class="inline-flex items-center justify-center px-6 py-2.5 rounded-xl text-sm font-semibold text-white bg-gradient-to-r from-brand-600 to-accent-500 hover:from-brand-500 hover:to-accent-400 shadow-glow transition-all active:scale-[0.98]"
          >
            <span>Transmutar Texto</span>
            <svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </button>
        </div>
      </section>

      <!-- Output Panel -->
      <section class="flex flex-col justify-between p-6 sm:p-8 rounded-2xl border border-slate-800 bg-slate-900/60 shadow-xl" aria-labelledby="output-heading">
        <div>
          <div class="flex items-center justify-between gap-4 mb-4">
            <h2 id="output-heading" class="text-sm font-semibold uppercase tracking-wider text-emerald-400 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              Prosa Transmutada Resultante
            </h2>
            <span id="transmute-status" class="text-xs text-slate-500">Heurística lista</span>
          </div>

          <div
            id="output-container"
            class="min-h-[220px] rounded-xl bg-slate-950 border border-slate-800/90 p-5 font-serif text-slate-200 text-base leading-relaxed tracking-wide select-all"
            aria-live="polite"
          >
            "Continúa con tu sendero porque en tu ausencia la calidad de mi vida ha aumentado; actualmente poseo a otras entidades femeninas que copulan más satisfactoriamente con mi persona."
          </div>

          <!-- Chain trace (visible only for whispers) -->
          <div id="whispers-trace" class="hidden mt-4 p-3 rounded-lg bg-slate-950/80 border border-slate-800 text-xs text-slate-400 space-y-1">
            <span class="font-mono text-brand-300 block mb-1 font-semibold">Deriva Semántica (Saltos):</span>
            <div id="whispers-steps" class="font-mono text-[11px] text-slate-400"></div>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-slate-800/80 flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-2">
            <button
              id="copy-btn"
              type="button"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium text-slate-300 bg-slate-800 hover:bg-slate-700 hover:text-white transition-colors"
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <span id="copy-text">Copiar</span>
            </button>

            <button
              id="share-whatsapp-btn"
              type="button"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium text-emerald-300 bg-emerald-950/60 border border-emerald-800/50 hover:bg-emerald-900/60 transition-colors"
            >
              <Icon name="whatsapp" class="w-3.5 h-3.5" />
              <span>Compartir en WhatsApp</span>
            </button>
          </div>

          <span class="text-[11px] text-slate-500">Motor Dual: Heurístico & BYOK LLM</span>
        </div>
      </section>
    </div>

    <!-- Technical Note Section -->
    <aside class="p-6 rounded-xl border border-slate-800/60 bg-slate-900/30 text-xs text-slate-400 space-y-2">
      <h3 class="font-semibold text-slate-300 uppercase tracking-wider text-[11px]">
        Acerca del motor de transmutación:
      </h3>
      <p>
        Este módulo opera en modalidad híbrida: por defecto ejecuta un motor 100% heurístico client-side con diccionario combinatorio de morfología culta, desambiguación léxica de chilenismos y reglas gramaticales latinizadas inspiradas en el proyecto canónico <em>retorica-y-descalabro</em>.
      </p>
      <p>
        Adicionalmente, incorpora soporte <strong>BYOK (Bring Your Own Key)</strong> para conectarse directamente con modelos de lenguaje de última generación (como <strong>Llama 3.3 70B en Groq</strong>, OpenRouter u Ollama local) mediante un endpoint serverless con mitigación estricta de SSRF. Tu clave API nunca se almacena en base de datos; reside únicamente en el <code>localStorage</code> de tu navegador.
      </p>
    </aside>
  </main>

  <Footer />
</Layout>

<script>
  // Lexicographical dictionaries & transposition heuristics
  const DICTIONARY_CHILEAN: Record<string, string> = {
    "me dio la pálida": "experimenté una súbita y dramática lipotimia vasovagal de etiología somatomorfa",
    "la pálida": "un colapso neurovegetativo transitorio",
    "terremoto": "un cóctel alcohólico hiperbólico a base de vino fermentado y crema láctea",
    "a la mala": "mediante una imposición carente de consentimiento o decoro",
    "brígida": "de una naturaleza ontológicamente severa y desconcertante",
    "brígido": "grave y epistemológicamente inquietante",
    "pega": "mi jornada de servidumbre asalariada",
    "piscola": "una dilución hidroalcohólica de destilado de uva moscatel en soda carbonatada caramelizada",
    "entero estresado": "en un estado de extenuación neuropsiquiátrica integral",
    "peludo": "intelectualmente inescrutable y de complejidad abrumadora",
    "peluda": "de insondable dificultad heurística",
    "cachó": "comprendió cabalmente",
    "cacharon": "aprehendieron cognitivamente",
    "carrete": "un cónclave dionisíaco de comunión etílica",
    "hermano": "estimado coetáneo y compatriota",
    "wena": "cordial salutación fraterna",
    "weon": "sujeto indeterminado de la comunidad",
    "weona": "fémina no especificada del conglomerado social",
    "sapo": "vigilante clandestino y delator consuetudinario"
  };

  const DICTIONARY_REGGAETON: Record<string, string> = {
    "sigue tu camino": "prosigue con tu desplazamiento teleológico autónomo",
    "sin ti me va mejor": "en tu conspicua ausencia los índices de bienestar de mi existencia han experimentado un alza estadística",
    "ahora tengo otras": "en el presente disfruto del concurso de diversos especímenes femeninos alternativos",
    "que me lo hacen mejor": "cuyas destrezas copulatorias resultan manifiestamente superiores a tu desempeño pretérito",
    "perreo": "una danza de fricción pélvica sincopada al compás del dembow",
    "bellaqueo": "un cortejo lúbrico y desinhibido orientado al intercambio de fluidos",
    "sandungueo": "un frenético ejercicio rítmico de cortejo corporal"
  };

  function transmuteOntologico(text: string): string {
    let result = text;

    // Apply phrases first
    for (const [k, v] of Object.entries(DICTIONARY_REGGAETON)) {
      const reg = new RegExp(k, "gi");
      result = result.replace(reg, v);
    }
    for (const [k, v] of Object.entries(DICTIONARY_CHILEAN)) {
      const reg = new RegExp(k, "gi");
      result = result.replace(reg, v);
    }

    // Generic word replacements
    const wordMap: Record<string, string> = {
      "quiero": "manifiesto una pulsión irrefrenable por",
      "puedo": "dispongo de la facultad volitiva para",
      "tengo": "ostento en mi haber existencial",
      "hacen": "ejecutan con destreza motriz",
      "dijo": "declaró con énfasis categórico",
      "amor": "afecto neuroquímico correspondido",
      "noche": "intervalo circadiano nocturno",
      "besos": "ósculos mucosos de naturaleza erótica",
      "cama": "lecho horizontal de reposo fisiológico"
    };

    for (const [w, repl] of Object.entries(wordMap)) {
      const reg = new RegExp(`\\b${w}\\b`, "gi");
      result = result.replace(reg, repl);
    }

    return `"${result.charAt(0).toUpperCase() + result.slice(1)}"`;
  }

  function transmuteDiplomatico(text: string): string {
    let result = text;
    for (const [k, v] of Object.entries(DICTIONARY_CHILEAN)) {
      const reg = new RegExp(k, "gi");
      result = result.replace(reg, v);
    }

    return `"Por medio de la presente, cumplo con transmitir que: ${result.toLowerCase().trim()}. Rogamos a las partes concernidas tomar debida nota del precedente enunciado con la mayor circunspección y solemnidad diplomática."`;
  }

  function transmuteBarroco(text: string): string {
    return `"¡Oh voluble Fortuna! Ved aquí cómo, en dorada sombra de engaño envuelta, ${text.trim().toLowerCase()}, cual Ícaro audaz cuyas alas de cera el Febo implacable derrite en las procelosas ondas del Parnaso."`;
  }

  async function runWhispersTranslation(text: string, onStep: (step: string) => void): Promise<string> {
    const hops = [
      { from: "es", to: "de", label: "Alemán (de)" },
      { from: "de", to: "ja", label: "Japonés (ja)" },
      { from: "ja", to: "es", label: "Español retornado (es)" }
    ];

    let current = text.trim();
    for (const hop of hops) {
      onStep(`Traduciendo: ${hop.label}...`);
      try {
        const enc = encodeURIComponent(current);
        const res = await fetch(`https://api.mymemory.translated.net/get?q=${enc}&langpair=${hop.from}|${hop.to}`);
        if (!res.ok) throw new Error("HTTP " + res.status);
        const data = await res.json();
        const translated = data?.responseData?.translatedText;
        if (translated && !translated.toUpperCase().includes("MYMEMORY WARNING")) {
          current = translated;
        }
      } catch (err) {
        // Fallback to slight lexical drift if network rate-limits
        current = current + " [alteración semántica]";
      }
    }
    return `"${current}"`;
  }

  // DOM bindings
  const sourceText = document.getElementById('source-text') as HTMLTextAreaElement;
  const outputContainer = document.getElementById('output-container') as HTMLDivElement;
  const transmuteBtn = document.getElementById('transmute-btn') as HTMLButtonElement;
  const clearBtn = document.getElementById('clear-btn') as HTMLButtonElement;
  const copyBtn = document.getElementById('copy-btn') as HTMLButtonElement;
  const copyText = document.getElementById('copy-text') as HTMLSpanElement;
  const shareWaBtn = document.getElementById('share-whatsapp-btn') as HTMLButtonElement;
  const wordCount = document.getElementById('word-count') as HTMLSpanElement;
  const whispersTrace = document.getElementById('whispers-trace') as HTMLDivElement;
  const whispersSteps = document.getElementById('whispers-steps') as HTMLDivElement;
  const transmuteStatus = document.getElementById('transmute-status') as HTMLSpanElement;

  // Engine & BYOK elements
  const engineCardHeuristic = document.getElementById('engine-card-heuristic') as HTMLElement;
  const engineCardLlm = document.getElementById('engine-card-llm') as HTMLElement;
  const toggleEngineConfigBtn = document.getElementById('toggle-engine-config-btn') as HTMLButtonElement;
  const byokSettingsPanel = document.getElementById('byok-settings-panel') as HTMLDivElement;
  const llmProviderSelect = document.getElementById('llm-provider') as HTMLSelectElement;
  const llmModelInput = document.getElementById('llm-model') as HTMLInputElement;
  const llmApiKeyInput = document.getElementById('llm-api-key') as HTMLInputElement;
  const llmBaseUrlInput = document.getElementById('llm-base-url') as HTMLInputElement;
  const toggleKeyVisibilityBtn = document.getElementById('toggle-key-visibility-btn') as HTMLButtonElement;

  const STORAGE_KEY = 'ryd_llm_config';

  const PROVIDER_PRESETS: Record<string, { baseUrl: string; model: string; keyPlaceholder: string }> = {
    groq: {
      baseUrl: 'https://api.groq.com/openai/v1',
      model: 'llama-3.3-70b-versatile',
      keyPlaceholder: 'gsk_...'
    },
    openrouter: {
      baseUrl: 'https://openrouter.ai/api/v1',
      model: 'meta-llama/llama-3.3-70b-instruct',
      keyPlaceholder: 'sk-or-v1-...'
    },
    ollama: {
      baseUrl: 'http://localhost:11434/v1',
      model: 'llama3.2',
      keyPlaceholder: 'No requerida para Ollama local'
    },
    custom: {
      baseUrl: 'https://api.openai.com/v1',
      model: 'gpt-4o-mini',
      keyPlaceholder: 'sk-...'
    }
  };

  function loadLlmConfig() {
    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved) {
        const config = JSON.parse(saved);
        if (config.provider && llmProviderSelect) llmProviderSelect.value = config.provider;
        if (config.model && llmModelInput) llmModelInput.value = config.model;
        if (config.apiKey && llmApiKeyInput) llmApiKeyInput.value = config.apiKey;
        if (config.baseUrl && llmBaseUrlInput) llmBaseUrlInput.value = config.baseUrl;
      }
    } catch {}
  }

  function saveLlmConfig() {
    try {
      const config = {
        provider: llmProviderSelect?.value || 'groq',
        model: llmModelInput?.value.trim() || '',
        apiKey: llmApiKeyInput?.value.trim() || '',
        baseUrl: llmBaseUrlInput?.value.trim() || ''
      };
      localStorage.setItem(STORAGE_KEY, JSON.stringify(config));
    } catch {}
  }

  function updateEngineUI(mode: string) {
    if (mode === 'llm') {
      engineCardLlm?.classList.add('border-brand-500/50', 'bg-brand-500/10');
      engineCardLlm?.classList.remove('border-slate-800', 'bg-slate-900/40');
      engineCardHeuristic?.classList.remove('border-brand-500/50', 'bg-brand-500/10');
      engineCardHeuristic?.classList.add('border-slate-800', 'bg-slate-900/40');
      toggleEngineConfigBtn?.classList.remove('hidden');

      if (!llmApiKeyInput?.value && llmProviderSelect?.value !== 'ollama') {
        byokSettingsPanel?.classList.remove('hidden');
        toggleEngineConfigBtn?.setAttribute('aria-expanded', 'true');
      }
    } else {
      engineCardHeuristic?.classList.add('border-brand-500/50', 'bg-brand-500/10');
      engineCardHeuristic?.classList.remove('border-slate-800', 'bg-slate-900/40');
      engineCardLlm?.classList.remove('border-brand-500/50', 'bg-brand-500/10');
      engineCardLlm?.classList.add('border-slate-800', 'bg-slate-900/40');
      toggleEngineConfigBtn?.classList.add('hidden');
      byokSettingsPanel?.classList.add('hidden');
      toggleEngineConfigBtn?.setAttribute('aria-expanded', 'false');
    }
  }

  document.querySelectorAll('input[name="engine-mode"]').forEach((radio) => {
    radio.addEventListener('change', (e) => {
      const mode = (e.target as HTMLInputElement).value;
      updateEngineUI(mode);
    });
  });

  toggleEngineConfigBtn?.addEventListener('click', () => {
    const isHidden = byokSettingsPanel.classList.contains('hidden');
    if (isHidden) {
      byokSettingsPanel.classList.remove('hidden');
      toggleEngineConfigBtn.setAttribute('aria-expanded', 'true');
    } else {
      byokSettingsPanel.classList.add('hidden');
      toggleEngineConfigBtn.setAttribute('aria-expanded', 'false');
    }
  });

  llmProviderSelect?.addEventListener('change', () => {
    const preset = PROVIDER_PRESETS[llmProviderSelect.value];
    if (preset) {
      llmBaseUrlInput.value = preset.baseUrl;
      llmModelInput.value = preset.model;
      llmApiKeyInput.placeholder = preset.keyPlaceholder;
    }
    saveLlmConfig();
  });

  [llmModelInput, llmApiKeyInput, llmBaseUrlInput].forEach((input) => {
    input?.addEventListener('input', saveLlmConfig);
    input?.addEventListener('change', saveLlmConfig);
  });

  toggleKeyVisibilityBtn?.addEventListener('click', () => {
    if (llmApiKeyInput.type === 'password') {
      llmApiKeyInput.type = 'text';
      toggleKeyVisibilityBtn.textContent = 'Ocultar';
    } else {
      llmApiKeyInput.type = 'password';
      toggleKeyVisibilityBtn.textContent = 'Ver';
    }
  });

  function updateWordCount() {
    const words = sourceText.value.trim().split(/\s+/).filter(Boolean).length;
    wordCount.textContent = `${words} palabra${words === 1 ? '' : 's'}`;
  }

  sourceText?.addEventListener('input', updateWordCount);

  // Preset chips click
  document.querySelectorAll('.preset-chip').forEach((btn) => {
    btn.addEventListener('click', () => {
      const val = btn.getAttribute('data-text');
      if (val && sourceText) {
        sourceText.value = val;
        updateWordCount();
        executeTransmutation();
      }
    });
  });

  // Radio button styling feedback
  document.querySelectorAll('input[name="style-mode"]').forEach((radio) => {
    radio.addEventListener('change', (e) => {
      document.querySelectorAll('.style-card').forEach((card) => {
        card.classList.remove('border-brand-500/50', 'bg-brand-500/10');
        card.classList.add('border-slate-800', 'bg-slate-950/60');
      });
      const parent = (e.target as HTMLElement).closest('.style-card');
      parent?.classList.add('border-brand-500/50', 'bg-brand-500/10');
      parent?.classList.remove('border-slate-800', 'bg-slate-950/60');
    });
  });

  async function executeHeuristicTransmutation(raw: string, mode: string) {
    transmuteStatus.textContent = "Procesando con motor local...";
    if (mode === 'ontologico') {
      outputContainer.textContent = transmuteOntologico(raw);
      transmuteStatus.textContent = "Transmutación ontológica completa (Heurística)";
    } else if (mode === 'diplomatico') {
      outputContainer.textContent = transmuteDiplomatico(raw);
      transmuteStatus.textContent = "Registro diplomático aplicado (Heurística)";
    } else if (mode === 'barroco') {
      outputContainer.textContent = transmuteBarroco(raw);
      transmuteStatus.textContent = "Culteranismo barroco generado (Heurística)";
    } else if (mode === 'whispers') {
      whispersTrace.classList.remove('hidden');
      whispersSteps.textContent = "Iniciando cadena de traducción...";
      const result = await runWhispersTranslation(raw, (step) => {
        whispersSteps.textContent = step;
      });
      outputContainer.textContent = result;
      transmuteStatus.textContent = "Deriva semántica completada (MyMemory)";
      whispersSteps.textContent = "es -> de -> ja -> es [completado]";
    }
  }

  async function executeTransmutation() {
    const raw = sourceText.value.trim();
    if (!raw) {
      outputContainer.textContent = "Por favor ingresa un enunciado para transmutar.";
      return;
    }

    const engineMode = (document.querySelector('input[name="engine-mode"]:checked') as HTMLInputElement)?.value || 'heuristic';
    const styleMode = (document.querySelector('input[name="style-mode"]:checked') as HTMLInputElement)?.value || 'ontologico';

    whispersTrace.classList.add('hidden');

    if (engineMode === 'llm') {
      const provider = llmProviderSelect.value;
      const apiKey = llmApiKeyInput.value.trim();
      const baseUrl = llmBaseUrlInput.value.trim() || 'https://api.groq.com/openai/v1';
      const model = llmModelInput.value.trim() || 'llama-3.3-70b-versatile';

      if (!apiKey && provider !== 'ollama') {
        byokSettingsPanel.classList.remove('hidden');
        toggleEngineConfigBtn.setAttribute('aria-expanded', 'true');
        outputContainer.innerHTML = `
          <div class="space-y-3 font-sans text-xs">
            <div class="p-3 rounded-lg border border-amber-500/40 bg-amber-950/20 text-amber-200">
              <strong class="block mb-1 font-semibold">⚠️ Se requiere una API Key para el Motor Neuronal</strong>
              Configura tu clave en el panel de ajustes arriba (o <a href="https://console.groq.com/keys" target="_blank" rel="noopener noreferrer" class="underline text-brand-400">obtén una gratuita en Groq</a>).
            </div>
            <p class="text-slate-400">¿Prefieres no usar claves externas? Puedes usar el motor local instantáneo:</p>
            <button
              type="button"
              id="quick-fallback-btn"
              class="px-3 py-1.5 rounded-lg bg-brand-600 hover:bg-brand-500 text-white font-medium transition-colors"
            >
              Transmutar con Motor Heurístico Local
            </button>
          </div>
        `;
        document.getElementById('quick-fallback-btn')?.addEventListener('click', () => {
          const heuristicRadio = document.querySelector('input[name="engine-mode"][value="heuristic"]') as HTMLInputElement;
          if (heuristicRadio) {
            heuristicRadio.checked = true;
            updateEngineUI('heuristic');
          }
          executeHeuristicTransmutation(raw, styleMode);
        });
        return;
      }

      transmuteStatus.textContent = `Invocando ${model}...`;
      transmuteBtn.disabled = true;
      transmuteBtn.classList.add('opacity-75', 'cursor-wait');

      try {
        const formalityLevel = styleMode === 'diplomatico' ? 1 : (styleMode === 'barroco' ? 3 : 2);
        const action = styleMode === 'whispers' ? 'whispers' : 'enrich';

        const res = await fetch('/api/lab/retorica', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action,
            text: raw,
            formality_level: formalityLevel,
            llm: {
              base_url: baseUrl,
              api_key: apiKey || undefined,
              model: model
            }
          })
        });

        const data = await res.json().catch(() => null);

        if (!res.ok || !data?.success) {
          const errMsg = data?.error || `Error HTTP ${res.status}`;
          outputContainer.innerHTML = `
            <div class="space-y-3 font-sans text-xs">
              <div class="p-3 rounded-lg border border-rose-500/40 bg-rose-950/20 text-rose-300">
                <strong class="block mb-1 font-semibold">Fallo en la inferencia LLM</strong>
                ${errMsg}
              </div>
              <button
                type="button"
                id="error-fallback-btn"
                class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 transition-colors"
              >
                Reintentar con Motor Heurístico Local
              </button>
            </div>
          `;
          document.getElementById('error-fallback-btn')?.addEventListener('click', () => {
            executeHeuristicTransmutation(raw, styleMode);
          });
          transmuteStatus.textContent = 'Error en proveedor';
          return;
        }

        const cleanResult = data.result.replace(/^"|"$/g, '').trim();
        outputContainer.textContent = `"${cleanResult}"`;
        transmuteStatus.textContent = `Generado por ${model}`;
      } catch (networkErr: any) {
        outputContainer.innerHTML = `
          <div class="space-y-3 font-sans text-xs">
            <div class="p-3 rounded-lg border border-rose-500/40 bg-rose-950/20 text-rose-300">
              <strong class="block mb-1 font-semibold">Error de Conexión</strong>
              ${networkErr.message}
            </div>
            <button
              type="button"
              id="error-fallback-btn-net"
              class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 transition-colors"
            >
              Ejecutar con Motor Heurístico Local
            </button>
          </div>
        `;
        document.getElementById('error-fallback-btn-net')?.addEventListener('click', () => {
          executeHeuristicTransmutation(raw, styleMode);
        });
        transmuteStatus.textContent = 'Error de red';
      } finally {
        transmuteBtn.disabled = false;
        transmuteBtn.classList.remove('opacity-75', 'cursor-wait');
      }
    } else {
      executeHeuristicTransmutation(raw, styleMode);
    }
  }

  transmuteBtn?.addEventListener('click', executeTransmutation);

  clearBtn?.addEventListener('click', () => {
    sourceText.value = '';
    updateWordCount();
    outputContainer.textContent = 'Ingresa un enunciado y presiona "Transmutar Texto".';
    whispersTrace.classList.add('hidden');
  });

  copyBtn?.addEventListener('click', async () => {
    const text = outputContainer.textContent || '';
    if (text) {
      await navigator.clipboard.writeText(text);
      copyText.textContent = "¡Copiado!";
      setTimeout(() => {
        copyText.textContent = "Copiar";
      }, 2000);
    }
  });

  shareWaBtn?.addEventListener('click', () => {
    const text = outputContainer.textContent || '';
    const shareMessage = `*Retórica y Descalabro* (Felipe Riquelme Lab):\n\n${text}\n\nPruébalo aquí: https://feliperiquel.me/lab/retorica`;
    const url = `https://api.whatsapp.com/send?text=${encodeURIComponent(shareMessage)}`;
    window.open(url, '_blank');
  });

  // Initialize
  loadLlmConfig();
</script>
