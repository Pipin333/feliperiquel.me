---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
---

<Layout
  title="Retórica y Descalabro | Transmutador Ontológico de Jerga Callejera"
  description="Herramienta heurística y lingüística para la transmutación de enunciados callejeros, modismos y letras urbanas en tratados ontológicos y prosa académica del siglo XIX."
  image="/og/og-retorica.png"
  imageAlt="Retórica y Descalabro - Transmutador Lingüístico y Prosa Decimonónica"
>
  <Header />

  <!-- Fondo Ambiental: Manuscrito Técnico Renacentista & Molinos Manchegos (Don Quijote) -->
  <div class="fixed inset-0 pointer-events-none overflow-hidden z-0 select-none" aria-hidden="true">
    <!-- Auras de luz radial púrpura y ámbar noble -->
    <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[900px] h-[500px] bg-gradient-to-b from-purple-900/25 via-purple-950/10 to-transparent blur-3xl"></div>
    <div class="absolute top-1/3 -left-32 w-[600px] h-[600px] bg-purple-950/30 blur-3xl rounded-full"></div>
    <div class="absolute bottom-10 -right-20 w-[600px] h-[500px] bg-amber-500/10 blur-3xl rounded-full"></div>

    <!-- Malla sutil de blueprint / pergamino milimetrado de fondo -->
    <div class="absolute inset-0 bg-[linear-gradient(rgba(168,85,247,0.025)_1px,transparent_1px),linear-gradient(90deg,rgba(168,85,247,0.025)_1px,transparent_1px)] bg-[size:40px_40px]"></div>

    <!-- Topografía Inferior: Montes y Colinas Manchegas en el horizonte inferior (ocupa el 100% del ancho) -->
    <svg class="absolute inset-x-0 bottom-0 w-full h-44 text-purple-500/25" viewBox="0 0 1440 180" preserveAspectRatio="none" fill="none" stroke="currentColor">
      <path d="M0,80 Q360,20 720,60 T1440,40" stroke-width="0.75" stroke-dasharray="4,4" />
      <path d="M0,120 Q400,70 820,100 T1440,90" stroke-width="1" />
      <path d="M0,160 Q280,120 640,145 T1440,130" stroke-width="0.75" />
    </svg>

    <!-- Flanco Izquierdo: Anclado al margen izquierdo para cualquier resolución -->
    <div class="absolute left-0 top-0 bottom-0 w-72 sm:w-88 xl:w-[420px] overflow-hidden">
      <svg class="w-full h-full text-purple-400/25" viewBox="0 0 380 960" preserveAspectRatio="xMinYMin meet" fill="none" stroke="currentColor">
        <defs>
          <!-- Molino Manchego Izquierdo -->
          <g id="windmill-blueprint-l">
            <line x1="100" y1="0" x2="100" y2="245" stroke-width="0.5" stroke-dasharray="3,3" class="text-purple-500/30" />
            <line x1="20" y1="85" x2="180" y2="85" stroke-width="0.5" stroke-dasharray="2,4" class="text-amber-500/30" />
            <path d="M72,230 L84,95 L116,95 L128,230 Z" stroke-width="1" class="text-purple-400/60" />
            <ellipse cx="100" cy="95" rx="16" ry="3.5" stroke-width="0.75" class="text-amber-400/50" />
            <ellipse cx="100" cy="140" rx="20" ry="4" stroke-width="0.5" stroke-dasharray="2,2" class="text-purple-400/30" />
            <ellipse cx="100" cy="185" rx="24" ry="5" stroke-width="0.5" stroke-dasharray="2,2" class="text-purple-400/30" />
            <ellipse cx="100" cy="230" rx="28" ry="5.5" stroke-width="0.75" class="text-purple-400/50" />
            <polygon points="84,95 100,68 116,95" stroke-width="1" class="text-amber-400/70" />
            <path d="M94,230 L94,208 A6,6 0 0,1 106,208 L106,230 Z" stroke-width="0.75" class="text-purple-300/40" />
            <circle cx="100" cy="85" rx="68" ry="68" stroke-width="0.5" stroke-dasharray="2,6" class="text-amber-400/25" />
            <g transform="translate(100, 85)">
              <circle cx="0" cy="0" r="3.5" stroke-width="1" class="text-amber-400" />
              <circle cx="0" cy="0" r="1.5" fill="currentColor" class="text-amber-300" />
              <line x1="0" y1="0" x2="0" y2="-68" stroke-width="1" class="text-purple-300/80" />
              <rect x="2" y="-64" width="12" height="52" stroke-width="0.75" class="text-amber-400/60" />
              <line x1="2" y1="-50" x2="14" y2="-50" stroke-width="0.5" class="text-purple-400/50" />
              <line x1="2" y1="-36" x2="14" y2="-36" stroke-width="0.5" class="text-purple-400/50" />
              <line x1="2" y1="-22" x2="14" y2="-22" stroke-width="0.5" class="text-purple-400/50" />
              <line x1="0" y1="0" x2="0" y2="68" stroke-width="1" class="text-purple-300/80" />
              <rect x="-14" y="12" width="12" height="52" stroke-width="0.75" class="text-amber-400/60" />
              <line x1="-14" y1="26" x2="-2" y2="26" stroke-width="0.5" class="text-purple-400/50" />
              <line x1="-14" y1="40" x2="-2" y2="40" stroke-width="0.5" class="text-purple-400/50" />
              <line x1="-14" y1="54" x2="-2" y2="54" stroke-width="0.5" class="text-purple-400/50" />
              <line x1="0" y1="0" x2="68" y2="0" stroke-width="1" class="text-purple-300/80" />
              <rect x="12" y="2" width="52" height="12" stroke-width="0.75" class="text-amber-400/60" />
              <line x1="26" y1="2" x2="26" y2="14" stroke-width="0.5" class="text-purple-400/50" />
              <line x1="40" y1="2" x2="40" y2="14" stroke-width="0.5" class="text-purple-400/50" />
              <line x1="54" y1="2" x2="54" y2="14" stroke-width="0.5" class="text-purple-400/50" />
              <line x1="0" y1="0" x2="-68" y2="0" stroke-width="1" class="text-purple-300/80" />
              <rect x="-64" y="-14" width="52" height="12" stroke-width="0.75" class="text-amber-400/60" />
              <line x1="-50" y1="-14" x2="-50" y2="-2" stroke-width="0.5" class="text-purple-400/50" />
              <line x1="-36" y1="-14" x2="-36" y2="-2" stroke-width="0.5" class="text-purple-400/50" />
              <line x1="-22" y1="-14" x2="-22" y2="-2" stroke-width="0.5" class="text-purple-400/50" />
            </g>
          </g>

          <!-- Torre de Fortaleza Medieval Izquierda -->
          <g id="castle-tower-l">
            <rect x="20" y="50" width="60" height="180" stroke-width="1" class="text-purple-400/50" />
            <path d="M15,50 L15,30 L27,30 L27,38 L39,38 L39,30 L51,30 L51,38 L63,38 L63,30 L75,30 L75,38 L85,38 L85,50 Z" stroke-width="1" class="text-amber-400/60" />
            <line x1="12" y1="50" x2="88" y2="50" stroke-width="1.25" class="text-amber-400/70" />
            <g class="text-purple-300/60">
              <line x1="50" y1="75" x2="50" y2="105" stroke-width="1" />
              <line x1="44" y1="85" x2="56" y2="85" stroke-width="1" />
              <line x1="50" y1="130" x2="50" y2="160" stroke-width="1" />
              <line x1="44" y1="140" x2="56" y2="140" stroke-width="1" />
            </g>
            <path d="M40,230 L40,195 Q50,180 60,195 L60,230 Z" stroke-width="0.75" class="text-amber-400/50" />
            <line x1="20" y1="120" x2="80" y2="120" stroke-width="0.5" stroke-dasharray="2,4" class="text-purple-500/30" />
            <line x1="20" y1="175" x2="80" y2="175" stroke-width="0.5" stroke-dasharray="2,4" class="text-purple-500/30" />
          </g>

          <!-- Flor de Lis Heráldica Izquierda -->
          <g id="fleur-de-lis-l">
            <path d="M50,10 C53,25 60,35 60,50 C55,48 45,48 40,50 C40,35 47,25 50,10 Z" stroke-width="1" class="text-amber-400/70" />
            <path d="M40,50 C32,45 20,40 18,52 C16,65 30,70 38,58 C38,55 39,52 40,50 Z" stroke-width="0.85" class="text-purple-400/60" />
            <path d="M60,50 C68,45 80,40 82,52 C84,65 70,70 62,58 C62,55 61,52 60,50 Z" stroke-width="0.85" class="text-purple-400/60" />
            <path d="M30,55 L70,55 L68,62 L32,62 Z" stroke-width="1" class="text-amber-400/80" />
            <circle cx="50" cy="58.5" r="1.5" fill="currentColor" class="text-amber-300" />
            <path d="M44,62 C46,72 50,78 50,78 C50,78 54,72 56,62 Z" stroke-width="0.85" class="text-purple-400/50" />
          </g>
        </defs>

        <!-- Anotaciones renacentistas margen izquierdo -->
        <g class="text-[9px] font-mono text-amber-400/40 select-none">
          <text x="24" y="38">FIG. I : CASTRUM &amp; AXIS ROTATORIUS</text>
          <text x="24" y="52">SCRIPTIRIUM IMPERIALIS • CHANCELERIA</text>
        </g>

        <!-- Molino superior izquierdo -->
        <use href="#windmill-blueprint-l" x="20" y="70" transform="scale(0.85) rotate(-8 60 140)" />
        <!-- Flor de lis decorativa -->
        <use href="#fleur-de-lis-l" x="230" y="240" transform="scale(0.65)" />
        <!-- Torre de Fortaleza medieval izquierda -->
        <use href="#castle-tower-l" x="20" y="400" transform="scale(0.95)" />
        <!-- Molino inferior sobre colina izquierda -->
        <use href="#windmill-blueprint-l" x="60" y="660" transform="scale(0.90) rotate(14 120 600)" />
        <!-- Flor de lis inferior -->
        <use href="#fleur-de-lis-l" x="220" y="850" transform="scale(0.50)" />
      </svg>
    </div>

    <!-- Flanco Derecho: Anclado al margen derecho para cualquier resolución -->
    <div class="absolute right-0 top-0 bottom-0 w-72 sm:w-88 xl:w-[420px] overflow-hidden">
      <svg class="w-full h-full text-purple-400/25" viewBox="0 0 380 960" preserveAspectRatio="xMaxYMin meet" fill="none" stroke="currentColor">
        <defs>
          <!-- Molino Manchego Derecho -->
          <g id="windmill-blueprint-r">
            <line x1="100" y1="0" x2="100" y2="245" stroke-width="0.5" stroke-dasharray="3,3" class="text-purple-500/30" />
            <line x1="20" y1="85" x2="180" y2="85" stroke-width="0.5" stroke-dasharray="2,4" class="text-amber-500/30" />
            <path d="M72,230 L84,95 L116,95 L128,230 Z" stroke-width="1" class="text-purple-400/60" />
            <ellipse cx="100" cy="95" rx="16" ry="3.5" stroke-width="0.75" class="text-amber-400/50" />
            <ellipse cx="100" cy="140" rx="20" ry="4" stroke-width="0.5" stroke-dasharray="2,2" class="text-purple-400/30" />
            <ellipse cx="100" cy="185" rx="24" ry="5" stroke-width="0.5" stroke-dasharray="2,2" class="text-purple-400/30" />
            <ellipse cx="100" cy="230" rx="28" ry="5.5" stroke-width="0.75" class="text-purple-400/50" />
            <polygon points="84,95 100,68 116,95" stroke-width="1" class="text-amber-400/70" />
            <path d="M94,230 L94,208 A6,6 0 0,1 106,208 L106,230 Z" stroke-width="0.75" class="text-purple-300/40" />
            <circle cx="100" cy="85" rx="68" ry="68" stroke-width="0.5" stroke-dasharray="2,6" class="text-amber-400/25" />
            <g transform="translate(100, 85)">
              <circle cx="0" cy="0" r="3.5" stroke-width="1" class="text-amber-400" />
              <circle cx="0" cy="0" r="1.5" fill="currentColor" class="text-amber-300" />
              <line x1="0" y1="0" x2="0" y2="-68" stroke-width="1" class="text-purple-300/80" />
              <rect x="2" y="-64" width="12" height="52" stroke-width="0.75" class="text-amber-400/60" />
              <line x1="2" y1="-50" x2="14" y2="-50" stroke-width="0.5" class="text-purple-400/50" />
              <line x1="2" y1="-36" x2="14" y2="-36" stroke-width="0.5" class="text-purple-400/50" />
              <line x1="2" y1="-22" x2="14" y2="-22" stroke-width="0.5" class="text-purple-400/50" />
              <line x1="0" y1="0" x2="0" y2="68" stroke-width="1" class="text-purple-300/80" />
              <rect x="-14" y="12" width="12" height="52" stroke-width="0.75" class="text-amber-400/60" />
              <line x1="-14" y1="26" x2="-2" y2="26" stroke-width="0.5" class="text-purple-400/50" />
              <line x1="-14" y1="40" x2="-2" y2="40" stroke-width="0.5" class="text-purple-400/50" />
              <line x1="-14" y1="54" x2="-2" y2="54" stroke-width="0.5" class="text-purple-400/50" />
              <line x1="0" y1="0" x2="68" y2="0" stroke-width="1" class="text-purple-300/80" />
              <rect x="12" y="2" width="52" height="12" stroke-width="0.75" class="text-amber-400/60" />
              <line x1="26" y1="2" x2="26" y2="14" stroke-width="0.5" class="text-purple-400/50" />
              <line x1="40" y1="2" x2="40" y2="14" stroke-width="0.5" class="text-purple-400/50" />
              <line x1="54" y1="2" x2="54" y2="14" stroke-width="0.5" class="text-purple-400/50" />
              <line x1="0" y1="0" x2="-68" y2="0" stroke-width="1" class="text-purple-300/80" />
              <rect x="-64" y="-14" width="52" height="12" stroke-width="0.75" class="text-amber-400/60" />
              <line x1="-50" y1="-14" x2="-50" y2="-2" stroke-width="0.5" class="text-purple-400/50" />
              <line x1="-36" y1="-14" x2="-36" y2="-2" stroke-width="0.5" class="text-purple-400/50" />
              <line x1="-22" y1="-14" x2="-22" y2="-2" stroke-width="0.5" class="text-purple-400/50" />
            </g>
          </g>

          <!-- Torre de Fortaleza Medieval Derecha -->
          <g id="castle-tower-r">
            <rect x="20" y="50" width="60" height="180" stroke-width="1" class="text-purple-400/50" />
            <path d="M15,50 L15,30 L27,30 L27,38 L39,38 L39,30 L51,30 L51,38 L63,38 L63,30 L75,30 L75,38 L85,38 L85,50 Z" stroke-width="1" class="text-amber-400/60" />
            <line x1="12" y1="50" x2="88" y2="50" stroke-width="1.25" class="text-amber-400/70" />
            <g class="text-purple-300/60">
              <line x1="50" y1="75" x2="50" y2="105" stroke-width="1" />
              <line x1="44" y1="85" x2="56" y2="85" stroke-width="1" />
              <line x1="50" y1="130" x2="50" y2="160" stroke-width="1" />
              <line x1="44" y1="140" x2="56" y2="140" stroke-width="1" />
            </g>
            <path d="M40,230 L40,195 Q50,180 60,195 L60,230 Z" stroke-width="0.75" class="text-amber-400/50" />
            <line x1="20" y1="120" x2="80" y2="120" stroke-width="0.5" stroke-dasharray="2,4" class="text-purple-500/30" />
            <line x1="20" y1="175" x2="80" y2="175" stroke-width="0.5" stroke-dasharray="2,4" class="text-purple-500/30" />
          </g>

          <!-- Flor de Lis Heráldica Derecha -->
          <g id="fleur-de-lis-r">
            <path d="M50,10 C53,25 60,35 60,50 C55,48 45,48 40,50 C40,35 47,25 50,10 Z" stroke-width="1" class="text-amber-400/70" />
            <path d="M40,50 C32,45 20,40 18,52 C16,65 30,70 38,58 C38,55 39,52 40,50 Z" stroke-width="0.85" class="text-purple-400/60" />
            <path d="M60,50 C68,45 80,40 82,52 C84,65 70,70 62,58 C62,55 61,52 60,50 Z" stroke-width="0.85" class="text-purple-400/60" />
            <path d="M30,55 L70,55 L68,62 L32,62 Z" stroke-width="1" class="text-amber-400/80" />
            <circle cx="50" cy="58.5" r="1.5" fill="currentColor" class="text-amber-300" />
            <path d="M44,62 C46,72 50,78 50,78 C50,78 54,72 56,62 Z" stroke-width="0.85" class="text-purple-400/50" />
          </g>
        </defs>

        <!-- Anotaciones renacentistas margen derecho -->
        <g class="text-[9px] font-mono text-amber-400/40 select-none">
          <text x="356" y="38" text-anchor="end">OPUS RETORICUM • ANNO 1888</text>
          <text x="356" y="52" text-anchor="end">FLOS LILII • DIPLOMATICA</text>
        </g>

        <!-- Molino superior derecho -->
        <use href="#windmill-blueprint-r" x="140" y="70" transform="scale(0.85) rotate(20 180 140)" />
        <!-- Flor de lis decorativa derecha -->
        <use href="#fleur-de-lis-r" x="50" y="240" transform="scale(0.65)" />
        <!-- Torre de Fortaleza medieval derecha -->
        <use href="#castle-tower-r" x="170" y="390" transform="scale(0.95)" />
        <!-- Molino inferior derecho -->
        <use href="#windmill-blueprint-r" x="70" y="660" transform="scale(0.90) rotate(-16 120 600)" />
        <!-- Flor de lis inferior derecha -->
        <use href="#fleur-de-lis-r" x="250" y="850" transform="scale(0.50)" />
      </svg>
    </div>
  </div>

  <main id="main-content" class="flex-1 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 relative z-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-purple-300/80 mb-8 font-serif" aria-label="Ruta de navegación">
      <a href="/" class="hover:text-amber-300 transition-colors">Inicio</a>
      <span aria-hidden="true" class="text-purple-600">/</span>
      <a href="/lab" class="hover:text-amber-300 transition-colors">Lab</a>
      <span aria-hidden="true" class="text-purple-600">/</span>
      <span class="text-purple-300 font-semibold" aria-current="page">Retórica y Descalabro</span>
    </nav>

    <!-- Header -->
    <div class="mb-10">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-3">
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white font-serif">
          Retórica y Descalabro
        </h1>
        <a
          href="https://github.com/Pipin333/retorica-y-descalabro"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-tech font-mono text-xs font-medium text-purple-200 hover:text-amber-200 bg-purple-950/40 border border-purple-800/60 hover:border-amber-400/50 transition-colors self-start sm:self-auto"
          title="Ver repositorio canónico retorica-y-descalabro en GitHub"
        >
          <svg class="w-3.5 h-3.5 text-purple-400" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          <span>Repo: retorica-y-descalabro</span>
          <svg class="w-3 h-3 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
      <p class="text-base text-purple-200/80 leading-relaxed max-w-3xl">
        Transmuta cualquier enunciado coloquial, jerga callejera o copla popular en un denso tratado ontológico decimonónico, correspondencia de cancillería imperial o en un ejercicio de entropía semántica multilingüe digno de las cortes medievales.
      </p>
    </div>

    <!-- Presets bar -->
    <section class="mb-8" aria-labelledby="presets-heading">
      <h2 id="presets-heading" class="text-xs font-semibold uppercase tracking-wider text-purple-300/80 mb-3 flex items-center gap-1.5">
        <Icon name="feather2" class="w-3.5 h-3.5 text-amber-400" />
        <span>Coplas y Refranes de Prueba Rápida:</span>
      </h2>
      <div class="flex flex-wrap gap-2">
        <button
          type="button"
          class="preset-chip inline-flex items-center gap-1.5 text-xs px-3 py-1.5 rounded-lg bg-purple-950/40 border border-purple-800/60 text-purple-200 hover:text-white hover:border-amber-400/50 hover:bg-purple-900/50 transition-all text-left shadow-xs"
          data-text="Sigue tu camino que sin ti me va mejor, ahora tengo otras que me lo hacen mejor."
        >
          <Icon name="music-note-beamed" class="w-3.5 h-3.5 text-amber-400" />
          <span>"Sigue tu camino que sin ti me va mejor..."</span>
        </button>
        <button
          type="button"
          class="preset-chip inline-flex items-center gap-1.5 text-xs px-3 py-1.5 rounded-lg bg-purple-950/40 border border-purple-800/60 text-purple-200 hover:text-white hover:border-amber-400/50 hover:bg-purple-900/50 transition-all text-left shadow-xs"
          data-text="Hermano, me dio la pálida brígida con el terremoto y me fui a acostar a la mala."
        >
          <Icon name="emoji-dizzy" class="w-3.5 h-3.5 text-purple-300" />
