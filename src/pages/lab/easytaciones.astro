<script>
  let currentTenders = [];
  let isCheckingAuth = false;
  let activeCategory = 'all';
  let activeEvaluatingLic = null;
  let activeEffectivePresupuesto = 50000000;
  let activeBasesTexto = '';
  let activeBasesArchivos = [];

  // Perfil inicial neutro en cliente (los datos reales se desencriptan en servidor sólo tras autenticar)
  let currentProfile = {
    profile_version: 6,
    razon_social: 'Consultora TI',
    rut_empresa: '',
    anios_experiencia: 7,
    capacidad_garantia_max_clp: 35000000,
    factor_oferta_default: 94,
    equipo: []
  };

  function hydrateVaultProfile(decryptedProfile) {
    if (decryptedProfile && typeof decryptedProfile === 'object') {
      currentProfile = { ...currentProfile, ...decryptedProfile, profile_version: 6 };
    }
    try {
      const saved = localStorage.getItem('easytaciones_company_profile');
      if (saved) {
        const parsed = JSON.parse(saved);
        if (parsed && typeof parsed === 'object' && parsed.profile_version === 6) {
          currentProfile = { ...currentProfile, ...parsed };
        } else if (decryptedProfile) {
          localStorage.setItem('easytaciones_company_profile', JSON.stringify(currentProfile));
        }
      } else if (decryptedProfile) {
        localStorage.setItem('easytaciones_company_profile', JSON.stringify(currentProfile));
      }
    } catch {}

    const nameDisp = document.getElementById('profileNameDisplay');
    if (nameDisp && currentProfile.razon_social) {
      nameDisp.textContent = currentProfile.razon_social;
    }
    updateTeamBadge();
  }

  // 1. Verificación Inicial de Autenticación
  async function checkSession() {
    if (isCheckingAuth) return;
    isCheckingAuth = true;

    try {
      const res = await fetch('/api/easytaciones/auth');
      if (res.ok) {
        const data = await res.json();
        if (data.authenticated) {
          if (data.defaultProfile) hydrateVaultProfile(data.defaultProfile);
          showWorkspace();
          return;
        }
      }
    } catch {}

    showAuthGate();
  }

  function showAuthGate() {
    const gate = document.getElementById('authGateSection');
    const ws = document.getElementById('workspaceSection');
    if (gate) gate.classList.remove('hidden');
    if (ws) ws.classList.add('hidden');
  }

  function showWorkspace() {
    const gate = document.getElementById('authGateSection');
    const ws = document.getElementById('workspaceSection');
    if (gate) gate.classList.add('hidden');
    if (ws) ws.classList.remove('hidden');
    updateTeamBadge();
    runSearch();
  }

  function updateTeamBadge() {
    const badge = document.getElementById('badgeTeamCount');
    const tabCount = document.getElementById('tabCountTeam');
    const count = (currentProfile.equipo || []).length;
    if (badge) badge.textContent = `${count} profesionales`;
    if (tabCount) tabCount.textContent = String(count);
  }

  // 2. Manejo de Login
  const authForm = document.getElementById('authForm');
  if (authForm) {
    authForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = document.getElementById('accessTokenInput');
      const errBox = document.getElementById('authErrorMsg');
      const btn = document.getElementById('btnSubmitAuth');
      const label = document.getElementById('authBtnLabel');

      if (!input || !errBox || !btn || !label) return;

      const token = input.value.trim();
      if (!token) return;

      btn.disabled = true;
      label.textContent = 'Verificando...';
      errBox.classList.add('hidden');

      try {
        const res = await fetch('/api/easytaciones/auth', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token })
        });
        const data = await res.json();

        if (res.ok && data.authenticated) {
          input.value = '';
          if (data.defaultProfile) hydrateVaultProfile(data.defaultProfile);
          showWorkspace();
        } else {
          errBox.textContent = data.error || 'Clave de acceso inválida.';
          errBox.classList.remove('hidden');
        }
      } catch (err) {
        errBox.textContent = 'Error de conexión con el endpoint de verificación.';
        errBox.classList.remove('hidden');
      } finally {
        btn.disabled = false;
        label.textContent = 'Desbloquear Consola';
      }
    });
  }

  // Toggle Password
  const btnToggle = document.getElementById('btnTogglePassword');
  if (btnToggle) {
    btnToggle.addEventListener('click', () => {
      const input = document.getElementById('accessTokenInput');
      if (!input) return;
      if (input.type === 'password') {
        input.type = 'text';
        btnToggle.textContent = 'ocultar';
      } else {
        input.type = 'password';
        btnToggle.textContent = 'ver';
      }
    });
  }

  // Logout
  const btnLogout = document.getElementById('btnLogout');
  if (btnLogout) {
    btnLogout.addEventListener('click', async () => {
      try {
        await fetch('/api/easytaciones/auth', { method: 'DELETE' });
        localStorage.removeItem('easytaciones_company_profile');
      } catch {}
      showAuthGate();
    });
  }

  // 3. Ejecución de Búsqueda Semántica
  async function runSearch(forceRefresh = false) {
    const queryInput = document.getElementById('semanticQueryInput');
    const skeleton = document.getElementById('loadingSkeleton');
    const container = document.getElementById('tendersContainer');
    const emptyState = document.getElementById('emptyResultsState');
    const syncSpinner = document.getElementById('syncSpinner');

    if (!queryInput || !skeleton || !container || !emptyState) return;

    skeleton.classList.remove('hidden');
    container.innerHTML = '';
    emptyState.classList.add('hidden');
    if (syncSpinner && forceRefresh) syncSpinner.classList.add('animate-spin');

    const query = queryInput.value.trim();

    try {
      const res = await fetch('/api/easytaciones/match', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          query,
          min_score_percentage: 0,
          top_k: 250,
          force_refresh: forceRefresh
        })
      });

      if (res.status === 401) {
        showAuthGate();
        return;
      }

      const data = await res.json();
      skeleton.classList.add('hidden');

      if (data.success && Array.isArray(data.licitaciones)) {
        currentTenders = data.licitaciones;

        const totalMP = document.getElementById('kpiTotalMP');
        const totalTI = document.getElementById('kpiTotalTI');
        const latency = document.getElementById('kpiLatency');
        const highMatch = document.getElementById('kpiHighMatch');
        if (totalMP && data.total_mercado_publico) {
          totalMP.textContent = Number(data.total_mercado_publico).toLocaleString('es-CL');
        }
        if (totalTI) totalTI.textContent = String(currentTenders.length);
        if (latency) latency.textContent = `Inferencia: ${data.tiempo_procesamiento_ms || 4.2} ms`;
        if (highMatch) {
          const highCount = currentTenders.filter(t => (t.score_percentage || 0) >= 75).length;
          highMatch.textContent = String(highCount);
        }

        if (forceRefresh) {
          const syncLabel = document.getElementById('syncBtnLabel');
          if (syncLabel) {
            if (data.ticket_warning) {
              syncLabel.textContent = '⚠ Error en Ticket';
            } else {
              const countStr = Number(data.total_mercado_publico || currentTenders.length).toLocaleString('es-CL');
              syncLabel.textContent = `✓ ${countStr} activas`;
            }
            setTimeout(() => {
              syncLabel.textContent = 'Actualizar Catálogo';
            }, 3500);
          }
        }

        updateCategoryPillCounts();
        renderTenders();
      } else {
        emptyState.classList.remove('hidden');
      }
    } catch (err) {
      skeleton.classList.add('hidden');
      emptyState.classList.remove('hidden');
    } finally {
      if (syncSpinner) syncSpinner.classList.remove('animate-spin');
    }
  }

  function updateCategoryPillCounts() {
    const counts = { all: currentTenders.length, software: 0, datos: 0, ciberseguridad: 0, hardware: 0 };
    currentTenders.forEach(t => {
      const cat = (t.categoria_id || '').toLowerCase();
      if (counts[cat] !== undefined) {
        counts[cat] += 1;
      }
    });

    const setVal = (id, val) => {
      const el = document.getElementById(id);
      if (el) el.textContent = String(val);
    };

    setVal('catCountAll', counts.all);
    setVal('catCountSoftware', counts.software);
    setVal('catCountDatos', counts.datos);
    setVal('catCountCiber', counts.ciberseguridad);
    setVal('catCountHardware', counts.hardware);
  }

  // 4. Renderizado de Tarjetas
  function renderTenders() {
    const container = document.getElementById('tendersContainer');
    const emptyState = document.getElementById('emptyResultsState');
    const countBadge = document.getElementById('resultsCountBadge');
    const sortSelect = document.getElementById('selectSort');
    const slider = document.getElementById('scoreSlider');
    const visibleCount = document.getElementById('kpiVisibleCount');

    if (!container || !emptyState || !slider) return;

    const minScore = parseFloat(slider.value) || 0;
    const sortBy = sortSelect ? sortSelect.value : 'score_desc';

    let list = currentTenders.filter(t => {
      const score = t.score_percentage || 0;
      if (score < minScore) return false;
      if (activeCategory !== 'all') {
        const cat = (t.categoria_id || '').toLowerCase();
        if (cat !== activeCategory) return false;
      }
      return true;
    });

    if (sortBy === 'score_desc') {
      list.sort((a, b) => (b.score_percentage || 0) - (a.score_percentage || 0));
    } else if (sortBy === 'monto_desc') {
      list.sort((a, b) => (b.monto_estimado || 0) - (a.monto_estimado || 0));
    } else if (sortBy === 'cierre_asc') {
      list.sort((a, b) => new Date(a.fecha_cierre || 0).getTime() - new Date(b.fecha_cierre || 0).getTime());
    }

    if (countBadge) countBadge.textContent = String(list.length);
    if (visibleCount) visibleCount.textContent = `${list.length} / ${currentTenders.length}`;

    if (list.length === 0) {
      container.innerHTML = '';
      emptyState.classList.remove('hidden');
      return;
    }

    emptyState.classList.add('hidden');

    container.innerHTML = list.map((lic, index) => {
      const score = Math.round((lic.score_percentage || 0) * 10) / 10;
      let badgeColor = 'text-cyan-300 border-cyan-500/40 bg-cyan-950/40';
      let progressColor = 'bg-cyan-400';

      if (score >= 75) {
        badgeColor = 'text-emerald-300 border-emerald-500/40 bg-emerald-950/40';
        progressColor = 'bg-emerald-400';
      } else if (score >= 50) {
        badgeColor = 'text-amber-300 border-amber-500/40 bg-amber-950/40';
        progressColor = 'bg-amber-400';
      }

      const montoFormatted = lic.monto_estimado && lic.monto_estimado > 0
        ? `$${Number(lic.monto_estimado).toLocaleString('es-CL')} ${lic.moneda || 'CLP'}`
        : 'Monto No Publicado';

      const organismo = lic.comprador?.nombre_organismo || 'Organismo del Estado de Chile';
      const region = lic.comprador?.region || 'Chile';
      const fechaCierre = lic.fecha_cierre
        ? new Date(lic.fecha_cierre).toLocaleDateString('es-CL', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' })
        : 'Consultar en Ficha';

      return `
        <article class="p-5 sm:p-6 rounded-2xl bg-canvas-subtle border border-canvas-border hover:border-slate-700 transition-all space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div class="flex flex-wrap items-center gap-2">
              <span class="px-2.5 py-1 rounded-md text-xs font-mono font-bold border ${badgeColor}">
                ${score}% Afinidad
              </span>
              <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-slate-800 text-slate-400 border border-slate-700">
                ${lic.categoria_label || 'TI'}
              </span>
              <a
                href="https://www.mercadopublico.cl/FichaLicitacion.html?idLicitacion=${encodeURIComponent(lic.codigo_externo)}"
                target="_blank"
                rel="noopener noreferrer"
                class="px-2 py-1 rounded-md text-xs font-mono text-slate-400 hover:text-amber-300 bg-canvas border border-canvas-border transition-colors flex items-center gap-1"
                title="Abrir ficha oficial en Mercado Público"
              >
                <span>${lic.codigo_externo}</span>
                <span>↗</span>
              </a>
            </div>

            <div class="flex items-center gap-3 text-xs font-mono text-slate-400">
              <span>Cierre: <strong class="text-slate-200">${fechaCierre}</strong></span>
            </div>
          </div>

          <div class="space-y-1.5">
            <h4 class="text-base sm:text-lg font-bold text-white font-display leading-snug">
              ${lic.nombre}
            </h4>
            <div class="text-xs font-mono text-amber-300/80">
              ${organismo} · ${region}
            </div>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed pt-1">
              ${lic.descripcion}
            </p>
          </div>

          <!-- Barra de Afinidad -->
          <div class="space-y-1">
            <div class="w-full h-1.5 bg-slate-800 rounded-full overflow-hidden">
              <div class="h-full ${progressColor} transition-all duration-500" style="width: ${Math.min(100, score)}%"></div>
            </div>
          </div>

          <!-- Footer de Tarjeta con Dos Acciones -->
          <div class="pt-2 border-t border-canvas-border flex flex-wrap items-center justify-between gap-3 text-xs font-mono">
            <div class="text-slate-400">
              Monto Estimado: <strong class="text-emerald-400 font-sans font-semibold">${montoFormatted}</strong>
            </div>

            <div class="flex items-center gap-2">
              <button
                type="button"
                data-index="${index}"
                class="btn-open-detail px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white transition-colors cursor-pointer"
              >
                Ficha Básica
              </button>

              <button
                type="button"
                data-codigo="${lic.codigo_externo}"
                class="btn-open-suite px-3.5 py-1.5 rounded-lg bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-slate-950 font-bold shadow-md shadow-emerald-500/20 transition-all flex items-center gap-1.5 cursor-pointer"
              >
                <span>Auditar Bases & Win Rate ✦</span>
              </button>
            </div>
          </div>
        </article>
      `;
    }).join('');

    document.querySelectorAll('.btn-open-detail').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget;
        const idx = parseInt(target.getAttribute('data-index') || '0', 10);
        if (list[idx]) openDetailModal(list[idx]);
      });
    });

    document.querySelectorAll('.btn-open-suite').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const codigo = e.currentTarget.getAttribute('data-codigo');
        const tender = currentTenders.find(t => t.codigo_externo === codigo);
        if (tender) openEvaluationSuite(tender, null, false);
      });
    });
  }

  // 5. Suite de Auditoría & Win Probability
  async function openEvaluationSuite(lic, customOferta = null, preserveBases = true) {
    const isNewTender = !activeEvaluatingLic || activeEvaluatingLic.codigo_externo !== lic.codigo_externo;
    if (isNewTender && !preserveBases) {
      activeBasesTexto = '';
      activeBasesArchivos = [];
    }
    activeEvaluatingLic = lic;
    const modal = document.getElementById('evaluationSuiteModal');
    const codigo = document.getElementById('suiteModalCodigo');
    const titulo = document.getElementById('suiteModalTitulo');
    const organismo = document.getElementById('suiteModalOrganismo');
    const btnOficial = document.getElementById('suiteBtnFichaOficial');

    if (!modal || !codigo || !titulo || !organismo) return;

    codigo.textContent = lic.codigo_externo;
    titulo.textContent = lic.nombre;
    organismo.textContent = `${lic.comprador?.nombre_organismo || 'Organismo del Estado'} · ${lic.comprador?.region || 'Chile'}`;
    if (btnOficial) {
      btnOficial.href = `https://www.mercadopublico.cl/FichaLicitacion.html?idLicitacion=${encodeURIComponent(lic.codigo_externo)}`;
    }

    modal.classList.remove('hidden');

    try {
      const res = await fetch('/api/easytaciones/evaluar', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          codigo_externo: lic.codigo_externo,
          perfil: currentProfile,
          monto_ofertado_clp: customOferta,
          bases_texto: activeBasesTexto || undefined,
          bases_archivos: activeBasesArchivos.length > 0 ? activeBasesArchivos : undefined
        })
      });

      if (!res.ok) throw new Error('Fallo al evaluar licitación');
      const data = await res.json();
      if (data.success && data.evaluacion) {
        renderSuiteEvaluation(data.evaluacion);
      }
    } catch (err) {
      console.error(err);
    }
  }

  function renderSuiteEvaluation(evalResult) {
    const banner = document.getElementById('suiteDecisionBanner');
    const label = document.getElementById('suiteDecisionLabel');
    const sub = document.getElementById('suiteDecisionSub');
    const winValue = document.getElementById('suiteWinProbValue');
    const tableBody = document.getElementById('suiteCriteriosTableBody');
    const auditoriaList = document.getElementById('suiteAuditoriaList');
    const fortalezasList = document.getElementById('suiteFortalezasList');
    const riesgosList = document.getElementById('suiteRiesgosList');
    const recText = document.getElementById('suiteRecomendacionText');
    const simRef = document.getElementById('simPresupuestoRef');
    const simOferta = document.getElementById('simOfertaDisplay');
    const simFactor = document.getElementById('simFactorDisplay');
    const simSlider = document.getElementById('simOfertaSlider');

    if (!banner || !label || !winValue || !tableBody || !auditoriaList) return;

    let borderColor = 'border-emerald-500/40 bg-emerald-950/30 text-emerald-300';
    if (evalResult.decision === 'CONDITIONAL_GO') {
      borderColor = 'border-amber-500/40 bg-amber-950/30 text-amber-300';
    } else if (evalResult.decision === 'NO_GO') {
      borderColor = 'border-rose-500/40 bg-rose-950/30 text-rose-300';
    }

    banner.className = `p-5 rounded-2xl border transition-all flex flex-col sm:flex-row items-center justify-between gap-6 ${borderColor}`;
    label.textContent = evalResult.decision_label;
    if (sub) {
      sub.textContent = evalResult.decision === 'GO'
        ? `Cumple con el perfil de ${currentProfile.razon_social} y nómina de ${currentProfile.equipo.length} profesionales acreditados.`
        : 'Requiere revisión de las cláusulas destacadas en la auditoría antes de comprometer pólizas.';
    }

    winValue.textContent = `${evalResult.win_probability}%`;
    winValue.className = `text-3xl sm:text-4xl font-bold font-display ${evalResult.win_probability >= 70 ? 'text-emerald-400' : (evalResult.win_probability >= 50 ? 'text-amber-400' : 'text-rose-400')}`;

    activeEffectivePresupuesto = evalResult.monto_estimado_clp || 50000000;
    if (simRef) simRef.textContent = `$${Number(evalResult.monto_estimado_clp).toLocaleString('es-CL')} CLP`;
    if (simOferta) simOferta.textContent = `$${Number(evalResult.monto_ofertado_clp).toLocaleString('es-CL')} CLP`;
    const factorActual = Math.round((evalResult.monto_ofertado_clp / evalResult.monto_estimado_clp) * 100);
    if (simFactor) simFactor.textContent = `${factorActual}% del presupuesto`;
    if (simSlider) simSlider.value = String(factorActual);

    tableBody.innerHTML = evalResult.criterios_evaluacion.map(c => `
      <tr class="hover:bg-slate-800/40 transition-colors">
        <td class="p-3 font-bold text-white">${c.criterio}</td>
        <td class="p-3 text-center text-slate-400">${c.ponderacion}%</td>
        <td class="p-3 text-center font-bold ${c.puntaje_obtenido >= 80 ? 'text-emerald-400' : 'text-amber-400'}">${c.puntaje_obtenido} / 100</td>
        <td class="p-3 text-center font-bold text-white">${c.puntaje_ponderado} pts</td>
        <td class="p-3 text-slate-300 text-[11px]">${c.observacion}</td>
      </tr>
    `).join('');

    // Auditoría de Requisitos (Calculada integralmente por el motor de evaluar.ts)
    const auditoriaItems = [...evalResult.auditoria_requisitos];

    auditoriaList.innerHTML = auditoriaItems.map(r => {
      let icon = '✓';
      let pillClass = 'bg-emerald-950 text-emerald-300 border-emerald-500/30';
      if (r.estado === 'alerta') {
        icon = '⚠';
        pillClass = 'bg-amber-950 text-amber-300 border-amber-500/30';
      } else if (r.estado === 'critico') {
        icon = '✕';
        pillClass = 'bg-rose-950 text-rose-300 border-rose-500/30';
      }

      return `
        <div class="p-3 rounded-lg bg-canvas border border-canvas-border flex items-start gap-3">
          <span class="w-5 h-5 rounded-full flex items-center justify-center text-xs font-bold border ${pillClass} shrink-0 mt-0.5">
            ${icon}
          </span>
          <div class="space-y-0.5 text-xs font-sans">
            <div class="font-bold text-white flex items-center gap-2">
              <span>${r.item}</span>
              <span class="text-[10px] uppercase font-mono px-1.5 py-0.2 rounded bg-slate-800 text-slate-400">${r.tipo}</span>
            </div>
            <p class="text-slate-300 text-[11px] leading-relaxed">${r.detalle}</p>
          </div>
        </div>
      `;
    }).join('');

    if (fortalezasList) {
      fortalezasList.innerHTML = evalResult.fortalezas.map(f => `<li>${f}</li>`).join('') || '<li class="text-slate-500 italic">Sin ventajas diferenciales declaradas.</li>';
    }
    if (riesgosList) {
      riesgosList.innerHTML = evalResult.riesgos_dealbreakers.map(r => `<li>${r}</li>`).join('') || '<li class="text-slate-500 italic">Sin showstoppers críticos identificados en las bases.</li>';
    }

    if (recText) {
      recText.textContent = evalResult.recomendacion_estrategica;
    }

    // Heads-Up Estratégico & Brechas del Equipo
    const headsUpList = document.getElementById('suiteHeadsUpList');
    if (headsUpList && evalResult.heads_up_brechas) {
      headsUpList.innerHTML = evalResult.heads_up_brechas.map(b => {
        let borderClass = 'border-amber-500/30 bg-canvas';
        let badgeClass = 'bg-amber-950 text-amber-300 border-amber-500/30';
        let icon = '⚡';
        if (b.severidad === 'alta') {
          borderClass = 'border-rose-500/40 bg-rose-950/20';
          badgeClass = 'bg-rose-950 text-rose-300 border-rose-500/40';
          icon = '🚨';
        } else if (b.severidad === 'baja') {
          borderClass = 'border-emerald-500/30 bg-emerald-950/20';
          badgeClass = 'bg-emerald-950 text-emerald-300 border-emerald-500/30';
          icon = '✓';
        }

        return `
          <div class="p-3.5 rounded-xl border ${borderClass} space-y-2">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1.5">
              <div class="flex items-center gap-2">
                <span class="text-sm shrink-0">${icon}</span>
                <span class="font-bold text-xs text-white">${b.titulo}</span>
              </div>
              <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded border ${badgeClass} w-fit">
                ${b.severidad === 'alta' ? 'Brecha Crítica' : b.severidad === 'media' ? 'Atención Requerida' : 'Conforme'}
              </span>
            </div>

            <p class="text-xs text-slate-300 leading-relaxed">${b.hallazgo}</p>

            <div class="pt-2 border-t border-canvas-border/50 grid grid-cols-1 md:grid-cols-2 gap-2 text-[11px]">
              <div class="text-rose-300/90 leading-normal">
                <strong class="text-rose-200">Impacto en Pauta:</strong> ${b.impacto_puntaje}
              </div>
              <div class="text-emerald-300/90 leading-normal">
                <strong class="text-emerald-200">Táctica Sugerida:</strong> ${b.mitigacion_sugerida}
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    // Renderizado del Analizador Forense de Bases Oficiales (PDF / DOCX / Texto)
    const basesBadge = document.getElementById('basesStatusBadge');
    const basesBox = document.getElementById('suiteBasesExtractedBox');
    const btnClearBases = document.getElementById('btnClearBases');
    const pillsContainer = document.getElementById('suiteBasesSummaryPills');
    const anexosList = document.getElementById('suiteAnexosList');
    const anexosCount = document.getElementById('suiteAnexosCount');
    const clausulasList = document.getElementById('suiteClausulasList');
    const clausulasCount = document.getElementById('suiteClausulasCount');

    const ab = evalResult.analisis_bases;
    if (ab && ab.activo) {
      if (basesBadge) {
        basesBadge.textContent = `✓ Bases Activas (${ab.archivos_procesados.join(', ')} · ${Number(ab.caracteres_analizados).toLocaleString('es-CL')} chars)`;
        basesBadge.className = 'text-[10px] font-mono px-2.5 py-1 rounded bg-emerald-950 text-emerald-300 border border-emerald-500/40 whitespace-nowrap w-fit';
      }
      if (basesBox) basesBox.classList.remove('hidden');
      if (btnClearBases) btnClearBases.classList.remove('hidden');

      if (pillsContainer) {
        const pills = [];
        if (ab.ponderacion_extraida_del_documento) {
          pills.push(`<span class="px-2.5 py-1 rounded-lg text-[11px] font-mono bg-emerald-950/80 text-emerald-300 border border-emerald-500/40">⚖ Ponderación extraída del PDF: ${ab.ponderaciones.economica}% Eco / ${ab.ponderaciones.tecnica}% Téc / ${ab.ponderaciones.experiencia}% Exp / ${ab.ponderaciones.formal}% Formal</span>`);
        } else {
          pills.push(`<span class="px-2.5 py-1 rounded-lg text-[11px] font-mono bg-slate-800 text-slate-300 border border-slate-700">⚖ Ponderación estándar aplicada (45/35/15/5)</span>`);
        }
        if (ab.presupuesto_extraido_clp) {
          pills.push(`<span class="px-2.5 py-1 rounded-lg text-[11px] font-mono bg-cyan-950/80 text-cyan-300 border border-cyan-500/40">💰 Presupuesto en Bases: $${Number(ab.presupuesto_extraido_clp).toLocaleString('es-CL')} CLP</span>`);
        }
        if (ab.req_anios_jp) {
          pills.push(`<span class="px-2.5 py-1 rounded-lg text-[11px] font-mono bg-amber-950/80 text-amber-300 border border-amber-500/40">👔 Exigencia JP: ${ab.req_anios_jp} años</span>`);
