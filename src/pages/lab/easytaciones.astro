            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-[11px] text-slate-300 pt-1 border-t border-canvas-border/50">
            <div>🎓 <strong>Carrera / Título:</strong> ${member.titulo || 'No especificado'}</div>
            <div>⏱ <strong>Experiencia:</strong> ${member.anios_exp} años acreditables</div>
            <div class="sm:col-span-2">📜 <strong>Certificaciones:</strong> ${member.certificaciones || 'Estándar'}</div>
          </div>

          <div class="pt-2 flex items-center justify-between text-[11px] bg-canvas-subtle p-2.5 rounded-lg border border-canvas-border">
            <div class="flex items-center gap-2 text-slate-300">
              <span class="text-amber-400">📄</span>
              <span>CV Oficial: <strong class="text-white">${member.cv_filename || 'CV_Adjunto.pdf'}</strong></span>
            </div>

            <label class="cursor-pointer text-amber-400 hover:text-amber-300 font-bold">
              <span>Reemplazar CV</span>
              <input type="file" accept=".pdf,.doc,.docx" class="hidden input-replace-cv" data-idx="${idx}" />
            </label>
          </div>
        </div>
      `;
    }).join('');

    // Eventos editar
    document.querySelectorAll('.btn-edit-member').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt(e.currentTarget.getAttribute('data-idx') || '0', 10);
        const mem = currentProfile.equipo[idx];
        editingMemberId = mem ? (mem.id || String(idx)) : null;
        renderTeamMembersList();
      });
    });

    // Eventos cancelar edición
    document.querySelectorAll('.btn-cancel-member-edit').forEach(btn => {
      btn.addEventListener('click', () => {
        editingMemberId = null;
        renderTeamMembersList();
      });
    });

    // Eventos guardar edición inline
    document.querySelectorAll('.btn-save-member-edit').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt(e.currentTarget.getAttribute('data-idx') || '0', 10);
        const mem = currentProfile.equipo[idx];
        if (!mem) return;

        const nomInput = document.getElementById(`editMemberNombre_${idx}`);
        const rolInput = document.getElementById(`editMemberRol_${idx}`);
        const titInput = document.getElementById(`editMemberTitulo_${idx}`);
        const expInput = document.getElementById(`editMemberExp_${idx}`);
        const certInput = document.getElementById(`editMemberCert_${idx}`);

        const nombre = nomInput ? nomInput.value.trim() : mem.nombre;
        const rol = rolInput ? rolInput.value.trim() : mem.rol;
        const titulo = titInput ? titInput.value.trim() : mem.titulo;
        const exp = expInput ? parseInt(expInput.value, 10) : mem.anios_exp;
        const cert = certInput ? certInput.value.trim() : mem.certificaciones;

        if (!nombre || !rol) {
          alert('Por favor indica al menos el nombre y cargo del profesional.');
          return;
        }

        mem.nombre = nombre;
        mem.rol = rol;
        mem.titulo = titulo || 'Profesional de Software';
        mem.anios_exp = isNaN(exp) ? 0 : Math.max(0, exp);
        mem.certificaciones = cert || 'Capacitación Continua';

        saveProfileToStorage();
        editingMemberId = null;
        updateTeamBadge();
        renderTeamMembersList();

        if (activeEvaluatingLic) {
          openEvaluationSuite(activeEvaluatingLic);
        }
      });
    });

    // Eventos eliminar
    document.querySelectorAll('.btn-delete-member').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt(e.currentTarget.getAttribute('data-idx') || '0', 10);
        currentProfile.equipo.splice(idx, 1);
        saveProfileToStorage();
        updateTeamBadge();
        renderTeamMembersList();
        if (activeEvaluatingLic) {
          openEvaluationSuite(activeEvaluatingLic);
        }
      });
    });

    // Eventos reemplazar archivo
    document.querySelectorAll('.input-replace-cv').forEach(input => {
      input.addEventListener('change', (e) => {
        const idx = parseInt(e.currentTarget.getAttribute('data-idx') || '0', 10);
        const file = e.target.files?.[0];
        if (file && currentProfile.equipo[idx]) {
          currentProfile.equipo[idx].cv_filename = file.name;
          currentProfile.equipo[idx].cv_status = 'CV Cargado';
          saveProfileToStorage();
          renderTeamMembersList();
        }
      });
    });
  }

  // Toggle form nuevo integrante
  const btnShowAddMember = document.getElementById('btnShowAddMemberForm');
  const addMemberBox = document.getElementById('addMemberFormBox');
  const btnCancelAddMember = document.getElementById('btnCancelAddMember');
  const btnSaveMember = document.getElementById('btnSaveMember');

  if (btnShowAddMember && addMemberBox) {
    btnShowAddMember.addEventListener('click', () => {
      addMemberBox.classList.remove('hidden');
    });
  }

  if (btnCancelAddMember && addMemberBox) {
    btnCancelAddMember.addEventListener('click', () => {
      addMemberBox.classList.add('hidden');
    });
  }

  if (btnSaveMember && addMemberBox) {
    btnSaveMember.addEventListener('click', () => {
      const nombre = document.getElementById('newMemberNombre').value.trim();
      const rol = document.getElementById('newMemberRol').value.trim();
      const titulo = document.getElementById('newMemberTitulo').value.trim();
      const exp = parseInt(document.getElementById('newMemberExp').value, 10) || 3;
      const cert = document.getElementById('newMemberCert').value.trim();
      const fileInput = document.getElementById('newMemberCvFile');
      const fileName = fileInput?.files?.[0]?.name || 'Curriculum_Vitae.pdf';

      if (!nombre || !rol) {
        alert('Por favor indica al menos el nombre y rol del profesional.');
        return;
      }

      currentProfile.equipo.push({
        id: String(Date.now()),
        nombre,
        rol,
        titulo: titulo || 'Profesional de Software',
        anios_exp: exp,
        certificaciones: cert || 'Capacitación Continua',
        cv_status: fileInput?.files?.[0] ? 'CV Cargado' : 'Acreditado',
        cv_filename: fileName
      });

      // Limpiar campos
      document.getElementById('newMemberNombre').value = '';
      document.getElementById('newMemberRol').value = '';
      document.getElementById('newMemberTitulo').value = '';
      document.getElementById('newMemberCert').value = '';
      if (fileInput) fileInput.value = '';

      addMemberBox.classList.add('hidden');
      saveProfileToStorage();
      updateTeamBadge();
      renderTeamMembersList();
      if (activeEvaluatingLic) {
        openEvaluationSuite(activeEvaluatingLic);
      }
    });
  }

  // Abrir y cerrar modal general
  if (btnOpenProfile && profileModal) {
    btnOpenProfile.addEventListener('click', () => {
      document.getElementById('cfgRazonSocial').value = currentProfile.razon_social;
      document.getElementById('cfgRut').value = currentProfile.rut_empresa;
      document.getElementById('cfgAniosExp').value = currentProfile.anios_experiencia;
      document.getElementById('cfgCapacidadGarantia').value = currentProfile.capacidad_garantia_max_clp;
      document.getElementById('cfgFactorOferta').value = currentProfile.factor_oferta_default;
      switchProfileTab('company');
      profileModal.classList.remove('hidden');
    });
  }

  function closeProfileModal() {
    if (profileModal) profileModal.classList.add('hidden');
  }

  if (btnCloseProfile) btnCloseProfile.addEventListener('click', closeProfileModal);
  if (btnDismissProfile) btnDismissProfile.addEventListener('click', closeProfileModal);

  // Guardar configuración completa de perfil
  if (btnSaveAllProfile) {
    btnSaveAllProfile.addEventListener('click', () => {
      const razon = document.getElementById('cfgRazonSocial').value.trim();
      const rut = document.getElementById('cfgRut').value.trim();
      const exp = parseInt(document.getElementById('cfgAniosExp').value, 10) || 7;
      const cap = parseInt(document.getElementById('cfgCapacidadGarantia').value, 10) || 35000000;
      const factor = parseInt(document.getElementById('cfgFactorOferta').value, 10) || 94;

      currentProfile.razon_social = razon;
      currentProfile.rut_empresa = rut;
      currentProfile.anios_experiencia = exp;
      currentProfile.capacidad_garantia_max_clp = cap;
      currentProfile.factor_oferta_default = factor;

      try {
        localStorage.setItem('easytaciones_company_profile', JSON.stringify(currentProfile));
      } catch {}

      const disp = document.getElementById('profileNameDisplay');
      if (disp) disp.textContent = razon;

      updateTeamBadge();
      closeProfileModal();

      if (activeEvaluatingLic) {
        openEvaluationSuite(activeEvaluatingLic);
      }
    });
  }

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeModal();
      closeSuiteModal();
      closeProfileModal();
    }
  });

  // Slider & Presets Events
  const slider = document.getElementById('scoreSlider');
  const sliderVal = document.getElementById('sliderValueText');
  const kpiMinScore = document.getElementById('kpiMinScoreDisplay');

  if (slider && sliderVal && kpiMinScore) {
    slider.addEventListener('input', () => {
      sliderVal.textContent = `${slider.value}%`;
      kpiMinScore.textContent = `Umbral: ${slider.value}%`;
      renderTenders();
    });
  }

  const sortSelect = document.getElementById('selectSort');
  if (sortSelect) {
    sortSelect.addEventListener('change', renderTenders);
  }

  const btnRunSearch = document.getElementById('btnRunSearch');
  if (btnRunSearch) {
    btnRunSearch.addEventListener('click', () => runSearch(false));
  }

  const btnSync = document.getElementById('btnSyncMercadoPublico');
  if (btnSync) {
    btnSync.addEventListener('click', () => runSearch(true));
  }

  // Presets click
  document.querySelectorAll('.preset-chip').forEach(chip => {
    chip.addEventListener('click', (e) => {
      const target = e.currentTarget;
      const q = target.getAttribute('data-query') || '';
      const s = target.getAttribute('data-score') || '50';

      const qInput = document.getElementById('semanticQueryInput');
      if (qInput) qInput.value = q;
      if (slider && sliderVal && kpiMinScore) {
        slider.value = s;
        sliderVal.textContent = `${s}%`;
        kpiMinScore.textContent = `Umbral: ${s}%`;
      }

      runSearch(false);
    });
  });

  // Filtros de categoría
  document.querySelectorAll('.cat-pill').forEach(pill => {
    pill.addEventListener('click', (e) => {
      document.querySelectorAll('.cat-pill').forEach(p => {
        p.classList.remove('active', 'bg-amber-400', 'text-slate-950', 'font-bold');
        p.classList.add('bg-canvas', 'border', 'border-canvas-border', 'text-slate-300');
      });

      const current = e.currentTarget;
      current.classList.add('active', 'bg-amber-400', 'text-slate-950', 'font-bold');
      current.classList.remove('bg-canvas', 'border', 'border-canvas-border', 'text-slate-300');

      activeCategory = current.getAttribute('data-cat') || 'all';
      renderTenders();
    });
  });

  // Iniciar al cargar
  checkSession();
</script>
