      const files = Array.from(e.target.files || []);
      if (files.length === 0 || !activeEvaluatingLic) return;

      const basesBadge = document.getElementById('basesStatusBadge');
      if (basesBadge) {
        basesBadge.textContent = '⏳ Extrayendo texto de las Bases...';
        basesBadge.className = 'text-[10px] font-mono px-2.5 py-1 rounded bg-amber-950 text-amber-300 border border-amber-500/40 whitespace-nowrap w-fit animate-pulse';
      }

      const chunks = [];
      const labels = [];

      for (const file of files) {
        const ext = file.name.toLowerCase().split('.').pop();
        try {
          if (ext === 'pdf') {
            const res = await extractPdfTextFromFile(file, (p, total) => {
              if (basesBadge) basesBadge.textContent = `⏳ Leyendo ${file.name} (pág ${p}/${total})...`;
            });
            chunks.push(res.text);
            labels.push(`${file.name} (${res.pages} págs)`);
          } else if (ext === 'docx') {
            const docxText = await extractDocxTextFromFile(file);
            chunks.push(docxText);
            labels.push(file.name);
          } else {
            const raw = await file.text();
            chunks.push(raw);
            labels.push(file.name);
          }
        } catch (err) {
          console.error('Error procesando archivo de bases:', err);
        }
      }

      activeBasesTexto = chunks.join('\n\n');
      activeBasesArchivos = labels;
      basesFileInput.value = '';
      openEvaluationSuite(activeEvaluatingLic);
    });
