---
// src/pages/lab/easytaciones.astro
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';

const pageTitle = "Easytaciones // Radar Semántico & Suite de Adjudicación TI | Felipe Riquelme";
const pageDescription = "Consola técnica interna para detección semántica, auditoría de bases y scoring de probabilidad de adjudicación en Mercado Público (ChileCompra).";
---

<Layout title={pageTitle} description={pageDescription} robots="noindex, nofollow, noarchive">
  <Header />

  <main class="min-h-screen bg-canvas text-slate-100 font-sans antialiased pb-28">

    <!-- Hero Header / Breadcrumb -->
    <section class="border-b border-canvas-border bg-gradient-to-b from-[#080D17] via-canvas to-canvas px-4 sm:px-6 lg:px-8 pt-10 sm:pt-14 pb-8">
      <div class="max-w-7xl mx-auto space-y-4">
        
        <div class="flex flex-wrap items-center justify-between gap-3 text-xs font-mono">
          <div class="flex items-center gap-2 text-slate-400">
            <a href="/" class="hover:text-telemetry transition-colors">inicio</a>
            <span>/</span>
            <a href="/lab" class="hover:text-telemetry transition-colors">lab</a>
            <span>/</span>
            <span class="text-amber-400 font-semibold">easytaciones</span>
          </div>

          <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-mono border border-emerald-500/30 bg-emerald-950/30 text-emerald-300">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              SUITE DE BASES & WIN RATE ACTIVA
            </span>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-mono border border-amber-500/30 bg-amber-950/30 text-amber-300">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
              NO-INDEX // ACCESO RESTRINGIDO
            </span>
          </div>
        </div>

        <div class="space-y-2">
          <h1 class="text-2xl sm:text-4xl lg:text-5xl font-display font-bold tracking-tight text-white flex flex-wrap items-center gap-3">
            <span>Easytaciones</span>
            <span class="text-slate-600">//</span>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-orange-300 to-amber-200">
              Radar Semántico & Suite de Adjudicación
            </span>
          </h1>
          <p class="max-w-4xl text-sm sm:text-base text-slate-300 leading-relaxed font-sans pt-1">
            Motor de procesamiento de lenguaje natural sobre <strong class="text-white">152 licitaciones informáticas reales</strong> de ChileCompra, integrado con <strong class="text-amber-300">Auditoría de Bases, Contraste de Requisitos Legales y Gestión de Equipo/CVs</strong> bajo las reglas de compras públicas de Chile.
          </p>
        </div>

      </div>
    </section>

    <!-- PANTALLA 1: DESBLOQUEO / AUTENTICACIÓN (Visible si no hay sesión) -->
    <section id="authGateSection" class="px-4 sm:px-6 lg:px-8 py-16 flex items-center justify-center">
      <div class="w-full max-w-md bg-canvas-subtle/80 backdrop-blur-md border border-canvas-border rounded-2xl p-6 sm:p-8 shadow-2xl space-y-6">
        
        <div class="space-y-2 text-center">
          <div class="w-12 h-12 mx-auto rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 text-xl">
            <Icon name="shield-lock" class="w-6 h-6" />
          </div>
          <h2 class="text-xl font-bold font-display text-white">Consola Privada Requerida</h2>
          <p class="text-xs text-slate-400 leading-relaxed">
            Ingresa la clave de acceso configurada en <code class="font-mono text-amber-300">EASYTACIONES_ACCESS_TOKEN</code> para desbloquear el radar.
          </p>
        </div>

        <form id="authForm" class="space-y-4">
          <div class="space-y-1.5">
            <label for="accessTokenInput" class="block text-xs font-mono text-slate-300">
              Clave o Token Secreto
            </label>
            <div class="relative">
              <input
                id="accessTokenInput"
                type="password"
                required
                autocomplete="current-password"
                placeholder="Ingresa tu clave..."
                class="w-full px-3.5 py-2.5 bg-canvas border border-canvas-border rounded-lg text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 font-mono transition-all pr-10"
              />
              <button
                type="button"
                id="btnTogglePassword"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-500 hover:text-slate-300 text-xs font-mono"
                aria-label="Mostrar u ocultar clave"
              >
                ver
              </button>
            </div>
          </div>

          <div id="authErrorMsg" class="hidden text-xs text-red-400 bg-red-950/40 border border-red-500/30 rounded-lg p-2.5 font-mono"></div>

          <button
            type="submit"
            id="btnSubmitAuth"
            class="w-full py-2.5 px-4 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-slate-950 font-semibold text-sm rounded-lg shadow-lg shadow-amber-500/20 transition-all flex items-center justify-center gap-2 cursor-pointer"
          >
            <span id="authBtnLabel">Desbloquear Consola</span>
          </button>
        </form>

        <div class="pt-2 border-t border-canvas-border/60 text-center">
          <span class="text-[11px] font-mono text-slate-500">
            Asegurado con HttpOnly Cookie · Sin fugas de API Ticket
          </span>
        </div>

      </div>
    </section>

    <!-- PANTALLA 2: WORKSPACE DE MATCHING & EVALUACIÓN (Oculto inicialmente) -->
    <div id="workspaceSection" class="hidden max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 space-y-8">
      
      <!-- Top Action Ribbon -->
      <div class="flex flex-wrap items-center justify-between gap-4 p-4 rounded-xl bg-canvas-subtle border border-canvas-border">
        <div class="flex flex-wrap items-center gap-3">
          <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-canvas border border-canvas-border text-xs font-mono">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span class="text-slate-300">Empresa:</span>
            <span id="profileNameDisplay" class="text-amber-400 font-semibold">Consultora TI</span>
          </div>

          <!-- Botón de Configuración de Empresa & CVs -->
          <button
            type="button"
            id="btnOpenProfileConfig"
            class="px-3 py-1.5 rounded-lg bg-canvas border border-canvas-border text-xs font-mono text-slate-300 hover:text-amber-300 hover:border-amber-400/50 transition-colors flex items-center gap-1.5 cursor-pointer"
            title="Ajustar empresa, nómina del equipo técnico y certificados/CVs"
          >
            <span>⚙ Perfil de Empresa & Equipo (CVs)</span>
            <span id="badgeTeamCount" class="px-1.5 py-0.2 rounded-full text-[10px] bg-emerald-950 text-emerald-300 border border-emerald-500/40">2 profesionales</span>
          </button>
        </div>

        <div class="flex items-center gap-2">
          <button
            type="button"
            id="btnSyncMercadoPublico"
            class="px-3 py-1.5 bg-canvas hover:bg-slate-800 border border-canvas-border rounded-lg text-xs font-mono text-slate-200 transition-colors flex items-center gap-2 cursor-pointer"
          >
            <span id="syncSpinner" class="inline-block transition-transform">↻</span>
            <span id="syncBtnLabel">Actualizar Catálogo</span>
          </button>

          <button
            type="button"
            id="btnLogout"
            class="px-3 py-1.5 bg-red-950/30 hover:bg-red-900/40 border border-red-500/30 rounded-lg text-xs font-mono text-red-300 transition-colors cursor-pointer"
          >
            Cerrar Sesión
          </button>
        </div>
      </div>

      <!-- KPI Strip -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="p-4 rounded-xl bg-canvas-subtle border border-canvas-border space-y-1">
          <span class="text-xs font-mono text-slate-400">Total Mercado Público</span>
          <div class="text-2xl font-bold font-display text-white" id="kpiTotalMP">4.791</div>
          <span class="text-[11px] text-slate-500 font-mono">Licitaciones en Chile</span>
        </div>

        <div class="p-4 rounded-xl bg-canvas-subtle border border-canvas-border space-y-1">
          <span class="text-xs font-mono text-slate-400">Licitaciones TI Reales</span>
          <div class="text-2xl font-bold font-display text-amber-400" id="kpiTotalTI">152</div>
          <span class="text-[11px] text-slate-500 font-mono" id="kpiLatency">Inferencia: -- ms</span>
        </div>

        <div class="p-4 rounded-xl bg-canvas-subtle border border-canvas-border space-y-1">
          <span class="text-xs font-mono text-slate-400">Alta Afinidad (&ge; 75%)</span>
          <div class="text-2xl font-bold font-display text-emerald-400" id="kpiHighMatch">--</div>
          <span class="text-[11px] text-slate-500 font-mono">Perfil óptimo para postular</span>
        </div>

        <div class="p-4 rounded-xl bg-canvas-subtle border border-canvas-border space-y-1">
          <span class="text-xs font-mono text-slate-400">Visibles con Filtro Actual</span>
          <div class="text-2xl font-bold font-display text-cyan-400" id="kpiVisibleCount">--</div>
          <span class="text-[11px] text-slate-500 font-mono" id="kpiMinScoreDisplay">Umbral: 50%</span>
        </div>
      </div>

      <!-- Control Box (Búsqueda Semántica & Presets) -->
      <div class="p-6 rounded-2xl bg-canvas-subtle border border-canvas-border space-y-6">
        
        <div class="space-y-3">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <label for="semanticQueryInput" class="text-sm font-semibold text-white flex items-center gap-2">
              <span class="text-amber-400">❖</span>
              <span>Perfil de Búsqueda Semántica o Requerimiento Técnico</span>
            </label>
            <span class="text-xs font-mono text-slate-400">Modelo: Paraphrase Multilingual MiniLM</span>
          </div>

          <div class="flex gap-2">
            <input
              id="semanticQueryInput"
              type="text"
              value="Desarrollo de software, plataformas web empresariales, arquitectura cloud AWS Azure GCP, bases de datos SQL Oracle, modelos de datos ODS, Business Intelligence y ciberseguridad"
              class="w-full px-4 py-3 bg-canvas border border-canvas-border rounded-xl text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 font-sans transition-all"
              placeholder="Ej: Auditoría de ciberseguridad, pentesting y ethical hacking..."
            />
            <button
              type="button"
              id="btnRunSearch"
              class="px-6 py-3 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-slate-950 font-bold text-sm rounded-xl shadow-lg shadow-amber-500/20 whitespace-nowrap transition-all cursor-pointer"
            >
              Recalcular Match
            </button>
          </div>
        </div>

        <!-- Presets rápidos por línea de solución -->
        <div class="space-y-2">
          <span class="text-xs font-mono text-slate-400">Líneas de Solución TI:</span>
          <div class="flex flex-wrap gap-2" id="presetChipsContainer">
            <button
              type="button"
              data-query="Desarrollo de plataformas y portales web empresariales, sistemas transaccionales, React Next.js Node.js TypeScript Python .NET Core Java Spring"
              data-score="50"
              class="preset-chip px-3 py-1.5 rounded-lg text-xs font-mono bg-canvas border border-canvas-border text-slate-300 hover:border-amber-400/50 hover:text-amber-300 transition-colors cursor-pointer"
            >
              Plataformas Web & ERP Cloud
            </button>
            <button
              type="button"
              data-query="Modelos de datos ODS Operational Data Store, administración de bases de datos SQL Server PostgreSQL Oracle Snowflake, tuberías ETL Data Factory y Business Intelligence"
              data-score="50"
              class="preset-chip px-3 py-1.5 rounded-lg text-xs font-mono bg-canvas border border-canvas-border text-slate-300 hover:border-amber-400/50 hover:text-amber-300 transition-colors cursor-pointer"
            >
              Modelos ODS, BD & BI
            </button>
            <button
              type="button"
              data-query="Hub de integración de sistemas y ecosistema de APIs REST, conectores ERP SAP Softland Oracle, CRM, facturación electrónica SII y modernización de legados"
              data-score="50"
              class="preset-chip px-3 py-1.5 rounded-lg text-xs font-mono bg-canvas border border-canvas-border text-slate-300 hover:border-amber-400/50 hover:text-amber-300 transition-colors cursor-pointer"
            >
              Hub APIs & Conector ERP
            </button>
            <button
              type="button"
              data-query="Infraestructura Multi-Cloud resiliente AWS ECS Lambda, Microsoft Azure App Services, Google Cloud GKE Kubernetes, contenedores Docker y DevOps CI/CD"
              data-score="50"
              class="preset-chip px-3 py-1.5 rounded-lg text-xs font-mono bg-canvas border border-canvas-border text-slate-300 hover:border-amber-400/50 hover:text-amber-300 transition-colors cursor-pointer"
            >
              Multi-Cloud (AWS / Azure / GCP)
            </button>
            <button
              type="button"
              data-query="Portal de tracking satelital, monitoreo GPS de flotas y cargas, visibilidad logística B2B, mapas interactivos y control de inventario"
              data-score="50"
              class="preset-chip px-3 py-1.5 rounded-lg text-xs font-mono bg-canvas border border-canvas-border text-slate-300 hover:border-amber-400/50 hover:text-amber-300 transition-colors cursor-pointer"
            >
              Tracking Satelital & Logística
            </button>
            <button
              type="button"
              data-query="Consultoría estratégica TI, auditoría de ciberseguridad OWASP, diagnóstico de deuda técnica, gobernanza de datos y planes de modernización"
              data-score="50"
              class="preset-chip px-3 py-1.5 rounded-lg text-xs font-mono bg-canvas border border-canvas-border text-slate-300 hover:border-amber-400/50 hover:text-amber-300 transition-colors cursor-pointer"
            >
              Consultoría & Gobernanza TI
            </button>
          </div>
        </div>

        <!-- Filtros de Categoría -->
        <div class="space-y-2 pt-2">
          <span class="text-xs font-mono text-slate-400">Filtrar por Categoría TI:</span>
          <div class="flex flex-wrap gap-2" id="categoryFilterContainer">
            <button type="button" data-cat="all" class="cat-pill active px-3 py-1 rounded-full text-xs font-mono bg-amber-400 text-slate-950 font-bold transition-all cursor-pointer">
              Todas (<span id="catCountAll">152</span>)
            </button>
            <button type="button" data-cat="software" class="cat-pill px-3 py-1 rounded-full text-xs font-mono bg-canvas border border-canvas-border text-slate-300 hover:text-white transition-all cursor-pointer">
              Software (<span id="catCountSoftware">0</span>)
            </button>
            <button type="button" data-cat="datos" class="cat-pill px-3 py-1 rounded-full text-xs font-mono bg-canvas border border-canvas-border text-slate-300 hover:text-white transition-all cursor-pointer">
              Datos & BI (<span id="catCountDatos">0</span>)
            </button>
            <button type="button" data-cat="ciberseguridad" class="cat-pill px-3 py-1 rounded-full text-xs font-mono bg-canvas border border-canvas-border text-slate-300 hover:text-white transition-all cursor-pointer">
              Ciberseguridad (<span id="catCountCiber">0</span>)
            </button>
            <button type="button" data-cat="hardware" class="cat-pill px-3 py-1 rounded-full text-xs font-mono bg-canvas border border-canvas-border text-slate-300 hover:text-white transition-all cursor-pointer">
              Hardware & Servidores (<span id="catCountHardware">0</span>)
            </button>
          </div>
        </div>

        <!-- Barra de filtros y slider de Score -->
        <div class="pt-4 border-t border-canvas-border flex flex-col md:flex-row items-stretch md:items-center justify-between gap-6">
          <div class="flex items-center gap-4 flex-1">
            <label for="scoreSlider" class="text-xs font-mono text-slate-300 whitespace-nowrap">
              Afinidad Mínima: <span id="sliderValueText" class="text-amber-400 font-bold">50%</span>
            </label>
            <input
              id="scoreSlider"
              type="range"
              min="0"
              max="95"
              step="5"
              value="50"
              class="w-full h-1.5 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-amber-400"
            />
          </div>

          <div class="flex items-center gap-3">
            <span class="text-xs font-mono text-slate-400">Ordenar por:</span>
            <select
              id="selectSort"
              class="bg-canvas border border-canvas-border rounded-lg px-3 py-1.5 text-xs font-mono text-slate-200 focus:outline-none focus:border-amber-400"
            >
              <option value="score_desc">Mayor Afinidad Semántica</option>
              <option value="monto_desc">Mayor Monto Estimado</option>
              <option value="cierre_asc">Cierre más Próximo</option>
            </select>
          </div>
        </div>

      </div>

      <!-- LISTADO DE LICITACIONES -->
      <section class="space-y-4">
        
        <div class="flex items-center justify-between">
          <h3 class="text-lg font-bold font-display text-white flex items-center gap-2">
            <span>Licitaciones Reales del Estado</span>
            <span id="resultsCountBadge" class="text-xs font-mono px-2 py-0.5 rounded-full bg-slate-800 text-slate-300 border border-slate-700">0</span>
          </h3>
          <span class="text-xs font-mono text-slate-400">Enlace directo a ficha ChileCompra</span>
        </div>

        <!-- Estado de Carga (Skeleton) -->
        <div id="loadingSkeleton" class="hidden space-y-4">
          <div class="p-6 rounded-xl bg-canvas-subtle border border-canvas-border animate-pulse space-y-3">
            <div class="h-4 bg-slate-800 rounded w-1/3"></div>
            <div class="h-6 bg-slate-800 rounded w-3/4"></div>
            <div class="h-3 bg-slate-800 rounded w-full"></div>
            <div class="h-3 bg-slate-800 rounded w-2/3"></div>
          </div>
          <div class="p-6 rounded-xl bg-canvas-subtle border border-canvas-border animate-pulse space-y-3">
            <div class="h-4 bg-slate-800 rounded w-1/4"></div>
            <div class="h-6 bg-slate-800 rounded w-2/3"></div>
            <div class="h-3 bg-slate-800 rounded w-full"></div>
          </div>
        </div>

        <!-- Estado Vacío -->
        <div id="emptyResultsState" class="hidden text-center py-12 p-6 rounded-2xl bg-canvas-subtle border border-canvas-border space-y-3">
          <div class="text-3xl text-slate-600">❖</div>
          <h4 class="text-base font-semibold text-white font-display">Sin licitaciones para el umbral o categoría actual</h4>
          <p class="text-xs text-slate-400 max-w-md mx-auto">
            Prueba reduciendo el slider de afinidad mínima a 0% o seleccionando "Todas".
          </p>
        </div>

        <!-- Contenedor de Tarjetas Renderizadas -->
        <div id="tendersContainer" class="space-y-4"></div>

      </section>

    </div>

    <!-- MODAL 1: DETALLE DE LICITACIÓN BÁSICO -->
    <div id="tenderModalBackdrop" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
      <div class="bg-canvas-subtle border border-canvas-border rounded-2xl max-w-2xl w-full max-h-[90vh] flex flex-col shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-150">
        
        <div class="p-5 border-b border-canvas-border flex items-start justify-between gap-4 bg-canvas">
          <div class="space-y-1">
            <div class="flex items-center gap-2">
              <span id="modalCodigo" class="text-xs font-mono px-2 py-0.5 rounded bg-slate-800 text-amber-300 border border-amber-500/30"></span>
              <span id="modalScoreBadge" class="text-xs font-mono font-bold px-2 py-0.5 rounded"></span>
            </div>
            <h3 id="modalTitulo" class="text-base font-bold text-white font-display"></h3>
          </div>
          <button
            type="button"
            id="btnCloseModal"
            class="text-slate-400 hover:text-white p-1 rounded-lg hover:bg-slate-800 transition-colors"
            aria-label="Cerrar modal"
          >
            ✕
          </button>
        </div>

        <div class="p-6 overflow-y-auto space-y-6 text-sm text-slate-300" id="modalBody">
          <!-- Inyectado dinámicamente -->
        </div>

        <div class="p-4 border-t border-canvas-border bg-canvas flex flex-wrap items-center justify-between gap-3">
          <a
            id="modalExternalLink"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-slate-950 font-semibold rounded-lg text-xs font-mono transition-colors"
          >
            Abrir Ficha en Mercado Público ↗
          </a>
          <button
            type="button"
            id="btnDismissModal"
            class="px-4 py-2 bg-canvas-border hover:bg-slate-700 text-slate-200 rounded-lg text-xs font-mono transition-colors"
          >
            Cerrar
          </button>
        </div>

      </div>
    </div>

    <!-- MODAL 2: SUITE DE AUDITORÍA DE BASES & WIN PROBABILITY (AVANZADA) -->
    <div id="evaluationSuiteModal" class="fixed inset-0 bg-black/85 backdrop-blur-md z-50 hidden flex items-center justify-center p-3 sm:p-5">
      <div class="bg-canvas-subtle border border-canvas-border rounded-2xl max-w-4xl w-full max-h-[92vh] flex flex-col shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-150">
        
        <!-- Header de la Suite -->
        <div class="p-5 border-b border-canvas-border bg-canvas flex items-start justify-between gap-4">
          <div class="space-y-1">
            <div class="flex items-center gap-2">
              <span class="text-xs font-mono px-2 py-0.5 rounded bg-emerald-950 text-emerald-300 border border-emerald-500/40 font-bold">
                SUITE DE ADJUDICACIÓN CHILECOMPRA
              </span>
              <span id="suiteModalCodigo" class="text-xs font-mono text-amber-300 px-2 py-0.5 rounded bg-slate-800"></span>
            </div>
            <h3 id="suiteModalTitulo" class="text-base sm:text-lg font-bold text-white font-display leading-tight"></h3>
            <span id="suiteModalOrganismo" class="text-xs font-mono text-slate-400 block"></span>
          </div>

          <button
            type="button"
            id="btnCloseSuiteModal"
            class="text-slate-400 hover:text-white p-1.5 rounded-lg hover:bg-slate-800 transition-colors"
            aria-label="Cerrar suite"
          >
            ✕
          </button>
        </div>

        <!-- Contenido Scrollable de la Suite -->
        <div class="p-6 overflow-y-auto space-y-6 text-sm text-slate-200" id="suiteModalBody">
          
          <!-- BANNER DE DICTAMEN & WIN PROBABILITY -->
          <div id="suiteDecisionBanner" class="p-5 rounded-2xl border transition-all flex flex-col sm:flex-row items-center justify-between gap-6">
            <div class="space-y-1 text-center sm:text-left">
              <span class="text-xs font-mono uppercase tracking-wider text-slate-400">Veredicto Estratégico de Postulación</span>
              <div id="suiteDecisionLabel" class="text-xl sm:text-2xl font-bold font-display"></div>
              <p id="suiteDecisionSub" class="text-xs text-slate-300 max-w-lg leading-relaxed"></p>
            </div>

