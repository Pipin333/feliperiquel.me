---
// src/pages/lab/index.astro
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';

interface Experiment {
  id?: string;
  title: string;
  tagline: string;
  description: string;
  tags: string[];
  href?: string;
  externalHref?: string;
  canonicalHref?: string;
  badge: string;
  badgeColor: string;
  isInteractive: boolean;
  isComingSoon?: boolean;
  comingSoonText?: string;
  icon: string;
  cardHoverClass?: string;
  iconColorClass?: string;
  taglineClass?: string;
  btnClass?: string;
  btnIconClass?: string;
  btnText?: string;
}

const experiments: Experiment[] = [
  {
    id: "retorica",
    title: "Retórica y Descalabro",
    tagline: "Transmutador Ontológico & Scriptorium Medieval",
    description: "Convierte modismos coloquiales, letras de música urbana y coplas populares en densos tratados ontológicos, correspondencia diplomática o culteranismo barroco. Motor dual heurístico y neuronal LLM con estética de fortaleza medieval.",
    tags: ["NLP Heurístico", "BYOK LLM", "Groq / Ollama", "Medieval Scriptorium"],
    href: "/lab/retorica",
    canonicalHref: "https://github.com/Pipin333/retorica-y-descalabro",
    badge: "Interactivo",
    badgeColor: "text-purple-300 border-purple-500/40 bg-purple-950/40",
    isInteractive: true,
    icon: "bank2",
    cardHoverClass: "group-hover:border-purple-500/50 hover:shadow-[0_0_25px_rgba(147,51,234,0.18)]",
    iconColorClass: "text-amber-400 group-hover:border-purple-500/50",
    taglineClass: "font-serif italic text-purple-300",
    btnClass: "text-amber-100 bg-gradient-to-r from-purple-800 via-purple-700 to-indigo-900 hover:from-purple-700 hover:to-indigo-800 border border-amber-400/40 shadow-[0_0_15px_rgba(147,51,234,0.25)]",
    btnIconClass: "text-amber-300"
  },
  {
    id: "sonicrip",
    title: "SonicRip",
    tagline: "Suite DSP, EQ de 8 Bandas & VFD Spectrum Analyzer",
    description: "Suite de audio en navegador con ecualizador paramétrico de 8 bandas (BiquadFilterNode), curvas de ecualización en tiempo real, distorsión Lo-Fi Bitcrusher, analizador de espectro segmentado VFD estilo Pioneer y generador de comandos por lotes para yt-dlp.",
    tags: ["Audio DSP", "VFD Matrix", "8-Band EQ", "Web Audio API"],
    href: "/lab/sonicrip",
    badge: "Interactivo",
    badgeColor: "text-cyan-300 border-cyan-500/40 bg-cyan-950/40",
    isInteractive: true,
    icon: "sliders",
    cardHoverClass: "group-hover:border-cyan-400/50 hover:shadow-[0_0_25px_rgba(6,182,212,0.22)]",
    iconColorClass: "text-cyan-400 group-hover:border-cyan-400/50",
    taglineClass: "font-mono text-cyan-300",
    btnClass: "text-slate-950 bg-gradient-to-r from-cyan-400 via-teal-300 to-cyan-400 hover:from-cyan-300 hover:to-teal-200 border border-cyan-200/50 shadow-[0_0_15px_rgba(6,182,212,0.35)]",
    btnIconClass: "text-slate-950"
  },
  {
    id: "copete",
    title: "Cuánto Rinde",
    tagline: "Optimizador Logístico & Presupuesto (Repo: calculadoracopete)",
    description: "Cálculo matemático de bebidas, destilados, hielo y mixers para juntas y eventos según perfil de consumo y duración. Desacoplándose como aplicación independiente con workers dedicados, privacidad y términos propios.",
    tags: ["Algoritmia", "Logística", "Presupuesto", "Workers"],
    href: "/lab/copete",
    canonicalHref: "https://github.com/Pipin333/calculadoracopete",
    badge: "En Preparación",
    badgeColor: "text-amber-300 border-amber-500/30 bg-amber-500/10",
    isInteractive: true,
    isComingSoon: true,
    comingSoonText: "Próximamente",
    icon: "cup-straw",
    cardHoverClass: "group-hover:border-domain-beer/40 hover:shadow-[0_0_25px_rgba(251,191,36,0.15)]",
    iconColorClass: "text-domain-beer group-hover:border-domain-beer/50",
    taglineClass: "font-mono text-amber-300",
    btnClass: "text-slate-900 bg-amber-400 hover:bg-amber-300 border border-amber-300 shadow-[0_0_15px_rgba(245,158,11,0.25)]",
    btnIconClass: "text-slate-900"
  },
  {
    id: "quiz",
    title: "Ni Idea",
    tagline: "Party Game: Trivia, That's You & Pinturillo",
    description: "Consola social multijugador para carretes y reuniones virtuales. Salas en tiempo real sobre Cloudflare Durable Objects, ruleta de modos rotativa y cero descargas.",
    tags: ["WebSockets", "Durable Objects", "PartyKit", "Multiplayer", "Canvas"],
    href: "/lab/quiz",
    canonicalHref: "https://github.com/Pipin333/niideaapp",
    badge: "Interactivo",
    badgeColor: "text-emerald-400 border-emerald-500/30 bg-emerald-950/40",
    isInteractive: true,
    isComingSoon: false,
    icon: "dice-5",
    cardHoverClass: "group-hover:border-emerald-500/50 hover:shadow-[0_0_25px_rgba(16,185,129,0.2)]",
    iconColorClass: "text-emerald-400 group-hover:border-emerald-500/50",
    taglineClass: "font-mono text-emerald-300",
    btnClass: "text-slate-950 bg-gradient-to-r from-emerald-400 to-teal-400 hover:from-emerald-300 hover:to-teal-300 border border-emerald-300/40 shadow-[0_0_15px_rgba(16,185,129,0.3)]",
    btnIconClass: "text-slate-950",
    btnText: "Abrir en vivo"
  },
  {
    title: "Toodles",
    tagline: "Motor de Audio en Discord & Recomendación Híbrida ML",
    description: "Bot de música en Discord con buffer de 3 niveles, streaming WebM/Opus directo vía FFmpeg (< 0.5% CPU en ARM64), extracción nativa yt-dlp y sistema de recomendación híbrido Implicit ALS + Item2Vec con persistencia de colas.",
    tags: ["Discord Bot", "Python (asyncio)", "RecSys ML", "FFmpeg Opus", "ARM64 Docker"],
    externalHref: "https://github.com/Pipin333/Toodles",
    badge: "Open Source",
    badgeColor: "text-domain-audio border-domain-audio/30 bg-domain-audio/10",
    isInteractive: false,
    icon: "music-note-beamed"
  },
  {
    title: "Whatsarr",
    tagline: "Puente en WhatsApp & Progressive Streamer para el *Arr Stack",
    description: "Integración conversacional multi-dispositivo (Baileys) para solicitar películas y series. Incluye Progressive Streamer que prioriza el Episodio 1 en qBittorrent, Fuzzball scorer y Dashboard Web para Plex, Radarr y Sonarr.",
    tags: ["Node.js", "Baileys", "Radarr/Sonarr", "Plex", "Web Dashboard"],
    externalHref: "https://github.com/Pipin333/Whatsarr",
    badge: "Open Source",
    badgeColor: "text-telemetry border-telemetry/30 bg-telemetry/10",
    isInteractive: false,
    icon: "film"
  },
  {
    title: "UniCalendar AI",
    tagline: "Planificador Académico con IA, Feriados y Simulador de Notas",
    description: "Ingiere sílabos universitarios en PDF o Canvas LMS, detecta feriados y semanas de receso institucional, simula calificaciones ponderadas ('¿cuánto necesito para pasar?') y sincroniza eventos con código de colores en Google Calendar.",
    tags: ["Next.js", "Canvas LMS", "Google Calendar OAuth", "Gemini / Groq", "SheetJS"],
    externalHref: "https://github.com/Pipin333/UniCalendar",
    badge: "Publicado",
    badgeColor: "text-domain-ai border-domain-ai/30 bg-domain-ai/10",
    isInteractive: false,
    icon: "calendar-event"
  },
  {
    title: "JD Watch Controller",
    tagline: "Controlador de Movimiento en Wear OS & Companion Android",
    description: "Controlador de código abierto para smartwatches Wear OS (Galaxy Watch / Pixel Watch). Fusión sensorial de 6 ejes a 50 Hz exactos, navegación por bisel rotativo con hápticos y curva de puntuación ponderada oficial para Just Dance.",
    tags: ["Wear OS", "Kotlin", "6-Axis IMU", "Bluetooth BLE", "WebSockets"],
    externalHref: "https://github.com/Pipin333/jd-watch-controller",
    badge: "Open Source",
    badgeColor: "text-telemetry border-telemetry/30 bg-telemetry/10",
    isInteractive: false,
    icon: "smartwatch"
  },
  {
    title: "AD-BSA",
    tagline: "Metaheurística Global Continua & Auditoría Científica",
    description: "Investigación exploratoria en optimización continua sobre L-SHADE/jSO: evaluación mecanicista de barreras repulsivas cosecantes, análisis de concentración de medida en 20D y auditoría del benchmark IEEE CEC 2020.",
    tags: ["Python", "Metaheurísticas", "Auditoría Científica", "L-SHADE / jSO", "SciPy"],
    externalHref: "https://github.com/Pipin333/AD-BSA",
    badge: "Investigación",
    badgeColor: "text-domain-algo border-domain-algo/30 bg-domain-algo/10",
    isInteractive: false,
    icon: "diagram-3"
  }
];
---

<Layout
  title="El Laboratorio | Felipe Riquelme"
  description="Playground interactivo de herramientas experimentales, procesamiento de lenguaje natural, modelos logísticos y proyectos de código abierto de Felipe Riquelme."
>
  <Header />

  <main id="main-content" class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 font-mono text-xs text-slate-400 mb-8" aria-label="Ruta de navegación">
      <a href="/" class="hover:text-white transition-colors">Inicio</a>
      <span aria-hidden="true">/</span>
      <span class="text-telemetry font-medium" aria-current="page">Laboratorio</span>
    </nav>

    <!-- Lab Hero -->
    <header class="max-w-3xl mb-14">
      <h1 class="text-4xl sm:text-5xl font-display font-extrabold tracking-tight text-white mb-4">
        Herramientas, algoritmos y código no convencional.
      </h1>
      <p class="text-sm sm:text-base text-slate-300 leading-relaxed font-sans">
        Un espacio de experimentación activa donde convergen modelos de procesamiento de lenguaje natural, optimización matemática práctica, integraciones de hardware y utilidades cotidianas.
      </p>
    </header>

    <!-- Active Interactive Section -->
    <section class="mb-16" aria-labelledby="interactive-heading">
      <div class="flex items-center justify-between gap-4 mb-8 pb-3 border-b border-canvas-border">
        <div>
          <h2 id="interactive-heading" class="text-2xl font-display font-bold text-white tracking-tight flex items-center gap-2.5">
            <Icon name="lightning-charge" class="w-5 h-5 text-telemetry" />
            <span>Herramientas Interactivas en Vivo</span>
          </h2>
          <p class="font-mono text-xs text-slate-400 mt-1">
            Aplicaciones cliente ejecutables de inmediato desde el navegador sin instalación.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {experiments.filter(e => e.isInteractive).map((exp) => (
          <article class={`spotlight-card group p-7 flex flex-col justify-between relative overflow-hidden transition-all duration-200 ${exp.cardHoverClass ?? ''}`}>
            <!-- Auras ambientales tenues en esquina superior -->
            {exp.id === "retorica" && (
              <div class="absolute -top-12 -right-12 w-44 h-44 bg-purple-600/10 rounded-full blur-2xl pointer-events-none group-hover:bg-purple-600/20 transition-all duration-300"></div>
            )}
            {exp.id === "copete" && (
              <div class="absolute -top-12 -right-12 w-44 h-44 bg-amber-500/10 rounded-full blur-2xl pointer-events-none group-hover:bg-amber-500/20 transition-all duration-300"></div>
            )}
            {exp.id === "sonicrip" && (
              <div class="absolute -top-12 -right-12 w-44 h-44 bg-cyan-500/10 rounded-full blur-2xl pointer-events-none group-hover:bg-cyan-500/20 transition-all duration-300"></div>
            )}
            {exp.id === "quiz" && (
              <div class="absolute -top-12 -right-12 w-44 h-44 bg-indigo-600/10 rounded-full blur-2xl pointer-events-none group-hover:bg-indigo-600/20 transition-all duration-300"></div>
            )}

            <!-- Marcas de Agua Técnicas a Toda la Altura (Sección Transversal / Blueprint Industrial) cortadas al 50% en el borde derecho -->
            {exp.id === "retorica" && (
              <svg class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-[46%] group-hover:translate-x-[40%] h-[115%] w-[280px] pointer-events-none select-none z-0 text-purple-400 opacity-[0.07] group-hover:opacity-[0.22] transition-all duration-300" viewBox="0 0 240 420" fill="none" stroke="currentColor">
                <!-- Eje de cancillería vertical milimetrado con cotas -->
                <line x1="120" y1="10" x2="120" y2="410" stroke-width="0.75" stroke-dasharray="3,3" class="text-purple-300/40" />
                <line x1="10" y1="210" x2="230" y2="210" stroke-width="0.75" stroke-dasharray="3,3" class="text-amber-400/40" />
                
                <!-- Círculos de cota concéntricos mayores -->
                <circle cx="120" cy="210" r="140" stroke-width="0.5" stroke-dasharray="4,6" class="text-purple-500/30" />
                <circle cx="120" cy="210" r="95" stroke-width="0.75" stroke-dasharray="2,4" class="text-amber-400/40" />
                
                <!-- Flor de Lis Monumental a Gran Altura -->
                <g transform="translate(120, 210) scale(1.6)">
                  <path d="M0,-85 C6,-50 20,-30 20,-5 C12,-8 -2,-8 -8,-5 C-8,-30 -2,-50 0,-85 Z" stroke-width="1.25" class="text-amber-400" />
                  <path d="M-8,-5 C-25,-12 -50,-18 -52,4 C-55,26 -28,32 -14,12 C-12,8 -9,3 -8,-5 Z" stroke-width="1" class="text-purple-300" />
                  <path d="M20,-5 C37,-12 62,-18 64,4 C67,26 40,32 26,12 C24,8 21,3 20,-5 Z" stroke-width="1" class="text-purple-300" />
                  <path d="M-30,4 L38,4 L35,16 L-27,16 Z" stroke-width="1.25" class="text-amber-400" />
                  <circle cx="4" cy="10" r="2.5" fill="currentColor" class="text-amber-300" />
                  <path d="M-10,16 C-7,34 4,46 4,46 C4,46 15,34 18,16 Z" stroke-width="1" class="text-purple-300" />
                </g>

                <!-- Anotaciones técnicas y cotas de ingeniería renacentista -->
                <line x1="20" y1="65" x2="105" y2="65" stroke-width="0.75" class="text-amber-400/50" />
                <text x="22" y="58" font-family="monospace" font-size="8" fill="currentColor" class="text-amber-300/70">FIG. I — FLOS LILII MAGNA</text>
                <text x="22" y="77" font-family="monospace" font-size="7" fill="currentColor" class="text-purple-300/50">R=140mm • RADIALIS</text>
                <text x="22" y="375" font-family="monospace" font-size="7.5" fill="currentColor" class="text-amber-400/60">SCRIPTIRIUM • ANNO 1888</text>
                <text x="22" y="390" font-family="monospace" font-size="6.5" fill="currentColor" class="text-purple-300/40">DIPLOMATICA IMPERIALIS</text>
              </svg>
            )}

            {exp.id === "copete" && (
              <svg class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-[46%] group-hover:translate-x-[40%] h-[115%] w-[280px] pointer-events-none select-none z-0 text-amber-400 opacity-[0.07] group-hover:opacity-[0.22] transition-all duration-300" viewBox="0 0 240 420" fill="none" stroke="currentColor">
                <!-- Eje central de dosificación vertical -->
                <line x1="120" y1="15" x2="120" y2="405" stroke-width="0.75" stroke-dasharray="3,3" class="text-amber-500/40" />

                <!-- Gran Vaso Técnico / Highball a toda la altura -->
                <ellipse cx="120" cy="45" rx="65" ry="9" stroke-width="1.25" class="text-yellow-300" />
                <ellipse cx="120" cy="45" rx="55" ry="7" stroke-width="0.75" stroke-dasharray="2,2" class="text-amber-500/40" />
                
                <path d="M55,45 L72,365 Q74,375 88,375 L152,375 Q166,375 168,365 L185,45" stroke-width="1.5" />
                <ellipse cx="120" cy="375" rx="36" ry="6" stroke-width="1" class="text-amber-400" />
                <path d="M72,365 L76,345 L164,345 L168,365" stroke-width="0.75" class="text-yellow-300/40" />

                <!-- Líneas de nivel graduadas (ml / oz) -->
                <g class="text-yellow-300/70">
                  <line x1="60" y1="105" x2="180" y2="105" stroke-width="1" />
                  <text x="25" y="108" font-family="monospace" font-size="7.5" fill="currentColor">500ml</text>
                  
                  <line x1="63" y1="165" x2="177" y2="165" stroke-width="0.75" stroke-dasharray="3,2" />
                  <text x="25" y="168" font-family="monospace" font-size="7.5" fill="currentColor">375ml</text>

                  <line x1="66" y1="225" x2="174" y2="225" stroke-width="0.75" stroke-dasharray="3,2" />
                  <text x="25" y="228" font-family="monospace" font-size="7.5" fill="currentColor">250ml</text>

                  <line x1="69" y1="285" x2="171" y2="285" stroke-width="0.75" stroke-dasharray="3,2" />
                  <text x="25" y="288" font-family="monospace" font-size="7.5" fill="currentColor">125ml</text>
                </g>

                <!-- Cubos de hielo axonométricos en flotación -->
                <g transform="translate(90, 115) scale(1.3)" class="text-yellow-200/50">
                  <polygon points="12,0 30,-8 42,0 24,8" stroke-width="0.75" />
                  <polygon points="12,0 24,8 24,24 12,16" stroke-width="0.75" />
                  <polygon points="24,8 42,0 42,16 24,24" stroke-width="0.75" />
                </g>

                <!-- Cotas de ingeniería exterior -->
                <line x1="198" y1="45" x2="198" y2="375" stroke-width="0.75" class="text-amber-300/60" />
                <line x1="192" y1="45" x2="204" y2="45" stroke-width="0.75" />
                <line x1="192" y1="375" x2="204" y2="375" stroke-width="0.75" />
                <text x="204" y="215" font-family="monospace" font-size="7.5" fill="currentColor" class="text-amber-300/70">H=330mm</text>
                
                <text x="20" y="365" font-family="monospace" font-size="7" fill="currentColor" class="text-amber-400/60">SPEC 04 • VOLUMETRIA</text>
                <text x="20" y="380" font-family="monospace" font-size="6.5" fill="currentColor" class="text-amber-500/40">ISO 3819 • STANDARD</text>
              </svg>
            )}

            {exp.id === "sonicrip" && (
              <svg class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-[46%] group-hover:translate-x-[40%] h-[115%] w-[280px] pointer-events-none select-none z-0 text-cyan-400 opacity-[0.07] group-hover:opacity-[0.22] transition-all duration-300" viewBox="0 0 240 420" fill="none" stroke="currentColor">
                <!-- Eje central acústico -->
                <line x1="120" y1="10" x2="120" y2="410" stroke-width="0.75" stroke-dasharray="3,3" class="text-cyan-500/30" />

                <!-- Diadema de Estudio Superior (arco completo con muescas de ajuste) -->
                <path d="M30,130 C30,35 210,35 210,130" stroke-width="2" class="text-cyan-300" />
                <path d="M42,130 C42,48 198,48 198,130" stroke-width="0.75" stroke-dasharray="3,2" class="text-teal-400/40" />
                <path d="M70,55 C90,48 150,48 170,55" stroke-width="4" class="text-cyan-500/30" />
                <line x1="50" y1="85" x2="58" y2="88" stroke-width="0.75" />
                <line x1="45" y1="95" x2="53" y2="98" stroke-width="0.75" />
                <line x1="41" y1="105" x2="49" y2="108" stroke-width="0.75" />

                <!-- Gran Cápsula Acústica / Auricular de Monitoreo en Sección Técnica -->
                <g transform="translate(120, 205)">
                  <path d="M-85,-20 L-65,-20 L-65,20 L-85,20" stroke-width="1.25" class="text-cyan-200" />
                  <circle cx="0" cy="0" r="68" stroke-width="1.5" class="text-cyan-300" />
                  <circle cx="0" cy="0" r="54" stroke-width="0.75" stroke-dasharray="3,3" class="text-teal-300/50" />
                  <circle cx="0" cy="0" r="38" stroke-width="1" class="text-cyan-400" />
                  <circle cx="0" cy="0" r="22" stroke-width="1.25" class="text-teal-200" />
                  <circle cx="0" cy="0" r="8" fill="currentColor" class="text-cyan-300" />
                  <circle cx="0" cy="0" r="62" stroke-width="0.5" stroke-dasharray="1,4" />
                </g>

                <!-- Mesa de mezclas: Fader vertical con escala en dB al pie -->
                <g transform="translate(60, 315)">
                  <rect x="0" y="0" width="70" height="75" rx="6" stroke-width="1" class="text-cyan-400/50" />
                  <line x1="35" y1="10" x2="35" y2="65" stroke-width="1.5" class="text-cyan-300" />
                  <rect x="25" y="28" width="20" height="12" rx="2" stroke-width="1.25" class="text-cyan-200" />
                  <line x1="25" y1="34" x2="45" y2="34" stroke-width="1" class="text-cyan-950" />
                  <line x1="12" y1="12" x2="20" y2="12" stroke-width="0.75" />
                  <text x="4" y="14" font-family="monospace" font-size="6" fill="currentColor">+6</text>
                  <line x1="12" y1="34" x2="20" y2="34" stroke-width="1" class="text-cyan-300" />
                  <text x="4" y="36" font-family="monospace" font-size="6" fill="currentColor">0dB</text>
                  <line x1="12" y1="50" x2="20" y2="50" stroke-width="0.75" />
                  <text x="4" y="52" font-family="monospace" font-size="6" fill="currentColor">-10</text>
                  <line x1="12" y1="63" x2="20" y2="63" stroke-width="0.75" />
                  <text x="4" y="65" font-family="monospace" font-size="6" fill="currentColor">-∞</text>
                </g>

                <!-- Anotaciones de ingeniería acústica -->
                <text x="20" y="398" font-family="monospace" font-size="7.5" fill="currentColor" class="text-cyan-300/60">Ø 50mm TITANIUM DRIVER</text>
                <text x="20" y="410" font-family="monospace" font-size="6.5" fill="currentColor" class="text-cyan-400/40">32Ω • 98dB/mW • STUDIO REF</text>
              </svg>
            )}

            {exp.id === "quiz" && (
              <svg class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-[46%] group-hover:translate-x-[40%] h-[115%] w-[280px] pointer-events-none select-none z-0 text-emerald-400 opacity-[0.07] group-hover:opacity-[0.22] transition-all duration-300" viewBox="0 0 240 420" fill="none" stroke="currentColor">
                <!-- Eje vertical punteado de ruleta -->
                <line x1="120" y1="15" x2="120" y2="405" stroke-width="0.75" stroke-dasharray="3,3" class="text-emerald-500/30" />

                <!-- Gran Ruleta de Casino Técnica a toda la altura -->
                <circle cx="120" cy="150" r="85" stroke-width="1.5" class="text-emerald-300" />
                <circle cx="120" cy="150" r="70" stroke-width="0.75" stroke-dasharray="4,4" class="text-emerald-400/50" />
                <circle cx="120" cy="150" r="35" stroke-width="1.25" class="text-teal-200" />
                <circle cx="120" cy="150" r="8" fill="currentColor" class="text-emerald-300" />

                <!-- Rayos / Divisiones de la Ruleta -->
                <line x1="120" y1="65" x2="120" y2="235" stroke-width="0.75" class="text-emerald-500/40" />
                <line x1="35" y1="150" x2="205" y2="150" stroke-width="0.75" class="text-emerald-500/40" />
                <line x1="60" y1="90" x2="180" y2="210" stroke-width="0.75" class="text-emerald-500/30" />
                <line x1="60" y1="210" x2="180" y2="90" stroke-width="0.75" class="text-emerald-500/30" />

                <!-- Dado Isométrico al pie -->
                <g transform="translate(60, 275)" class="text-emerald-300">
                  <polygon points="35,0 70,18 35,36 0,18" stroke-width="1.25" />
                  <polygon points="0,18 35,36 35,72 0,54" stroke-width="1.25" />
                  <polygon points="35,36 70,18 70,54 35,72" stroke-width="1.25" />
                  <!-- Puntos del dado -->
                  <circle cx="35" cy="18" r="3" fill="currentColor" />
                  <circle cx="16" cy="38" r="2.5" fill="currentColor" class="text-teal-200" />
                  <circle cx="20" cy="52" r="2.5" fill="currentColor" class="text-teal-200" />
                  <circle cx="50" cy="38" r="2.5" fill="currentColor" class="text-teal-200" />
                  <circle cx="54" cy="52" r="2.5" fill="currentColor" class="text-teal-200" />
                </g>

                <!-- Anotaciones de arquitectura de fiesta -->
                <text x="20" y="380" font-family="monospace" font-size="7.5" fill="currentColor" class="text-emerald-300/70">SPEC 05 • PARTY ROULETTE</text>
                <text x="20" y="395" font-family="monospace" font-size="6.5" fill="currentColor" class="text-emerald-400/50">DURABLE OBJECTS • LATENCY &lt; 20ms</text>
                <text x="20" y="408" font-family="monospace" font-size="6.5" fill="currentColor" class="text-teal-300/40">SANTIAGO SCL • ZERO-LOGINS</text>
              </svg>
            )}

            <!-- Contenido Frontal de la Tarjeta (Garantiza WCAG AA) -->
            <div class="relative z-10 flex flex-col justify-between h-full">
              <div>
                <div class="flex items-center justify-between gap-3 mb-4">
                  <div class={`w-10 h-10 rounded-tech bg-canvas border border-canvas-border flex items-center justify-center transition-colors ${exp.iconColorClass ?? 'text-telemetry group-hover:border-telemetry/50'}`}>
                    <Icon name={exp.icon} class="w-5 h-5" />
                  </div>
                  <span class={`font-mono text-[11px] px-2.5 py-0.5 rounded-tech-sm font-semibold border ${exp.badgeColor}`}>
                    {exp.badge}
                  </span>
                </div>
                <h3 class="text-xl font-display font-bold text-white mb-1 group-hover:text-telemetry transition-colors">
                  {exp.title}
                </h3>
                <p class={`text-xs mb-3 ${exp.taglineClass ?? 'font-mono text-slate-400'}`}>
                  {exp.tagline}
                </p>
                <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-6 font-sans">
                  {exp.description}
                </p>
              </div>

              <div>
                <div class="flex flex-wrap gap-1.5 mb-5">
                  {exp.tags.map((tag) => (
                    <span class="font-mono text-[11px] px-2 py-0.5 rounded-tech-sm bg-canvas/90 text-slate-300 border border-canvas-border">
                      {tag}
                    </span>
                  ))}
                </div>
                <div class="flex items-center gap-2">
                  {exp.isComingSoon ? (
                    <button
                      type="button"
                      disabled
                      class="flex-1 inline-flex items-center justify-center px-3.5 py-2.5 rounded-tech font-mono text-xs font-semibold text-slate-400 bg-canvas-surface/90 border border-canvas-border cursor-not-allowed opacity-80 select-none transition-colors"
                      title="Esta herramienta se encuentra actualmente en desarrollo y preparación técnica."
                    >
                      <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse mr-2 shrink-0"></span>
                      <span>{exp.comingSoonText ?? "Próximamente"}</span>
                    </button>
                  ) : (
                    <a
                      href={exp.href}
                      class={`flex-1 inline-flex items-center justify-center px-3.5 py-2.5 rounded-tech font-mono text-xs font-bold transition-all duration-140 group/btn ${exp.btnClass ?? 'text-telemetry-dark bg-telemetry hover:bg-telemetry-hover shadow-glow-cyan'}`}
                    >
                      <span>{exp.btnText ?? "Abrir en vivo"}</span>
                      <svg class={`w-3.5 h-3.5 ml-1 transition-transform duration-140 group-hover/btn:translate-x-0.5 ${exp.btnIconClass ?? ''}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                      </svg>
                    </a>
                  )}
                  {exp.canonicalHref && (
                    <a
                      href={exp.canonicalHref}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 px-3 py-2.5 rounded-tech font-mono text-xs font-medium text-slate-300 hover:text-white bg-canvas-surface border border-canvas-border hover:border-telemetry transition-colors"
                      title={`Ver versión canónica / repositorio de ${exp.title} en GitHub`}
                      aria-label={`Ver repositorio de ${exp.title} en GitHub`}
                    >
                      <svg class="w-3.5 h-3.5 text-slate-300" fill="currentColor" viewBox="0 0 24 24">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                      </svg>
                      <span>Repo</span>
                      <svg class="w-3 h-3 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </a>
                  )}
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Lab Ecosystem & Research -->
    <section aria-labelledby="ecosystem-heading">
      <div class="flex items-center justify-between gap-4 mb-8 pb-3 border-b border-canvas-border">
        <div>
          <h2 id="ecosystem-heading" class="text-2xl font-display font-bold text-white tracking-tight flex items-center gap-2.5">
            <Icon name="cpu" class="w-5 h-5 text-domain-audio" />
            <span>Ecosistema de Proyectos & Homelab</span>
          </h2>
          <p class="font-mono text-xs text-slate-400 mt-1">
            Investigaciones, arquitecturas de backend y herramientas distribuidas de código abierto.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {experiments.filter(e => !e.isInteractive).map((exp, index) => (
          <article class={`spotlight-card group p-6 flex flex-col justify-between relative ${index === 3 && experiments.filter(e => !e.isInteractive).length % 3 !== 0 ? '' : ''}`}>
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <div class="w-9 h-9 rounded-tech bg-canvas border border-canvas-border flex items-center justify-center text-slate-300 group-hover:text-telemetry group-hover:border-telemetry/50 transition-colors">
                  <Icon name={exp.icon} class="w-4 h-4" />
                </div>
                <span class={`font-mono text-[10px] px-2 py-0.5 rounded-tech-sm font-semibold border ${exp.badgeColor}`}>
                  {exp.badge}
                </span>
              </div>
              <h3 class="text-lg font-display font-bold text-white mb-1 group-hover:text-telemetry transition-colors">
                {exp.title}
              </h3>
              <p class="font-mono text-xs text-slate-400 mb-2.5">
                {exp.tagline}
              </p>
              <p class="text-xs text-slate-300 leading-relaxed mb-4 font-sans">
                {exp.description}
              </p>
            </div>

            <div>
              <div class="flex flex-wrap gap-1.5 mb-4">
                {exp.tags.map((tag) => (
                  <span class="font-mono text-[10px] px-2 py-0.5 rounded-tech-sm bg-canvas text-slate-400 border border-canvas-border">
                    {tag}
                  </span>
                ))}
              </div>

              {exp.externalHref ? (
                <a
                  href={exp.externalHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center font-mono text-xs font-semibold text-telemetry hover:text-white transition-colors"
                >
                  <span>Ver repositorio en GitHub</span>
                  <svg class="w-3.5 h-3.5 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              ) : (
                <span class="font-mono text-xs text-slate-500 italic">Próximamente disponible</span>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
