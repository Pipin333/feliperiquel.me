---
// src/pages/lab/index.astro
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';

interface Experiment {
  title: string;
  tagline: string;
  description: string;
  tags: string[];
  href?: string;
  externalHref?: string;
  canonicalHref?: string;
  badge: string;
  badgeColor: string;
  isInteractive: boolean;
  icon: string;
  cardHoverClass?: string;
  iconColorClass?: string;
  taglineClass?: string;
  btnClass?: string;
  btnIconClass?: string;
}

const experiments: Experiment[] = [
  {
    title: "Retórica y Descalabro",
    tagline: "Transmutador Ontológico & Scriptorium Medieval",
    description: "Convierte modismos coloquiales, letras de música urbana y coplas populares en densos tratados ontológicos, correspondencia diplomática o culteranismo barroco. Motor dual heurístico y neuronal LLM con estética de fortaleza medieval.",
    tags: ["NLP Heurístico", "BYOK LLM", "Groq / Ollama", "Medieval Scriptorium"],
    href: "/lab/retorica",
    canonicalHref: "https://github.com/Pipin333/retorica-y-descalabro",
    badge: "Interactivo",
    badgeColor: "text-purple-300 border-purple-500/40 bg-purple-950/40",
    isInteractive: true,
    icon: "bank2",
    cardHoverClass: "group-hover:border-purple-500/50 hover:shadow-[0_0_25px_rgba(147,51,234,0.18)]",
    iconColorClass: "text-amber-400 group-hover:border-purple-500/50",
    taglineClass: "font-serif italic text-purple-300",
    btnClass: "text-amber-100 bg-gradient-to-r from-purple-800 via-purple-700 to-indigo-900 hover:from-purple-700 hover:to-indigo-800 border border-amber-400/40 shadow-[0_0_15px_rgba(147,51,234,0.25)]",
    btnIconClass: "text-amber-300"
  },
  {
    title: "Cuánto Rinde",
    tagline: "Optimizador Logístico & Presupuesto (Repo: calculadoracopete)",
    description: "Cálculo matemático de bebidas, destilados, hielo y mixers para juntas y carretes según perfil de consumo y duración. Desglose en botellas reales, cuota por persona en pesos chilenos ($ CLP) y exportación limpia para WhatsApp (repositorio: calculadoracopete).",
    tags: ["Algoritmia", "Logística", "Presupuesto", "CLP"],
    href: "/lab/copete",
    canonicalHref: "https://github.com/Pipin333/calculadoracopete",
    badge: "Interactivo",
    badgeColor: "text-domain-beer border-domain-beer/30 bg-domain-beer/10",
    isInteractive: true,
    icon: "cup-straw"
  },
  {
    title: "SonicRip",
    tagline: "Suite DSP, EQ de 8 Bandas & VFD Spectrum Analyzer",
    description: "Suite de audio en navegador con ecualizador paramétrico de 8 bandas (BiquadFilterNode), curvas de ecualización en tiempo real, distorsión Lo-Fi Bitcrusher, analizador de espectro segmentado VFD estilo Pioneer y generador de comandos por lotes para yt-dlp.",
    tags: ["Audio DSP", "VFD Matrix", "8-Band EQ", "Web Audio API"],
    href: "/lab/sonicrip",
    badge: "Interactivo",
    badgeColor: "text-cyan-300 border-cyan-500/40 bg-cyan-950/40",
    isInteractive: true,
    icon: "sliders",
    cardHoverClass: "group-hover:border-cyan-400/50 hover:shadow-[0_0_25px_rgba(6,182,212,0.22)]",
    iconColorClass: "text-cyan-400 group-hover:border-cyan-400/50",
    taglineClass: "font-mono text-cyan-300",
    btnClass: "text-slate-950 bg-gradient-to-r from-cyan-400 via-teal-300 to-cyan-400 hover:from-cyan-300 hover:to-teal-200 border border-cyan-200/50 shadow-[0_0_15px_rgba(6,182,212,0.35)]",
    btnIconClass: "text-slate-950"
  },
  {
    title: "Toodles",
    tagline: "Motor de Audio en Discord & Recomendación Híbrida ML",
    description: "Bot de música en Discord con buffer de 3 niveles, streaming WebM/Opus directo vía FFmpeg (< 0.5% CPU en ARM64), extracción nativa yt-dlp y sistema de recomendación híbrido Implicit ALS + Item2Vec con persistencia de colas.",
    tags: ["Discord Bot", "Python (asyncio)", "RecSys ML", "FFmpeg Opus", "ARM64 Docker"],
    externalHref: "https://github.com/Pipin333/Toodles",
    badge: "Open Source",
    badgeColor: "text-domain-audio border-domain-audio/30 bg-domain-audio/10",
    isInteractive: false,
    icon: "music-note-beamed"
  },
  {
    title: "Whatsarr",
    tagline: "Puente en WhatsApp & Progressive Streamer para el *Arr Stack",
    description: "Integración conversacional multi-dispositivo (Baileys) para solicitar películas y series. Incluye Progressive Streamer que prioriza el Episodio 1 en qBittorrent, Fuzzball scorer y Dashboard Web para Plex, Radarr y Sonarr.",
    tags: ["Node.js", "Baileys", "Radarr/Sonarr", "Plex", "Web Dashboard"],
    externalHref: "https://github.com/Pipin333/Whatsarr",
    badge: "Open Source",
    badgeColor: "text-telemetry border-telemetry/30 bg-telemetry/10",
    isInteractive: false,
    icon: "film"
  },
  {
    title: "UniCalendar AI",
    tagline: "Planificador Académico con IA, Feriados y Simulador de Notas",
    description: "Ingiere sílabos universitarios en PDF o Canvas LMS, detecta feriados y semanas de receso institucional, simula calificaciones ponderadas ('¿cuánto necesito para pasar?') y sincroniza eventos con código de colores en Google Calendar.",
    tags: ["Next.js", "Canvas LMS", "Google Calendar OAuth", "Gemini / Groq", "SheetJS"],
    externalHref: "https://github.com/Pipin333/UniCalendar",
    badge: "Publicado",
    badgeColor: "text-domain-ai border-domain-ai/30 bg-domain-ai/10",
    isInteractive: false,
    icon: "calendar-event"
  },
  {
    title: "JD Watch Controller",
    tagline: "Controlador de Movimiento en Wear OS & Companion Android",
    description: "Controlador de código abierto para smartwatches Wear OS (Galaxy Watch / Pixel Watch). Fusión sensorial de 6 ejes a 50 Hz exactos, navegación por bisel rotativo con hápticos y curva de puntuación ponderada oficial para Just Dance.",
    tags: ["Wear OS", "Kotlin", "6-Axis IMU", "Bluetooth BLE", "WebSockets"],
    externalHref: "https://github.com/Pipin333/jd-watch-controller",
    badge: "Open Source",
    badgeColor: "text-telemetry border-telemetry/30 bg-telemetry/10",
    isInteractive: false,
    icon: "smartwatch"
  },
  {
    title: "AD-BSA",
    tagline: "Metaheurística Global Continua (Rank #1 en IEEE CEC 2020)",
    description: "Algoritmo evolutivo basado en aprendizaje negativo explícito (Anti-Attractors) con barreras de repulsión cosecante acotadas. Evaluado sobre el benchmark formal IEEE CEC 2020 en 50 dimensiones, empatando en el primer lugar con CMA-ES.",
    tags: ["Python", "Metaheurísticas", "IEEE CEC 2020", "Optimización Continua", "SciPy"],
    externalHref: "https://github.com/Pipin333/AD-BSA",
    badge: "Research",
    badgeColor: "text-domain-algo border-domain-algo/30 bg-domain-algo/10",
    isInteractive: false,
    icon: "diagram-3"
  }
];
---

<Layout
  title="El Laboratorio | Felipe Riquelme"
  description="Playground interactivo de herramientas experimentales, procesamiento de lenguaje natural, modelos logísticos y proyectos de código abierto de Felipe Riquelme."
>
  <Header />

  <main id="main-content" class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 font-mono text-xs text-slate-400 mb-8" aria-label="Ruta de navegación">
      <a href="/" class="hover:text-white transition-colors">Inicio</a>
      <span aria-hidden="true">/</span>
      <span class="text-telemetry font-medium" aria-current="page">Laboratorio</span>
    </nav>

    <!-- Lab Hero -->
    <header class="max-w-3xl mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-tech border border-canvas-border bg-canvas-surface text-telemetry font-mono text-xs uppercase tracking-wider mb-4">
        <Icon name="flask" class="w-3.5 h-3.5" />
        <span>The Playground & Lab</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-display font-extrabold tracking-tight text-white mb-4">
        Herramientas, algoritmos y código no convencional.
      </h1>
      <p class="text-sm sm:text-base text-slate-300 leading-relaxed font-sans">
        Un espacio de experimentación activa donde convergen modelos de procesamiento de lenguaje natural, optimización matemática práctica, integraciones de hardware y utilidades cotidianas.
      </p>
    </header>

    <!-- Active Interactive Section -->
    <section class="mb-16" aria-labelledby="interactive-heading">
      <div class="flex items-center justify-between gap-4 mb-8 pb-3 border-b border-canvas-border">
        <div>
          <h2 id="interactive-heading" class="text-2xl font-display font-bold text-white tracking-tight flex items-center gap-2.5">
            <Icon name="lightning-charge" class="w-5 h-5 text-telemetry" />
            <span>Herramientas Interactivas en Vivo</span>
          </h2>
          <p class="font-mono text-xs text-slate-400 mt-1">
            Aplicaciones cliente ejecutables de inmediato desde el navegador sin instalación.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {experiments.filter(e => e.isInteractive).map((exp) => (
          <article class={`spotlight-card group p-7 flex flex-col justify-between relative transition-all duration-200 ${exp.cardHoverClass ?? ''}`}>
            <div>
              <div class="flex items-center justify-between gap-3 mb-4">
                <div class={`w-10 h-10 rounded-tech bg-canvas border border-canvas-border flex items-center justify-center transition-colors ${exp.iconColorClass ?? 'text-telemetry group-hover:border-telemetry/50'}`}>
                  <Icon name={exp.icon} class="w-5 h-5" />
                </div>
                <span class={`font-mono text-[11px] px-2.5 py-0.5 rounded-tech-sm font-semibold border ${exp.badgeColor}`}>
                  {exp.badge}
                </span>
              </div>
              <h3 class="text-xl font-display font-bold text-white mb-1 group-hover:text-telemetry transition-colors">
                {exp.title}
              </h3>
              <p class={`text-xs mb-3 ${exp.taglineClass ?? 'font-mono text-slate-400'}`}>
                {exp.tagline}
              </p>
              <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-6 font-sans">
                {exp.description}
              </p>
            </div>

            <div>
              <div class="flex flex-wrap gap-1.5 mb-5">
                {exp.tags.map((tag) => (
                  <span class="font-mono text-[11px] px-2 py-0.5 rounded-tech-sm bg-canvas text-slate-400 border border-canvas-border">
                    {tag}
                  </span>
                ))}
              </div>
              <div class="flex items-center gap-2">
                <a
                  href={exp.href}
                  class={`flex-1 inline-flex items-center justify-center px-3.5 py-2.5 rounded-tech font-mono text-xs font-bold transition-all duration-140 group/btn ${exp.btnClass ?? 'text-telemetry-dark bg-telemetry hover:bg-telemetry-hover shadow-glow-cyan'}`}
                >
                  <span>Abrir en vivo</span>
                  <svg class={`w-3.5 h-3.5 ml-1 transition-transform duration-140 group-hover/btn:translate-x-0.5 ${exp.btnIconClass ?? ''}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>
                {exp.canonicalHref && (
                  <a
                    href={exp.canonicalHref}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 px-3 py-2.5 rounded-tech font-mono text-xs font-medium text-slate-300 hover:text-white bg-canvas-surface border border-canvas-border hover:border-telemetry transition-colors"
                    title={`Ver versión canónica / repositorio de ${exp.title} en GitHub`}
                    aria-label={`Ver repositorio de ${exp.title} en GitHub`}
                  >
                    <svg class="w-3.5 h-3.5 text-slate-300" fill="currentColor" viewBox="0 0 24 24">
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                    </svg>
                    <span>Repo</span>
                    <svg class="w-3 h-3 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Lab Ecosystem & Research -->
    <section aria-labelledby="ecosystem-heading">
      <div class="flex items-center justify-between gap-4 mb-8 pb-3 border-b border-canvas-border">
        <div>
          <h2 id="ecosystem-heading" class="text-2xl font-display font-bold text-white tracking-tight flex items-center gap-2.5">
            <Icon name="cpu" class="w-5 h-5 text-domain-audio" />
            <span>Ecosistema de Proyectos & Homelab</span>
          </h2>
          <p class="font-mono text-xs text-slate-400 mt-1">
            Investigaciones, arquitecturas de backend y herramientas distribuidas de código abierto.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {experiments.filter(e => !e.isInteractive).map((exp, index) => (
          <article class={`spotlight-card group p-6 flex flex-col justify-between relative ${index === 3 && experiments.filter(e => !e.isInteractive).length % 3 !== 0 ? '' : ''}`}>
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <div class="w-9 h-9 rounded-tech bg-canvas border border-canvas-border flex items-center justify-center text-slate-300 group-hover:text-telemetry group-hover:border-telemetry/50 transition-colors">
                  <Icon name={exp.icon} class="w-4 h-4" />
                </div>
                <span class={`font-mono text-[10px] px-2 py-0.5 rounded-tech-sm font-semibold border ${exp.badgeColor}`}>
                  {exp.badge}
                </span>
              </div>
              <h3 class="text-lg font-display font-bold text-white mb-1 group-hover:text-telemetry transition-colors">
                {exp.title}
              </h3>
              <p class="font-mono text-xs text-slate-400 mb-2.5">
                {exp.tagline}
              </p>
              <p class="text-xs text-slate-300 leading-relaxed mb-4 font-sans">
                {exp.description}
              </p>
            </div>

            <div>
              <div class="flex flex-wrap gap-1.5 mb-4">
                {exp.tags.map((tag) => (
                  <span class="font-mono text-[10px] px-2 py-0.5 rounded-tech-sm bg-canvas text-slate-400 border border-canvas-border">
                    {tag}
                  </span>
                ))}
              </div>

              {exp.externalHref ? (
                <a
                  href={exp.externalHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center font-mono text-xs font-semibold text-telemetry hover:text-white transition-colors"
                >
                  <span>Ver repositorio en GitHub</span>
                  <svg class="w-3.5 h-3.5 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              ) : (
                <span class="font-mono text-xs text-slate-500 italic">Próximamente disponible</span>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
