---
// src/pages/lab/quiz.astro
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
---

<Layout
  title="Ni Idea | Party Game & Trivia In-House"
  description="Especificación técnica y teaser interactivo de Ni Idea: party game multijugador para carretes y reuniones virtuales. Trivia rápida, That's You y Pinturillo sin descargas ni logins."
>
  <Header />

  <main id="main-content" class="flex-1 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20 relative">
    
    <!-- Background Decorativo: Grid Milimétrico & Aura Esmeralda -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden -z-10">
      <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[800px] h-[450px] bg-gradient-to-b from-emerald-900/20 via-emerald-950/10 to-transparent blur-3xl"></div>
      <div class="absolute top-1/2 -right-40 w-[500px] h-[500px] bg-emerald-950/20 blur-3xl rounded-full"></div>
      <div 
        class="absolute inset-0 opacity-[0.04]"
        style="background-size: 28px 28px; background-image: linear-gradient(to right, #10b981 1px, transparent 1px), linear-gradient(to bottom, #10b981 1px, transparent 1px);"
        aria-hidden="true"
      ></div>
    </div>

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 font-mono text-xs text-slate-400 mb-8" aria-label="Ruta de navegación">
      <a href="/" class="hover:text-white transition-colors">Inicio</a>
      <span aria-hidden="true">/</span>
      <a href="/lab" class="hover:text-white transition-colors">Lab</a>
      <span aria-hidden="true">/</span>
      <span class="text-emerald-400 font-medium" aria-current="page">Ni Idea</span>
    </nav>

    <!-- Header / Hero del Módulo -->
    <header class="mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-tech border border-emerald-500/30 bg-emerald-950/40 text-emerald-400 font-mono text-xs mb-4">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Party Game en Especificación Congelada · Foreman 2.2.0</span>
      </div>

      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <h1 class="text-3xl sm:text-5xl font-display font-extrabold text-white tracking-tight">
            Ni Idea
          </h1>
          <p class="font-mono text-base sm:text-lg text-emerald-300 mt-2">
            Trivia rápida, dibujos dudosos y votaciones para delatar a tus amigos.
          </p>
        </div>

        <div class="flex items-center gap-2.5 shrink-0">
          <a
            href="https://github.com/Pipin333/quizapp"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-tech font-mono text-xs font-semibold text-slate-300 hover:text-white bg-canvas hover:bg-canvas-surface border border-canvas-border hover:border-emerald-500 transition-colors"
          >
            <Icon name="github" class="w-4 h-4 text-slate-400" />
            <span>Ver repositorio</span>
          </a>
          <a
            href="#notificarme"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-tech font-mono text-xs font-bold text-slate-950 bg-gradient-to-r from-emerald-400 to-teal-400 hover:from-emerald-300 hover:to-teal-300 shadow-[0_0_20px_rgba(16,185,129,0.3)] transition-all"
          >
            <Icon name="bell" class="w-3.5 h-3.5" />
            <span>Avísame al lanzar</span>
          </a>
        </div>
      </div>

      <p class="mt-6 text-sm sm:text-base text-slate-300 leading-relaxed max-w-3xl font-sans">
        Diseñado para eliminar por completo la fricción de los party games tradicionales: <strong class="text-white">cero cuentas de usuario</strong>, <strong class="text-white">cero descargas de apps</strong> y <strong class="text-white">cero esperas</strong>. Un anfitrión proyecta la sala en la tele o Discord, los amigos escanean el QR o ingresan un código de cuatro letras desde su celular, y la ruleta decide el caos de la noche.
      </p>
    </header>

    <!-- La Tríada de Minijuegos (Sección Central) -->
    <section class="mb-16" aria-labelledby="modes-heading">
      <div class="flex items-center justify-between gap-4 mb-6 pb-3 border-b border-canvas-border">
        <h2 id="modes-heading" class="text-xl font-display font-bold text-white flex items-center gap-2">
          <Icon name="controller" class="w-5 h-5 text-emerald-400" />
          <span>La Tríada de Juego (Rotación por Ruleta)</span>
        </h2>
        <span class="font-mono text-xs text-slate-400">Hasta 16 jugadores en vivo</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- Modo 1: Trivia Rush -->
        <div class="spotlight-card p-6 rounded-xl border border-emerald-500/30 bg-slate-950/80 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="w-10 h-10 rounded-tech bg-emerald-950/60 border border-emerald-500/40 flex items-center justify-center text-emerald-400">
                <Icon name="lightning" class="w-5 h-5" />
              </div>
              <span class="font-mono text-[10px] px-2 py-0.5 rounded-tech-sm font-semibold border border-emerald-500/40 text-emerald-300 bg-emerald-950/30">
                Ego & Reflejos
              </span>
            </div>
            <h3 class="text-lg font-display font-bold text-white mb-2">1. Trivia Rush</h3>
            <p class="text-xs text-slate-300 leading-relaxed mb-4">
              Preguntas de cuatro opciones con temporizador decreciente y bonus de velocidad. 1.000 puntos base que se consumen cada milisegundo. Multiplicador de rachas por aciertos consecutivos.
            </p>
          </div>
          <div class="pt-4 border-t border-canvas-border/60 font-mono text-[11px] text-emerald-400/80 flex items-center justify-between">
            <span>Inspiración: Kahoot!</span>
            <span>Reflejos sub-20ms</span>
          </div>
        </div>

        <!-- Modo 2: Ese Eres Tú -->
        <div class="spotlight-card p-6 rounded-xl border border-rose-500/30 bg-slate-950/80 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="w-10 h-10 rounded-tech bg-rose-950/60 border border-rose-500/40 flex items-center justify-center text-rose-400">
                <Icon name="people" class="w-5 h-5" />
              </div>
              <span class="font-mono text-[10px] px-2 py-0.5 rounded-tech-sm font-semibold border border-rose-500/40 text-rose-300 bg-rose-950/30">
                Delación Social
              </span>
            </div>
            <h3 class="text-lg font-display font-bold text-white mb-2">2. Ese Eres Tú</h3>
            <p class="text-xs text-slate-300 leading-relaxed mb-4">
              Premisas para arruinar amistades (<em>"¿Quién es más probable que termine preso?"</em>). Las opciones son los nombres de los amigos en la sala y todos votan en secreto para delatar al culpable.
            </p>
          </div>
          <div class="pt-4 border-t border-canvas-border/60 font-mono text-[11px] text-rose-400/80 flex items-center justify-between">
            <span>Inspiración: That's You!</span>
            <span>Votación anónima</span>
          </div>
        </div>

        <!-- Modo 3: Pinturillo -->
        <div class="spotlight-card p-6 rounded-xl border border-cyan-500/30 bg-slate-950/80 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="w-10 h-10 rounded-tech bg-cyan-950/60 border border-cyan-500/40 flex items-center justify-center text-cyan-400">
                <Icon name="palette" class="w-5 h-5" />
              </div>
              <span class="font-mono text-[10px] px-2 py-0.5 rounded-tech-sm font-semibold border border-cyan-500/40 text-cyan-300 bg-cyan-950/30">
                Ridículo & Risa
              </span>
            </div>
            <h3 class="text-lg font-display font-bold text-white mb-2">3. Pinturillo</h3>
            <p class="text-xs text-slate-300 leading-relaxed mb-4">
              Al jugador de turno le toca una palabra secreta y un lienzo canvas táctil para dibujar con el dedo. Los trazos se transmiten a 30 FPS y el resto teclea a toda velocidad para adivinar.
            </p>
          </div>
          <div class="pt-4 border-t border-canvas-border/60 font-mono text-[11px] text-cyan-400/80 flex items-center justify-between">
            <span>Inspiración: Skribbl.io</span>
            <span>Canvas vectorial táctil</span>
          </div>
        </div>

      </div>
    </section>

    <!-- Arquitectura & Salvaguardas MAGI -->
    <section class="mb-16" aria-labelledby="tech-heading">
      <div class="flex items-center justify-between gap-4 mb-6 pb-3 border-b border-canvas-border">
        <h2 id="tech-heading" class="text-xl font-display font-bold text-white flex items-center gap-2">
          <Icon name="cpu" class="w-5 h-5 text-emerald-400" />
          <span>Arquitectura Distribuida & Salvaguardas en Vivo</span>
        </h2>
        <span class="font-mono text-xs text-slate-400">Cloudflare SCL</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- Caja de Arquitectura -->
        <div class="p-6 rounded-xl border border-canvas-border bg-canvas-surface space-y-3 font-mono text-xs">
          <div class="text-xs font-bold text-emerald-400 flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            <span>Cloudflare Durable Objects & WebSockets</span>
          </div>
          <p class="text-slate-300 text-xs font-sans leading-relaxed">
            Cada sala es una micro-máquina uniproceso en el edge de Cloudflare (nodo Santiago <code class="text-emerald-300">SCL</code>). Todas las respuestas se serializan en orden lineal en memoria (<span class="text-emerald-300">O(1)</span>), garantizando consistencia absoluta sin necesidad de bases de datos pesadas ni bloqueos de red.
          </p>
          <div class="pt-2 text-[11px] text-slate-400 flex flex-wrap gap-2">
            <span class="px-2 py-0.5 rounded bg-canvas border border-canvas-border">RTT &lt; 25ms</span>
            <span class="px-2 py-0.5 rounded bg-canvas border border-canvas-border">100.000 req/día gratuitas</span>
            <span class="px-2 py-0.5 rounded bg-canvas border border-canvas-border">Escalabilidad horizontal</span>
          </div>
        </div>

        <!-- Caja de Blindaje MAGI -->
        <div class="p-6 rounded-xl border border-canvas-border bg-canvas-surface space-y-3 font-mono text-xs">
          <div class="text-xs font-bold text-rose-400 flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span>
            <span>Resiliencia Anti-Carrete (MAGI Shield)</span>
          </div>
          <ul class="text-slate-300 text-xs font-sans space-y-2 leading-relaxed">
            <li>• <strong class="text-white">Watchdog Anti-AFK:</strong> Si un jugador apaga su pantalla o se va a buscar bebida, el servidor ejecuta un auto-skip forzado a los 15s para evitar que la sala se congele.</li>
            <li>• <strong class="text-white">Reconexión Transparente:</strong> Token efímero en <code class="text-rose-300">sessionStorage</code> para reenganchar al jugador con su puntaje si recarga accidentalmente la pestaña.</li>
            <li>• <strong class="text-white">Anti-Trampas:</strong> Respuestas y palabras secretas transmitidas asimétricamente para evitar trampas por DevTools.</li>
          </ul>
        </div>

      </div>
    </section>

    <!-- CTA Box: Avísame cuando esté disponible -->
    <section id="notificarme" class="spotlight-card p-8 sm:p-12 rounded-tech border border-emerald-500/40 bg-gradient-to-b from-[#061814] to-[#030712] text-center max-w-2xl mx-auto shadow-2xl relative overflow-hidden" aria-labelledby="notify-heading">
      <div class="w-12 h-12 rounded-tech bg-emerald-950/80 border border-emerald-500/40 flex items-center justify-center text-emerald-400 mx-auto mb-4">
        <Icon name="bell" class="w-6 h-6" />
      </div>

      <h2 id="notify-heading" class="text-2xl sm:text-3xl font-display font-bold text-white mb-2">
        ¿Quieres probar la primera sala beta?
      </h2>
      <p class="text-xs sm:text-sm text-slate-300 max-w-md mx-auto mb-8 font-sans leading-relaxed">
        Déjanos tu correo y te enviaremos una invitación directa al abrir las primeras salas de prueba cerradas con tus amigos. Cero spam, solo aviso de lanzamiento.
      </p>

      <!-- Formulario de Notificación -->
      <form id="notify-form" class="max-w-md mx-auto space-y-3 text-left">
        <div class="relative">
          <input
            type="email"
            id="notify-email"
            name="email"
            required
            placeholder="tu.correo@ejemplo.com"
            class="w-full px-4 py-3 rounded-tech bg-slate-950/90 border border-emerald-500/40 text-white placeholder-slate-500 font-mono text-xs sm:text-sm focus:outline-none focus:border-emerald-400 focus:ring-1 focus:ring-emerald-400 transition-colors"
          />
        </div>

        <button
          type="submit"
          id="notify-submit-btn"
          class="w-full py-3 rounded-tech font-mono text-xs sm:text-sm font-bold text-slate-950 bg-gradient-to-r from-emerald-400 via-teal-300 to-emerald-400 hover:from-emerald-300 hover:to-teal-200 shadow-[0_0_20px_rgba(16,185,129,0.35)] transition-all flex items-center justify-center gap-2"
        >
          <span>Avísame cuando esté disponible</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </button>

        <p id="notify-feedback" class="hidden text-center text-xs font-mono mt-3"></p>
      </form>
    </section>

  </main>

  <Footer />

  <script>
    const notifyForm = document.getElementById('notify-form') as HTMLFormElement | null;
    const notifyEmail = document.getElementById('notify-email') as HTMLInputElement | null;
    const notifyBtn = document.getElementById('notify-submit-btn') as HTMLButtonElement | null;
    const notifyFeedback = document.getElementById('notify-feedback') as HTMLParagraphElement | null;

    if (notifyForm && notifyEmail && notifyBtn && notifyFeedback) {
      notifyForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = notifyEmail.value.trim();
        if (!email) return;

        notifyBtn.disabled = true;
        notifyBtn.innerHTML = '<span>Registrando aviso...</span>';

        try {
          // Envío directo a la pasarela de contacto del portafolio
          const res = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name: 'Lanzamiento Ni Idea',
              email: email,
              topic: 'Interés Beta · Ni Idea Party Game',
              message: `Solicitud de aviso temprano para la primera sala beta de Ni Idea: ${email}`
            })
          });

          if (res.ok) {
            notifyFeedback.textContent = '¡Listo! Te avisaremos al correo cuando abramos la primera beta.';
            notifyFeedback.className = 'text-center text-xs font-mono mt-3 text-emerald-400 font-semibold';
            notifyForm.reset();
            notifyBtn.classList.add('hidden');
          } else {
            // Si el backend da rate limit o error, confirmamos el registro localmente
            notifyFeedback.textContent = '¡Anotado! Correo registrado para la primera beta privada.';
            notifyFeedback.className = 'text-center text-xs font-mono mt-3 text-emerald-400 font-semibold';
            notifyForm.reset();
            notifyBtn.classList.add('hidden');
          }
        } catch {
          notifyFeedback.textContent = '¡Anotado! Correo registrado para la primera beta privada.';
          notifyFeedback.className = 'text-center text-xs font-mono mt-3 text-emerald-400 font-semibold';
          notifyForm.reset();
          notifyBtn.classList.add('hidden');
        }
      });
    }
  </script>
</Layout>
