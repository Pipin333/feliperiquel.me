---
// src/pages/lab/quiz.astro
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
---

<Layout
  title="Ni Idea | Party Game & Trivia In-House"
  description="Especificación técnica y teaser interactivo de Ni Idea: party game multijugador para carretes y reuniones virtuales. Trivia rápida, That's You y Pinturillo sin descargas ni logins."
>
  <Header />

  <!-- Fondo Ambiental: Blueprints de Ruleta, Dados Isométricos y Naipes Técnicos (Flanco Izquierdo y Derecho) -->
  <div class="fixed inset-0 pointer-events-none overflow-hidden z-0 select-none" aria-hidden="true">
    <!-- Resplandor central Esmeralda / Fieltro Nocturno difuso -->
    <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[900px] h-[500px] bg-gradient-to-b from-emerald-950/30 via-emerald-900/10 to-transparent blur-3xl"></div>
    <div class="absolute bottom-0 inset-x-0 h-[400px] bg-gradient-to-t from-emerald-950/20 via-transparent to-transparent blur-2xl"></div>

    <!-- Rejilla milimétrica técnica esmeralda de fondo -->
    <div class="absolute inset-0 bg-[linear-gradient(rgba(16,185,129,0.025)_1px,transparent_1px),linear-gradient(90deg,rgba(16,185,129,0.025)_1px,transparent_1px)] bg-[size:32px_32px]"></div>

    <!-- Flanco Izquierdo: Ruleta Monumental, Naipes y Cotas de Ángulo -->
    <div class="absolute left-0 top-0 bottom-0 w-72 sm:w-88 xl:w-[420px] overflow-hidden">
      <svg class="w-full h-full text-emerald-400/20" viewBox="0 0 380 960" preserveAspectRatio="xMinYMin meet" fill="none" stroke="currentColor">
        <defs>
          <!-- Ruleta Técnica de Casino -->
          <g id="roulette-wheel-blueprint">
            <circle cx="120" cy="120" r="105" stroke-width="1.5" class="text-emerald-400/60" />
            <circle cx="120" cy="120" r="92" stroke-width="0.75" stroke-dasharray="3,3" class="text-teal-300/40" />
            <circle cx="120" cy="120" r="65" stroke-width="1" class="text-emerald-500/50" />
            <circle cx="120" cy="120" r="38" stroke-width="1.25" class="text-emerald-300/70" />
            <circle cx="120" cy="120" r="12" fill="currentColor" class="text-emerald-400/30" stroke-width="1" />
            <circle cx="120" cy="120" r="4" fill="currentColor" class="text-emerald-200" />
            
            <!-- Divisiones radiales (Rayos de Ruleta) -->
            <line x1="120" y1="15" x2="120" y2="225" stroke-width="0.75" class="text-emerald-400/50" />
            <line x1="15" y1="120" x2="225" y2="120" stroke-width="0.75" class="text-emerald-400/50" />
            <line x1="45" y1="45" x2="195" y2="195" stroke-width="0.75" class="text-emerald-500/40" />
            <line x1="45" y1="195" x2="195" y2="45" stroke-width="0.75" class="text-emerald-500/40" />
            <line x1="28" y1="83" x2="212" y2="157" stroke-width="0.5" stroke-dasharray="2,2" class="text-emerald-400/30" />
            <line x1="28" y1="157" x2="212" y2="83" stroke-width="0.5" stroke-dasharray="2,2" class="text-emerald-400/30" />
            <line x1="83" y1="28" x2="157" y2="212" stroke-width="0.5" stroke-dasharray="2,2" class="text-emerald-400/30" />
            <line x1="157" y1="28" x2="83" y2="212" stroke-width="0.5" stroke-dasharray="2,2" class="text-emerald-400/30" />

            <!-- Aguja selectora de modo superior -->
            <polygon points="120,5 125,25 115,25" fill="currentColor" class="text-rose-400/80" stroke-width="0.75" />
            
            <!-- Marcas perimetrales de grados -->
            <text x="123" y="10" font-family="monospace" font-size="7" fill="currentColor" class="text-emerald-300/60">0°</text>
            <text x="215" y="123" font-family="monospace" font-size="7" fill="currentColor" class="text-emerald-300/60">90°</text>
            <text x="123" y="235" font-family="monospace" font-size="7" fill="currentColor" class="text-emerald-300/60">180°</text>
            <text x="0" y="123" font-family="monospace" font-size="7" fill="currentColor" class="text-emerald-300/60">270°</text>
          </g>

          <!-- Carta de Juego Técnica en Sección Isométrica -->
          <g id="playing-card-blueprint">
            <rect x="0" y="0" width="85" height="125" rx="8" stroke-width="1.25" class="text-emerald-400/60" />
            <rect x="5" y="5" width="75" height="115" rx="5" stroke-width="0.5" stroke-dasharray="2,3" class="text-emerald-500/40" />
            <!-- Pique heráldico central -->
            <g transform="translate(42, 58) scale(0.9)">
              <path d="M0,-24 C-12,-8 -22,4 -18,16 C-14,24 -4,22 0,16 C4,22 14,24 18,16 C22,4 12,-8 0,-24 Z" stroke-width="1.25" class="text-emerald-300" />
              <path d="M-3,16 L-8,28 L8,28 L3,16 Z" stroke-width="1" class="text-teal-200" />
            </g>
            <!-- Índices de esquina -->
            <text x="10" y="20" font-family="monospace" font-size="10" font-weight="bold" fill="currentColor" class="text-emerald-300">A</text>
            <text x="70" y="115" font-family="monospace" font-size="10" font-weight="bold" fill="currentColor" class="text-emerald-300">A</text>
          </g>
        </defs>

        <!-- Anotaciones de ingeniería de juego en margen izquierdo -->
        <g class="text-[9px] font-mono text-emerald-400/40 select-none">
          <text x="24" y="38">FIG. I — ROTA ALEATORIA ET CASINUM</text>
          <text x="24" y="52">SPEC 05 • CLOUDFLARE DURABLE OBJECTS</text>
          <text x="24" y="66">LATENCY &lt; 20ms • SANTIAGO SCL</text>
        </g>

        <!-- Ruleta técnica superior izquierda -->
        <use href="#roulette-wheel-blueprint" x="20" y="80" transform="scale(0.95)" />

        <!-- Carta técnica flotante intermedia -->
        <use href="#playing-card-blueprint" x="50" y="360" transform="rotate(-12 90 420) scale(0.95)" />
        <use href="#playing-card-blueprint" x="120" y="380" transform="rotate(18 160 440) scale(0.85)" />

        <!-- Segunda ruleta inferior con rotación alternativa -->
        <use href="#roulette-wheel-blueprint" x="-20" y="620" transform="scale(0.85) rotate(35 100 700)" />

        <!-- Cotas y anotaciones de protocolo -->
        <g class="text-[8px] font-mono text-emerald-500/40 select-none">
          <line x1="24" y1="875" x2="160" y2="875" stroke-width="0.75" stroke-dasharray="3,3" />
          <text x="24" y="890">WS PROTOCOL • BINARY FRAMES</text>
          <text x="24" y="904">SESSION_TOKEN :: STORAGE_AUTH</text>
          <text x="24" y="918">ZERO-LOGIN IDENTITY MATRIX</text>
        </g>
      </svg>
    </div>

    <!-- Flanco Derecho: Dados Isométricos 3D, Casillas y Malla Vectorial Pinturillo -->
    <div class="absolute right-0 top-0 bottom-0 w-72 sm:w-88 xl:w-[420px] overflow-hidden">
      <svg class="w-full h-full text-emerald-400/20" viewBox="0 0 380 960" preserveAspectRatio="xMaxYMin meet" fill="none" stroke="currentColor">
        <defs>
          <!-- Gran Dado Isométrico 3D en Wireframe -->
          <g id="isometric-dice-blueprint">
            <polygon points="50,0 100,28 50,56 0,28" stroke-width="1.5" class="text-emerald-400/70" />
            <polygon points="0,28 50,56 50,112 0,84" stroke-width="1.5" class="text-emerald-500/60" />
            <polygon points="50,56 100,28 100,84 50,112" stroke-width="1.5" class="text-teal-400/60" />
            
            <!-- Puntos cara superior (3) -->
            <circle cx="28" cy="18" r="3" fill="currentColor" class="text-emerald-200" />
            <circle cx="50" cy="28" r="3" fill="currentColor" class="text-emerald-200" />
            <circle cx="72" cy="38" r="3" fill="currentColor" class="text-emerald-200" />
            
            <!-- Puntos cara izquierda (5) -->
            <circle cx="16" cy="48" r="3" fill="currentColor" class="text-teal-300" />
            <circle cx="34" cy="58" r="3" fill="currentColor" class="text-teal-300" />
            <circle cx="25" cy="70" r="3" fill="currentColor" class="text-teal-300" />
            <circle cx="16" cy="82" r="3" fill="currentColor" class="text-teal-300" />
            <circle cx="34" cy="92" r="3" fill="currentColor" class="text-teal-300" />

            <!-- Puntos cara derecha (2) -->
            <circle cx="68" cy="62" r="3" fill="currentColor" class="text-emerald-300" />
            <circle cx="82" cy="78" r="3" fill="currentColor" class="text-emerald-300" />

            <!-- Cotas isométricas exteriores -->
            <line x1="108" y1="28" x2="108" y2="84" stroke-width="0.75" class="text-emerald-400/50" />
            <line x1="104" y1="28" x2="112" y2="28" stroke-width="0.75" />
            <line x1="104" y1="84" x2="112" y2="84" stroke-width="0.75" />
            <text x="115" y="60" font-family="monospace" font-size="7" fill="currentColor" class="text-emerald-300/60">H=56mm</text>
          </g>

          <!-- Peón de Juego de Mesa (Meeple Clásico) en Sección Técnica -->
          <g id="meeple-blueprint">
            <line x1="40" y1="0" x2="40" y2="120" stroke-width="0.5" stroke-dasharray="3,3" class="text-emerald-500/40" />
            <!-- Cabeza -->
            <circle cx="40" cy="22" r="14" stroke-width="1.25" class="text-emerald-300" />
            <circle cx="40" cy="22" r="10" stroke-width="0.5" stroke-dasharray="2,2" class="text-emerald-400/40" />
            <!-- Torso / Hombros -->
            <path d="M22,45 L10,55 L16,72 L26,62 L24,105 L56,105 L54,62 L64,72 L70,55 L58,45 Z" stroke-width="1.25" class="text-emerald-400/70" />
            <circle cx="40" cy="65" r="4" fill="currentColor" class="text-rose-400/70" />
          </g>

          <!-- Malla Vectorial de Trazo Pinturillo (Normalización 0 a 1000) -->
          <g id="vector-canvas-blueprint">
            <rect x="0" y="0" width="130" height="90" rx="4" stroke-width="1" class="text-cyan-400/50" />
            <line x1="15" y1="10" x2="15" y2="80" stroke-width="0.5" class="text-cyan-500/40" />
            <line x1="15" y1="80" x2="120" y2="80" stroke-width="0.5" class="text-cyan-500/40" />
            
            <!-- Curva de trazo vectorial simulada con puntos de control -->
            <path d="M25,65 Q50,15 75,50 T115,30" stroke-width="1.5" class="text-cyan-300" />
            <circle cx="25" cy="65" r="2.5" fill="currentColor" class="text-cyan-200" />
            <circle cx="50" cy="15" r="2" stroke-width="0.75" class="text-rose-400" />
            <circle cx="75" cy="50" r="2" stroke-width="0.75" class="text-rose-400" />
            <circle cx="115" cy="30" r="2.5" fill="currentColor" class="text-cyan-200" />

            <text x="20" y="20" font-family="monospace" font-size="6" fill="currentColor" class="text-cyan-300/60">[X, Y] :: 30 FPS</text>
            <text x="75" y="75" font-family="monospace" font-size="6" fill="currentColor" class="text-cyan-400/40">DELTA COMPRESSION</text>
          </g>
        </defs>

        <!-- Anotaciones de ingeniería en margen derecho -->
        <g class="text-[9px] font-mono text-emerald-400/40 select-none">
          <text x="180" y="38">FIG. II — CUBUS ISOMETRICUS &amp; VECTORES</text>
          <text x="180" y="52">PINTURILLO ENGINE • 30Hz SAMPLING</text>
          <text x="180" y="66">FAILSAFE WATCHDOG • 15s ALARM</text>
        </g>

        <!-- Dado isométrico superior derecho -->
        <use href="#isometric-dice-blueprint" x="200" y="85" transform="scale(0.95)" />

        <!-- Segundo dado con rotación complementaria -->
        <use href="#isometric-dice-blueprint" x="140" y="195" transform="scale(0.75) rotate(-24 180 230)" />

        <!-- Peón de juego en sección técnica -->
        <use href="#meeple-blueprint" x="220" y="350" transform="scale(0.90)" />

        <!-- Malla vectorial de Pinturillo intermedia -->
        <use href="#vector-canvas-blueprint" x="190" y="520" transform="scale(0.95)" />

        <!-- Casillero de avance al pie -->
        <g transform="translate(180, 680)" class="text-emerald-400/40 font-mono text-[8px]">
          <rect x="0" y="0" width="35" height="35" rx="3" stroke-width="0.75" />
          <text x="10" y="22">01</text>
          <rect x="40" y="0" width="35" height="35" rx="3" stroke-width="0.75" class="text-emerald-300/60" />
          <text x="50" y="22" class="text-emerald-200">02</text>
          <rect x="80" y="0" width="35" height="35" rx="3" stroke-width="0.75" />
          <text x="90" y="22">03</text>
          <rect x="120" y="0" width="35" height="35" rx="3" stroke-width="1.25" class="text-rose-400/60" />
          <text x="128" y="22" class="text-rose-300">★</text>
          <line x1="0" y1="45" x2="155" y2="45" stroke-width="0.75" stroke-dasharray="2,3" />
          <text x="0" y="60">STAGE ADVANCEMENT :: LOOP</text>
        </g>

        <!-- Notas de latencia y Cloudflare Workers -->
        <g class="text-[8px] font-mono text-emerald-500/40 select-none">
          <text x="180" y="890">ACTOR MODEL :: DURABLE OBJECTS</text>
          <text x="180" y="904">FAILSAFE DISCONNECT TIMER: 15s</text>
          <text x="180" y="918">ZERO CLUSTER OVERHEAD</text>
        </g>
      </svg>
    </div>
  </div>

  <main id="main-content" class="flex-1 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20 relative z-10">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 font-mono text-xs text-slate-400 mb-8" aria-label="Ruta de navegación">
      <a href="/" class="hover:text-white transition-colors">Inicio</a>
      <span aria-hidden="true">/</span>
      <a href="/lab" class="hover:text-white transition-colors">Lab</a>
      <span aria-hidden="true">/</span>
      <span class="text-emerald-400 font-medium" aria-current="page">Ni Idea</span>
    </nav>

    <!-- Header / Hero del Módulo -->
    <header class="mb-10">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <h1 class="text-3xl sm:text-5xl font-display font-extrabold text-white tracking-tight">
            Ni Idea
          </h1>
          <p class="font-mono text-base sm:text-lg text-emerald-300 mt-2">
            Trivia rápida, dibujos dudosos y votaciones para delatar a tus amigos.
          </p>
        </div>

        <div class="flex items-center gap-2.5 shrink-0">
          <a
            href="https://github.com/Pipin333/niideaapp"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-tech font-mono text-xs font-semibold text-slate-300 hover:text-white bg-canvas hover:bg-canvas-surface border border-canvas-border hover:border-emerald-500 transition-colors whitespace-nowrap flex-shrink-0"
          >
            <Icon name="github" class="w-4 h-4 text-slate-400" />
            <span>Ver repositorio</span>
          </a>
          <a
            href="https://ni-idea.pipin333.workers.dev"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-tech font-mono text-xs font-bold text-slate-950 bg-gradient-to-r from-emerald-400 to-teal-400 hover:from-emerald-300 hover:to-teal-300 shadow-[0_0_20px_rgba(16,185,129,0.3)] transition-all whitespace-nowrap flex-shrink-0"
          >
            <Icon name="controller" class="w-3.5 h-3.5" />
            <span>Pantalla completa</span>
          </a>
        </div>
      </div>

      <p class="mt-6 text-sm sm:text-base text-slate-300 leading-relaxed max-w-3xl font-sans">
        Diseñado para eliminar por completo la fricción de los party games tradicionales: <strong class="text-white">cero cuentas de usuario</strong>, <strong class="text-white">cero descargas de apps</strong> y <strong class="text-white">cero esperas</strong>. Crea una sala aquí mismo o únete con el código de cuatro caracteres desde cualquier teléfono o navegador.
      </p>
    </header>

    <!-- CONSOLA INTERACTIVA EN VIVO -->
    <section id="consola-en-vivo" class="mb-16" aria-label="Consola de juego en vivo Ni Idea">
      <!-- ESTADO 1: Entrada (Crear / Unirse + Cajetín _ _ _ _) -->
      <div
        id="state-entry"
        class="w-full rounded-2xl bg-[#061814] border border-[#064E3B] p-6 sm:p-8 shadow-2xl space-y-6"
      >
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[#064E3B] pb-3">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-[#10B981]"></span>
            <span class="font-mono text-xs uppercase tracking-widest text-[#10B981] font-bold">
              MESA MULTIJUGADOR EN TIEMPO REAL
            </span>
          </div>
          <span class="font-mono text-xs text-[#94A3B8]">HASTA 16 JUGADORES · 0 LOGINS</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-end">
          <!-- Apodo -->
          <div class="space-y-2">
            <label for="input-nickname" class="block font-mono text-xs uppercase tracking-wider text-[#94A3B8]">
              1. Tu apodo para esta partida
            </label>
            <input
              id="input-nickname"
              type="text"
              maxlength="18"
              autocomplete="off"
              placeholder="Ej: Pipe, Cami, ElProfe"
              class="w-full px-4 py-3.5 rounded-xl bg-[#0B241E] border border-[#064E3B] text-[#F8FAFC] placeholder-[#94A3B8]/60 font-sans text-sm sm:text-base focus-visible:outline-none focus-visible:border-[#10B981] focus-visible:ring-2 focus-visible:ring-[#10B981] transition-all"
            />
          </div>

          <!-- Cajetín de 4 ranuras -->
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <label for="pin-slot-0" class="font-mono text-xs uppercase tracking-wider text-[#94A3B8]">
                2. Código PIN de Sala (si te unes)
              </label>
              <span class="font-mono text-xs text-[#10B981]">A-Z / 0-9</span>
            </div>

            <div
              id="pin-slot-group"
              data-complete="false"
              class="grid grid-cols-4 gap-2.5"
              role="group"
              aria-label="Ranuras para el código de cuatro caracteres de la sala"
            >
              <input
                id="pin-slot-0"
                type="text"
                maxlength="1"
                placeholder="_"
                aria-label="Carácter 1 del código de sala"
                class="w-full h-14 text-center rounded-xl bg-[#0B241E] border border-[#064E3B] text-[#F8FAFC] placeholder-[#94A3B8]/40 font-mono text-2xl font-bold uppercase focus-visible:outline-none focus-visible:border-[#10B981] focus-visible:ring-2 focus-visible:ring-[#10B981]"
              />
              <input
                id="pin-slot-1"
                type="text"
                maxlength="1"
                placeholder="_"
                aria-label="Carácter 2 del código de sala"
                class="w-full h-14 text-center rounded-xl bg-[#0B241E] border border-[#064E3B] text-[#F8FAFC] placeholder-[#94A3B8]/40 font-mono text-2xl font-bold uppercase focus-visible:outline-none focus-visible:border-[#10B981] focus-visible:ring-2 focus-visible:ring-[#10B981]"
              />
              <input
                id="pin-slot-2"
                type="text"
                maxlength="1"
                placeholder="_"
                aria-label="Carácter 3 del código de sala"
                class="w-full h-14 text-center rounded-xl bg-[#0B241E] border border-[#064E3B] text-[#F8FAFC] placeholder-[#94A3B8]/40 font-mono text-2xl font-bold uppercase focus-visible:outline-none focus-visible:border-[#10B981] focus-visible:ring-2 focus-visible:ring-[#10B981]"
              />
              <input
                id="pin-slot-3"
                type="text"
                maxlength="1"
                placeholder="_"
                aria-label="Carácter 4 del código de sala"
                class="w-full h-14 text-center rounded-xl bg-[#0B241E] border border-[#064E3B] text-[#F8FAFC] placeholder-[#94A3B8]/40 font-mono text-2xl font-bold uppercase focus-visible:outline-none focus-visible:border-[#10B981] focus-visible:ring-2 focus-visible:ring-[#10B981]"
              />
            </div>
          </div>
        </div>

        <p id="entry-inline-feedback" role="alert" class="hidden font-mono text-xs text-[#F43F5E]"></p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
          <button
            id="btn-create-room"
            type="button"
            class="w-full py-3.5 px-5 rounded-xl font-mono text-xs sm:text-sm font-bold text-[#022C22] bg-gradient-to-r from-[#10B981] to-[#34D399] hover:-translate-y-0.5 hover:shadow-[0_0_20px_rgba(16,185,129,0.3)] active:scale-[0.98] transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#F8FAFC]"
          >
            Crear Sala
          </button>

          <button
            id="btn-join-room"
            type="button"
            class="w-full py-3.5 px-5 rounded-xl font-mono text-xs sm:text-sm font-bold text-[#F8FAFC] bg-[#0B241E] border border-[#064E3B] hover:border-[#10B981] hover:text-white active:scale-[0.98] transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#10B981]"
          >
            Unirse a Sala
          </button>
        </div>
      </div>

      <!-- ESTADO 2: Carga -->
      <div
        id="state-loading"
        aria-live="polite"
        class="hidden w-full rounded-2xl bg-[#061814] border border-[#064E3B] p-8 text-center space-y-4"
      >
        <div class="w-10 h-10 mx-auto rounded-full border-2 border-[#10B981] border-t-transparent animate-spin"></div>
        <p class="font-display text-lg font-bold text-[#F8FAFC]">Sincronizando mesa de juego...</p>
      </div>

      <!-- ESTADO 4: Error Reintentable -->
      <div
        id="state-error"
        role="alert"
        class="hidden w-full rounded-2xl bg-[#061814] border border-[#F43F5E] p-8 text-center space-y-4"
      >
        <p class="font-mono text-xs uppercase tracking-widest text-[#F43F5E]">CONEXIÓN INTERRUMPIDA</p>
        <h2 class="font-display text-xl font-bold text-[#F8FAFC]">No pudimos conectar con la sala</h2>
