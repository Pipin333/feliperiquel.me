---
// src/pages/lab/quiz.astro
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
---

<Layout
  title="Ni Idea | Party Game & Trivia In-House"
  description="Especificación técnica y teaser interactivo de Ni Idea: party game multijugador para carretes y reuniones virtuales. Trivia rápida, That's You y Pinturillo sin descargas ni logins."
>
  <Header />

  <!-- Fondo Ambiental: Blueprints de Ruleta, Dados Isométricos y Naipes Técnicos (Flanco Izquierdo y Derecho) -->
  <div class="fixed inset-0 pointer-events-none overflow-hidden z-0 select-none" aria-hidden="true">
    <!-- Resplandor central Esmeralda / Fieltro Nocturno difuso -->
    <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[900px] h-[500px] bg-gradient-to-b from-emerald-950/30 via-emerald-900/10 to-transparent blur-3xl"></div>
    <div class="absolute bottom-0 inset-x-0 h-[400px] bg-gradient-to-t from-emerald-950/20 via-transparent to-transparent blur-2xl"></div>

    <!-- Rejilla milimétrica técnica esmeralda de fondo -->
    <div class="absolute inset-0 bg-[linear-gradient(rgba(16,185,129,0.025)_1px,transparent_1px),linear-gradient(90deg,rgba(16,185,129,0.025)_1px,transparent_1px)] bg-[size:32px_32px]"></div>

    <!-- Flanco Izquierdo: Ruleta Monumental, Naipes y Cotas de Ángulo -->
    <div class="absolute left-0 top-0 bottom-0 w-72 sm:w-88 xl:w-[420px] overflow-hidden">
      <svg class="w-full h-full text-emerald-400/20" viewBox="0 0 380 960" preserveAspectRatio="xMinYMin meet" fill="none" stroke="currentColor">
        <defs>
          <!-- Ruleta Técnica de Casino -->
          <g id="roulette-wheel-blueprint">
            <circle cx="120" cy="120" r="105" stroke-width="1.5" class="text-emerald-400/60" />
            <circle cx="120" cy="120" r="92" stroke-width="0.75" stroke-dasharray="3,3" class="text-teal-300/40" />
            <circle cx="120" cy="120" r="65" stroke-width="1" class="text-emerald-500/50" />
            <circle cx="120" cy="120" r="38" stroke-width="1.25" class="text-emerald-300/70" />
            <circle cx="120" cy="120" r="12" fill="currentColor" class="text-emerald-400/30" stroke-width="1" />
            <circle cx="120" cy="120" r="4" fill="currentColor" class="text-emerald-200" />
            
            <!-- Divisiones radiales (Rayos de Ruleta) -->
            <line x1="120" y1="15" x2="120" y2="225" stroke-width="0.75" class="text-emerald-400/50" />
            <line x1="15" y1="120" x2="225" y2="120" stroke-width="0.75" class="text-emerald-400/50" />
            <line x1="45" y1="45" x2="195" y2="195" stroke-width="0.75" class="text-emerald-500/40" />
            <line x1="45" y1="195" x2="195" y2="45" stroke-width="0.75" class="text-emerald-500/40" />
            <line x1="28" y1="83" x2="212" y2="157" stroke-width="0.5" stroke-dasharray="2,2" class="text-emerald-400/30" />
            <line x1="28" y1="157" x2="212" y2="83" stroke-width="0.5" stroke-dasharray="2,2" class="text-emerald-400/30" />
            <line x1="83" y1="28" x2="157" y2="212" stroke-width="0.5" stroke-dasharray="2,2" class="text-emerald-400/30" />
            <line x1="157" y1="28" x2="83" y2="212" stroke-width="0.5" stroke-dasharray="2,2" class="text-emerald-400/30" />

            <!-- Aguja selectora de modo superior -->
            <polygon points="120,5 125,25 115,25" fill="currentColor" class="text-rose-400/80" stroke-width="0.75" />
            
            <!-- Marcas perimetrales de grados -->
            <text x="123" y="10" font-family="monospace" font-size="7" fill="currentColor" class="text-emerald-300/60">0°</text>
            <text x="215" y="123" font-family="monospace" font-size="7" fill="currentColor" class="text-emerald-300/60">90°</text>
            <text x="123" y="235" font-family="monospace" font-size="7" fill="currentColor" class="text-emerald-300/60">180°</text>
            <text x="0" y="123" font-family="monospace" font-size="7" fill="currentColor" class="text-emerald-300/60">270°</text>
          </g>

          <!-- Carta de Juego Técnica en Sección Isométrica -->
          <g id="playing-card-blueprint">
            <rect x="0" y="0" width="85" height="125" rx="8" stroke-width="1.25" class="text-emerald-400/60" />
            <rect x="5" y="5" width="75" height="115" rx="5" stroke-width="0.5" stroke-dasharray="2,3" class="text-emerald-500/40" />
            <!-- Pique heráldico central -->
            <g transform="translate(42, 58) scale(0.9)">
              <path d="M0,-24 C-12,-8 -22,4 -18,16 C-14,24 -4,22 0,16 C4,22 14,24 18,16 C22,4 12,-8 0,-24 Z" stroke-width="1.25" class="text-emerald-300" />
              <path d="M-3,16 L-8,28 L8,28 L3,16 Z" stroke-width="1" class="text-teal-200" />
            </g>
            <!-- Índices de esquina -->
            <text x="10" y="20" font-family="monospace" font-size="10" font-weight="bold" fill="currentColor" class="text-emerald-300">A</text>
            <text x="70" y="115" font-family="monospace" font-size="10" font-weight="bold" fill="currentColor" class="text-emerald-300">A</text>
          </g>
        </defs>

        <!-- Anotaciones de ingeniería de juego en margen izquierdo -->
        <g class="text-[9px] font-mono text-emerald-400/40 select-none">
          <text x="24" y="38">FIG. I — ROTA ALEATORIA ET CASINUM</text>
          <text x="24" y="52">SPEC 05 • CLOUDFLARE DURABLE OBJECTS</text>
          <text x="24" y="66">LATENCY &lt; 20ms • SANTIAGO SCL</text>
        </g>

        <!-- Ruleta técnica superior izquierda -->
        <use href="#roulette-wheel-blueprint" x="20" y="80" transform="scale(0.95)" />

        <!-- Carta técnica flotante intermedia -->
        <use href="#playing-card-blueprint" x="50" y="360" transform="rotate(-12 90 420) scale(0.95)" />
        <use href="#playing-card-blueprint" x="120" y="380" transform="rotate(18 160 440) scale(0.85)" />

        <!-- Segunda ruleta inferior con rotación alternativa -->
        <use href="#roulette-wheel-blueprint" x="-20" y="620" transform="scale(0.85) rotate(35 100 700)" />

        <!-- Cotas y anotaciones de protocolo -->
        <g class="text-[8px] font-mono text-emerald-500/40 select-none">
          <line x1="24" y1="875" x2="160" y2="875" stroke-width="0.75" stroke-dasharray="3,3" />
          <text x="24" y="890">WS PROTOCOL • BINARY FRAMES</text>
          <text x="24" y="904">SESSION_TOKEN :: STORAGE_AUTH</text>
          <text x="24" y="918">ZERO-LOGIN IDENTITY MATRIX</text>
        </g>
      </svg>
    </div>

    <!-- Flanco Derecho: Dados Isométricos 3D, Casillas y Malla Vectorial Pinturillo -->
    <div class="absolute right-0 top-0 bottom-0 w-72 sm:w-88 xl:w-[420px] overflow-hidden">
      <svg class="w-full h-full text-emerald-400/20" viewBox="0 0 380 960" preserveAspectRatio="xMaxYMin meet" fill="none" stroke="currentColor">
        <defs>
          <!-- Gran Dado Isométrico 3D en Wireframe -->
          <g id="isometric-dice-blueprint">
            <polygon points="50,0 100,28 50,56 0,28" stroke-width="1.5" class="text-emerald-400/70" />
            <polygon points="0,28 50,56 50,112 0,84" stroke-width="1.5" class="text-emerald-500/60" />
            <polygon points="50,56 100,28 100,84 50,112" stroke-width="1.5" class="text-teal-400/60" />
            
            <!-- Puntos cara superior (3) -->
            <circle cx="28" cy="18" r="3" fill="currentColor" class="text-emerald-200" />
            <circle cx="50" cy="28" r="3" fill="currentColor" class="text-emerald-200" />
            <circle cx="72" cy="38" r="3" fill="currentColor" class="text-emerald-200" />
            
            <!-- Puntos cara izquierda (5) -->
            <circle cx="16" cy="48" r="3" fill="currentColor" class="text-teal-300" />
            <circle cx="34" cy="58" r="3" fill="currentColor" class="text-teal-300" />
            <circle cx="25" cy="70" r="3" fill="currentColor" class="text-teal-300" />
            <circle cx="16" cy="82" r="3" fill="currentColor" class="text-teal-300" />
            <circle cx="34" cy="92" r="3" fill="currentColor" class="text-teal-300" />

            <!-- Puntos cara derecha (2) -->
            <circle cx="68" cy="62" r="3" fill="currentColor" class="text-emerald-300" />
            <circle cx="82" cy="78" r="3" fill="currentColor" class="text-emerald-300" />

            <!-- Cotas isométricas exteriores -->
            <line x1="108" y1="28" x2="108" y2="84" stroke-width="0.75" class="text-emerald-400/50" />
            <line x1="104" y1="28" x2="112" y2="28" stroke-width="0.75" />
            <line x1="104" y1="84" x2="112" y2="84" stroke-width="0.75" />
            <text x="115" y="60" font-family="monospace" font-size="7" fill="currentColor" class="text-emerald-300/60">H=56mm</text>
          </g>

          <!-- Peón de Juego de Mesa (Meeple Clásico) en Sección Técnica -->
          <g id="meeple-blueprint">
            <line x1="40" y1="0" x2="40" y2="120" stroke-width="0.5" stroke-dasharray="3,3" class="text-emerald-500/40" />
            <!-- Cabeza -->
            <circle cx="40" cy="22" r="14" stroke-width="1.25" class="text-emerald-300" />
            <circle cx="40" cy="22" r="10" stroke-width="0.5" stroke-dasharray="2,2" class="text-emerald-400/40" />
            <!-- Torso / Hombros -->
            <path d="M22,45 L10,55 L16,72 L26,62 L24,105 L56,105 L54,62 L64,72 L70,55 L58,45 Z" stroke-width="1.25" class="text-emerald-400/70" />
            <circle cx="40" cy="65" r="4" fill="currentColor" class="text-rose-400/70" />
          </g>

          <!-- Malla Vectorial de Trazo Pinturillo (Normalización 0 a 1000) -->
          <g id="vector-canvas-blueprint">
            <rect x="0" y="0" width="130" height="90" rx="4" stroke-width="1" class="text-cyan-400/50" />
            <line x1="15" y1="10" x2="15" y2="80" stroke-width="0.5" class="text-cyan-500/40" />
            <line x1="15" y1="80" x2="120" y2="80" stroke-width="0.5" class="text-cyan-500/40" />
            
            <!-- Curva de trazo vectorial simulada con puntos de control -->
            <path d="M25,65 Q50,15 75,50 T115,30" stroke-width="1.5" class="text-cyan-300" />
            <circle cx="25" cy="65" r="2.5" fill="currentColor" class="text-cyan-200" />
            <circle cx="50" cy="15" r="2" stroke-width="0.75" class="text-rose-400" />
            <circle cx="75" cy="50" r="2" stroke-width="0.75" class="text-rose-400" />
            <circle cx="115" cy="30" r="2.5" fill="currentColor" class="text-cyan-200" />

            <text x="20" y="20" font-family="monospace" font-size="6" fill="currentColor" class="text-cyan-300/60">[X, Y] :: 30 FPS</text>
            <text x="75" y="75" font-family="monospace" font-size="6" fill="currentColor" class="text-cyan-400/40">DELTA COMPRESSION</text>
          </g>
        </defs>

        <!-- Anotaciones de ingeniería en margen derecho -->
        <g class="text-[9px] font-mono text-emerald-400/40 select-none">
          <text x="180" y="38">FIG. II — CUBUS ISOMETRICUS &amp; VECTORES</text>
          <text x="180" y="52">PINTURILLO ENGINE • 30Hz SAMPLING</text>
          <text x="180" y="66">FAILSAFE WATCHDOG • 15s ALARM</text>
        </g>

        <!-- Dado isométrico superior derecho -->
        <use href="#isometric-dice-blueprint" x="200" y="85" transform="scale(0.95)" />

        <!-- Segundo dado con rotación complementaria -->
        <use href="#isometric-dice-blueprint" x="140" y="195" transform="scale(0.75) rotate(-24 180 230)" />

        <!-- Peón de juego en sección técnica -->
        <use href="#meeple-blueprint" x="220" y="350" transform="scale(0.90)" />

        <!-- Malla vectorial de Pinturillo intermedia -->
        <use href="#vector-canvas-blueprint" x="190" y="520" transform="scale(0.95)" />

        <!-- Casillero de avance al pie -->
        <g transform="translate(180, 680)" class="text-emerald-400/40 font-mono text-[8px]">
          <rect x="0" y="0" width="35" height="35" rx="3" stroke-width="0.75" />
          <text x="10" y="22">01</text>
          <rect x="40" y="0" width="35" height="35" rx="3" stroke-width="0.75" class="text-emerald-300/60" />
          <text x="50" y="22" class="text-emerald-200">02</text>
          <rect x="80" y="0" width="35" height="35" rx="3" stroke-width="0.75" />
          <text x="90" y="22">03</text>
          <rect x="120" y="0" width="35" height="35" rx="3" stroke-width="1.25" class="text-rose-400/60" />
          <text x="128" y="22" class="text-rose-300">★</text>
          <line x1="0" y1="45" x2="155" y2="45" stroke-width="0.75" stroke-dasharray="2,3" />
          <text x="0" y="60">STAGE ADVANCEMENT :: LOOP</text>
        </g>

        <!-- Notas de latencia y Cloudflare Workers -->
        <g class="text-[8px] font-mono text-emerald-500/40 select-none">
          <text x="180" y="890">ACTOR MODEL :: DURABLE OBJECTS</text>
          <text x="180" y="904">FAILSAFE DISCONNECT TIMER: 15s</text>
          <text x="180" y="918">ZERO CLUSTER OVERHEAD</text>
        </g>
      </svg>
    </div>
  </div>

  <main id="main-content" class="flex-1 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20 relative z-10">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 font-mono text-xs text-slate-400 mb-8" aria-label="Ruta de navegación">
      <a href="/" class="hover:text-white transition-colors">Inicio</a>
      <span aria-hidden="true">/</span>
      <a href="/lab" class="hover:text-white transition-colors">Lab</a>
      <span aria-hidden="true">/</span>
      <span class="text-emerald-400 font-medium" aria-current="page">Ni Idea</span>
    </nav>

    <!-- Header / Hero del Módulo -->
    <header class="mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-tech border border-emerald-500/30 bg-emerald-950/40 text-emerald-400 font-mono text-xs mb-4">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Party Game en Especificación Congelada · Foreman 2.2.0</span>
      </div>

      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <h1 class="text-3xl sm:text-5xl font-display font-extrabold text-white tracking-tight">
            Ni Idea
          </h1>
          <p class="font-mono text-base sm:text-lg text-emerald-300 mt-2">
            Trivia rápida, dibujos dudosos y votaciones para delatar a tus amigos.
          </p>
        </div>

        <div class="flex items-center gap-2.5 shrink-0">
          <a
            href="https://github.com/Pipin333/niideaapp"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-tech font-mono text-xs font-semibold text-slate-300 hover:text-white bg-canvas hover:bg-canvas-surface border border-canvas-border hover:border-emerald-500 transition-colors"
          >
            <Icon name="github" class="w-4 h-4 text-slate-400" />
            <span>Ver repositorio</span>
          </a>
          <a
            href="#notificarme"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-tech font-mono text-xs font-bold text-slate-950 bg-gradient-to-r from-emerald-400 to-teal-400 hover:from-emerald-300 hover:to-teal-300 shadow-[0_0_20px_rgba(16,185,129,0.3)] transition-all"
          >
            <Icon name="bell" class="w-3.5 h-3.5" />
            <span>Avísame al lanzar</span>
          </a>
        </div>
      </div>

      <p class="mt-6 text-sm sm:text-base text-slate-300 leading-relaxed max-w-3xl font-sans">
        Diseñado para eliminar por completo la fricción de los party games tradicionales: <strong class="text-white">cero cuentas de usuario</strong>, <strong class="text-white">cero descargas de apps</strong> y <strong class="text-white">cero esperas</strong>. Un anfitrión proyecta la sala en la tele o Discord, los amigos escanean el QR o ingresan un código de cuatro letras desde su celular, y la ruleta decide el caos de la noche.
      </p>
    </header>

    <!-- La Tríada de Minijuegos (Sección Central) -->
    <section class="mb-16" aria-labelledby="modes-heading">
      <div class="flex items-center justify-between gap-4 mb-6 pb-3 border-b border-canvas-border">
        <h2 id="modes-heading" class="text-xl font-display font-bold text-white flex items-center gap-2">
          <Icon name="controller" class="w-5 h-5 text-emerald-400" />
          <span>La Tríada de Juego (Rotación por Ruleta)</span>
        </h2>
        <span class="font-mono text-xs text-slate-400">Hasta 16 jugadores en vivo</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- Modo 1: Trivia Rush -->
        <div class="spotlight-card p-6 rounded-xl border border-emerald-500/30 bg-slate-950/80 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="w-10 h-10 rounded-tech bg-emerald-950/60 border border-emerald-500/40 flex items-center justify-center text-emerald-400">
                <Icon name="lightning" class="w-5 h-5" />
              </div>
              <span class="font-mono text-[10px] px-2 py-0.5 rounded-tech-sm font-semibold border border-emerald-500/40 text-emerald-300 bg-emerald-950/30">
                Ego & Reflejos
              </span>
            </div>
            <h3 class="text-lg font-display font-bold text-white mb-2">1. Trivia Rush</h3>
            <p class="text-xs text-slate-300 leading-relaxed mb-4">
              Preguntas de cuatro opciones con temporizador decreciente y bonus de velocidad. 1.000 puntos base que se consumen cada milisegundo. Multiplicador de rachas por aciertos consecutivos.
            </p>
          </div>
          <div class="pt-4 border-t border-canvas-border/60 font-mono text-[11px] text-emerald-400/80 flex items-center justify-between">
            <span>Inspiración: Kahoot!</span>
            <span>Reflejos sub-20ms</span>
          </div>
        </div>

        <!-- Modo 2: Ese Eres Tú -->
        <div class="spotlight-card p-6 rounded-xl border border-rose-500/30 bg-slate-950/80 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="w-10 h-10 rounded-tech bg-rose-950/60 border border-rose-500/40 flex items-center justify-center text-rose-400">
                <Icon name="people" class="w-5 h-5" />
              </div>
              <span class="font-mono text-[10px] px-2 py-0.5 rounded-tech-sm font-semibold border border-rose-500/40 text-rose-300 bg-rose-950/30">
                Delación Social
              </span>
            </div>
            <h3 class="text-lg font-display font-bold text-white mb-2">2. Ese Eres Tú</h3>
            <p class="text-xs text-slate-300 leading-relaxed mb-4">
              Premisas para arruinar amistades (<em>"¿Quién es más probable que termine preso?"</em>). Las opciones son los nombres de los amigos en la sala y todos votan en secreto para delatar al culpable.
            </p>
          </div>
          <div class="pt-4 border-t border-canvas-border/60 font-mono text-[11px] text-rose-400/80 flex items-center justify-between">
            <span>Inspiración: That's You!</span>
            <span>Votación anónima</span>
          </div>
        </div>

        <!-- Modo 3: Pinturillo -->
        <div class="spotlight-card p-6 rounded-xl border border-cyan-500/30 bg-slate-950/80 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="w-10 h-10 rounded-tech bg-cyan-950/60 border border-cyan-500/40 flex items-center justify-center text-cyan-400">
                <Icon name="palette" class="w-5 h-5" />
              </div>
              <span class="font-mono text-[10px] px-2 py-0.5 rounded-tech-sm font-semibold border border-cyan-500/40 text-cyan-300 bg-cyan-950/30">
                Ridículo & Risa
              </span>
            </div>
            <h3 class="text-lg font-display font-bold text-white mb-2">3. Pinturillo</h3>
            <p class="text-xs text-slate-300 leading-relaxed mb-4">
              Al jugador de turno le toca una palabra secreta y un lienzo canvas táctil para dibujar con el dedo. Los trazos se transmiten a 30 FPS y el resto teclea a toda velocidad para adivinar.
            </p>
          </div>
          <div class="pt-4 border-t border-canvas-border/60 font-mono text-[11px] text-cyan-400/80 flex items-center justify-between">
            <span>Inspiración: Skribbl.io</span>
            <span>Canvas vectorial táctil</span>
          </div>
        </div>

      </div>
    </section>

    <!-- Arquitectura & Salvaguardas MAGI -->
    <section class="mb-16" aria-labelledby="tech-heading">
      <div class="flex items-center justify-between gap-4 mb-6 pb-3 border-b border-canvas-border">
        <h2 id="tech-heading" class="text-xl font-display font-bold text-white flex items-center gap-2">
          <Icon name="cpu" class="w-5 h-5 text-emerald-400" />
          <span>Arquitectura Distribuida & Salvaguardas en Vivo</span>
        </h2>
        <span class="font-mono text-xs text-slate-400">Cloudflare SCL</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- Caja de Arquitectura -->
        <div class="p-6 rounded-xl border border-canvas-border bg-canvas-surface space-y-3 font-mono text-xs">
          <div class="text-xs font-bold text-emerald-400 flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            <span>Cloudflare Durable Objects & WebSockets</span>
          </div>
          <p class="text-slate-300 text-xs font-sans leading-relaxed">
            Cada sala es una micro-máquina uniproceso en el edge de Cloudflare (nodo Santiago <code class="text-emerald-300">SCL</code>). Todas las respuestas se serializan en orden lineal en memoria (<span class="text-emerald-300">O(1)</span>), garantizando consistencia absoluta sin necesidad de bases de datos pesadas ni bloqueos de red.
          </p>
          <div class="pt-2 text-[11px] text-slate-400 flex flex-wrap gap-2">
            <span class="px-2 py-0.5 rounded bg-canvas border border-canvas-border">RTT &lt; 25ms</span>
            <span class="px-2 py-0.5 rounded bg-canvas border border-canvas-border">100.000 req/día gratuitas</span>
            <span class="px-2 py-0.5 rounded bg-canvas border border-canvas-border">Escalabilidad horizontal</span>
          </div>
        </div>

        <!-- Caja de Blindaje MAGI -->
        <div class="p-6 rounded-xl border border-canvas-border bg-canvas-surface space-y-3 font-mono text-xs">
          <div class="text-xs font-bold text-rose-400 flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span>
            <span>Resiliencia Anti-Carrete (MAGI Shield)</span>
          </div>
          <ul class="text-slate-300 text-xs font-sans space-y-2 leading-relaxed">
            <li>• <strong class="text-white">Watchdog Anti-AFK:</strong> Si un jugador apaga su pantalla o se va a buscar bebida, el servidor ejecuta un auto-skip forzado a los 15s para evitar que la sala se congele.</li>
            <li>• <strong class="text-white">Reconexión Transparente:</strong> Token efímero en <code class="text-rose-300">sessionStorage</code> para reenganchar al jugador con su puntaje si recarga accidentalmente la pestaña.</li>
            <li>• <strong class="text-white">Anti-Trampas:</strong> Respuestas y palabras secretas transmitidas asimétricamente para evitar trampas por DevTools.</li>
          </ul>
        </div>

      </div>
    </section>

    <!-- CTA Box: Avísame cuando esté disponible -->
    <section id="notificarme" class="spotlight-card p-8 sm:p-12 rounded-tech border border-emerald-500/40 bg-gradient-to-b from-[#061814] to-[#030712] text-center max-w-2xl mx-auto shadow-2xl relative overflow-hidden" aria-labelledby="notify-heading">
      <div class="w-12 h-12 rounded-tech bg-emerald-950/80 border border-emerald-500/40 flex items-center justify-center text-emerald-400 mx-auto mb-4">
        <Icon name="bell" class="w-6 h-6" />
      </div>

      <h2 id="notify-heading" class="text-2xl sm:text-3xl font-display font-bold text-white mb-2">
        ¿Quieres probar la primera sala beta?
      </h2>
      <p class="text-xs sm:text-sm text-slate-300 max-w-md mx-auto mb-8 font-sans leading-relaxed">
        Déjanos tu correo y te enviaremos una invitación directa al abrir las primeras salas de prueba cerradas con tus amigos. Cero spam, solo aviso de lanzamiento.
      </p>

      <!-- Formulario de Notificación -->
      <div id="notify-container" class="max-w-md mx-auto">
        <form id="notify-form" class="space-y-3 text-left">
          <div class="relative">
            <input
              type="email"
              id="notify-email"
              name="email"
              required
              placeholder="tu.correo@ejemplo.com"
              class="w-full px-4 py-3 rounded-tech bg-slate-950/90 border border-emerald-500/40 text-white placeholder-slate-500 font-mono text-xs sm:text-sm focus:outline-none focus:border-emerald-400 focus:ring-1 focus:ring-emerald-400 transition-colors"
            />
          </div>

          <button
            type="submit"
            id="notify-submit-btn"
            class="w-full py-3 rounded-tech font-mono text-xs sm:text-sm font-bold text-slate-950 bg-gradient-to-r from-emerald-400 via-teal-300 to-emerald-400 hover:from-emerald-300 hover:to-teal-200 shadow-[0_0_20px_rgba(16,185,129,0.35)] transition-all flex items-center justify-center gap-2"
          >
            <span>Reservar pase para la primera beta</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>
        </form>

        <!-- Ficha de Acceso Temática (ACK State In-Character) -->
        <div id="notify-ticket" class="hidden text-left p-5 rounded-xl border border-emerald-500/50 bg-[#061814] space-y-3 font-mono shadow-[0_0_25px_rgba(16,185,129,0.2)] animate-fade-in">
          <div class="flex items-center justify-between border-b border-emerald-500/30 pb-2.5">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
              <span class="text-xs font-bold text-emerald-300 tracking-wider">FICHA DE ACCESO BETA #001</span>
            </div>
            <span class="text-[10px] text-emerald-400/60 font-mono">SCL-EDGE-PARTY</span>
          </div>

          <p class="text-xs sm:text-sm text-slate-200 font-sans leading-relaxed">
            <strong class="text-white">¡Mesa reservada!</strong> Quedaste anotado para hostear la primera partida. Cuando giremos la ruleta del servidor en Santiago, te llegará el enlace directo para armar sala y delatar a tus amigos.
          </p>

          <div class="pt-2 border-t border-emerald-500/20 flex flex-wrap items-center justify-between gap-2 text-[11px]">
            <div>
              <span class="text-slate-500">Destinatario:</span>
              <span id="ticket-email" class="text-emerald-300 font-semibold font-mono ml-1"></span>
            </div>
            <span class="text-emerald-400/80 font-mono">0 logins • 0 esperas • 100% gratis</span>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />

  <script>
    const notifyForm = document.getElementById('notify-form') as HTMLFormElement | null;
    const notifyEmail = document.getElementById('notify-email') as HTMLInputElement | null;
    const notifyBtn = document.getElementById('notify-submit-btn') as HTMLButtonElement | null;
    const notifyTicket = document.getElementById('notify-ticket') as HTMLDivElement | null;
    const ticketEmail = document.getElementById('ticket-email') as HTMLSpanElement | null;

    if (notifyForm && notifyEmail && notifyBtn && notifyTicket && ticketEmail) {
      notifyForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = notifyEmail.value.trim();
        if (!email) return;

        notifyBtn.disabled = true;
        notifyBtn.innerHTML = '<span>Tirando la ruleta...</span>';

        // Mostrar de inmediato la ficha con el correo del usuario
        ticketEmail.textContent = email;

        try {
          await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name: 'Reserva Beta Ni Idea',
              email: email,
              topic: 'Ficha de Sala · Ni Idea Party Game',
              message: `Solicitud de pase temprano para hostear la primera sala beta de Ni Idea: ${email}`
            })
          });
        } catch {
          // El ticket se muestra igual aunque haya bloqueo de red temporal
        } finally {
          notifyForm.classList.add('hidden');
          notifyTicket.classList.remove('hidden');
        }
      });
    }
  </script>
</Layout>
