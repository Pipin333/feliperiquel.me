---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
---

<Layout
  title="Cuánto Rinde | Logística de Carrete y Presupuesto"
  description="Calcula exactamente cuántas botellas de pisco, cerveza, mixers y bolsas de hielo comprar para tu carrete según la cantidad de personas y el perfil de consumo. Desglose en pesos chilenos ($ CLP) y exportación a WhatsApp (repo: calculadoracopete)."
>
  <Header />

  <main id="main-content" class="flex-1 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-400 mb-8" aria-label="Ruta de navegación">
      <a href="/" class="hover:text-white transition-colors">Inicio</a>
      <span aria-hidden="true">/</span>
      <a href="/lab" class="hover:text-white transition-colors">Lab</a>
      <span aria-hidden="true">/</span>
      <span class="text-brand-400 font-medium" aria-current="page">Cuánto Rinde</span>
    </nav>

    <!-- Header -->
    <div class="mb-10">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-3">
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
          Cuánto Rinde
        </h1>
        <a
          href="https://github.com/Pipin333/calculadoracopete"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-tech font-mono text-xs font-medium text-slate-300 hover:text-white bg-canvas-surface border border-canvas-border hover:border-amber-400/50 transition-colors self-start sm:self-auto"
          title="Ver repositorio canónico calculadoracopete en GitHub"
        >
          <svg class="w-3.5 h-3.5 text-slate-400" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          <span>Repo: calculadoracopete</span>
          <svg class="w-3 h-3 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
      <p class="text-base text-slate-300 leading-relaxed max-w-3xl">
        Para cuando no quieres cranearte la logística ni terminar tomando pisco tibio a las 3 AM. Calcula botellas exactas, cervezas, mixers, bolsas de hielo y la cuota justa por persona ("la vaca").
      </p>
    </div>

    <!-- Interactive Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-12">
      <!-- Controls Column (7 cols) -->
      <section class="lg:col-span-7 flex flex-col justify-between p-6 sm:p-8 rounded-2xl border border-slate-800 bg-slate-900/60 shadow-xl space-y-8" aria-labelledby="params-heading">
        <div>
          <h2 id="params-heading" class="text-sm font-semibold uppercase tracking-wider text-slate-400 mb-6">
            1. Parámetros de la Junta
          </h2>

          <!-- Personas Slider -->
          <div class="space-y-3 mb-8">
            <div class="flex items-center justify-between">
              <label for="people-count" class="text-sm font-medium text-slate-200">
                Cantidad de personas asistentes:
              </label>
              <span id="people-badge" class="px-3 py-1 rounded-lg bg-brand-500/20 border border-brand-500/40 text-brand-300 font-bold text-base">
                10 personas
              </span>
            </div>
            <input
              id="people-count"
              type="range"
              min="2"
              max="50"
              value="10"
              class="w-full h-2 bg-slate-950 rounded-lg appearance-none cursor-pointer accent-brand-500 focus-visible:ring-2 focus-visible:ring-brand-400"
            />
            <div class="flex justify-between text-[11px] text-slate-500 font-mono">
              <span>2 pers. (pareja/junta chica)</span>
              <span>25 pers.</span>
              <span>50 pers. (fiesta masiva)</span>
            </div>
          </div>

          <!-- Perfil de Sed -->
          <fieldset class="mb-8">
            <legend class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-3">
              Intensidad / Perfil de Consumo:
            </legend>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              <label class="intensity-card flex flex-col p-3.5 rounded-xl border border-slate-800 bg-slate-950/60 hover:bg-slate-950 cursor-pointer transition-all">
                <input type="radio" name="intensity" value="tranqui" class="sr-only" />
                <Icon name="snow" class="w-5 h-5 text-sky-400 mb-2" />
                <span class="text-xs font-bold text-white">Tranqui</span>
                <span class="text-[11px] text-slate-400 mt-1">1 a 2 tragos por persona. Conversa piola.</span>
              </label>

              <label class="intensity-card flex flex-col p-3.5 rounded-xl border border-brand-500/50 bg-brand-500/10 cursor-pointer transition-all">
                <input type="radio" name="intensity" value="normal" checked class="sr-only" />
                <Icon name="cup-straw" class="w-5 h-5 text-amber-400 mb-2" />
                <span class="text-xs font-bold text-white">Carrete Normal</span>
                <span class="text-[11px] text-slate-400 mt-1">3 a 5 tragos por persona. Estándar chileno.</span>
              </label>

              <label class="intensity-card flex flex-col p-3.5 rounded-xl border border-slate-800 bg-slate-950/60 hover:bg-slate-950 cursor-pointer transition-all">
                <input type="radio" name="intensity" value="vikingo" class="sr-only" />
                <Icon name="lightning-charge" class="w-5 h-5 text-rose-400 mb-2" />
                <span class="text-xs font-bold text-white">Modo Vikingo</span>
                <span class="text-[11px] text-slate-400 mt-1">6+ tragos. Hasta que las velas no ardan.</span>
              </label>
            </div>
          </fieldset>

          <!-- Duración de la junta -->
          <div class="mb-8">
            <label for="hours-select" class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">
              Duración estimada de la reunión:
            </label>
            <select
              id="hours-select"
              class="w-full rounded-xl bg-slate-950 border border-slate-800 p-3 text-slate-100 text-sm focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-colors"
            >
              <option value="3">3 horas (Previa corta / Almuerzo extendido)</option>
              <option value="5" selected>5 horas (Carrete noche estándar)</option>
              <option value="8">8 horas (Desde la tarde hasta el amanecer)</option>
            </select>
          </div>

          <!-- Selección de Bebidas -->
          <fieldset>
            <legend class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-3">
              ¿Qué se va a tomar? (Selecciona los preferidos):
            </legend>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
              <label class="flex items-center gap-2.5 p-3 rounded-xl border border-slate-800 bg-slate-950 hover:bg-slate-900 cursor-pointer text-xs font-medium text-slate-200">
                <input type="checkbox" id="drink-piscola" checked class="rounded text-brand-500 focus:ring-brand-400 bg-slate-900 border-slate-700" />
                <Icon name="cup-straw" class="w-3.5 h-3.5 text-amber-400" />
                <span>Piscola</span>
              </label>

              <label class="flex items-center gap-2.5 p-3 rounded-xl border border-slate-800 bg-slate-950 hover:bg-slate-900 cursor-pointer text-xs font-medium text-slate-200">
                <input type="checkbox" id="drink-cerveza" checked class="rounded text-brand-500 focus:ring-brand-400 bg-slate-900 border-slate-700" />
                <Icon name="cup-hot" class="w-3.5 h-3.5 text-amber-300" />
                <span>Cerveza</span>
              </label>

              <label class="flex items-center gap-2.5 p-3 rounded-xl border border-slate-800 bg-slate-950 hover:bg-slate-900 cursor-pointer text-xs font-medium text-slate-200">
                <input type="checkbox" id="drink-ginvodka" class="rounded text-brand-500 focus:ring-brand-400 bg-slate-900 border-slate-700" />
                <Icon name="eyedropper" class="w-3.5 h-3.5 text-sky-400" />
                <span>Gin / Vodka</span>
              </label>

              <label class="flex items-center gap-2.5 p-3 rounded-xl border border-slate-800 bg-slate-950 hover:bg-slate-900 cursor-pointer text-xs font-medium text-slate-200">
                <input type="checkbox" id="drink-fernet" class="rounded text-brand-500 focus:ring-brand-400 bg-slate-900 border-slate-700" />
                <Icon name="flower1" class="w-3.5 h-3.5 text-emerald-400" />
                <span>Fernet</span>
              </label>

              <label class="flex items-center gap-2.5 p-3 rounded-xl border border-slate-800 bg-slate-950 hover:bg-slate-900 cursor-pointer text-xs font-medium text-slate-200">
                <input type="checkbox" id="drink-sin-alcohol" checked class="rounded text-brand-500 focus:ring-brand-400 bg-slate-900 border-slate-700" />
                <Icon name="droplet" class="w-3.5 h-3.5 text-sky-300" />
                <span>Jugos / Agua</span>
              </label>
            </div>
          </fieldset>
        </div>
      </section>

      <!-- Output Summary Column (5 cols) -->
      <section class="lg:col-span-5 flex flex-col justify-between p-6 sm:p-8 rounded-2xl border border-slate-800 bg-slate-900/90 shadow-2xl relative overflow-hidden" aria-labelledby="summary-heading">
        <div class="absolute -right-16 -top-16 w-48 h-48 rounded-full bg-amber-500/10 blur-3xl pointer-events-none"></div>

        <div>
          <div class="flex items-center justify-between pb-4 border-b border-slate-800 mb-6">
            <h2 id="summary-heading" class="text-sm font-bold uppercase tracking-wider text-amber-400 flex items-center gap-2">
              <Icon name="clipboard-check" class="w-4 h-4" />
              <span>Lista de Compras Calculada</span>
            </h2>
            <span class="text-[11px] text-slate-400 font-mono">Con margen +10%</span>
          </div>

          <!-- Items Breakdown -->
          <ul id="items-list" class="space-y-3.5 mb-8 text-sm" aria-live="polite">
            <!-- Dynamically populated via JS -->
          </ul>

          <!-- Budget & Cuota Card -->
          <div class="p-4 rounded-xl bg-slate-950 border border-slate-800 space-y-3 mb-6">
            <div class="flex items-center justify-between text-xs text-slate-400">
              <span>Costo estimado total:</span>
              <span id="total-cost" class="font-bold text-white text-sm">$0 CLP</span>
            </div>
            <div class="pt-2 border-t border-slate-800/80 flex items-center justify-between">
              <div>
                <span class="block text-xs font-bold text-emerald-400">Cuota por persona ("La Vaca"):</span>
                <span class="text-[10px] text-slate-500">Monto parejo para transferir</span>
              </div>
              <span id="per-person-cost" class="text-xl font-extrabold text-emerald-400 font-mono">$0 CLP</span>
            </div>
          </div>
        </div>

        <div class="space-y-3 pt-4 border-t border-slate-800">
          <button
            id="share-whatsapp-btn"
            type="button"
            class="w-full inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-500 shadow-glow transition-all active:scale-[0.98]"
          >
            <Icon name="whatsapp" class="w-4 h-4" />
            <span>Enviar lista al grupo de WhatsApp</span>
          </button>

          <button
            id="copy-list-btn"
            type="button"
            class="w-full inline-flex items-center justify-center px-4 py-2.5 rounded-xl text-xs font-medium text-slate-300 bg-slate-800 hover:bg-slate-700 hover:text-white transition-colors"
          >
            <span id="copy-text">Copiar resumen al portapapeles</span>
          </button>
        </div>
      </section>
    </div>

    <!-- Practical Tips Section -->
    <aside class="grid grid-cols-1 sm:grid-cols-3 gap-6 p-6 rounded-xl border border-slate-800/60 bg-slate-900/30 text-xs text-slate-400">
      <div>
        <h3 class="font-bold text-slate-200 mb-1 flex items-center gap-1.5">
          <Icon name="snow" class="w-3.5 h-3.5 text-sky-400" />
          <span>La Regla del Hielo:</span>
        </h3>
        <p>El hielo se gasta más rápido por derretimiento ambiental que por consumo. Siempre calcula al menos 1 kg de hielo por cada 2 personas.</p>
      </div>
      <div>
        <h3 class="font-bold text-slate-200 mb-1 flex items-center gap-1.5">
          <Icon name="cup-straw" class="w-3.5 h-3.5 text-amber-400" />
          <span>Proporción Piscola:</span>
        </h3>
        <p>Una botella estándar de 750cc rinde entre 10 y 12 piscolas bien preparadas (ratio 35% pisco / 65% bebida). Cada botella requiere 1.5L de Coca-Cola.</p>
      </div>
      <div>
        <h3 class="font-bold text-slate-200 mb-1 flex items-center gap-1.5">
          <Icon name="shield-check" class="w-3.5 h-3.5 text-emerald-400" />
          <span>Consumo Responsable:</span>
        </h3>
        <p>Asegura agua potable o jugos accesibles para hidratarse entre rondas y designar conductores antes de que empiece la junta.</p>
      </div>
    </aside>
  </main>

  <Footer />
</Layout>

<script>
  // Pricing baseline reference in Chile (CLP)
  const PRICES = {
    pisco_750: 7990,      // Pisco Mistral / Alto del Carmen 35°
    coca_cola_2500: 2290, // Bebida Cola 2.5L
    cerveza_pack6: 5490,  // Pack 6 latas cerveza
    gin_vodka_750: 9990,  // Botella Gin/Vodka
    tonica_1500: 1690,    // Tónica / Ginger Ale 1.5L
    fernet_750: 10990,    // Fernet Branca
    hielo_bolsa_2kg: 1890, // Bolsa de hielo 2kg
    jugo_agua_2000: 1490   // Botella jugo / agua 2L
  };

  // State elements
  const peopleSlider = document.getElementById('people-count') as HTMLInputElement;
  const peopleBadge = document.getElementById('people-badge') as HTMLSpanElement;
  const hoursSelect = document.getElementById('hours-select') as HTMLSelectElement;
  const itemsList = document.getElementById('items-list') as HTMLUListElement;
  const totalCostEl = document.getElementById('total-cost') as HTMLSpanElement;
  const perPersonCostEl = document.getElementById('per-person-cost') as HTMLSpanElement;
  const shareWaBtn = document.getElementById('share-whatsapp-btn') as HTMLButtonElement;
  const copyBtn = document.getElementById('copy-list-btn') as HTMLButtonElement;
  const copyText = document.getElementById('copy-text') as HTMLSpanElement;

  const drinkPiscola = document.getElementById('drink-piscola') as HTMLInputElement;
  const drinkCerveza = document.getElementById('drink-cerveza') as HTMLInputElement;
  const drinkGinVodka = document.getElementById('drink-ginvodka') as HTMLInputElement;
  const drinkFernet = document.getElementById('drink-fernet') as HTMLInputElement;
  const drinkSinAlcohol = document.getElementById('drink-sin-alcohol') as HTMLInputElement;

  function formatCLP(val: number): string {
    return new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 }).format(val);
  }

  function calculate() {
    const people = parseInt(peopleSlider.value, 10);
    peopleBadge.textContent = `${people} personas`;

    const intensity = (document.querySelector('input[name="intensity"]:checked') as HTMLInputElement)?.value || 'normal';
    const hours = parseInt(hoursSelect.value, 10);

    // Multiplier based on intensity & hours
    let tragoFactor = 3.5; // normal base
    if (intensity === 'tranqui') tragoFactor = 2.0;
    if (intensity === 'vikingo') tragoFactor = 6.0;

    // Adjust for hours (relative to 5h standard)
    const hourFactor = Math.max(0.8, hours / 5.0);
    const totalTragosEvento = people * tragoFactor * hourFactor;

    // Active drink options
    const activeDrinks = [];
    if (drinkPiscola.checked) activeDrinks.push('piscola');
    if (drinkCerveza.checked) activeDrinks.push('cerveza');
    if (drinkGinVodka.checked) activeDrinks.push('ginvodka');
    if (drinkFernet.checked) activeDrinks.push('fernet');

    const totalActive = activeDrinks.length || 1;
    const tragosPorCategoria = totalTragosEvento / totalActive;

    interface CalculatedItem {
      name: string;
      quantity: number;
      unit: string;
      cost: number;
      icon: string;
    }

    const items: CalculatedItem[] = [];

    const ICONS_SVG: Record<string, string> = {
      "cup-straw": '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="w-4 h-4 text-amber-400 shrink-0" viewBox="0 0 16 16" aria-hidden="true"><path d="M13.902.334a.5.5 0 0 1-.28.65l-2.254.902-.4 1.927c.376.095.715.215.972.367.228.135.56.396.56.82q0 .069-.011.132l-.962 9.068a1.28 1.28 0 0 1-.524.93c-.488.34-1.494.87-3.01.87s-2.522-.53-3.01-.87a1.28 1.28 0 0 1-.524-.93L3.51 5.132A1 1 0 0 1 3.5 5c0-.424.332-.685.56-.82.262-.154.607-.276.99-.372C5.824 3.614 6.867 3.5 8 3.5c.712 0 1.389.045 1.985.127l.464-2.215a.5.5 0 0 1 .303-.356l2.5-1a.5.5 0 0 1 .65.278M9.768 4.607A14 14 0 0 0 8 4.5c-1.076 0-2.033.11-2.707.278A3.3 3.3 0 0 0 4.645 5c.146.073.362.15.648.222C5.967 5.39 6.924 5.5 8 5.5c.571 0 1.109-.03 1.588-.085zm.292 1.756C9.445 6.45 8.742 6.5 8 6.5c-1.133 0-2.176-.114-2.95-.308a6 6 0 0 1-.435-.127l.838 7.898q.013.121.116.195c.375.261 1.177.69 2.431.69s2.056-.429 2.431-.69q.103-.073.116-.195l.838-7.898a6 6 0 0 1-.435.127 9 9 0 0 1-.89.17"/></svg>',
      "cup-hot": '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="w-4 h-4 text-amber-300 shrink-0" viewBox="0 0 16 16" aria-hidden="true"><path fill-rule="evenodd" d="M.5 6a.5.5 0 0 0-.488.608l1.652 7.434A2.5 2.5 0 0 0 4.104 16h5.792a2.5 2.5 0 0 0 2.44-1.958l.131-.59a3 3 0 0 0 1.3-5.854l.221-.99A.5.5 0 0 0 13.5 6zM13 12.5a2 2 0 0 1-.316-.025l.867-3.898A2.001 2.001 0 0 1 13 12.5M2.64 13.825 1.123 7h11.754l-1.517 6.825A1.5 1.5 0 0 1 9.896 15H4.104a1.5 1.5 0 0 1-1.464-1.175"/><path d="m4.4.8-.003.004-.014.019a4 4 0 0 0-.204.31 2 2 0 0 0-.141.267c-.026.06-.034.092-.037.103v.004a.6.6 0 0 0 .091.248c.075.133.178.272.308.445l.01.012c.118.158.26.347.37.543.112.2.22.455.22.745 0 .188-.065.368-.119.494a3 3 0 0 1-.202.388 5 5 0 0 1-.253.382l-.018.025-.005.008-.002.002A.5.5 0 0 1 3.6 4.2l.003-.004.014-.019a4 4 0 0 0 .204-.31 2 2 0 0 0 .141-.267c.026-.06.034-.092.037-.103a.6.6 0 0 0-.09-.252A4 4 0 0 0 3.6 2.8l-.01-.012a5 5 0 0 1-.37-.543A1.53 1.53 0 0 1 3 1.5c0-.188.065-.368.119-.494.059-.138.134-.274.202-.388a6 6 0 0 1 .253-.382l.025-.035A.5.5 0 0 1 4.4.8m3 0-.003.004-.014.019a4 4 0 0 0-.204.31 2 2 0 0 0-.141.267c-.026.06-.034.092-.037.103v.004a.6.6 0 0 0 .091.248c.075.133.178.272.308.445l.01.012c.118.158.26.347.37.543.112.2.22.455.22.745 0 .188-.065.368-.119.494a3 3 0 0 1-.202.388 5 5 0 0 1-.253.382l-.018.025-.005.008-.002.002A.5.5 0 0 1 6.6 4.2l.003-.004.014-.019a4 4 0 0 0 .204-.31 2 2 0 0 0 .141-.267c.026-.06.034-.092.037-.103a.6.6 0 0 0-.09-.252A4 4 0 0 0 6.6 2.8l-.01-.012a5 5 0 0 1-.37-.543A1.53 1.53 0 0 1 6 1.5c0-.188.065-.368.119-.494.059-.138.134-.274.202-.388a6 6 0 0 1 .253-.382l.025-.035A.5.5 0 0 1 7.4.8m3 0-.003.004-.014.019a4 4 0 0 0-.204.31 2 2 0 0 0-.141.267c-.026.06-.034.092-.037.103v.004a.6.6 0 0 0 .091.248c.075.133.178.272.308.445l.01.012c.118.158.26.347.37.543.112.2.22.455.22.745 0 .188-.065.368-.119.494a3 3 0 0 1-.202.388 5 5 0 0 1-.253.382l-.018.025-.005.008-.002.002A.5.5 0 0 1 9.6 4.2l.003-.004.014-.019a4 4 0 0 0 .204-.31 2 2 0 0 0 .141-.267c.026-.06.034-.092.037-.103a.6.6 0 0 0-.09-.252A4 4 0 0 0 9.6 2.8l-.01-.012a5 5 0 0 1-.37-.543A1.53 1.53 0 0 1 9 1.5c0-.188.065-.368.119-.494.059-.138.134-.274.202-.388a6 6 0 0 1 .253-.382l.025-.035A.5.5 0 0 1 10.4.8"/></svg>',
      "eyedropper": '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="w-4 h-4 text-sky-400 shrink-0" viewBox="0 0 16 16" aria-hidden="true"><path d="M13.354.646a1.207 1.207 0 0 0-1.708 0L8.5 3.793l-.646-.647a.5.5 0 1 0-.708.708L8.293 5l-7.147 7.146A.5.5 0 0 0 1 12.5v1.793l-.854.853a.5.5 0 1 0 .708.707L1.707 15H3.5a.5.5 0 0 0 .354-.146L11 7.707l1.146 1.147a.5.5 0 0 0 .708-.708l-.647-.646 3.147-3.146a1.207 1.207 0 0 0 0-1.708zM2 12.707l7-7L10.293 7l-7 7H2z"/></svg>',
      "flower1": '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="w-4 h-4 text-emerald-400 shrink-0" viewBox="0 0 16 16" aria-hidden="true"><path d="M6.174 1.184a2 2 0 0 1 3.652 0A2 2 0 0 1 12.99 3.01a2 2 0 0 1 1.826 3.164 2 2 0 0 1 0 3.652 2 2 0 0 1-1.826 3.164 2 2 0 0 1-3.164 1.826 2 2 0 0 1-3.652 0A2 2 0 0 1 3.01 12.99a2 2 0 0 1-1.826-3.164 2 2 0 0 1 0-3.652A2 2 0 0 1 3.01 3.01a2 2 0 0 1 3.164-1.826M8 1a1 1 0 0 0-.998 1.03l.01.091q.017.116.054.226c.049.147.122.348.212.567.182.438.421.967.642 1.418L8 4.492l.08-.16c.221-.45.46-.98.642-1.418.09-.219.163-.42.212-.567q.037-.11.054-.226l.01-.09A1 1 0 0 0 8 1m0 14a1 1 0 0 0 .998-1.03l-.01-.091q-.017-.116-.054-.226c-.049-.147-.122-.348-.212-.567-.182-.438-.421-.967-.642-1.418L8 11.508l-.08.16c-.221.45-.46.98-.642 1.418-.09.219-.163.42-.212.567q-.037.11-.054.226l-.01.09A1 1 0 0 0 8 15"/></svg>',
      "snow": '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="w-4 h-4 text-sky-300 shrink-0" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 16a.5.5 0 0 1-.5-.5v-1.293l-.646.647a.5.5 0 0 1-.707-.708L7.5 12.793V8.866l-3.4 1.963-.496 1.85a.5.5 0 1 1-.966-.26l.237-.882-1.12.646a.5.5 0 0 1-.5-.866l1.12-.646-.884-.237a.5.5 0 1 1 .26-.966l1.848.495 3.4-1.963-3.4-1.963-1.848.495a.5.5 0 0 1-.258-.966l.883-.237-1.12-.646a.5.5 0 1 1 .5-.866l1.12.646-.237-.883a.5.5 0 0 1 .966-.258l.495 1.849 3.4 1.963V3.207L6.147 1.854a.5.5 0 1 1 .707-.708l.646.647V.5a.5.5 0 1 1 1 0v1.293l.647-.647a.5.5 0 1 1 .707.708L8.5 3.207v3.927l3.4-1.963.496-1.85a.5.5 0 1 1 .966.26l-.236.882 1.12-.646a.5.5 0 0 1 .5.866l-1.12.646.883.237a.5.5 0 1 1-.26.966l-1.848-.495L8.999 8l3.401 1.963 1.848-.495a.5.5 0 0 1 .259.966l-.883.237 1.12.646a.5.5 0 0 1-.5.866l-1.12-.646.236.883a.5.5 0 1 1-.966.258l-.495-1.849-3.4-1.963v3.927l1.353 1.353a.5.5 0 0 1-.707.708l-.647-.647V15.5a.5.5 0 0 1-.5.5"/></svg>',
      "droplet": '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="w-4 h-4 text-sky-400 shrink-0" viewBox="0 0 16 16" aria-hidden="true"><path fill-rule="evenodd" d="M7.21.8C7.69.295 8 0 8 0q.164.544.371 1.038c.812 1.946 2.073 3.35 3.197 4.6C12.878 7.096 14 8.345 14 10a6 6 0 0 1-12 0C2 6.668 5.58 2.517 7.21.8m.413 1.021A31 31 0 0 0 5.794 3.99c-.726.95-1.436 2.008-1.96 3.07C3.304 8.133 3 9.138 3 10a5 5 0 0 0 10 0c0-1.201-.796-2.157-2.181-3.7l-.03-.032C9.75 5.11 8.5 3.72 7.623 1.82z"/><path fill-rule="evenodd" d="M4.553 7.776c.82-1.641 1.717-2.753 2.093-3.13l.708.708c-.29.29-1.128 1.311-1.907 2.87z"/></svg>'
    };

    // 1. PISCOLA
    if (drinkPiscola.checked) {
      // 1 botella de 750 rinde ~11 vasos
      const botellasPisco = Math.ceil(tragosPorCategoria / 11);
      // Cada botella requiere 1.5L de Coca Cola -> 1 bebida de 2.5L rinde para ~1.6 botellas
      const botellasBebida = Math.ceil((botellasPisco * 1.5) / 2.5);

      items.push({
        name: "Pisco 35° (750cc)",
        quantity: botellasPisco,
        unit: "botella(s)",
        cost: botellasPisco * PRICES.pisco_750,
        icon: "cup-straw"
      });
      items.push({
        name: "Bebida Cola (2.5L)",
        quantity: botellasBebida,
        unit: "botella(s)",
        cost: botellasBebida * PRICES.coca_cola_2500,
        icon: "droplet"
      });
    }

    // 2. CERVEZA
    if (drinkCerveza.checked) {
      // En cerveza 1 trago = 1 lata
      const latasTotales = Math.ceil(tragosPorCategoria * 1.2);
      const packs6 = Math.ceil(latasTotales / 6);

      items.push({
        name: `Cerveza (${latasTotales} latas en total)`,
        quantity: packs6,
        unit: "pack(s) de 6",
        cost: packs6 * PRICES.coca_cola_2500,
        icon: "cup-hot"
      });
    }

    // 3. GIN / VODKA
    if (drinkGinVodka.checked) {
      const botellasDestilado = Math.ceil(tragosPorCategoria / 12);
      const botellasTonica = Math.ceil((botellasDestilado * 1.5) / 1.5);

      items.push({
        name: "Gin o Vodka (750cc)",
        quantity: botellasDestilado,
        unit: "botella(s)",
        cost: botellasDestilado * PRICES.gin_vodka_750,
        icon: "eyedropper"
      });
      items.push({
        name: "Tónica / Mixer (1.5L)",
        quantity: botellasTonica,
        unit: "botella(s)",
        cost: botellasTonica * PRICES.tonica_1500,
        icon: "droplet"
      });
    }

    // 4. FERNET
    if (drinkFernet.checked) {
      const botellasFernet = Math.ceil(tragosPorCategoria / 10);
      const bebidasFernet = Math.ceil(botellasFernet * 2);

      items.push({
        name: "Fernet (750cc)",
        quantity: botellasFernet,
        unit: "botella(s)",
        cost: botellasFernet * PRICES.fernet_750,
        icon: "flower1"
      });
      items.push({
        name: "Coca-Cola extra (2.5L)",
        quantity: bebidasFernet,
        unit: "botella(s)",
        cost: bebidasFernet * PRICES.coca_cola_2500,
        icon: "droplet"
      });
    }

    // 5. HIELO (1 bolsa de 2kg cada 3 personas mínimo)
    const bolsasHielo = Math.max(1, Math.ceil(people / 2.5));
    items.push({
      name: "Bolsa de Hielo (2kg)",
      quantity: bolsasHielo,
      unit: "bolsa(s)",
      cost: bolsasHielo * PRICES.hielo_bolsa_2kg,
      icon: "snow"
    });

    // 6. SIN ALCOHOL / HIDRATACIÓN
    if (drinkSinAlcohol.checked) {
      const botellasJugo = Math.max(1, Math.ceil(people / 5));
      items.push({
        name: "Jugo / Agua Mineral (2L)",
        quantity: botellasJugo,
        unit: "botella(s)",
        cost: botellasJugo * PRICES.jugo_agua_2000,
        icon: "droplet"
      });
    }

    // Render list
    itemsList.innerHTML = items.map(item => `
      <li class="flex items-center justify-between p-2.5 rounded-lg bg-slate-950/70 border border-slate-800/80">
        <div class="flex items-center gap-2.5">
          ${ICONS_SVG[item.icon] || ''}
          <div>
            <span class="font-medium text-slate-200 block text-xs">${item.name}</span>
            <span class="text-[11px] text-brand-300 font-bold">${item.quantity} ${item.unit}</span>
          </div>
        </div>
        <span class="text-xs font-mono text-slate-400 font-semibold">${formatCLP(item.cost)}</span>
      </li>
    `).join('');

    const totalCost = items.reduce((sum, it) => sum + it.cost, 0);
    const perPerson = Math.ceil(totalCost / people);

    totalCostEl.textContent = formatCLP(totalCost);
    perPersonCostEl.textContent = formatCLP(perPerson);

    return { items, totalCost, perPerson, people };
  }

  // Event Listeners
  peopleSlider?.addEventListener('input', calculate);
  hoursSelect?.addEventListener('change', calculate);

  document.querySelectorAll('input[name="intensity"]').forEach((radio) => {
    radio.addEventListener('change', (e) => {
      document.querySelectorAll('.intensity-card').forEach((card) => {
        card.classList.remove('border-brand-500/50', 'bg-brand-500/10');
        card.classList.add('border-slate-800', 'bg-slate-950/60');
      });
      const parent = (e.target as HTMLElement).closest('.intensity-card');
      parent?.classList.add('border-brand-500/50', 'bg-brand-500/10');
      parent?.classList.remove('border-slate-800', 'bg-slate-950/60');
      calculate();
    });
  });

  [drinkPiscola, drinkCerveza, drinkGinVodka, drinkFernet, drinkSinAlcohol].forEach(box => {
    box?.addEventListener('change', calculate);
  });

  // Share to WhatsApp
  shareWaBtn?.addEventListener('click', () => {
    const data = calculate();
    let text = `*LISTA DE COMPRAS CARRETE (${data.people} personas)*\n\n`;
    data.items.forEach(it => {
      text += `- ${it.name}: *${it.quantity} ${it.unit}* (~${formatCLP(it.cost)})\n`;
    });
    text += `\n*Total estimado:* ${formatCLP(data.totalCost)}`;
    text += `\n*Cuota por persona ("La Vaca"):* ${formatCLP(data.perPerson)}`;
    text += `\n\nCalculado en: https://feliperiquel.me/lab/copete`;

    const url = `https://api.whatsapp.com/send?text=${encodeURIComponent(text)}`;
    window.open(url, '_blank');
  });

  // Copy Summary
  copyBtn?.addEventListener('click', async () => {
    const data = calculate();
    let text = `LISTA DE COMPRAS (${data.people} personas):\n\n`;
    data.items.forEach(it => {
      text += `- ${it.name}: ${it.quantity} ${it.unit} (${formatCLP(it.cost)})\n`;
    });
    text += `\nTotal: ${formatCLP(data.totalCost)} | Cuota p/p: ${formatCLP(data.perPerson)}`;

    await navigator.clipboard.writeText(text);
    copyText.textContent = "¡Copiado al portapapeles!";
    setTimeout(() => {
      copyText.textContent = "Copiar resumen al portapapeles";
    }, 2000);
  });

  // Initial calculation on load
  calculate();
</script>
