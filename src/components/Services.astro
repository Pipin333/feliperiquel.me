---
// src/components/Services.astro
interface Service {
  icon: string;
  badge: string;
  title: string;
  description: string;
  features: string[];
  idealFor: string;
}

const services: Service[] = [
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />`,
    badge: "Más Solicitado",
    title: "Renovación & Rediseño Web",
    description: "Transformo sitios web lentos, anticuados o difíciles de navegar en plataformas modernas, limpias y ultrarrápidas, cuidando tu SEO actual.",
    features: [
      "Migración de sitios obsoletos o WordPress pesados a arquitectura moderna",
      "Optimización de velocidad (Core Web Vitals al 100%)",
      "Rediseño visual completo adaptado a móviles y tablets",
      "Conservación y mejora de posicionamiento en Google"
    ],
    idealFor: "Empresas y profesionales con una web que ya no refleja su calidad actual."
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />`,
    badge: "Lanzamientos",
    title: "Sitios Web & Landing Pages desde Cero",
    description: "Creamos la presencia digital de tu negocio desde la primera línea de código con enfoque estético, comercial y de captación.",
    features: [
      "Diseño a medida según la identidad y colores de tu marca",
      "Copywriting persuasivo estructurado para generar contactos",
      "Formularios de contacto directos a tu email o WhatsApp",
      "Dominio personalizado (.me, .com, .cl) con certificado SSL vitalicio"
    ],
    idealFor: "Emprendimientos, profesionales independientes o nuevas empresas."
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />`,
    badge: "Comercial & Stripe",
    title: "Cobros en Línea & Catálogo Digital",
    description: "Integra cobros seguros con tarjeta de crédito o transferencias, catálogos interactivos y agenda de reservas de servicios.",
    features: [
      "Integración de pasarela Stripe / Webpay con protección anti-fraude",
      "Cobro de señas, anticipos de servicios o productos digitales",
      "Confirmación y envío de comprobantes automáticos por email",
      "Panel sencillo para consultar pedidos o contactos recibidos"
    ],
    idealFor: "Proveedores de servicios, consultores y tiendas que quieren cobrar online sin comisiones abusivas."
  }
];
---

<section id="servicios" class="py-24 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-xs uppercase tracking-widest font-bold text-brand-400 mb-3">Servicios Especializados</h2>
      <h3 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Soluciones a la medida de tu presupuesto y objetivos
      </h3>
      <p class="mt-4 text-slate-300 text-base sm:text-lg">
        Sin plantillas genéricas sobrecargadas. Cada proyecto se construye con código limpio, arquitectura de alto rendimiento y enfoque directo a ventas.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {services.map((srv) => (
        <div class="flex flex-col justify-between rounded-3xl bg-slate-900/60 border border-slate-800 p-8 hover:border-brand-500/50 hover:shadow-glow transition-all duration-300 group">
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="w-12 h-12 rounded-2xl bg-brand-950 border border-brand-800/60 text-brand-400 flex items-center justify-center group-hover:scale-110 transition-transform">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={srv.icon} />
              </span>
              <span class="text-xs font-semibold px-3 py-1 rounded-full bg-slate-800 text-slate-300 border border-slate-700">
                {srv.badge}
              </span>
            </div>

            <h4 class="text-xl font-bold text-white mb-3 group-hover:text-brand-300 transition-colors">
              {srv.title}
            </h4>
            <p class="text-sm text-slate-400 mb-6 leading-relaxed">
              {srv.description}
            </p>

            <div class="space-y-3 mb-8 pt-6 border-t border-slate-800/80">
              <p class="text-xs font-semibold text-slate-300 uppercase tracking-wider">Incluye:</p>
              {srv.features.map((feat) => (
                <div class="flex items-start gap-2.5 text-sm text-slate-300">
                  <svg class="w-4 h-4 text-emerald-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>{feat}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="pt-6 border-t border-slate-800/60">
            <p class="text-xs text-slate-400 mb-4">
              <strong class="text-slate-300">Ideal para:</strong> {srv.idealFor}
            </p>
            <a
              href="#contacto"
              class="w-full inline-flex items-center justify-center px-4 py-3 rounded-xl text-sm font-semibold text-brand-300 bg-brand-950/80 border border-brand-800/80 hover:bg-brand-900 hover:text-white transition-colors"
            >
              Consultar por este servicio
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
