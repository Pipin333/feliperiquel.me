---
// src/components/Header.astro
interface NavItem {
  label: string;
  href: string;
  badge?: string;
}

const navItems: NavItem[] = [
  { label: "Laboratorio 🧪", href: "/lab", badge: "Live" },
  { label: "Proyectos", href: "/#proyectos" },
  { label: "Sobre mí", href: "/#sobre-mi" },
  { label: "Contacto", href: "/#contacto" }
];
---

<header class="sticky top-0 z-50 w-full border-b border-canvas-border bg-canvas/90 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-18 flex items-center justify-between">
    <!-- Brand / Tech Logo in one line -->
    <a href="/" class="flex items-center gap-3 group focus-visible:rounded-tech">
      <div class="w-9 h-9 rounded-tech bg-canvas-surface border border-canvas-border flex items-center justify-center text-telemetry transition-all duration-140 group-hover:border-telemetry group-hover:shadow-glow-cyan flex-shrink-0">
        <svg class="w-4 h-4 text-telemetry transition-transform duration-140 group-hover:scale-105" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="4 7 10 12 4 17"></polyline>
          <line x1="12" y1="17" x2="20" y2="17"></line>
        </svg>
      </div>
      <div class="flex items-center gap-2.5">
        <span class="text-base font-display font-bold tracking-tight text-white group-hover:text-telemetry transition-colors">
          feliperiquel<span class="text-telemetry">.me</span>
        </span>
        <span class="text-canvas-border font-mono text-xs hidden sm:inline">/</span>
        <span class="hidden sm:inline-flex items-center gap-1.5 font-mono text-xs text-slate-400">
          <span class="w-1.5 h-1.5 rounded-full bg-telemetry animate-pulse flex-shrink-0"></span>
          Ingeniero Civil en Informática
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-6" aria-label="Navegación principal">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="font-mono text-xs font-medium text-slate-300 hover:text-white transition-colors duration-140 focus-visible:rounded-tech px-2.5 py-1 flex items-center gap-1.5 group"
        >
          <span>{item.label}</span>
          {item.badge && (
            <span class="text-[9px] px-1.5 py-0.2 rounded-tech-sm bg-telemetry/10 text-telemetry border border-telemetry/30 group-hover:border-telemetry/60">
              {item.badge}
            </span>
          )}
        </a>
      ))}
    </nav>

    <!-- Header Action Button -->
    <div class="hidden sm:flex items-center gap-3">
      <a
        href="/#contacto"
        class="inline-flex items-center justify-center px-4 py-2 rounded-tech font-mono text-xs font-semibold text-telemetry-dark bg-telemetry hover:bg-telemetry-hover shadow-glow-cyan transition-all duration-140 hover:-translate-y-0.5"
      >
        <span>Iniciar contacto</span>
        <svg class="w-3.5 h-3.5 ml-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      type="button"
      class="md:hidden p-2 rounded-tech text-slate-400 hover:text-white hover:bg-canvas-surface border border-canvas-border focus-visible:ring-2 focus-visible:ring-telemetry"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div
    id="mobile-nav"
    class="hidden md:hidden border-b border-canvas-border bg-canvas/98 px-4 pt-3 pb-6 space-y-2"
  >
    {navItems.map((item) => (
      <a
        href={item.href}
        class="block px-3 py-2 rounded-tech font-mono text-sm font-medium text-slate-200 hover:text-white hover:bg-canvas-surface transition-colors"
      >
        {item.label}
      </a>
    ))}
    <a
      href="/#contacto"
      class="block w-full text-center px-4 py-2.5 rounded-tech font-mono text-xs font-bold text-telemetry-dark bg-telemetry hover:bg-telemetry-hover transition-colors mt-3"
    >
      Iniciar contacto
    </a>
  </div>
</header>

<script>
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileNav = document.getElementById('mobile-nav');

  if (mobileBtn && mobileNav) {
    mobileBtn.addEventListener('click', () => {
      const isExpanded = mobileBtn.getAttribute('aria-expanded') === 'true';
      mobileBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      mobileNav.classList.toggle('hidden');
    });
  }
</script>
