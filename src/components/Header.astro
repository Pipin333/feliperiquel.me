---
// src/components/Header.astro
import Icon from './Icon.astro';

interface NavItem {
  label: string;
  href: string;
  icon?: string;
}

const navItems: NavItem[] = [
  { label: "Laboratorio", href: "/lab", icon: "flask" },
  { label: "Proyectos", href: "/proyectos" },
  { label: "Sobre mí", href: "/#sobre-mi" },
  { label: "Contacto", href: "/#contacto" }
];
---

<header class="sticky top-0 z-50 w-full border-b border-canvas-border bg-canvas/90 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-18 flex items-center justify-between gap-4">
    <!-- Brand / Tech Logo in one line -->
    <a href="/" class="flex items-center gap-3 group focus-visible:rounded-tech flex-shrink-0">
      <div class="w-9 h-9 rounded-tech bg-canvas-surface border border-canvas-border flex items-center justify-center text-telemetry transition-all duration-140 group-hover:border-telemetry group-hover:shadow-glow-cyan flex-shrink-0">
        <svg class="w-4 h-4 text-telemetry transition-transform duration-140 group-hover:scale-105" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="4 7 10 12 4 17"></polyline>
          <line x1="12" y1="17" x2="20" y2="17"></line>
        </svg>
      </div>
      <div class="flex items-center gap-2.5 whitespace-nowrap">
        <span class="text-base font-display font-bold tracking-tight text-white group-hover:text-telemetry transition-colors">
          feliperiquel<span class="text-telemetry">.me</span>
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-3 lg:gap-5" aria-label="Navegación principal">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="font-mono text-xs font-medium text-slate-300 hover:text-white transition-colors duration-140 focus-visible:rounded-tech px-2.5 py-1 flex items-center gap-1.5 whitespace-nowrap group"
        >
          {item.icon && <Icon name={item.icon} class="w-3.5 h-3.5 text-telemetry flex-shrink-0" />}
          <span>{item.label}</span>
        </a>
      ))}
    </nav>

    <!-- Header Action Button -->
    <div class="flex items-center gap-2.5 flex-shrink-0">
      <a
        href="/cv"
        class="hidden sm:inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-tech font-mono text-xs font-medium text-slate-300 hover:text-white bg-canvas-surface hover:bg-canvas-raised border border-canvas-border hover:border-telemetry/50 transition-all duration-140 whitespace-nowrap flex-shrink-0"
        title="Ver currículum vitae"
      >
        <Icon name="file-earmark-text" class="w-3.5 h-3.5 text-telemetry flex-shrink-0" />
        <span>CV</span>
      </a>
      <a
        href="/#contacto"
        class="inline-flex items-center justify-center gap-2.5 px-4 py-1.5 sm:px-4 sm:py-2 rounded-tech font-mono text-xs font-semibold text-telemetry-dark bg-telemetry hover:bg-telemetry-hover shadow-glow-cyan transition-all duration-140 hover:-translate-y-0.5 whitespace-nowrap"
      >
        <Icon name="chat-dots" class="w-3.5 h-3.5 sm:hidden shrink-0" />
        <span><span class="hidden sm:inline">Iniciar </span>contacto</span>
        <svg class="w-3.5 h-3.5 hidden sm:block shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</header>
