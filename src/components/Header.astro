---
// src/components/Header.astro
interface NavItem {
  label: string;
  href: string;
}

const navItems: NavItem[] = [
  { label: "Servicios", href: "#servicios" },
  { label: "¿Por qué renovar?", href: "#diagnostico" },
  { label: "Portafolio", href: "#portafolio" },
  { label: "Proceso", href: "#proceso" },
  { label: "Cotizador", href: "#cotizador" }
];
---

<header class="sticky top-0 z-50 w-full border-b border-slate-800/80 bg-slate-950/80 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand / Logo -->
    <a href="#" class="flex items-center gap-3 group focus-visible:rounded-lg">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 to-accent-500 flex items-center justify-center font-bold text-white text-xl shadow-glow transition-transform duration-300 group-hover:scale-105">
        FR
      </div>
      <div>
        <span class="text-lg font-bold tracking-tight text-white block group-hover:text-brand-300 transition-colors">
          feliperiquel<span class="text-brand-400">.me</span>
        </span>
        <span class="inline-flex items-center gap-1.5 text-xs text-emerald-400 font-medium">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Disponible para proyectos
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-8" aria-label="Navegación principal">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="text-sm font-medium text-slate-300 hover:text-white transition-colors duration-200 focus-visible:rounded-md py-1"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Action CTA -->
    <div class="hidden sm:flex items-center gap-4">
      <a
        href="#contacto"
        class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl text-sm font-semibold text-white bg-gradient-to-r from-brand-600 to-brand-500 hover:from-brand-500 hover:to-brand-400 shadow-glow transition-all duration-300 hover:-translate-y-0.5 active:translate-y-0"
      >
        Cotizar proyecto
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      type="button"
      class="md:hidden p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800/60 focus-visible:ring-2"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div
    id="mobile-nav"
    class="hidden md:hidden border-b border-slate-800 bg-slate-900/95 px-4 pt-2 pb-6 space-y-3"
  >
    {navItems.map((item) => (
      <a
        href={item.href}
        class="block px-3 py-2 rounded-md text-base font-medium text-slate-200 hover:text-white hover:bg-slate-800 transition-colors"
      >
        {item.label}
      </a>
    ))}
    <a
      href="#contacto"
      class="block w-full text-center px-4 py-3 rounded-xl text-sm font-semibold text-white bg-brand-600 hover:bg-brand-500 transition-colors"
    >
      Cotizar proyecto
    </a>
  </div>
</header>

<script>
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileNav = document.getElementById('mobile-nav');

  if (mobileBtn && mobileNav) {
    mobileBtn.addEventListener('click', () => {
      const isExpanded = mobileBtn.getAttribute('aria-expanded') === 'true';
      mobileBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileNav.classList.toggle('hidden');
    });

    // Close when clicking nav link
    const links = mobileNav.querySelectorAll('a');
    links.forEach(link => {
      link.addEventListener('click', () => {
        mobileNav.classList.add('hidden');
        mobileBtn.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
