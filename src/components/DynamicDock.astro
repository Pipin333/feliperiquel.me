---
// src/components/DynamicDock.astro
---

<!-- FLOATING DYNAMIC ISLAND & DOCK -->
<div class="fixed bottom-5 left-1/2 -translate-x-1/2 z-50 flex flex-col items-center pointer-events-none">
  
  <!-- FLOATING CLI MODAL / PANEL (ANCHORED ABOVE THE DOCK) -->
  <div
    id="dock-cli-panel"
    class="hidden pointer-events-auto w-[92vw] max-w-2xl mb-3 rounded-tech bg-canvas-surface/98 border border-canvas-border shadow-2xl backdrop-blur-xl overflow-hidden transition-all duration-140"
    role="dialog"
    aria-label="Consola de comandos flotante"
    aria-modal="true"
  >
    <!-- Terminal Header Bar (Native macOS Style) -->
    <div class="bg-canvas border-b border-canvas-border px-3.5 py-2 flex items-center justify-between select-none">
      <!-- Left: Interactive macOS Traffic Light Buttons -->
      <div class="group/traffic flex items-center gap-2" role="toolbar" aria-label="Controles de ventana">
        <!-- Red: Close -->
        <button
          type="button"
          id="dock-cli-close-btn"
          class="w-3 h-3 rounded-full bg-rose-500 hover:bg-rose-600 flex items-center justify-center transition-all focus-visible:ring-1 focus-visible:ring-white"
          aria-label="Cerrar consola"
          title="Cerrar consola [ESC]"
        >
          <svg class="w-1.5 h-1.5 opacity-0 group-hover/traffic:opacity-100 transition-opacity stroke-rose-950 stroke-[1.75]" viewBox="0 0 6 6" fill="none" aria-hidden="true">
            <path d="M1 1l4 4M5 1L1 5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <!-- Yellow: Clear output -->
        <button
          type="button"
          id="dock-cli-minimize-btn"
          class="w-3 h-3 rounded-full bg-amber-500 hover:bg-amber-600 flex items-center justify-center transition-all focus-visible:ring-1 focus-visible:ring-white"
          aria-label="Limpiar pantalla"
          title="Limpiar pantalla [clear]"
        >
          <svg class="w-1.5 h-1.5 opacity-0 group-hover/traffic:opacity-100 transition-opacity stroke-amber-950 stroke-[1.75]" viewBox="0 0 6 6" fill="none" aria-hidden="true">
            <path d="M1 3h4" stroke-linecap="round" />
          </svg>
        </button>
        <!-- Green: Expand / Toggle Size -->
        <button
          type="button"
          id="dock-cli-expand-btn"
          class="w-3 h-3 rounded-full bg-emerald-500 hover:bg-emerald-600 flex items-center justify-center transition-all focus-visible:ring-1 focus-visible:ring-white"
          aria-label="Maximizar consola"
          title="Expandir o reducir consola"
        >
          <svg class="w-1.5 h-1.5 opacity-0 group-hover/traffic:opacity-100 transition-opacity stroke-emerald-950 stroke-[1.75]" viewBox="0 0 6 6" fill="none" aria-hidden="true">
            <path d="M3 1v4M1 3h4" stroke-linecap="round" />
          </svg>
        </button>
      </div>

      <!-- Center: Clean Session Title -->
      <div class="font-mono text-[11px] text-slate-400 font-medium tracking-tight">
        lab-terminal-session (v2.2)
      </div>

      <!-- Right: Minimal status indicator -->
      <div class="flex items-center gap-1.5 font-mono text-[10px] text-slate-500">
        <span class="w-1.5 h-1.5 rounded-full bg-telemetry animate-pulse"></span>
        <span class="hidden sm:inline">ESC para cerrar</span>
      </div>
    </div>

    <!-- Terminal Body -->
    <div class="p-4 sm:p-5 font-mono text-xs text-slate-300">
      <div class="text-slate-400 mb-3 flex items-center justify-between">
        <span>Escribe un comando o pulsa un atajo:</span>
        <span class="text-[10px] text-slate-500">felipe@lab:~$</span>
      </div>

      <!-- Quick Command Shortcut Chips -->
      <div class="flex flex-wrap gap-1.5 mb-4" id="floating-terminal-chips">
        <button type="button" data-cmd="whoami" class="px-2.5 py-1 rounded-tech-sm bg-canvas border border-canvas-border hover:border-telemetry text-telemetry text-[11px] transition-colors">
          whoami
        </button>
        <button type="button" data-cmd="lab" class="px-2.5 py-1 rounded-tech-sm bg-canvas border border-canvas-border hover:border-telemetry text-telemetry text-[11px] transition-colors">
          lab
        </button>
        <button type="button" data-cmd="repos" class="px-2.5 py-1 rounded-tech-sm bg-canvas border border-canvas-border hover:border-telemetry text-telemetry text-[11px] transition-colors">
          repos
        </button>
        <button type="button" data-cmd="contact" class="px-2.5 py-1 rounded-tech-sm bg-canvas border border-canvas-border hover:border-telemetry text-telemetry text-[11px] transition-colors">
          contact
        </button>
        <button type="button" data-cmd="clear" class="px-2.5 py-1 rounded-tech-sm bg-canvas border border-canvas-border hover:border-slate-500 text-slate-400 text-[11px] transition-colors">
          clear
        </button>
      </div>

      <!-- Output Log Area -->
      <div id="floating-terminal-output" class="space-y-2 mb-3 max-h-48 overflow-y-auto min-h-[64px] text-[12px] leading-relaxed pr-1">
        <div class="text-slate-400">
          <span class="text-telemetry font-bold">felipe@lab:~$</span> whoami
        </div>
        <div class="text-slate-200 pl-4 border-l-2 border-telemetry/40">
          Felipe Riquelme. Ingeniero Civil en Informática con foco en audio DSP, herramientas de homelab y aplicaciones web de alto rendimiento.
        </div>
      </div>

      <!-- Live Command Prompt Input Form -->
      <form id="floating-terminal-form" class="flex items-center gap-2 pt-2 border-t border-canvas-border/80">
        <span class="text-telemetry font-bold">felipe@lab:~$</span>
        <input
          type="text"
          id="floating-terminal-input"
          autocomplete="off"
          spellcheck="false"
          placeholder="escribe 'help' o un comando..."
          class="flex-1 bg-transparent border-none text-white font-mono text-xs focus:outline-none placeholder-slate-600"
          aria-label="Línea de comando interactiva flotante"
        />
        <button type="submit" class="text-slate-400 hover:text-telemetry text-[11px] font-semibold px-2 py-0.5">
          Ejecutar
        </button>
      </form>
    </div>
  </div>

  <!-- THE DOCK PILL (ISLA DINÁMICA FLOTANTE) -->
  <div class="relative pointer-events-auto group">
    <!-- Ambient glowing aura behind the dock with initial bloom and smooth decay -->
    <div class="dock-ambient-glow absolute -inset-1 rounded-full bg-gradient-to-r from-telemetry/70 via-cyan-400/50 to-domain-audio/60 blur-md pointer-events-none" aria-hidden="true"></div>

    <nav
      id="dynamic-dock-bar"
      class="dock-pill-bar relative flex items-center gap-1.5 p-1.5 rounded-full bg-[#090D17]/95 border border-telemetry/40 shadow-2xl backdrop-blur-xl text-slate-200"
      aria-label="Barra de herramientas flotante"
    >
      <!-- CLI Toggle Button -->
      <button
        type="button"
        id="dock-toggle-cli"
        class="flex items-center gap-2 px-3 py-1.5 rounded-full font-mono text-xs font-bold text-telemetry-dark bg-telemetry hover:bg-telemetry-hover shadow-glow-cyan transition-all duration-140 group/cli focus-visible:rounded-full"
        aria-expanded="false"
        aria-controls="dock-cli-panel"
        title="Abrir consola interactiva [~]"
      >
        <svg class="w-3.5 h-3.5 text-telemetry-dark group-hover/cli:scale-105 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="4 7 10 12 4 17"></polyline>
          <line x1="12" y1="17" x2="20" y2="17"></line>
        </svg>
        <span>CLI</span>
        <span class="w-1.5 h-1.5 rounded-full bg-telemetry-dark/80 animate-pulse"></span>
      </button>

      <!-- Divider -->
      <span class="w-[1px] h-4 bg-canvas-border" aria-hidden="true"></span>

      <!-- Lab Shortcut -->
      <a
        href="/lab"
        class="flex items-center gap-1 px-2.5 py-1.5 rounded-full font-mono text-xs font-medium text-slate-300 hover:text-white hover:bg-canvas-raised transition-colors"
        title="Ir al Laboratorio"
      >
        <span>🧪</span>
        <span class="hidden sm:inline">Lab</span>
      </a>

      <!-- Projects Shortcut -->
      <a
        href="/#proyectos"
        class="flex items-center gap-1 px-2.5 py-1.5 rounded-full font-mono text-xs font-medium text-slate-300 hover:text-white hover:bg-canvas-raised transition-colors"
        title="Ir a Proyectos"
      >
        <span>⚙️</span>
        <span class="hidden sm:inline">Proyectos</span>
      </a>

      <!-- Contact Shortcut -->
      <a
        href="/#contacto"
        class="flex items-center gap-1 px-2.5 py-1.5 rounded-full font-mono text-xs font-medium text-slate-300 hover:text-white hover:bg-canvas-raised transition-colors"
        title="Ir a Contacto"
      >
        <span>💬</span>
        <span class="hidden sm:inline">Contacto</span>
      </a>

      <!-- Divider -->
      <span class="w-[1px] h-4 bg-canvas-border" aria-hidden="true"></span>

      <!-- Scroll to Top Button -->
      <button
        type="button"
        id="dock-scroll-top-btn"
        class="flex items-center justify-center w-7 h-7 rounded-full text-telemetry-dark bg-telemetry hover:bg-telemetry-hover shadow-glow-cyan transition-all duration-140 focus-visible:rounded-full hover:scale-105"
        aria-label="Subir al inicio de la página"
        title="Subir al inicio"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18" />
        </svg>
      </button>
    </nav>
  </div>

</div>

<style>
  @keyframes dock-arrival-glow {
    0% {
      box-shadow: 0 0 50px 10px rgba(0, 210, 255, 0.9), 0 0 100px 25px rgba(0, 210, 255, 0.45), inset 0 0 16px rgba(0, 210, 255, 0.6);
      border-color: rgba(0, 210, 255, 1);
      transform: translateY(-4px) scale(1.03);
    }
    30% {
      box-shadow: 0 0 45px 8px rgba(0, 210, 255, 0.75), 0 0 80px 20px rgba(0, 210, 255, 0.35), inset 0 0 12px rgba(0, 210, 255, 0.4);
      border-color: rgba(0, 210, 255, 0.9);
      transform: translateY(-2px) scale(1.02);
    }
    60% {
      box-shadow: 0 0 30px 4px rgba(0, 210, 255, 0.5), 0 0 50px 10px rgba(0, 210, 255, 0.2);
      border-color: rgba(0, 210, 255, 0.65);
      transform: translateY(0) scale(1);
    }
    100% {
      box-shadow: 0 0 22px 2px rgba(0, 210, 255, 0.35), 0 10px 30px rgba(0, 0, 0, 0.85);
      border-color: rgba(0, 210, 255, 0.45);
      transform: translateY(0) scale(1);
    }
  }

  @keyframes dock-aura-decay {
    0% {
      opacity: 1;
      filter: blur(18px);
      transform: scale(1.12);
    }
    30% {
      opacity: 0.9;
      filter: blur(14px);
      transform: scale(1.05);
    }
    100% {
      opacity: 0.4;
      filter: blur(8px);
      transform: scale(1);
    }
  }

  .dock-pill-bar {
    animation: dock-arrival-glow 4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    transition: box-shadow 200ms ease, border-color 200ms ease, transform 200ms ease;
  }

  .dock-pill-bar:hover {
    box-shadow: 0 0 38px 6px rgba(0, 210, 255, 0.65), 0 0 70px 12px rgba(0, 210, 255, 0.25);
    border-color: rgba(0, 210, 255, 0.85);
    transform: translateY(-2px);
  }

  .dock-ambient-glow {
    animation: dock-aura-decay 4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    transition: opacity 200ms ease, filter 200ms ease;
  }

  .group:hover .dock-ambient-glow {
    opacity: 0.85;
    filter: blur(14px);
  }

  @media (prefers-reduced-motion: reduce) {
    .dock-pill-bar,
    .dock-ambient-glow {
      animation: none !important;
    }
  }
</style>

<!-- SCRIPT: FLOATING DOCK & TERMINAL CONTROLLER -->
<script>
  const cliPanel = document.getElementById('dock-cli-panel');
  const cliToggleBtn = document.getElementById('dock-toggle-cli');
  const cliCloseBtn = document.getElementById('dock-cli-close-btn');
  const cliMinBtn = document.getElementById('dock-cli-minimize-btn');
  const cliExpandBtn = document.getElementById('dock-cli-expand-btn');
  const outputEl = document.getElementById('floating-terminal-output');
  const inputEl = document.getElementById('floating-terminal-input') as HTMLInputElement | null;
  const formEl = document.getElementById('floating-terminal-form');
  const chipsContainer = document.getElementById('floating-terminal-chips');
  const scrollTopBtn = document.getElementById('dock-scroll-top-btn');

  const commandResponses: Record<string, string> = {
    whoami: 'Felipe Riquelme. Ingeniero Civil en Informática especializado en desarrollo web de alto rendimiento, DSP de audio y homelab.',
    help: 'Comandos disponibles: whoami, lab, repos, contact, clear. También puedes pulsar los botones de atajo.',
    lab: 'El Laboratorio contiene 3 micro-apps en vivo: SonicRip Studio (Audio DSP), Retórica y Descalabro (NLP) y Cuánto Rinde (Logística). Navega a /lab para probarlas.',
    repos: 'Proyectos clave: Toodles (Discord Audio + RecSys ML), Whatsarr (WhatsApp + *Arr Stack + Plex), UniCalendar AI (Next.js + LLMs + Google Calendar), JD Watch Controller (Wear OS 6-Axis), AD-BSA (IEEE CEC 2020 Rank #1).',
    contact: 'Canales directos: Correo: f.riquelmesalvo@uandresbello.edu | WhatsApp: ver seccion #contacto | GitHub: @Pipin333',
    clear: ''
  };

  function toggleTerminal(forceOpen?: boolean) {
    if (!cliPanel || !cliToggleBtn) return;
    const isCurrentlyOpen = !cliPanel.classList.contains('hidden');
    const shouldOpen = forceOpen !== undefined ? forceOpen : !isCurrentlyOpen;

    if (shouldOpen) {
      cliPanel.classList.remove('hidden');
      cliToggleBtn.setAttribute('aria-expanded', 'true');
      cliToggleBtn.classList.add('ring-2', 'ring-white/90');
      if (inputEl) setTimeout(() => inputEl.focus(), 50);
    } else {
      cliPanel.classList.add('hidden');
      cliToggleBtn.setAttribute('aria-expanded', 'false');
      cliToggleBtn.classList.remove('ring-2', 'ring-white/90');
    }
  }

  function executeCommand(cmd: string) {
    if (!outputEl) return;
    const cleanCmd = cmd.trim().toLowerCase();

    if (cleanCmd === 'clear') {
      outputEl.innerHTML = '';
      return;
    }

    if (cleanCmd === '418' || cleanCmd === 'cafe' || cleanCmd === 'coffee') {
      const cmdRow = document.createElement('div');
      cmdRow.className = 'text-slate-400 mt-2 font-mono';
      cmdRow.innerHTML = `<span class="text-amber-400 font-bold">felipe@lab:~$</span> ${cleanCmd}`;

      const respRow = document.createElement('div');
      respRow.className = 'text-amber-200 pl-4 border-l-2 border-amber-500/60 font-mono text-[11px] leading-relaxed my-1.5 space-y-1.5';
      respRow.innerHTML = `
        <div class="text-amber-400 font-bold tracking-wider">
          HTTP 418 // I'M A TEAPOT (RFC 2324 / HTCPCP)
        </div>
        <pre class="text-amber-300 font-mono text-[10px] leading-none my-1 select-none">
     ( (
      ) )
   .-------.
   |  418  |]
   \\_______/
    \`=====\`
        </pre>
        <div class="text-slate-200">
          <strong class="text-white">Error de protocolo:</strong> Este servidor es una tetera y se niega a preparar café... en teoría.
        </div>
        <div class="text-slate-400 text-[10px] leading-normal pt-1 border-t border-amber-500/20">
          <span class="text-amber-300">Nota de origen:</span> De preparar litros de café en Dunkin a emprender con café de especialidad familiar y programar sistemas distribuidos. El café de verdad no se automatiza con HTTP, se extrae con paciencia.
        </div>
      `;

      outputEl.appendChild(cmdRow);
      outputEl.appendChild(respRow);
      outputEl.scrollTop = outputEl.scrollHeight;
      return;
    }

    const response = commandResponses[cleanCmd] || `Comando no reconocido: '${cleanCmd}'. Escribe 'help' para ver la lista de comandos.`;

    const cmdRow = document.createElement('div');
    cmdRow.className = 'text-slate-400 mt-2 font-mono';
    cmdRow.innerHTML = `<span class="text-telemetry font-bold">felipe@lab:~$</span> ${cleanCmd}`;

    const respRow = document.createElement('div');
    respRow.className = 'text-slate-200 pl-4 border-l-2 border-telemetry/40 font-mono text-[11px] leading-relaxed';
    respRow.textContent = response;

    outputEl.appendChild(cmdRow);
    outputEl.appendChild(respRow);

    outputEl.scrollTop = outputEl.scrollHeight;
  }

  // Toggle button clicks
  if (cliToggleBtn) {
    cliToggleBtn.addEventListener('click', () => toggleTerminal());
  }

  if (cliCloseBtn) {
    cliCloseBtn.addEventListener('click', () => toggleTerminal(false));
  }

  if (cliMinBtn) {
    cliMinBtn.addEventListener('click', () => {
      executeCommand('clear');
    });
  }

  if (cliExpandBtn) {
    cliExpandBtn.addEventListener('click', () => {
      if (outputEl) {
        outputEl.classList.toggle('max-h-48');
        outputEl.classList.toggle('max-h-[380px]');
      }
    });
  }

  // Form submit in terminal
  if (formEl && inputEl) {
    formEl.addEventListener('submit', (e) => {
      e.preventDefault();
      const val = inputEl.value;
      if (val.trim()) {
        executeCommand(val);
        inputEl.value = '';
      }
    });
  }

  // Chips click in terminal
  if (chipsContainer) {
    chipsContainer.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest('button[data-cmd]');
      if (target) {
        const cmd = target.getAttribute('data-cmd');
        if (cmd) {
          executeCommand(cmd);
          if (inputEl) inputEl.focus();
        }
      }
    });
  }

  // Smooth scroll to top
  if (scrollTopBtn) {
    scrollTopBtn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  // Global Keyboard Shortcuts (ESC to close, ~ or ` to toggle)
  window.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape' && cliPanel && !cliPanel.classList.contains('hidden')) {
      toggleTerminal(false);
    } else if ((e.key === '`' || e.key === '~') && !(e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement)) {
      e.preventDefault();
      toggleTerminal();
    }
  });
</script>
