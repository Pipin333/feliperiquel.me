---
// src/components/Hero.astro
import Icon from './Icon.astro';

const mundaneSolutions = [
  {
    problem: "Animar la junta sin descargas ni apps",
    tool: "Ni Idea",
    desc: "Party game y trivia interactiva en tiempo real con WebSockets, Canvas y temporizador en el navegador.",
    icon: "controller",
    tag: "Party Game",
    href: "/lab/quiz",
    accentColor: "text-emerald-400",
    dotColor: "bg-emerald-400",
    borderColor: "hover:border-emerald-400/60",
    glowColor: "group-hover:shadow-[0_0_20px_rgba(16,185,129,0.15)]"
  },
  {
    problem: "Probar respuesta de audífonos",
    tool: "SonicRip Studio",
    desc: "EQ paramétrico de 8 bandas (biquad), distorsión Lo-Fi y espectro VFD directo en el navegador.",
    icon: "sliders",
    tag: "Audio DSP",
    href: "/lab/sonicrip",
    accentColor: "text-domain-audio",
    dotColor: "bg-domain-audio",
    borderColor: "hover:border-cyan-400/60",
    glowColor: "group-hover:shadow-[0_0_20px_rgba(6,182,212,0.15)]"
  },
  {
    problem: "Redactar prosa decimonónica",
    tool: "Retórica & Descalabro",
    desc: "Transmutador ontológico de modismos cotidianos a tratados filosóficos con motor heurístico local.",
    icon: "bank2",
    tag: "NLP Heurístico",
    href: "/lab/retorica",
    accentColor: "text-purple-400",
    dotColor: "bg-purple-400",
    borderColor: "hover:border-purple-400/60",
    glowColor: "group-hover:shadow-[0_0_20px_rgba(168,85,247,0.15)]"
  },
  {
    problem: "Pedir series sin abrir paneles",
    tool: "Whatsarr & Homelab",
    desc: "Bot conversacional en WhatsApp para orquestar descargas y multimedia en servidor Docker casero.",
    icon: "hdd-network",
    tag: "Homelab & Bots",
    href: "/proyectos",
    accentColor: "text-telemetry",
    dotColor: "bg-telemetry",
    borderColor: "hover:border-telemetry/60",
    glowColor: "group-hover:shadow-[0_0_20px_rgba(0,210,255,0.15)]"
  }
];
---

<section class="relative overflow-hidden pt-12 pb-20 md:pt-18 md:pb-24 bg-canvas">
  <!-- Subtle technical grid background -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#1b233818_1px,transparent_1px),linear-gradient(to_bottom,#1b233818_1px,transparent_1px)] bg-[size:3rem_3rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Main Headline (Tested & Frozen) -->
    <h1 class="font-display font-extrabold text-3xl sm:text-5xl lg:text-6xl text-white text-center max-w-4xl mx-auto tracking-tight leading-[1.12] mb-6">
      Ideo soluciones sólidas hasta para el problema <span class="text-telemetry underline decoration-telemetry/40 underline-offset-8">más mundano</span>.
    </h1>

    <!-- Supporting Sentence (Tested & Frozen) -->
    <p class="font-sans text-slate-300 text-center max-w-2xl mx-auto text-base sm:text-lg leading-relaxed mb-10">
      En este sitio encontrarás mis proyectos destacados y mi laboratorio de pruebas. Soy <a href="/sobre-mi" class="font-semibold text-white hover:text-telemetry transition-colors duration-140 focus-visible:rounded-tech-sm inline-block group" title="Conocer más sobre mí">feliperiquel<span class="text-telemetry group-hover:underline">.me</span></a>: desarrollador detallista, enfocado en rigor técnico y en construir software sin rodeos.
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row flex-wrap items-center justify-center gap-3 sm:gap-3.5 max-w-2xl mx-auto mb-14">
      <a
        href="/lab"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 sm:px-6 py-3 rounded-tech font-mono text-xs font-bold text-telemetry-dark bg-telemetry hover:bg-telemetry-hover shadow-glow-cyan transition-all duration-140 hover:-translate-y-0.5 whitespace-nowrap flex-shrink-0"
      >
        <span class="whitespace-nowrap">Explorar el Laboratorio</span>
        <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>

      <a
        href="/proyectos"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 sm:px-6 py-3 rounded-tech font-mono text-xs font-medium text-slate-200 hover:text-white bg-canvas-surface hover:bg-canvas-raised border border-canvas-border hover:border-telemetry/50 transition-all duration-140 hover:-translate-y-0.5 whitespace-nowrap flex-shrink-0"
      >
        <span class="whitespace-nowrap">Ver proyectos & repos</span>
      </a>

      <a
        href="/cv"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 sm:px-6 py-3 rounded-tech font-mono text-xs font-medium text-slate-200 hover:text-white bg-canvas-surface hover:bg-canvas-raised border border-canvas-border hover:border-telemetry/50 transition-all duration-140 hover:-translate-y-0.5 whitespace-nowrap flex-shrink-0 group"
        title="Ver y descargar Currículum Vitae"
      >
        <svg class="w-4 h-4 text-telemetry group-hover:scale-110 transition-transform shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span class="whitespace-nowrap">Descargar CV</span>
      </a>
    </div>

    <!-- Engineering Capability Pillars: Problema Mundano -> Solución Sólida -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5 max-w-5xl mx-auto">
      {mundaneSolutions.map((item) => (
        <a
          href={item.href}
          class={`group p-4 rounded-tech bg-canvas-surface/70 hover:bg-canvas-surface border border-canvas-border ${item.borderColor} ${item.glowColor} transition-all duration-140 hover:-translate-y-0.5 flex flex-col justify-between text-left`}
        >
          <div>
            <!-- Header de tarjeta: Tag de Dominio + Icono -->
            <div class="flex items-center justify-between gap-2 mb-2.5">
              <div class="flex items-center gap-1.5 font-mono text-[11px] font-bold text-slate-400">
                <span class={`w-1.5 h-1.5 rounded-full ${item.dotColor} shrink-0`}></span>
                <span class="truncate">{item.tag}</span>
              </div>
              <Icon name={item.icon} class={`w-4 h-4 ${item.accentColor} shrink-0 opacity-80 group-hover:opacity-100 transition-opacity`} />
            </div>

            <!-- Problema mundano en foco -->
            <div class="text-[13px] font-bold text-white group-hover:text-slate-100 transition-colors leading-snug mb-1.5">
              {item.problem}
            </div>

            <!-- Solución técnica -->
            <p class="text-xs text-slate-300 leading-relaxed font-sans mb-3">
              <span class={`font-semibold ${item.accentColor}`}>{item.tool}:</span> {item.desc}
            </p>
          </div>

          <!-- Micro-callout inferior accesible -->
          <div class="pt-2 border-t border-canvas-border/50 flex items-center justify-between text-[11px] font-mono text-slate-400 group-hover:text-white transition-colors">
            <span>Explorar solución</span>
            <svg class="w-3 h-3 transition-transform duration-140 group-hover:translate-x-0.5 text-telemetry" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
