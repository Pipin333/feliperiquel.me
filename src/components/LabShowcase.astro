---
// src/components/LabShowcase.astro
import Icon from './Icon.astro';

interface ToolSpec {
  label: string;
  value: string;
}

interface LabTool {
  id: string;
  title: string;
  tagline: string;
  description: string;
  icon: string;
  tags: string[];
  href: string;
  canonicalHref?: string;
  canonicalLabel?: string;
  accentColor: string;
  badge: string;
  highlightBadge: string;
  cardGlowClass: string;
  iconColorClass: string;
  taglineClass: string;
  btnClass: string;
  btnIconClass?: string;
  gridColor: string;
  ambientAuraClass: string;
  isComingSoon?: boolean;
  comingSoonText?: string;
  specs: ToolSpec[];
}

const featuredTools: LabTool[] = [
  {
    id: "sonicrip",
    title: "SonicRip Studio",
    tagline: "Procesador DSP, EQ de 8 Bandas & VFD Spectrum Analyzer",
    description: "Carga audio en el navegador, aplica curvas de ecualización en tiempo real (BiquadFilterNode), distorsión Lo-Fi Bitcrusher y visualiza armónicos en un analizador de espectro segmentado VFD estilo Pioneer.",
    icon: "sliders",
    tags: ["Web Audio API", "DSP", "VFD Matrix", "8-Band EQ"],
    href: "/lab/sonicrip",
    accentColor: "text-cyan-300 border-cyan-500/40 bg-cyan-950/40",
    badge: "Audio DSP",
    highlightBadge: "Destacado del Día: Procesamiento DSP",
    cardGlowClass: "border-cyan-400/50 shadow-[0_0_35px_rgba(6,182,212,0.22)]",
    iconColorClass: "text-cyan-400 bg-cyan-950/60 border-cyan-500/40",
    taglineClass: "font-mono text-cyan-300",
    btnClass: "text-slate-950 bg-gradient-to-r from-cyan-400 via-teal-300 to-cyan-400 hover:from-cyan-300 hover:to-teal-200 border border-cyan-200/50 shadow-[0_0_20px_rgba(6,182,212,0.35)]",
    btnIconClass: "text-slate-950",
    gridColor: "rgba(6, 182, 212, 0.22)",
    ambientAuraClass: "from-cyan-500/15 via-cyan-950/5 to-transparent",
    specs: [
      { label: "Display de Espectro", value: "Matriz VFD de 32 bandas con Peak Hold" },
      { label: "Motor DSP", value: "Web Audio API (8 filtros Biquad en serie)" },
      { label: "Procesamiento", value: "100% In-Browser sin subir archivos" }
    ]
  },
  {
    id: "retorica",
    title: "Retórica y Descalabro",
    tagline: "Transmutador Ontológico & Scriptorium Medieval",
    description: "Convierte modismos coloquiales y letras urbanas en tratados filosóficos decimonónicos, correspondencia diplomática de cancillería o culteranismo barroco con motor dual heurístico y BYOK LLM.",
    icon: "bank2",
    tags: ["NLP Heurístico", "BYOK LLM", "Scriptorium", "TypeScript"],
    href: "/lab/retorica",
    canonicalHref: "https://github.com/Pipin333/retorica-y-descalabro",
    canonicalLabel: "Repo Canónico",
    accentColor: "text-purple-300 border-purple-500/40 bg-purple-950/40",
    badge: "Medieval NLP",
    highlightBadge: "Destacado del Día: Lingüística & NLP",
    cardGlowClass: "border-purple-500/50 shadow-[0_0_35px_rgba(147,51,234,0.18)]",
    iconColorClass: "text-amber-400 bg-purple-950/60 border-purple-500/40",
    taglineClass: "font-serif italic text-purple-300",
    btnClass: "text-amber-100 bg-gradient-to-r from-purple-800 via-purple-700 to-indigo-900 hover:from-purple-700 hover:to-indigo-800 border border-amber-400/40 shadow-[0_0_20px_rgba(147,51,234,0.3)]",
    btnIconClass: "text-amber-300",
    gridColor: "rgba(168, 85, 247, 0.22)",
    ambientAuraClass: "from-purple-600/15 via-purple-950/5 to-transparent",
    specs: [
      { label: "Modo de Inferencia", value: "Heurístico Local + LLM Opcional" },
      { label: "Ejecución", value: "Cliente puro (cero latencia)" },
      { label: "Estilo", value: "Cancillería y Filosofía Decimonónica" }
    ]
  },
  {
    id: "copete",
    title: "Cuánto Rinde",
    tagline: "Optimizador Logístico & Presupuesto (Repo: calculadoracopete)",
    description: "Cálculo matemático de bebidas, destilados, hielo y mixers para juntas y eventos según perfil de consumo y duración. Desacoplándose como aplicación independiente con workers dedicados, privacidad y términos propios.",
    icon: "cup-straw",
    tags: ["Algoritmia", "Logística", "Presupuesto", "Workers"],
    href: "/lab/copete",
    canonicalHref: "https://github.com/Pipin333/calculadoracopete",
    canonicalLabel: "Repo Canónico",
    accentColor: "text-domain-beer border-domain-beer/30 bg-domain-beer/10",
    badge: "En Preparación",
    highlightBadge: "Destacado del Día: Algoritmia Logística",
    cardGlowClass: "border-domain-beer/40 shadow-[0_0_35px_rgba(251,191,36,0.15)]",
    iconColorClass: "text-domain-beer bg-domain-beer/10 border-domain-beer/30",
    taglineClass: "font-mono text-amber-300",
    btnClass: "text-slate-900 bg-amber-400 hover:bg-amber-300 border border-amber-300 shadow-[0_0_20px_rgba(245,158,11,0.25)]",
    btnIconClass: "text-slate-900",
    gridColor: "rgba(245, 158, 11, 0.22)",
    ambientAuraClass: "from-amber-500/15 via-amber-950/5 to-transparent",
    isComingSoon: true,
    comingSoonText: "Próximamente (En desarrollo)",
    specs: [
      { label: "Modelo de Consumo", value: "Heurística de ingesta por perfil" },
      { label: "Moneda & Formato", value: "$ CLP exacto redondeado" },
      { label: "Integración", value: "Exportador de cuota para WhatsApp" }
    ]
  }
];

// Rotación determinista diaria por día del año (cambia cada medianoche UTC de forma predecible)
const now = new Date();
const startOfYear = new Date(Date.UTC(now.getUTCFullYear(), 0, 1));
const dayOfYear = Math.floor((now.getTime() - startOfYear.getTime()) / (1000 * 60 * 60 * 24));
const spotlightIndex = dayOfYear % featuredTools.length;
const spotlight = featuredTools[spotlightIndex];
---

<section id="laboratorio" class="py-20 relative overflow-hidden bg-canvas border-b border-canvas-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Header de Sección -->
    <div class="mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-tech border border-canvas-border bg-canvas-surface text-telemetry font-mono text-xs uppercase tracking-wider mb-3">
        <Icon name="flask" class="w-3.5 h-3.5" />
        <span>Playground Interactivo</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-display font-extrabold text-white tracking-tight">
        El Laboratorio: micro-apps en vivo
      </h2>
      <p class="mt-2 text-slate-300 text-sm sm:text-base max-w-2xl leading-relaxed">
        Herramientas de software ejecutadas 100% en el cliente. Cada día destacamos un experimento en foco, con el catálogo completo disponible en el laboratorio.
      </p>
    </div>

    <!-- Spotlight Hero Card: Experimento Destacado del Día -->
    <article class={`spotlight-card group relative p-7 sm:p-10 rounded-2xl bg-canvas-surface/90 border transition-all duration-200 overflow-hidden ${spotlight.cardGlowClass}`}>
      
      <!-- Aura difusa de dominio en esquina superior -->
      <div class={`absolute -top-24 -right-24 w-96 h-96 rounded-full blur-3xl pointer-events-none z-0 bg-gradient-to-b ${spotlight.ambientAuraClass}`}></div>

      <!-- Papel Milimétrico Base Faint (Sutil en reposo) -->
      <div
        class="absolute inset-0 pointer-events-none select-none z-0"
        style={`background-image: linear-gradient(to right, ${spotlight.gridColor} 1px, transparent 1px), linear-gradient(to bottom, ${spotlight.gridColor} 1px, transparent 1px); background-size: 28px 28px; opacity: 0.05;`}
        aria-hidden="true"
      ></div>

      <!-- Papel Milimétrico Reactivo al Spotlight del Cursor (Se revela circularmente bajo el mouse) -->
      <div
        class="absolute inset-0 pointer-events-none select-none z-0 opacity-0 group-hover:opacity-100 transition-opacity duration-200"
        style={`
          background-image: linear-gradient(to right, ${spotlight.gridColor} 1.25px, transparent 1.25px), linear-gradient(to bottom, ${spotlight.gridColor} 1.25px, transparent 1.25px);
          background-size: 28px 28px;
          mask-image: radial-gradient(380px circle at var(--mouse-x, -9999px) var(--mouse-y, -9999px), black 20%, rgba(0,0,0,0.3) 65%, transparent 100%);
          -webkit-mask-image: radial-gradient(380px circle at var(--mouse-x, -9999px) var(--mouse-y, -9999px), black 20%, rgba(0,0,0,0.3) 65%, transparent 100%);
        `}
        aria-hidden="true"
      ></div>

      <!-- Marca de Agua Técnica a Toda la Altura (Corte Transversal al 50% en el Borde Derecho) -->
      {spotlight.id === "retorica" && (
        <svg class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-[45%] group-hover:translate-x-[40%] h-[125%] w-[340px] pointer-events-none select-none z-0 text-purple-400 opacity-[0.08] group-hover:opacity-[0.24] transition-all duration-300" viewBox="0 0 240 420" fill="none" stroke="currentColor">
          <line x1="120" y1="10" x2="120" y2="410" stroke-width="0.75" stroke-dasharray="3,3" class="text-purple-300/40" />
          <line x1="10" y1="210" x2="230" y2="210" stroke-width="0.75" stroke-dasharray="3,3" class="text-amber-400/40" />
          <circle cx="120" cy="210" r="140" stroke-width="0.5" stroke-dasharray="4,6" class="text-purple-500/30" />
          <circle cx="120" cy="210" r="95" stroke-width="0.75" stroke-dasharray="2,4" class="text-amber-400/40" />
          <g transform="translate(120, 210) scale(1.6)">
            <path d="M0,-85 C6,-50 20,-30 20,-5 C12,-8 -2,-8 -8,-5 C-8,-30 -2,-50 0,-85 Z" stroke-width="1.25" class="text-amber-400" />
            <path d="M-8,-5 C-25,-12 -50,-18 -52,4 C-55,26 -28,32 -14,12 C-12,8 -9,3 -8,-5 Z" stroke-width="1" class="text-purple-300" />
            <path d="M20,-5 C37,-12 62,-18 64,4 C67,26 40,32 26,12 C24,8 21,3 20,-5 Z" stroke-width="1" class="text-purple-300" />
            <path d="M-30,4 L38,4 L35,16 L-27,16 Z" stroke-width="1.25" class="text-amber-400" />
            <circle cx="4" cy="10" r="2.5" fill="currentColor" class="text-amber-300" />
            <path d="M-10,16 C-7,34 4,46 4,46 C4,46 15,34 18,16 Z" stroke-width="1" class="text-purple-300" />
          </g>
          <line x1="20" y1="65" x2="105" y2="65" stroke-width="0.75" class="text-amber-400/50" />
          <text x="22" y="58" font-family="monospace" font-size="8" fill="currentColor" class="text-amber-300/70">FIG. I — FLOS LILII MAGNA</text>
          <text x="22" y="77" font-family="monospace" font-size="7" fill="currentColor" class="text-purple-300/50">R=140mm • RADIALIS</text>
          <text x="22" y="375" font-family="monospace" font-size="7.5" fill="currentColor" class="text-amber-400/60">SCRIPTIRIUM • ANNO 1888</text>
          <text x="22" y="390" font-family="monospace" font-size="6.5" fill="currentColor" class="text-purple-300/40">DIPLOMATICA IMPERIALIS</text>
        </svg>
      )}

      {spotlight.id === "copete" && (
        <svg class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-[45%] group-hover:translate-x-[40%] h-[125%] w-[340px] pointer-events-none select-none z-0 text-amber-400 opacity-[0.08] group-hover:opacity-[0.24] transition-all duration-300" viewBox="0 0 240 420" fill="none" stroke="currentColor">
          <line x1="120" y1="15" x2="120" y2="405" stroke-width="0.75" stroke-dasharray="3,3" class="text-amber-500/40" />
          <ellipse cx="120" cy="45" rx="65" ry="9" stroke-width="1.25" class="text-yellow-300" />
          <ellipse cx="120" cy="45" rx="55" ry="7" stroke-width="0.75" stroke-dasharray="2,2" class="text-amber-500/40" />
          <path d="M55,45 L72,365 Q74,375 88,375 L152,375 Q166,375 168,365 L185,45" stroke-width="1.5" />
          <ellipse cx="120" cy="375" rx="36" ry="6" stroke-width="1" class="text-amber-400" />
          <path d="M72,365 L76,345 L164,345 L168,365" stroke-width="0.75" class="text-yellow-300/40" />
          <g class="text-yellow-300/70">
            <line x1="60" y1="105" x2="180" y2="105" stroke-width="1" />
            <text x="25" y="108" font-family="monospace" font-size="7.5" fill="currentColor">500ml</text>
            <line x1="63" y1="165" x2="177" y2="165" stroke-width="0.75" stroke-dasharray="3,2" />
            <text x="25" y="168" font-family="monospace" font-size="7.5" fill="currentColor">375ml</text>
            <line x1="66" y1="225" x2="174" y2="225" stroke-width="0.75" stroke-dasharray="3,2" />
            <text x="25" y="228" font-family="monospace" font-size="7.5" fill="currentColor">250ml</text>
            <line x1="69" y1="285" x2="171" y2="285" stroke-width="0.75" stroke-dasharray="3,2" />
            <text x="25" y="288" font-family="monospace" font-size="7.5" fill="currentColor">125ml</text>
          </g>
          <g transform="translate(90, 115) scale(1.3)" class="text-yellow-200/50">
            <polygon points="12,0 30,-8 42,0 24,8" stroke-width="0.75" />
            <polygon points="12,0 24,8 24,24 12,16" stroke-width="0.75" />
            <polygon points="24,8 42,0 42,16 24,24" stroke-width="0.75" />
          </g>
          <line x1="198" y1="45" x2="198" y2="375" stroke-width="0.75" class="text-amber-300/60" />
          <line x1="192" y1="45" x2="204" y2="45" stroke-width="0.75" />
          <line x1="192" y1="375" x2="204" y2="375" stroke-width="0.75" />
          <text x="204" y="215" font-family="monospace" font-size="7.5" fill="currentColor" class="text-amber-300/70">H=330mm</text>
          <text x="20" y="365" font-family="monospace" font-size="7" fill="currentColor" class="text-amber-400/60">SPEC 04 • VOLUMETRIA</text>
          <text x="20" y="380" font-family="monospace" font-size="6.5" fill="currentColor" class="text-amber-500/40">ISO 3819 • STANDARD</text>
        </svg>
      )}

      {spotlight.id === "sonicrip" && (
        <svg class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-[45%] group-hover:translate-x-[40%] h-[125%] w-[340px] pointer-events-none select-none z-0 text-cyan-400 opacity-[0.08] group-hover:opacity-[0.24] transition-all duration-300" viewBox="0 0 240 420" fill="none" stroke="currentColor">
          <line x1="120" y1="10" x2="120" y2="410" stroke-width="0.75" stroke-dasharray="3,3" class="text-cyan-500/30" />
          <path d="M30,130 C30,35 210,35 210,130" stroke-width="2" class="text-cyan-300" />
          <path d="M42,130 C42,48 198,48 198,130" stroke-width="0.75" stroke-dasharray="3,2" class="text-teal-400/40" />
          <path d="M70,55 C90,48 150,48 170,55" stroke-width="4" class="text-cyan-500/30" />
          <line x1="50" y1="85" x2="58" y2="88" stroke-width="0.75" />
          <line x1="45" y1="95" x2="53" y2="98" stroke-width="0.75" />
          <line x1="41" y1="105" x2="49" y2="108" stroke-width="0.75" />
          <g transform="translate(120, 205)">
            <path d="M-85,-20 L-65,-20 L-65,20 L-85,20" stroke-width="1.25" class="text-cyan-200" />
            <circle cx="0" cy="0" r="68" stroke-width="1.5" class="text-cyan-300" />
            <circle cx="0" cy="0" r="54" stroke-width="0.75" stroke-dasharray="3,3" class="text-teal-300/50" />
            <circle cx="0" cy="0" r="38" stroke-width="1" class="text-cyan-400" />
            <circle cx="0" cy="0" r="22" stroke-width="1.25" class="text-teal-200" />
            <circle cx="0" cy="0" r="8" fill="currentColor" class="text-cyan-300" />
            <circle cx="0" cy="0" r="62" stroke-width="0.5" stroke-dasharray="1,4" />
          </g>
          <g transform="translate(60, 315)">
            <rect x="0" y="0" width="70" height="75" rx="6" stroke-width="1" class="text-cyan-400/50" />
            <line x1="35" y1="10" x2="35" y2="65" stroke-width="1.5" class="text-cyan-300" />
            <rect x="25" y="28" width="20" height="12" rx="2" stroke-width="1.25" class="text-cyan-200" />
            <line x1="25" y1="34" x2="45" y2="34" stroke-width="1" class="text-cyan-950" />
            <line x1="12" y1="12" x2="20" y2="12" stroke-width="0.75" />
            <text x="4" y="14" font-family="monospace" font-size="6" fill="currentColor">+6</text>
            <line x1="12" y1="34" x2="20" y2="34" stroke-width="1" class="text-cyan-300" />
            <text x="4" y="36" font-family="monospace" font-size="6" fill="currentColor">0dB</text>
            <line x1="12" y1="50" x2="20" y2="50" stroke-width="0.75" />
            <text x="4" y="52" font-family="monospace" font-size="6" fill="currentColor">-10</text>
            <line x1="12" y1="63" x2="20" y2="63" stroke-width="0.75" />
            <text x="4" y="65" font-family="monospace" font-size="6" fill="currentColor">-∞</text>
          </g>
          <text x="20" y="398" font-family="monospace" font-size="7.5" fill="currentColor" class="text-cyan-300/60">Ø 50mm TITANIUM DRIVER</text>
          <text x="20" y="410" font-family="monospace" font-size="6.5" fill="currentColor" class="text-cyan-400/40">32Ω • 98dB/mW • STUDIO REF</text>
        </svg>
      )}

      <!-- Contenido Frontal de la Tarjeta (Blindado con relative z-10) -->
      <div class="relative z-10">
        <!-- Barra superior de metadatos del Spotlight -->
        <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-5 border-b border-canvas-border">
          <div class="flex items-center gap-2.5">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-tech font-mono text-xs font-semibold bg-telemetry/15 text-telemetry border border-telemetry/30">
              <span class="w-2 h-2 rounded-full bg-telemetry animate-pulse"></span>
              <span>{spotlight.highlightBadge}</span>
            </span>
            <span class="font-mono text-xs text-slate-400 hidden sm:inline-block">
              Rotación diaria automática
            </span>
          </div>

          <span class={`font-mono text-xs px-3 py-1 rounded-tech font-semibold border ${spotlight.accentColor}`}>
            {spotlight.badge}
          </span>
        </div>

        <!-- Grid Principal: Contenido (Col 7) + Specs de Arquitectura (Col 5) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <!-- Columna Izquierda: Identidad y Descripción -->
          <div class="lg:col-span-7 flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-3.5 mb-3">
                <div class={`w-12 h-12 rounded-tech flex items-center justify-center border shrink-0 ${spotlight.iconColorClass}`}>
                  <Icon name={spotlight.icon} class="w-6 h-6" />
                </div>
                <div>
                  <h3 class="text-2xl sm:text-3xl font-display font-bold text-white tracking-tight">
                    {spotlight.title}
                  </h3>
                  <p class={`text-xs sm:text-sm mt-0.5 ${spotlight.taglineClass}`}>
                    {spotlight.tagline}
                  </p>
                </div>
              </div>

              <p class="text-slate-300 text-sm sm:text-base leading-relaxed mt-4 mb-6">
                {spotlight.description}
              </p>
            </div>

            <!-- Tags Tecnológicos -->
            <div class="flex flex-wrap gap-2">
              {spotlight.tags.map((tag) => (
                <span class="font-mono text-xs px-2.5 py-1 rounded-tech-sm bg-canvas/90 text-slate-300 border border-canvas-border">
                  {tag}
                </span>
              ))}
            </div>
          </div>

          <!-- Columna Derecha: Specs de Arquitectura Limpios -->
          <div class="lg:col-span-5 bg-canvas/80 border border-canvas-border rounded-xl p-6">
            <div class="font-mono text-xs uppercase tracking-wider text-slate-400 mb-4 flex items-center gap-1.5">
              <Icon name="cpu" class="w-3.5 h-3.5 text-telemetry" />
              <span>Invariantes de Arquitectura</span>
            </div>
            <div class="space-y-3">
              {spotlight.specs.map((spec) => (
                <div class="flex flex-col sm:flex-row sm:items-center justify-between text-xs gap-1.5 py-1.5 border-b border-canvas-border/50 last:border-b-0">
                  <span class="text-slate-400 font-mono">{spec.label}</span>
                  <span class="text-slate-200 font-medium font-sans sm:text-right">{spec.value}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Barra de Acciones Inferior a Todo el Ancho (Consola de Operaciones) -->
        <div class="mt-8 pt-6 border-t border-canvas-border/70 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 sm:gap-4">
          <!-- Primary CTA (Full width en móvil, auto en desktop) -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5 sm:gap-3">
            {spotlight.isComingSoon ? (
              <button
                type="button"
                disabled
                class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-6 py-3 rounded-tech font-mono text-xs sm:text-sm font-semibold whitespace-nowrap bg-canvas-surface/90 border border-canvas-border text-slate-300 cursor-not-allowed opacity-80 select-none"
                title="Esta aplicación se encuentra actualmente en migración de infraestructura y preparación técnica."
              >
                <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse shrink-0"></span>
                <span>{spotlight.comingSoonText ?? "Próximamente"}</span>
              </button>
            ) : (
              <a
                href={spotlight.href}
                class={`w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-6 py-3 rounded-tech font-mono text-xs sm:text-sm font-bold whitespace-nowrap transition-all duration-140 group/btn ${spotlight.btnClass}`}
              >
                <span>Probar {spotlight.title} en vivo</span>
                <svg class={`w-4 h-4 transition-transform duration-140 group-hover/btn:translate-x-1 ${spotlight.btnIconClass ?? ''}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            )}

