---
// src/components/LabShowcase.astro
import Icon from './Icon.astro';
import { featuredTools } from '../data/tools';
import SonicRipWatermark from './watermarks/SonicRipWatermark.astro';
import RetoricaWatermark from './watermarks/RetoricaWatermark.astro';
import CopeteWatermark from './watermarks/CopeteWatermark.astro';

// Rotacion determinista diaria por dia del ano (cambia cada medianoche UTC de forma predecible)
const now = new Date();
const startOfYear = new Date(Date.UTC(now.getUTCFullYear(), 0, 1));
const dayOfYear = Math.floor((now.getTime() - startOfYear.getTime()) / (1000 * 60 * 60 * 24));
const spotlightIndex = dayOfYear % featuredTools.length;
const spotlight = featuredTools[spotlightIndex];
---

<section id="laboratorio" class="py-20 sm:py-24 relative overflow-hidden bg-canvas">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Header de Seccion -->
    <div class="mb-10">
      <h2 class="text-3xl sm:text-4xl font-display font-extrabold text-white tracking-tight">
        El Laboratorio: micro-apps en vivo
      </h2>
      <p class="mt-2 text-slate-300 text-sm sm:text-base max-w-2xl leading-relaxed">
        Herramientas de software ejecutadas 100% en el cliente. Cada dia destacamos un experimento en foco, con el catalogo completo disponible en el laboratorio.
      </p>
    </div>

    <!-- Spotlight Hero Card: Experimento Destacado del Dia -->
    <article class={`spotlight-card group relative p-7 sm:p-10 rounded-2xl bg-canvas-surface/90 border transition-all duration-200 overflow-hidden ${spotlight.cardGlowClass}`}>
      
      <!-- Aura difusa de dominio en esquina superior -->
      <div class={`absolute -top-24 -right-24 w-96 h-96 rounded-full blur-3xl pointer-events-none z-0 bg-gradient-to-b ${spotlight.ambientAuraClass}`}></div>

      <!-- Papel Milimetrico Base Faint (Sutil en reposo) -->
      <div
        class="absolute inset-0 pointer-events-none select-none z-0"
        style={`background-image: linear-gradient(to right, ${spotlight.gridColor} 1px, transparent 1px), linear-gradient(to bottom, ${spotlight.gridColor} 1px, transparent 1px); background-size: 28px 28px; opacity: 0.05;`}
        aria-hidden="true"
      ></div>

      <!-- Papel Milimetrico Reactivo al Spotlight del Cursor (Se revela circularmente bajo el mouse) -->
      <div
        class="absolute inset-0 pointer-events-none select-none z-0 opacity-0 group-hover:opacity-100 transition-opacity duration-200"
        style={`
          background-image: linear-gradient(to right, ${spotlight.gridColor} 1.25px, transparent 1.25px), linear-gradient(to bottom, ${spotlight.gridColor} 1.25px, transparent 1.25px);
          background-size: 28px 28px;
          mask-image: radial-gradient(380px circle at var(--mouse-x, -9999px) var(--mouse-y, -9999px), black 20%, rgba(0,0,0,0.3) 65%, transparent 100%);
          -webkit-mask-image: radial-gradient(380px circle at var(--mouse-x, -9999px) var(--mouse-y, -9999px), black 20%, rgba(0,0,0,0.3) 65%, transparent 100%);
        `}
        aria-hidden="true"
      ></div>

      <!-- Marca de Agua Tecnica a Toda la Altura (Corte Transversal al 50% en el Borde Derecho) -->
      {spotlight.id === "retorica" && <RetoricaWatermark />}
      {spotlight.id === "copete" && <CopeteWatermark />}
      {spotlight.id === "sonicrip" && <SonicRipWatermark />}

      <!-- Contenido Frontal de la Tarjeta (Blindado con relative z-10) -->
      <div class="relative z-10">
        <!-- Barra superior de metadatos del Spotlight -->
        <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-4 border-b border-canvas-border font-mono text-xs text-slate-400">
          <span class="text-telemetry font-semibold">{spotlight.highlightBadge}</span>
          <span>Rotacion diaria automatica</span>
        </div>

        <!-- Grid Principal: Contenido (Col 7) + Specs de Arquitectura (Col 5) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <!-- Columna Izquierda: Identidad y Descripcion -->
          <div class="lg:col-span-7 flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-3.5 mb-3">
                <div class={`w-12 h-12 rounded-tech flex items-center justify-center border shrink-0 ${spotlight.iconColorClass}`}>
                  <Icon name={spotlight.icon} class="w-6 h-6" />
                </div>
                <div>
                  <h3 class="text-2xl sm:text-3xl font-display font-bold text-white tracking-tight">
                    {spotlight.title}
                  </h3>
                  <p class={`text-xs sm:text-sm mt-0.5 ${spotlight.taglineClass}`}>
                    {spotlight.tagline}
                  </p>
                </div>
              </div>

              <p class="text-slate-300 text-sm sm:text-base leading-relaxed mt-4 mb-6">
                {spotlight.description}
              </p>
            </div>

            <!-- Tags Tecnologicos -->
            <div class="flex flex-wrap gap-2">
              {spotlight.tags.map((tag) => (
                <span class="font-mono text-xs px-2.5 py-1 rounded-tech-sm bg-canvas/90 text-slate-300 border border-canvas-border">
                  {tag}
                </span>
              ))}
            </div>
          </div>

          <!-- Columna Derecha: Specs de Arquitectura Limpios -->
          <div class="lg:col-span-5 bg-canvas/80 border border-canvas-border rounded-xl p-6">
            <div class="font-mono text-xs uppercase tracking-wider text-slate-400 mb-4 flex items-center gap-1.5">
              <Icon name="cpu" class="w-3.5 h-3.5 text-telemetry" />
              <span>Invariantes de Arquitectura</span>
            </div>
            <div class="space-y-3">
              {spotlight.specs.map((spec) => (
                <div class="flex flex-col sm:flex-row sm:items-center justify-between text-xs gap-1.5 py-1.5 border-b border-canvas-border/50 last:border-b-0">
                  <span class="text-slate-400 font-mono">{spec.label}</span>
                  <span class="text-slate-200 font-medium font-sans sm:text-right">{spec.value}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Barra de Acciones Inferior a Todo el Ancho (Consola de Operaciones) -->
        <div class="mt-8 pt-6 border-t border-canvas-border/70 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 sm:gap-4">
          <!-- Primary CTA (Full width en movil, auto en desktop) -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5 sm:gap-3">
            {spotlight.isComingSoon ? (
              <button
                type="button"
                disabled
                class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-6 py-3 rounded-tech font-mono text-xs sm:text-sm font-semibold whitespace-nowrap bg-canvas-surface/90 border border-canvas-border text-slate-300 cursor-not-allowed opacity-80 select-none"
                title="Esta aplicacion se encuentra actualmente en migracion de infraestructura y preparacion tecnica."
              >
                <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse shrink-0"></span>
                <span>{spotlight.comingSoonText ?? "Proximamente"}</span>
              </button>
            ) : (
              <a
                href={spotlight.href}
                class={`w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-6 py-3 rounded-tech font-mono text-xs sm:text-sm font-bold whitespace-nowrap transition-all duration-140 group/btn ${spotlight.btnClass}`}
              >
                <span>Probar {spotlight.title} en vivo</span>
                <svg class={`w-4 h-4 transition-transform duration-140 group-hover/btn:translate-x-1 ${spotlight.btnIconClass ?? ''}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            )}

            {spotlight.canonicalHref && (
              <a
                href={spotlight.canonicalHref}
                target="_blank"
                rel="noopener noreferrer"
                class="hidden sm:inline-flex items-center gap-2 px-4 py-3 rounded-tech font-mono text-xs font-semibold text-slate-300 hover:text-white bg-canvas hover:bg-canvas-surface border border-canvas-border hover:border-telemetry transition-colors shrink-0"
                title={`Ver repositorio de ${spotlight.title} en GitHub`}
              >
                <svg class="w-4 h-4 text-slate-400" fill="currentColor" viewBox="0 0 24 24">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                </svg>
                <span>Repositorio</span>
              </a>
            )}
          </div>

          <!-- Fila de Acciones Secundarias en Movil (Grid de 2 columnas simetricas) -->
          <div class="grid grid-cols-2 gap-2 sm:hidden w-full">
            {spotlight.canonicalHref && (
              <a
                href={spotlight.canonicalHref}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-1.5 px-3 py-2.5 rounded-tech font-mono text-xs font-semibold text-slate-300 hover:text-white bg-canvas hover:bg-canvas-surface border border-canvas-border hover:border-telemetry transition-colors whitespace-nowrap"
                title={`Ver repositorio de ${spotlight.title} en GitHub`}
              >
                <svg class="w-3.5 h-3.5 text-slate-400 shrink-0" fill="currentColor" viewBox="0 0 24 24">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                </svg>
                <span>Repo</span>
              </a>
            )}
            <a
              href="/lab"
              class={`inline-flex items-center justify-center gap-1.5 px-3 py-2.5 rounded-tech font-mono text-xs font-semibold text-slate-300 hover:text-white bg-canvas hover:bg-canvas-surface border border-canvas-border hover:border-telemetry transition-colors whitespace-nowrap ${!spotlight.canonicalHref ? 'col-span-2' : ''}`}
            >
              <Icon name="grid" class="w-3.5 h-3.5 text-telemetry shrink-0" />
              <span>Catalogo (4)</span>
              <svg class="w-3 h-3 text-telemetry shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>

          <!-- En Desktop: Boton de Catalogo a la derecha -->
          <a
            href="/lab"
            class="hidden sm:inline-flex items-center justify-center gap-2 px-5 py-3 rounded-tech font-mono text-xs sm:text-sm font-semibold text-slate-300 hover:text-white bg-canvas hover:bg-canvas-surface border border-canvas-border hover:border-telemetry transition-colors group/lab whitespace-nowrap shrink-0"
          >
            <Icon name="grid" class="w-4 h-4 text-telemetry" />
            <span>Ver catalogo del Lab (4 herramientas)</span>
            <svg class="w-3.5 h-3.5 text-telemetry transition-transform duration-140 group-hover/lab:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>
    </article>
  </div>
</section>
