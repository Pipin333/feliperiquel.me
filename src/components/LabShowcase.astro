---
// src/components/LabShowcase.astro
interface LabTool {
  title: string;
  tagline: string;
  description: string;
  icon: string;
  tags: string[];
  href: string;
  canonicalHref: string;
  canonicalLabel: string;
  accentColor: string;
  badge: string;
}

const featuredTools: LabTool[] = [
  {
    title: "SonicRip Studio",
    tagline: "Procesador de Audio & EQ Paramétrico de 8 Bandas",
    description: "Carga audio en el navegador, aplica curvas de ecualización en tiempo real (BiquadFilterNode), distorsión Lo-Fi Bitcrusher y visualiza armónicos en un analizador de espectro FFT.",
    icon: "🎛️",
    tags: ["Web Audio API", "DSP", "8-Band EQ", "FFT"],
    href: "/lab/sonicrip",
    canonicalHref: "https://github.com/Pipin333/Toodles",
    canonicalLabel: "Repo Audio",
    accentColor: "text-domain-audio border-domain-audio/30 bg-domain-audio/10",
    badge: "Audio DSP"
  },
  {
    title: "Retórica y Descalabro",
    tagline: "Transmutador Ontológico de Jerga Callejera",
    description: "Convierte modismos coloquiales y letras urbanas en tratados filosóficos decimonónicos, correspondencia diplomática de cancillería o culteranismo barroco con teléfono chocho.",
    icon: "🎩",
    tags: ["NLP", "Lingüística", "Humor", "TypeScript"],
    href: "/lab/retorica",
    canonicalHref: "https://github.com/Pipin333/retorica-y-descalabro",
    canonicalLabel: "Repo Canónico",
    accentColor: "text-telemetry border-telemetry/30 bg-telemetry/10",
    badge: "NLP & Satire"
  },
  {
    title: "Cuánto Rinde",
    tagline: "Optimizador Logístico & Presupuesto (Repo: calculadoracopete)",
    description: "Algoritmo predictivo de insumos (destilados, cerveza, hielo, mixers) según perfil de asistentes y horas de junta. Cuota exacta en $ CLP y exportación limpia para WhatsApp.",
    icon: "🍻",
    tags: ["Algoritmia", "Logística", "Presupuesto CLP", "WhatsApp"],
    href: "/lab/copete",
    canonicalHref: "https://github.com/Pipin333/calculadoracopete",
    canonicalLabel: "Repo Canónico",
    accentColor: "text-domain-beer border-domain-beer/30 bg-domain-beer/10",
    badge: "Logística"
  }
];
---

<section id="laboratorio" class="py-20 relative overflow-hidden bg-canvas border-b border-canvas-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-tech border border-canvas-border bg-canvas-surface text-telemetry font-mono text-xs uppercase tracking-wider mb-3">
          <span>🧪 Playground Interactivo</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-display font-extrabold text-white tracking-tight">
          El Laboratorio: micro-apps en vivo
        </h2>
        <p class="mt-2 text-slate-300 text-sm sm:text-base max-w-2xl leading-relaxed">
          Herramientas de software ejecutadas 100% en el cliente. Pruébalas directamente en tu navegador sin cuentas ni descargas.
        </p>
      </div>

      <a
        href="/lab"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-tech font-mono text-xs font-semibold text-telemetry bg-canvas-surface border border-canvas-border hover:border-telemetry hover:text-white transition-all duration-140 group shadow-glow-cyan"
      >
        <span>Ver todas las micro-apps en /lab</span>
        <svg class="w-3.5 h-3.5 transition-transform duration-140 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- 3 Featured Interactive Tools Grid with Spotlight effect -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {featuredTools.map((tool) => (
        <article class="spotlight-card group p-7 flex flex-col justify-between relative">
          <div>
            <div class="flex items-center justify-between gap-3 mb-4">
              <span class="text-3xl" aria-hidden="true">{tool.icon}</span>
              <span class={`font-mono text-[11px] px-2.5 py-0.5 rounded-tech-sm font-semibold border ${tool.accentColor}`}>
                {tool.badge}
              </span>
            </div>

            <h3 class="text-xl font-display font-bold text-white mb-1 group-hover:text-telemetry transition-colors">
              {tool.title}
            </h3>
            <p class="font-mono text-xs text-slate-400 mb-3">
              {tool.tagline}
            </p>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-6">
              {tool.description}
            </p>
          </div>

          <div>
            <div class="flex flex-wrap gap-1.5 mb-5">
              {tool.tags.map((tag) => (
                <span class="font-mono text-[11px] px-2 py-0.5 rounded-tech-sm bg-canvas text-slate-400 border border-canvas-border">
                  {tag}
                </span>
              ))}
            </div>

            <div class="flex items-center gap-2">
              <a
                href={tool.href}
                class="flex-1 inline-flex items-center justify-center px-3.5 py-2.5 rounded-tech font-mono text-xs font-bold text-telemetry-dark bg-telemetry hover:bg-telemetry-hover shadow-glow-cyan transition-all duration-140 group/btn"
              >
                <span>Abrir en vivo</span>
                <svg class="w-3.5 h-3.5 ml-1 transition-transform duration-140 group-hover/btn:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
              <a
                href={tool.canonicalHref}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 px-3 py-2.5 rounded-tech font-mono text-xs font-medium text-slate-300 hover:text-white bg-canvas-surface border border-canvas-border hover:border-telemetry transition-colors"
                title={`Ver versión canónica / repositorio de ${tool.title} en GitHub`}
                aria-label={`Ver repositorio de ${tool.title} en GitHub`}
              >
                <svg class="w-3.5 h-3.5 text-slate-300" fill="currentColor" viewBox="0 0 24 24">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                </svg>
                <span>Repo</span>
                <svg class="w-3 h-3 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
