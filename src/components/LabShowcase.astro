---
// src/components/LabShowcase.astro
import Icon from './Icon.astro';

interface ToolSpec {
  label: string;
  value: string;
}

interface LabTool {
  id: string;
  title: string;
  tagline: string;
  description: string;
  icon: string;
  tags: string[];
  href: string;
  canonicalHref?: string;
  canonicalLabel?: string;
  accentColor: string;
  badge: string;
  highlightBadge: string;
  cardGlowClass: string;
  iconColorClass: string;
  taglineClass: string;
  btnClass: string;
  btnIconClass?: string;
  specs: ToolSpec[];
}

const featuredTools: LabTool[] = [
  {
    id: "sonicrip",
    title: "SonicRip Studio",
    tagline: "Procesador de Audio & EQ Paramétrico de 8 Bandas",
    description: "Carga audio en el navegador, aplica curvas de ecualización en tiempo real (BiquadFilterNode), distorsión Lo-Fi Bitcrusher y visualiza armónicos en un analizador de espectro FFT.",
    icon: "sliders",
    tags: ["Web Audio API", "DSP", "8-Band EQ", "FFT"],
    href: "/lab/sonicrip",
    accentColor: "text-domain-audio border-domain-audio/30 bg-domain-audio/10",
    badge: "Audio DSP",
    highlightBadge: "Destacado del Día: Procesamiento DSP",
    cardGlowClass: "border-domain-audio/40 shadow-[0_0_35px_rgba(34,211,238,0.12)]",
    iconColorClass: "text-domain-audio bg-domain-audio/10 border-domain-audio/30",
    taglineClass: "font-mono text-cyan-300",
    btnClass: "text-telemetry-dark bg-telemetry hover:bg-telemetry-hover shadow-glow-cyan",
    btnIconClass: "text-telemetry-dark",
    specs: [
      { label: "Motor de Audio", value: "Web Audio API (BiquadFilterNode)" },
      { label: "Análisis Espectral", value: "FFT en tiempo real por rAF" },
      { label: "Procesamiento", value: "100% In-Browser sin subir archivos" }
    ]
  },
  {
    id: "retorica",
    title: "Retórica y Descalabro",
    tagline: "Transmutador Ontológico & Scriptorium Medieval",
    description: "Convierte modismos coloquiales y letras urbanas en tratados filosóficos decimonónicos, correspondencia diplomática de cancillería o culteranismo barroco con motor dual heurístico y BYOK LLM.",
    icon: "bank2",
    tags: ["NLP Heurístico", "BYOK LLM", "Scriptorium", "TypeScript"],
    href: "/lab/retorica",
    canonicalHref: "https://github.com/Pipin333/retorica-y-descalabro",
    canonicalLabel: "Repo Canónico",
    accentColor: "text-purple-300 border-purple-500/40 bg-purple-950/40",
    badge: "Medieval NLP",
    highlightBadge: "Destacado del Día: Lingüística & NLP",
    cardGlowClass: "border-purple-500/50 shadow-[0_0_35px_rgba(147,51,234,0.18)]",
    iconColorClass: "text-amber-400 bg-purple-950/60 border-purple-500/40",
    taglineClass: "font-serif italic text-purple-300",
    btnClass: "text-amber-100 bg-gradient-to-r from-purple-800 via-purple-700 to-indigo-900 hover:from-purple-700 hover:to-indigo-800 border border-amber-400/40 shadow-[0_0_20px_rgba(147,51,234,0.3)]",
    btnIconClass: "text-amber-300",
    specs: [
      { label: "Modo de Inferencia", value: "Heurístico Local + LLM Opcional" },
      { label: "Ejecución", value: "Cliente puro (cero latencia)" },
      { label: "Estilo", value: "Cancillería y Filosofía Decimonónica" }
    ]
  },
  {
    id: "copete",
    title: "Cuánto Rinde",
    tagline: "Optimizador Logístico & Presupuesto (Repo: calculadoracopete)",
    description: "Algoritmo predictivo de insumos (destilados, cerveza, hielo, mixers) según perfil de asistentes y horas de junta. Cuota exacta en $ CLP y exportación limpia para WhatsApp.",
    icon: "cup-straw",
    tags: ["Algoritmia", "Logística", "Presupuesto CLP", "WhatsApp"],
    href: "/lab/copete",
    canonicalHref: "https://github.com/Pipin333/calculadoracopete",
    canonicalLabel: "Repo Canónico",
    accentColor: "text-domain-beer border-domain-beer/30 bg-domain-beer/10",
    badge: "Logística",
    highlightBadge: "Destacado del Día: Algoritmia Práctica",
    cardGlowClass: "border-domain-beer/40 shadow-[0_0_35px_rgba(251,191,36,0.15)]",
    iconColorClass: "text-domain-beer bg-domain-beer/10 border-domain-beer/30",
    taglineClass: "font-mono text-amber-300",
    btnClass: "text-slate-900 bg-amber-400 hover:bg-amber-300 border border-amber-300 shadow-[0_0_20px_rgba(245,158,11,0.25)]",
    btnIconClass: "text-slate-900",
    specs: [
      { label: "Modelo de Consumo", value: "Heurística de ingesta por perfil" },
      { label: "Moneda & Formato", value: "$ CLP exacto redondeado" },
      { label: "Integración", value: "Exportador de cuota para WhatsApp" }
    ]
  }
];

// Rotación determinista diaria por día del año (cambia cada medianoche UTC de forma predecible)
const now = new Date();
const startOfYear = new Date(Date.UTC(now.getUTCFullYear(), 0, 1));
const dayOfYear = Math.floor((now.getTime() - startOfYear.getTime()) / (1000 * 60 * 60 * 24));
const spotlightIndex = dayOfYear % featuredTools.length;
const spotlight = featuredTools[spotlightIndex];
const otherTools = featuredTools.filter((_, idx) => idx !== spotlightIndex);
---

<section id="laboratorio" class="py-20 relative overflow-hidden bg-canvas border-b border-canvas-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Header de Sección -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-6">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-tech border border-canvas-border bg-canvas-surface text-telemetry font-mono text-xs uppercase tracking-wider mb-3">
          <Icon name="flask" class="w-3.5 h-3.5" />
          <span>Playground Interactivo</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-display font-extrabold text-white tracking-tight">
          El Laboratorio: micro-apps en vivo
        </h2>
        <p class="mt-2 text-slate-300 text-sm sm:text-base max-w-2xl leading-relaxed">
          Herramientas de software ejecutadas 100% en el cliente. Cada día destacamos un experimento en foco, con el catálogo completo disponible en el laboratorio.
        </p>
      </div>

      <a
        href="/lab"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-tech font-mono text-xs font-semibold text-telemetry bg-canvas-surface border border-canvas-border hover:border-telemetry hover:text-white transition-all duration-140 group shadow-glow-cyan shrink-0"
      >
        <Icon name="grid" class="w-3.5 h-3.5" />
        <span>Ver catálogo completo en /lab</span>
        <svg class="w-3.5 h-3.5 transition-transform duration-140 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- Spotlight Hero Card: Experimento Destacado del Día -->
    <article class={`spotlight-card relative p-7 sm:p-10 rounded-2xl bg-canvas-surface/90 border transition-all duration-200 ${spotlight.cardGlowClass}`}>
      <!-- Barra superior de metadatos del Spotlight -->
      <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-5 border-b border-canvas-border">
        <div class="flex items-center gap-2.5">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-tech font-mono text-xs font-semibold bg-telemetry/15 text-telemetry border border-telemetry/30">
            <span class="w-2 h-2 rounded-full bg-telemetry animate-pulse"></span>
            <span>{spotlight.highlightBadge}</span>
          </span>
          <span class="font-mono text-xs text-slate-400 hidden sm:inline-block">
            Rotación diaria automática
          </span>
        </div>

        <span class={`font-mono text-xs px-3 py-1 rounded-tech font-semibold border ${spotlight.accentColor}`}>
          {spotlight.badge}
        </span>
      </div>

      <!-- Grid Principal: Contenido + Especificaciones & CTAs -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Columna Izquierda: Identidad y Descripción -->
        <div class="lg:col-span-7 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3.5 mb-3">
              <div class={`w-12 h-12 rounded-tech flex items-center justify-center border shrink-0 ${spotlight.iconColorClass}`}>
                <Icon name={spotlight.icon} class="w-6 h-6" />
              </div>
              <div>
                <h3 class="text-2xl sm:text-3xl font-display font-bold text-white tracking-tight">
                  {spotlight.title}
                </h3>
                <p class={`text-xs sm:text-sm mt-0.5 ${spotlight.taglineClass}`}>
                  {spotlight.tagline}
                </p>
              </div>
            </div>

            <p class="text-slate-300 text-sm sm:text-base leading-relaxed mt-4 mb-6">
              {spotlight.description}
            </p>
          </div>

          <!-- Tags Tecnológicos -->
          <div class="flex flex-wrap gap-2">
            {spotlight.tags.map((tag) => (
              <span class="font-mono text-xs px-2.5 py-1 rounded-tech-sm bg-canvas text-slate-300 border border-canvas-border">
                {tag}
              </span>
            ))}
          </div>
        </div>

        <!-- Columna Derecha: Specs Técnicos & Panel de Acciones -->
        <div class="lg:col-span-5 flex flex-col justify-between bg-canvas/80 border border-canvas-border rounded-xl p-6 h-full">
          <!-- Especificaciones de Arquitectura -->
          <div class="space-y-3 mb-6">
            <div class="font-mono text-xs uppercase tracking-wider text-slate-400 mb-2 flex items-center gap-1.5">
              <Icon name="cpu" class="w-3.5 h-3.5 text-telemetry" />
              <span>Invariantes de Arquitectura</span>
            </div>
            {spotlight.specs.map((spec) => (
              <div class="flex flex-col sm:flex-row sm:items-center justify-between text-xs gap-1 py-1.5 border-b border-canvas-border/50 last:border-b-0">
                <span class="text-slate-400 font-mono">{spec.label}</span>
                <span class="text-slate-200 font-medium font-sans text-right">{spec.value}</span>
              </div>
            ))}
          </div>

          <!-- Bloque de Acciones Claras (CTA Dual) -->
          <div class="flex flex-col gap-3">
            <a
              href={spotlight.href}
              class={`w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded-tech font-mono text-xs sm:text-sm font-bold transition-all duration-140 group/btn ${spotlight.btnClass}`}
            >
              <span>Probar {spotlight.title} en vivo</span>
              <svg class={`w-4 h-4 transition-transform duration-140 group-hover/btn:translate-x-1 ${spotlight.btnIconClass ?? ''}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>

            <div class="flex items-center gap-2">
              <a
                href="/lab"
                class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-tech font-mono text-xs font-semibold text-slate-200 hover:text-white bg-canvas-surface hover:bg-canvas-surface/80 border border-canvas-border hover:border-telemetry transition-colors group/lab"
              >
                <span>Explorar todo el Lab</span>
                <svg class="w-3.5 h-3.5 text-telemetry transition-transform duration-140 group-hover/lab:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>

              {spotlight.canonicalHref && (
                <a
                  href={spotlight.canonicalHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3 py-2.5 rounded-tech font-mono text-xs font-medium text-slate-300 hover:text-white bg-canvas-surface border border-canvas-border hover:border-telemetry transition-colors"
                  title={`Ver repositorio de ${spotlight.title} en GitHub`}
                  aria-label={`Ver repositorio de ${spotlight.title} en GitHub`}
                >
                  <svg class="w-3.5 h-3.5 text-slate-300" fill="currentColor" viewBox="0 0 24 24">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                  </svg>
                  <span>Repo</span>
                </a>
              )}
            </div>
          </div>
        </div>
      </div>

      <!-- Tira de Otros Experimentos en el Catálogo -->
      <div class="mt-8 pt-6 border-t border-canvas-border flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex items-center gap-2 font-mono text-xs text-slate-400">
          <Icon name="collection" class="w-3.5 h-3.5 text-telemetry" />
          <span>Otras micro-apps disponibles en el catálogo de /lab:</span>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          {otherTools.map((other) => (
            <a
              href={other.href}
              class="inline-flex items-center gap-2 px-3 py-1.5 rounded-tech-sm bg-canvas border border-canvas-border hover:border-telemetry/50 font-mono text-xs text-slate-300 hover:text-white transition-all duration-140 group"
            >
              <Icon name={other.icon} class="w-3.5 h-3.5 text-slate-400 group-hover:text-telemetry transition-colors" />
              <span>{other.title}</span>
              <svg class="w-3 h-3 text-slate-500 group-hover:text-telemetry transition-transform duration-140 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          ))}
        </div>
      </div>
    </article>
  </div>
</section>
