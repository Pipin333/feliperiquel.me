---
// src/components/Process.astro
interface Step {
  number: string;
  title: string;
  description: string;
  deliverable: string;
}

const steps: Step[] = [
  {
    number: "01",
    title: "Diagnóstico & Planificación",
    description: "Analizamos tu negocio, tus competidores y los problemas de tu web actual (o tus metas si es un sitio nuevo). Definimos la estructura exacta para que no pagues de más.",
    deliverable: "Plan de trabajo y presupuesto cerrado"
  },
  {
    number: "02",
    title: "Diseño & Prototipo Visual",
    description: "Diseño una propuesta visual moderna y adaptada a tu marca. Revisamos los textos, colores y secciones antes de tocar una sola línea de código para asegurar que te encante.",
    deliverable: "Maqueta aprobada de tu sitio"
  },
  {
    number: "03",
    title: "Desarrollo Rápido & Pruebas",
    description: "Programación con código limpio, optimización extrema de velocidad, adaptación táctil en teléfonos y configuración de formularios y pasarelas de pago (Stripe).",
    deliverable: "Web funcional en enlace privado de prueba"
  },
  {
    number: "04",
    title: "Lanzamiento & Entrega",
    description: "Conectamos tu dominio (ej. .me, .cl, .com), activamos el certificado de seguridad SSL y te entrego una breve guía para que sepas cómo gestionar tus consultas.",
    deliverable: "Sitio 100% público y operativo"
  }
];
---

<section id="proceso" class="py-24 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-xs uppercase tracking-widest font-bold text-brand-400 mb-3">Metodología Transparente</h2>
      <h3 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Cómo trabajamos juntos paso a paso
      </h3>
      <p class="mt-4 text-slate-300 text-base sm:text-lg">
        Sin tecnicismos complicados ni sorpresas en el presupuesto. Sabrás exactamente qué esperar en cada etapa del proyecto.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {steps.map((step) => (
        <div class="relative flex flex-col justify-between p-6 sm:p-8 rounded-3xl bg-slate-900/50 border border-slate-800 hover:border-slate-700 transition-colors">
          <div>
            <div class="text-3xl font-black text-brand-500/40 mb-4 font-mono">
              {step.number}
            </div>
            <h4 class="text-xl font-bold text-white mb-3">
              {step.title}
            </h4>
            <p class="text-sm text-slate-400 leading-relaxed mb-6">
              {step.description}
            </p>
          </div>

          <div class="pt-4 border-t border-slate-800/80">
            <span class="text-xs font-semibold text-slate-500 block mb-1 uppercase tracking-wider">Entregable:</span>
            <span class="text-xs font-medium text-brand-300 bg-brand-950/60 px-2.5 py-1 rounded-md border border-brand-800/40 inline-block">
              {step.deliverable}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
