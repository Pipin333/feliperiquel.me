---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-slate-800/80 bg-slate-950 py-12 text-slate-400">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 pb-8 border-b border-slate-800/60">
      <!-- Brand -->
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-brand-600 flex items-center justify-center font-bold text-white text-sm">
          FR
        </div>
        <span class="text-base font-bold text-white tracking-tight">
          feliperiquel<span class="text-brand-400">.me</span>
        </span>
      </div>

      <!-- Quick Nav -->
      <nav class="flex flex-wrap items-center justify-center gap-6 text-sm" aria-label="Navegación del pie de página">
        <a href="#servicios" class="hover:text-white transition-colors">Servicios</a>
        <a href="#diagnostico" class="hover:text-white transition-colors">¿Por qué renovar?</a>
        <a href="#portafolio" class="hover:text-white transition-colors">Portafolio</a>
        <a href="#proceso" class="hover:text-white transition-colors">Proceso</a>
        <a href="#cotizador" class="hover:text-white transition-colors">Cotizador</a>
        <a href="#contacto" class="hover:text-white transition-colors">Contacto</a>
      </nav>

      <!-- Back to top -->
      <a
        href="#"
        class="inline-flex items-center gap-1.5 text-xs text-slate-400 hover:text-brand-300 transition-colors p-2 rounded-lg hover:bg-slate-900"
        aria-label="Volver al inicio de la página"
      >
        <span>Volver arriba</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
        </svg>
      </a>
    </div>

    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs">
      <p class="text-slate-500">
        &copy; {currentYear} Felipe Riquelme. Todos los derechos reservados.
      </p>
      <div class="flex items-center gap-4 text-slate-500">
        <span>Construido con Astro & Tailwind</span>
        <span>•</span>
        <span>Dominio .me & Hosting GitHub Pages</span>
      </div>
    </div>
  </div>
</footer>
