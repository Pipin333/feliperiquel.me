---
// src/components/PainPoints.astro
interface PainPoint {
  problemTitle: string;
  problemDesc: string;
  solutionTitle: string;
  solutionDesc: string;
}

const points: PainPoint[] = [
  {
    problemTitle: "Carga lenta (+3 segundos)",
    problemDesc: "Más del 53% de las personas abandonan una web si no abre al instante. Además, Google castiga tu posicionamiento.",
    solutionTitle: "Arquitectura Ultrarrápida (<1s)",
    solutionDesc: "Sitios optimizados sin código basura que abren al instante en cualquier conexión móvil."
  },
  {
    problemTitle: "Incomodidad visual en celulares",
    problemDesc: "Textos diminutos, botones imposibles de presionar y diseño desalineado que ahuyenta a más del 75% del tráfico.",
    solutionTitle: "Diseño Mobile-First Intuitivo",
    solutionDesc: "Experiencia táctil fluida, botones de WhatsApp accesibles con un pulgar y navegación sin fricción."
  },
  {
    problemTitle: "Apariencia obsoleta o genérica",
    problemDesc: "Plantillas anticuadas que transmiten desinterés o falta de profesionalismo frente a tus competidores directos.",
    solutionTitle: "Identidad Visual Moderna & Premium",
    solutionDesc: "Diseño a medida que refleja el verdadero nivel de tus servicios y genera confianza inmediata en tus clientes."
  },
  {
    problemTitle: "Cero conversión (Nadie cotiza)",
    problemDesc: "La gente entra pero no encuentra un botón claro para contactarte o el formulario da errores.",
    solutionTitle: "Embudos de Contacto Directos",
    solutionDesc: "Integración de WhatsApp con un clic, formularios verificados y botones de acción que cierran prospectos."
  }
];
---

<section id="diagnostico" class="py-20 bg-slate-900/60 border-y border-slate-800/80 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-xs uppercase tracking-widest font-bold text-accent-400 mb-3">Diagnóstico Rápido</h2>
      <h3 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        ¿Tu sitio actual te está haciendo perder clientes?
      </h3>
      <p class="mt-4 text-slate-300 text-base sm:text-lg">
        Tener una página web que no convierte es como tener un local comercial con la persiana a medio bajar. Comparamos los problemas comunes con nuestra solución.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {points.map((item, index) => (
        <div class="rounded-2xl border border-slate-800 bg-slate-950/80 p-6 sm:p-8 flex flex-col justify-between hover:border-slate-700 transition-colors">
          <div>
            <!-- Problem -->
            <div class="flex items-start gap-3 pb-5 border-b border-slate-800/80 mb-5">
              <span class="p-2 rounded-xl bg-red-950/60 text-red-400 border border-red-800/50 flex-shrink-0" aria-hidden="true">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </span>
              <div>
                <h4 class="text-base font-bold text-red-300">{item.problemTitle}</h4>
                <p class="text-sm text-slate-400 mt-1 leading-relaxed">{item.problemDesc}</p>
              </div>
            </div>

            <!-- Solution -->
            <div class="flex items-start gap-3">
              <span class="p-2 rounded-xl bg-emerald-950/60 text-emerald-400 border border-emerald-800/50 flex-shrink-0" aria-hidden="true">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <div>
                <h4 class="text-base font-bold text-emerald-300">{item.solutionTitle}</h4>
                <p class="text-sm text-slate-300 mt-1 leading-relaxed">{item.solutionDesc}</p>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Banner CTA under diagnostic -->
    <div class="mt-12 p-6 sm:p-8 rounded-2xl bg-gradient-to-r from-brand-950/80 via-slate-900 to-slate-950 border border-brand-500/30 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <h4 class="text-lg font-bold text-white">¿Tienes dudas sobre el estado de tu página web actual?</h4>
        <p class="text-sm text-slate-300 mt-1">Escríbeme el enlace de tu web y te entrego una <strong>auditoría de velocidad y usabilidad 100% gratuita</strong>.</p>
      </div>
      <a
        href="#contacto"
        class="inline-flex items-center justify-center px-6 py-3 rounded-xl font-semibold text-sm text-white bg-brand-600 hover:bg-brand-500 transition-colors flex-shrink-0 shadow-glow"
      >
        Pedir auditoría gratis
      </a>
    </div>
  </div>
</section>
