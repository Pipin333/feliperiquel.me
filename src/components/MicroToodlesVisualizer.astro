---
// src/components/MicroToodlesVisualizer.astro
// Modal interactivo de alta producción: Arquitectura MicroToodles & Sniffer de Paquetes Reales (HTTP 206)
---

<!-- MICROTOODLES ARCHITECTURE & LIVE PACKET MODAL -->
<div
  id="microtoodles-arch-modal"
  class="hidden fixed inset-0 z-[100] flex items-center justify-center p-3 sm:p-5 md:p-6 bg-[#04060A]/85 backdrop-blur-md overflow-y-auto pointer-events-auto transition-opacity duration-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby="arch-modal-title"
>
  <div
    class="w-full max-w-5xl my-auto bg-[#0A0E17]/98 border border-[#1B2C42] rounded-2xl shadow-2xl overflow-hidden relative flex flex-col max-h-[92vh] transition-all"
    id="arch-modal-card"
  >
    <!-- Modal Top Header Bar -->
    <header class="flex flex-wrap items-center justify-between border-b border-[#1B2C42] px-4 sm:px-6 py-3.5 bg-[#070B12] gap-3 select-none shrink-0">
      <div class="flex items-center gap-3">
        <span class="relative flex h-3 w-3">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-400"></span>
        </span>
        <h2 id="arch-modal-title" class="font-mono text-xs sm:text-sm font-semibold tracking-wide text-slate-100 flex items-center gap-2">
          <span class="text-white font-bold">MicroToodles</span>
          <span class="text-slate-500">//</span>
          <span class="text-cyan-400">Arquitectura de Streaming & Telemetría I/O</span>
        </h2>
      </div>

      <!-- Quick Badges & Controls -->
      <div class="flex items-center flex-wrap gap-2 text-xs font-mono">
        <span class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-950/60 text-emerald-400 border border-emerald-500/30 text-[11px]">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          HTTP 206 Partial Content
        </span>
        <button
          type="button"
          id="arch-toggle-flow-btn"
          class="flex items-center gap-1.5 px-2.5 py-1 bg-[#111D2E] hover:bg-[#1A2C45] text-slate-300 hover:text-white rounded-tech-sm border border-[#1B2C42] text-[11px] transition-colors focus-visible:ring-1 focus-visible:ring-cyan-400"
          title="Pausar o reanudar animación de flujo"
        >
          <svg id="arch-flow-icon" class="w-3 h-3 text-emerald-400" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z"/>
          </svg>
          <span id="arch-flow-btn-text">Pausar Flujo</span>
        </button>
        <button
          type="button"
          id="arch-modal-close-btn"
          class="p-1 rounded-tech-sm text-slate-400 hover:text-white hover:bg-[#1A2C45] transition-colors focus-visible:ring-1 focus-visible:ring-cyan-400"
          aria-label="Cerrar modal de arquitectura"
          title="Cerrar [ESC]"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </header>

    <!-- Sub-header & Tab Navigation -->
    <div class="bg-gradient-to-r from-[#070B12] via-[#0E1726] to-[#070B12] border-b border-[#1B2C42] px-4 sm:px-6 py-2 flex flex-wrap items-center justify-between gap-2 text-xs font-mono shrink-0">
      <div class="flex items-center gap-1.5">
        <button
          type="button"
          id="tab-btn-pipeline"
          class="arch-tab-btn active px-3 py-1 rounded-tech-sm text-xs font-medium transition-all bg-cyan-950/70 text-cyan-300 border border-cyan-500/50 flex items-center gap-1.5"
        >
          <svg class="w-3.5 h-3.5 text-cyan-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
          <span>Topología & Pipeline</span>
        </button>
        <button
          type="button"
          id="tab-btn-sniffer"
          class="arch-tab-btn px-3 py-1 rounded-tech-sm text-xs font-medium transition-all text-slate-400 hover:text-slate-200 border border-transparent hover:border-[#1B2C42] flex items-center gap-1.5"
        >
          <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
          </svg>
          <span>Sniffer de Paquetes Reales & Buffer</span>
        </button>
      </div>

      <div class="hidden md:flex items-center gap-2 text-[11px] text-slate-400">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
        <span>Demostración I+D de Streaming sin Scraping reactivo</span>
      </div>
    </div>

    <!-- Modal Scrollable Content Area -->
    <div class="p-4 sm:p-6 overflow-y-auto space-y-5 flex-1 min-h-0">
      
      <!-- ========================================================================= -->
      <!-- VIEW 1: TOPOLOGY & PIPELINE VISUALIZER -->
      <!-- ========================================================================= -->
      <div id="view-pipeline" class="space-y-5">
        <!-- Stepper / Nodes 5-Card Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-3" id="archPipelineGrid">
          
          <!-- Node 0: Worker Sync -->
          <div
            onclick="window.selectArchNode && window.selectArchNode(0)"
            class="arch-node-card cursor-pointer group p-3.5 rounded-xl border border-[#1B2C42] bg-[#0E1624]/70 hover:border-emerald-500/70 transition-all relative overflow-hidden"
            data-node="0"
          >
            <div class="absolute top-2 right-2 text-[10px] font-mono text-slate-500 group-hover:text-emerald-400">01</div>
            <div class="w-8 h-8 rounded-lg bg-emerald-950/60 border border-emerald-500/30 flex items-center justify-center text-emerald-400 mb-2.5 group-hover:scale-105 transition-transform">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
              </svg>
            </div>
            <div class="text-[10px] font-mono uppercase tracking-wider text-emerald-400 font-semibold">Cron & Sync</div>
            <div class="text-xs font-semibold text-slate-100 mt-0.5">Playlist Resolver</div>
            <p class="text-[11px] text-slate-400 mt-1 leading-snug">Worker batch asíncrono. Sincroniza catálogo sin descargas bajo demanda.</p>
          </div>

          <!-- Node 1: OCI NVMe Storage -->
          <div
            onclick="window.selectArchNode && window.selectArchNode(1)"
            class="arch-node-card cursor-pointer group p-3.5 rounded-xl border border-[#1B2C42] bg-[#0E1624]/70 hover:border-cyan-500/70 transition-all relative overflow-hidden"
            data-node="1"
          >
            <div class="absolute top-2 right-2 text-[10px] font-mono text-slate-500 group-hover:text-cyan-400">02</div>
            <div class="w-8 h-8 rounded-lg bg-cyan-950/60 border border-cyan-500/30 flex items-center justify-center text-cyan-400 mb-2.5 group-hover:scale-105 transition-transform">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"/>
              </svg>
            </div>
            <div class="text-[10px] font-mono uppercase tracking-wider text-cyan-400 font-semibold">OCI NVMe Disk</div>
            <div class="text-xs font-semibold text-slate-100 mt-0.5">Storage Local</div>
            <p class="text-[11px] text-slate-400 mt-1 leading-snug">Volumen persistente 45GB OCI Always Free. Lecturas secuenciales &lt;1ms.</p>
          </div>

          <!-- Node 2: FastAPI Engine (ACTIVE DEFAULT) -->
          <div
            onclick="window.selectArchNode && window.selectArchNode(2)"
            class="arch-node-card cursor-pointer group p-3.5 rounded-xl border border-emerald-400 bg-[#0E1624]/90 ring-1 ring-emerald-400/40 transition-all relative overflow-hidden"
            data-node="2"
          >
            <div class="absolute top-2 right-2 text-[10px] font-mono text-emerald-400 font-bold">03 ACTIVO</div>
            <div class="w-8 h-8 rounded-lg bg-emerald-950/70 border border-emerald-400 flex items-center justify-center text-emerald-400 mb-2.5 group-hover:scale-105 transition-transform">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
            </div>
            <div class="text-[10px] font-mono uppercase tracking-wider text-emerald-400 font-semibold">FastAPI Engine</div>
            <div class="text-xs font-semibold text-slate-100 mt-0.5">Async Range Server</div>
            <p class="text-[11px] text-slate-400 mt-1 leading-snug">Starlette I/O con soporte <code>Accept-Ranges</code> y streaming atómico.</p>
          </div>

          <!-- Node 3: Cloudflare Edge -->
          <div
            onclick="window.selectArchNode && window.selectArchNode(3)"
            class="arch-node-card cursor-pointer group p-3.5 rounded-xl border border-[#1B2C42] bg-[#0E1624]/70 hover:border-sky-500/70 transition-all relative overflow-hidden"
            data-node="3"
          >
            <div class="absolute top-2 right-2 text-[10px] font-mono text-slate-500 group-hover:text-sky-400">04</div>
            <div class="w-8 h-8 rounded-lg bg-sky-950/60 border border-sky-500/30 flex items-center justify-center text-sky-400 mb-2.5 group-hover:scale-105 transition-transform">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 00-9.78 2.096A4.001 4.001 0 003 15z"/>
              </svg>
            </div>
            <div class="text-[10px] font-mono uppercase tracking-wider text-sky-400 font-semibold">Cloudflare CDN</div>
            <div class="text-xs font-semibold text-slate-100 mt-0.5">Perimeter Edge</div>
            <p class="text-[11px] text-slate-400 mt-1 leading-snug">Caché de chunks iniciales, SSL Termination y protección del origen.</p>
          </div>

          <!-- Node 4: Toodles Client UI -->
          <div
            onclick="window.selectArchNode && window.selectArchNode(4)"
            class="arch-node-card cursor-pointer group p-3.5 rounded-xl border border-[#1B2C42] bg-[#0E1624]/70 hover:border-emerald-400/70 transition-all relative overflow-hidden"
            data-node="4"
          >
            <div class="absolute top-2 right-2 text-[10px] font-mono text-slate-500 group-hover:text-emerald-400">05</div>
            <div class="w-8 h-8 rounded-lg bg-emerald-950/60 border border-emerald-500/30 flex items-center justify-center text-emerald-400 mb-2.5 group-hover:scale-105 transition-transform">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/>
              </svg>
            </div>
            <div class="text-[10px] font-mono uppercase tracking-wider text-emerald-400 font-semibold">Toodles Web UI</div>
            <div class="text-xs font-semibold text-slate-100 mt-0.5">HTML5 Audio & DSP</div>
            <p class="text-[11px] text-slate-400 mt-1 leading-snug">Buffer dinámico, volumen al 30% y canal de audio Web Audio API.</p>
          </div>

        </div>

        <!-- Animated SVG Data Highway -->
        <div class="w-full bg-[#06090F] border border-[#1B2C42] rounded-xl p-3 sm:p-4 relative overflow-hidden">
          <div class="flex items-center justify-between text-xs font-mono text-slate-400 mb-2 select-none">
            <span class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
              <span>DATA HIGHWAY // STREAM DISPATCH PIPELINE</span>
            </span>
            <span id="arch-stream-state-badge" class="text-emerald-400 font-semibold flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              <span>206 PARTIAL CONTENT [FLUID I/O]</span>
            </span>
          </div>

          <svg viewBox="0 0 1000 130" class="w-full h-24 sm:h-28 overflow-visible">
            <defs>
              <linearGradient id="streamGrad2" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#00e5a3" stop-opacity="0.3"/>
                <stop offset="50%" stop-color="#00e5ff" stop-opacity="0.9"/>
                <stop offset="100%" stop-color="#00e5a3" stop-opacity="0.3"/>
              </linearGradient>

              <filter id="archGlow" x="-20%" y="-20%" width="140%" height="140%">
                <feGaussianBlur stdDeviation="3.5" result="blur" />
                <feComposite in="SourceGraphic" in2="blur" operator="over" />
              </filter>
            </defs>

            <!-- Background Wire Track -->
            <path d="M 60 65 C 250 65, 250 65, 500 65 C 750 65, 750 65, 940 65" 
                  fill="none" stroke="#121D2C" stroke-width="8" stroke-linecap="round"/>

            <path d="M 60 65 C 250 65, 250 65, 500 65 C 750 65, 750 65, 940 65" 
                  fill="none" stroke="url(#streamGrad2)" stroke-width="2.5" stroke-dasharray="6,6"/>

            <!-- Nodes Anchor Circles -->
            <circle cx="60" cy="65" r="9" fill="#0A0E17" stroke="#00e5a3" stroke-width="3"/>
            <circle cx="280" cy="65" r="9" fill="#0A0E17" stroke="#00e5ff" stroke-width="3"/>
            <circle cx="500" cy="65" r="12" fill="#0A0E17" stroke="#00e5a3" stroke-width="4" filter="url(#archGlow)"/>
            <circle cx="720" cy="65" r="9" fill="#0A0E17" stroke="#38bdf8" stroke-width="3"/>
            <circle cx="940" cy="65" r="9" fill="#0A0E17" stroke="#00e5a3" stroke-width="3"/>

            <!-- Node Text Labels -->
            <text x="60" y="100" fill="#64748B" font-size="11" font-family="JetBrains Mono, monospace" text-anchor="middle">Cron/Sync</text>
            <text x="280" y="100" fill="#64748B" font-size="11" font-family="JetBrains Mono, monospace" text-anchor="middle">OCI Disk</text>
            <text x="500" y="102" fill="#00e5a3" font-size="12" font-family="JetBrains Mono, monospace" text-anchor="middle" font-weight="bold">FastAPI I/O</text>
            <text x="720" y="100" fill="#64748B" font-size="11" font-family="JetBrains Mono, monospace" text-anchor="middle">Edge CDN</text>
            <text x="940" y="100" fill="#64748B" font-size="11" font-family="JetBrains Mono, monospace" text-anchor="middle">Client UI</text>

            <!-- Animated Packets with offset-path and pulsing glow -->
            <circle id="arch-pkt-1" r="5.5" fill="#00e5a3" filter="url(#archGlow)" class="arch-flow-pkt" style="--track-path: path('M 60 65 C 250 65, 250 65, 500 65 C 750 65, 750 65, 940 65'); animation-delay: 0s;"/>
            <circle id="arch-pkt-2" r="6.5" fill="#00e5ff" filter="url(#archGlow)" class="arch-flow-pkt" style="--track-path: path('M 60 65 C 250 65, 250 65, 500 65 C 750 65, 750 65, 940 65'); animation-delay: 0.9s;"/>
            <circle id="arch-pkt-3" r="5.5" fill="#38bdf8" filter="url(#archGlow)" class="arch-flow-pkt" style="--track-path: path('M 60 65 C 250 65, 250 65, 500 65 C 750 65, 750 65, 940 65'); animation-delay: 1.8s;"/>
            <circle id="arch-pkt-4" r="5.0" fill="#a7f3d0" filter="url(#archGlow)" class="arch-flow-pkt" style="--track-path: path('M 60 65 C 250 65, 250 65, 500 65 C 750 65, 750 65, 940 65'); animation-delay: 2.7s;"/>
          </svg>
        </div>

        <!-- Node Inspector & Live Metrics Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
          <!-- Left 7 cols: Detailed Node Inspector -->
          <div class="lg:col-span-7 bg-[#0E1624]/60 border border-[#1B2C42] rounded-xl p-4 sm:p-5 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between pb-3 border-b border-[#1B2C42]">
                <div class="flex items-center gap-2">
                  <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
                  <span id="arch-inspect-subtitle" class="text-xs font-mono text-emerald-400 font-semibold uppercase tracking-wider">MÓDULO 03 // GATEWAY</span>
                </div>
                <span id="arch-inspect-tag" class="text-[11px] font-mono px-2 py-0.5 rounded-tech-sm bg-[#162335] text-slate-300 border border-[#22354E]">STARLETTE_ASYNC</span>
              </div>

              <h3 id="arch-inspect-title" class="text-base sm:text-lg font-bold text-slate-100 mt-3 font-mono">FastAPI Byte-Range Engine</h3>
              <p id="arch-inspect-description" class="text-xs sm:text-sm text-slate-300 mt-2 leading-relaxed">
                Resuelve peticiones con cabecera <code class="text-cyan-300">Range: bytes=start-end</code>, emitiendo códigos de estado <strong class="text-emerald-400">206 Partial Content</strong> con soporte de scrubbing instantáneo sin bloquear el bucle de eventos.
              </p>

              <!-- Code Snippet Display -->
              <div class="mt-4 bg-[#05080E] border border-[#1B2C42] rounded-lg p-3 font-mono text-xs overflow-x-auto text-slate-300">
                <div class="text-[10px] text-slate-400 uppercase mb-1.5 flex items-center justify-between">
                  <span>Implementación en Producción</span>
                  <button type="button" id="arch-copy-code-btn" class="text-cyan-400 hover:text-cyan-300 text-[10px] transition-colors focus-visible:ring-1 focus-visible:ring-cyan-400">Copiar</button>
                </div>
                <pre id="arch-inspect-code" class="text-emerald-300/90 leading-relaxed text-[11px] sm:text-xs"><code>@app.get("/api/media/&#123;track_id&#125;")
async def get_media_track(track_id: str) -&gt; FileResponse:
    file_path = os.path.join(settings.MEDIA_DIR, f"&#123;clean_id&#125;.mp3")
    return FileResponse(
        file_path,
        media_type="audio/mpeg",
        headers=&#123;"Accept-Ranges": "bytes", "Cache-Control": "public, max-age=86400"&#125;
    )</code></pre>
              </div>
            </div>

            <!-- Live Metrics Mini-Bar -->
            <div class="mt-4 pt-3 border-t border-[#1B2C42] grid grid-cols-3 gap-2 text-center font-mono">
              <div class="bg-[#070B12] p-2 rounded-tech-sm border border-[#1B2C42]">
                <div class="text-[10px] text-slate-400">Tamaño Chunk</div>
                <div id="arch-metric-chunk" class="text-xs sm:text-sm font-semibold text-cyan-400">1024 KB</div>
              </div>
              <div class="bg-[#070B12] p-2 rounded-tech-sm border border-[#1B2C42]">
                <div class="text-[10px] text-slate-400">Latencia Edge</div>
                <div id="arch-metric-latency" class="text-xs sm:text-sm font-semibold text-emerald-400">14 ms</div>
              </div>
              <div class="bg-[#070B12] p-2 rounded-tech-sm border border-[#1B2C42]">
                <div class="text-[10px] text-slate-400">Codec Destino</div>
                <div id="arch-metric-codec" class="text-xs sm:text-sm font-semibold text-slate-200">192k MP3</div>
              </div>
            </div>
          </div>

          <!-- Right 5 cols: Interactive HTTP 206 Simulator -->
          <div class="lg:col-span-5 bg-[#070A11] border border-[#1B2C42] rounded-xl p-4 sm:p-5 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between pb-2 border-b border-[#1B2C42] text-xs font-mono text-slate-400">
                <span class="flex items-center gap-1.5 text-slate-200 font-semibold">
                  <span class="w-2.5 h-2.5 rounded-full bg-amber-400/80 inline-block"></span>
                  <span>Range Request Terminal</span>
                </span>
                <span class="text-[10px] text-slate-500">HTTP/1.1 206</span>
              </div>

              <p class="text-xs text-slate-400 mt-2.5 leading-relaxed">
                Simula el scrubbing o salto temporal enviando un rango parcial de bytes al motor:
              </p>

              <!-- Controls -->
              <div class="mt-3 flex gap-2 font-mono text-xs">
                <select id="arch-sim-range-select" class="bg-[#0E1624] border border-[#1B2C42] rounded-tech-sm px-2.5 py-1.5 text-slate-200 text-xs focus:border-cyan-400 outline-none flex-1">
                  <option value="0-1048575">00:00 (Bytes 0 - 1MB)</option>
                  <option value="1048576-2097151">00:43 (Bytes 1MB - 2MB)</option>
                  <option value="2097152-3145727">01:26 (Bytes 2MB - 3MB)</option>
                </select>
                <button
                  type="button"
                  id="arch-sim-send-btn"
                  class="bg-cyan-950/70 hover:bg-cyan-900/80 text-cyan-300 border border-cyan-500/50 px-3 py-1.5 rounded-tech-sm transition-all font-semibold flex items-center justify-center gap-1.5 cursor-pointer text-xs focus-visible:ring-1 focus-visible:ring-cyan-400"
                >
                  <span>GET 206</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                  </svg>
                </button>
              </div>

              <!-- Terminal Output Log -->
              <div class="mt-3 bg-[#030508] rounded-lg p-3 border border-[#162335] text-[11px] font-mono leading-relaxed h-44 overflow-y-auto" id="arch-sim-log">
                <div class="text-slate-500">// Terminal de telemetría HTTP</div>
                <div class="text-slate-300 mt-1 space-y-1">
                  <div><span class="text-cyan-400">&gt;</span> GET /api/media/toodles-active.mp3 HTTP/1.1</div>
                  <div><span class="text-cyan-400">&gt;</span> Host: radio.feliperiquel.me</div>
