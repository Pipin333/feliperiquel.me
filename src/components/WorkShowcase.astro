---
// src/components/WorkShowcase.astro
import Icon from './Icon.astro';
import { projects, type Project } from '../data/projects';

interface Props {
  limit?: number;
  showAll?: boolean;
  showViewMore?: boolean;
  showDescription?: boolean;
  title?: string;
  subtitle?: string;
}

const {
  limit = 2,
  showAll = false,
  showViewMore = true,
  showDescription = false,
  title = "Repositorios & Soluciones Reales",
  subtitle = "Cada proyecto responde a una fricción real. Pulsa en cada tarjeta para inspeccionar el origen del problema y las decisiones de arquitectura detrás del código."
} = Astro.props;

const displayedProjects = showAll ? projects : (limit ? projects.slice(0, limit) : projects);
---

<section id="proyectos" class="py-20 bg-canvas-surface/40 border-b border-canvas-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
      <div>
        <h2 class="text-3xl sm:text-4xl font-display font-extrabold text-white tracking-tight">
          {title}
        </h2>
        <p class="mt-2 text-slate-300 text-sm sm:text-base max-w-2xl leading-relaxed">
          {subtitle}
        </p>
      </div>

      <a
        href="https://github.com/Pipin333"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 px-5 py-2.5 rounded-tech font-mono text-xs font-semibold text-white bg-canvas-surface hover:bg-canvas-raised border border-canvas-border hover:border-telemetry hover:text-telemetry shadow-lg transition-all duration-140 hover:-translate-y-0.5 group shrink-0"
      >
        <svg class="w-4 h-4 text-slate-300 group-hover:text-telemetry transition-colors" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        <span>Ver perfil en GitHub (@Pipin333)</span>
        <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-telemetry group-hover:translate-x-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      {displayedProjects.map((project, index) => (
        <article class={`spotlight-card group p-6 sm:p-7 flex flex-col justify-between relative ${index === displayedProjects.length - 1 && displayedProjects.length % 2 !== 0 ? 'lg:col-span-2 lg:max-w-[calc(50%-0.75rem)] lg:mx-auto w-full' : ''}`}>
          <div>
            <!-- Header bar -->
            <div class="mb-3">
              <span class="font-mono text-[11px] text-slate-400">
                {project.category}
              </span>
            </div>

            <h3 class="text-2xl font-display font-bold text-white mb-2.5 group-hover:text-telemetry transition-colors">
              {project.title}
            </h3>

            <!-- TL;DR Executive Impact Pill (for recruiters & quick scan) -->
            <div class="mb-3.5 p-3 rounded-tech bg-canvas/80 border border-telemetry/20 border-l-2 border-l-telemetry flex items-start gap-2.5">
              <span class="font-mono text-xs font-bold text-telemetry flex-shrink-0 tracking-wider">TL;DR:</span>
              <p class="text-xs sm:text-sm text-slate-200 leading-snug font-sans font-medium">
                {project.tldr}
              </p>
            </div>

            <!-- Deep Technical Description (shown in full detail when showDescription is true) -->
            {showDescription && project.description && (
              <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-4 font-sans">
                {project.description}
              </p>
            )}

            <!-- Tags (Tamaño aumentado a text-xs para legibilidad movil) -->
            <div class="flex flex-wrap gap-1.5 mb-5">
              {project.tags?.map((tag) => (
                <span class="font-mono text-xs px-2.5 py-1 rounded-tech-sm bg-canvas text-slate-300 border border-canvas-border">
                  {tag}
                </span>
              ))}
            </div>

            <!-- SIGNATURE ELEMENT 2: "Por qué se diseñó así" Accordion Drawer -->
            <div class="mb-5 border-t border-canvas-border/80 pt-3">
              <button
                type="button"
                data-toggle-why={project.id}
                class="flex items-center justify-between w-full font-mono text-xs text-telemetry hover:text-white py-1.5 transition-colors"
                aria-expanded="false"
                aria-controls={`rationale-${project.id}`}
              >
                <span class="flex items-center gap-2 font-bold text-left">
                  <span class="toggle-icon text-xs shrink-0">[+]</span>
                  <span>Por qué se diseñó así <span class="hidden sm:inline">(decisiones técnicas)</span></span>
                </span>
                <span class="text-xs text-slate-400 uppercase font-semibold shrink-0 ml-2">Detalles</span>
              </button>

              <div
                id={`rationale-${project.id}`}
                class="hidden mt-3 p-4 rounded-tech bg-canvas border border-canvas-border space-y-4 font-mono text-xs"
              >
                <div>
                  <div class="text-xs font-bold text-telemetry mb-1">
                    1. ¿Por qué nació esta solución?
                  </div>
                  <p class="text-slate-200 text-xs sm:text-sm leading-relaxed font-sans">
                    {project.rationale.origin}
                  </p>
                </div>

                <div>
                  <div class="text-xs font-bold text-domain-audio mb-1">
                    2. ¿Por qué esta arquitectura y stack?
                  </div>
                  <p class="text-slate-200 text-xs sm:text-sm leading-relaxed font-sans">
                    {project.rationale.decisions}
                  </p>
                </div>

                <div>
                  <div class="text-xs font-bold text-slate-200 mb-1">
                    3. ¿Por qué se muestra en este portafolio?
                  </div>
                  <p class="text-slate-300 text-xs sm:text-sm leading-relaxed font-sans">
                    {project.rationale.whyShown}
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Bottom Actions -->
          <div class="pt-3 border-t border-canvas-border/60 flex items-center justify-between gap-2.5">
            {project.githubUrl ? (
              <a
                href={project.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 sm:gap-2 font-mono text-xs font-semibold text-slate-300 hover:text-telemetry transition-colors whitespace-nowrap shrink-0"
              >
                <svg class="w-4 h-4 text-slate-400 shrink-0" fill="currentColor" viewBox="0 0 24 24">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                </svg>
                <span><span class="hidden sm:inline">Inspeccionar </span>repositorio</span>
                <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            ) : (
              <span class="font-mono text-xs text-slate-500 whitespace-nowrap">
                Código privado
              </span>
            )}
            <span class="font-mono text-[10px] text-slate-400 whitespace-nowrap shrink-0">
              {project.license ? `${project.license} / Open Source` : "Open Source"}
            </span>
          </div>
        </article>
      ))}
    </div>

    <!-- View More CTA (Para ver el catálogo completo de proyectos) -->
    {showViewMore && (
      <div class="mt-12 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/proyectos"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-tech font-mono text-xs sm:text-sm font-semibold text-white bg-canvas-surface hover:bg-canvas-raised border border-canvas-border hover:border-telemetry hover:text-telemetry transition-all duration-140 hover:-translate-y-0.5 shadow-lg group"
        >
          <Icon name="grid" class="w-4 h-4 text-telemetry" />
          <span>Ver todos los proyectos ({projects.length} repositorios)</span>
          <svg class="w-4 h-4 text-telemetry transition-transform duration-140 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    )}
  </div>
</section>

<!-- Accordion logic script -->
<script>
  const toggleButtons = document.querySelectorAll<HTMLButtonElement>('button[data-toggle-why]');

  toggleButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-toggle-why');
      if (!id) return;
      const target = document.getElementById(`rationale-${id}`);
      if (!target) return;

      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));

      const icon = btn.querySelector('.toggle-icon');

      if (isExpanded) {
        target.classList.add('hidden');
        if (icon) icon.textContent = '[+]';
      } else {
        target.classList.remove('hidden');
        if (icon) icon.textContent = '[-]';
      }
    });
  });
</script>
