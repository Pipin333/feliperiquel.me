---
// src/components/AboutMe.astro
import Icon from './Icon.astro';
---

<section id="sobre-mi" class="py-20 relative overflow-hidden bg-canvas border-b border-canvas-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-end">
      <!-- Left Column: Bio & Philosophy -->
      <div class="lg:col-span-7">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-tech border border-canvas-border bg-canvas-surface text-slate-300 font-mono text-xs uppercase tracking-wider mb-4">
          <Icon name="terminal" class="w-3.5 h-3.5 text-telemetry" />
          <span>Perfil & Enfoque</span>
        </div>

        <h2 class="text-3xl sm:text-4xl font-display font-extrabold text-white tracking-tight mb-5">
          Ingeniería de software pragmática, orientada a la utilidad real.
        </h2>

        <div class="space-y-4 text-slate-300 text-sm sm:text-base leading-relaxed mb-8">
          <p>
            Soy Felipe Riquelme, desarrollador con base en Chile. Mi enfoque combina la resolución práctica de problemas cotidianos con rigor de ingeniería: desde automatizaciones desatendidas para servidores homelab y telemetría de wearables hasta procesamiento digital de señales de audio (DSP) ejecutado enteramente en el navegador.
          </p>
          <p>
            Creo firmemente en el software liviano, directo y sin capas innecesarias de intermediación. Cada herramienta en este sitio y en mis repositorios está pensada para responder al instante, respetar los estándares de accesibilidad y ofrecer valor tangible desde la primera interacción.
          </p>
        </div>

        <!-- Principles -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 pt-4 border-t border-canvas-border">
          <div class="p-4 rounded-tech bg-canvas-surface border border-canvas-border">
            <h3 class="text-white font-mono font-bold text-xs mb-1 flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-telemetry"></span>
              Rendimiento & Cero Deuda
            </h3>
            <p class="text-xs text-slate-400 leading-relaxed font-sans">
              Priorizo sitios estáticos ultrarrápidos, optimización de bundles y arquitecturas que no requieran servidores costosos para funcionar con fluidez.
            </p>
          </div>

          <div class="p-4 rounded-tech bg-canvas-surface border border-canvas-border">
            <h3 class="text-white font-mono font-bold text-xs mb-1 flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-domain-audio"></span>
              Soluciones End-to-End
            </h3>
            <p class="text-xs text-slate-400 leading-relaxed font-sans">
              Experiencia integral que abarca desde la captura y el parseo de datos crudos hasta interfaces responsivas y automatizaciones de entrega continua.
            </p>
          </div>
        </div>
      </div>

      <!-- Right Column: Tech Stack Matrix -->
      <div class="lg:col-span-5 w-full lg:self-end">
        <div class="spotlight-card p-6 sm:p-7 relative shadow-2xl">
          <h3 class="text-base font-display font-bold text-white mb-5 flex items-center gap-2">
            <span class="text-telemetry font-mono">&gt;</span> Stack Técnico & Tecnologías
          </h3>

          <div class="space-y-5">
            <!-- Web & Frontend -->
            <div>
              <span class="font-mono text-xs font-semibold text-telemetry uppercase tracking-wider block mb-2">
                Frontend & Experiencia Web
              </span>
              <div class="flex flex-wrap gap-1.5">
                <span class="px-2.5 py-1 rounded-tech-sm font-mono text-xs bg-canvas text-slate-300 border border-canvas-border">TypeScript</span>
                <span class="px-2.5 py-1 rounded-tech-sm font-mono text-xs bg-canvas text-slate-300 border border-canvas-border">Astro</span>
                <span class="px-2.5 py-1 rounded-tech-sm font-mono text-xs bg-canvas text-slate-300 border border-canvas-border">Tailwind CSS</span>
                <span class="px-2.5 py-1 rounded-tech-sm font-mono text-xs bg-canvas text-slate-300 border border-canvas-border">Web Audio API</span>
                <span class="px-2.5 py-1 rounded-tech-sm font-mono text-xs bg-canvas text-slate-300 border border-canvas-border">Next.js / React</span>
              </div>
            </div>

            <!-- Backend & Systems -->
            <div>
              <span class="font-mono text-xs font-semibold text-domain-audio uppercase tracking-wider block mb-2">
                Backend, Sistemas & Automatización
              </span>
              <div class="flex flex-wrap gap-1.5">
                <span class="px-2.5 py-1 rounded-tech-sm font-mono text-xs bg-canvas text-slate-300 border border-canvas-border">Python</span>
                <span class="px-2.5 py-1 rounded-tech-sm font-mono text-xs bg-canvas text-slate-300 border border-canvas-border">Node.js</span>
                <span class="px-2.5 py-1 rounded-tech-sm font-mono text-xs bg-canvas text-slate-300 border border-canvas-border">Docker</span>
                <span class="px-2.5 py-1 rounded-tech-sm font-mono text-xs bg-canvas text-slate-300 border border-canvas-border">Discord & WhatsApp APIs</span>
                <span class="px-2.5 py-1 rounded-tech-sm font-mono text-xs bg-canvas text-slate-300 border border-canvas-border">Linux & Homelab</span>
              </div>
            </div>

            <!-- Mobile & Hardware -->
            <div>
              <span class="font-mono text-xs font-semibold text-domain-ai uppercase tracking-wider block mb-2">
                Dispositivos, Algoritmos & Mobile
              </span>
              <div class="flex flex-wrap gap-1.5">
                <span class="px-2.5 py-1 rounded-tech-sm font-mono text-xs bg-canvas text-slate-300 border border-canvas-border">Kotlin / Wear OS</span>
                <span class="px-2.5 py-1 rounded-tech-sm font-mono text-xs bg-canvas text-slate-300 border border-canvas-border">Metaheurísticas</span>
                <span class="px-2.5 py-1 rounded-tech-sm font-mono text-xs bg-canvas text-slate-300 border border-canvas-border">OCR / Vision AI</span>
                <span class="px-2.5 py-1 rounded-tech-sm font-mono text-xs bg-canvas text-slate-300 border border-canvas-border">Git / CI/CD</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Recruiter & CV Callout Box -->
    <div class="mt-12 p-6 sm:p-8 rounded-tech bg-[#090D17] border border-telemetry/30 shadow-2xl relative overflow-hidden group">
      <div class="absolute top-0 right-0 w-64 h-64 bg-telemetry/5 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

      <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
        <div class="space-y-2 max-w-2xl">
          <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-tech-sm font-mono text-[11px] font-semibold text-telemetry bg-telemetry/10 border border-telemetry/30">
            <span class="w-1.5 h-1.5 rounded-full bg-telemetry animate-pulse"></span>
            <span>Recruiting & Perfil Profesional</span>
          </div>
          <h3 class="text-xl sm:text-2xl font-display font-bold text-white tracking-tight">
            ¿Evaluando mi perfil para tu equipo de ingeniería?
          </h3>
          <p class="text-xs sm:text-sm text-slate-300 font-sans leading-relaxed">
            Currículum Vitae oficial estructurado bajo formato ATS de una sola columna (100% compatible con Workday, Greenhouse y Lever). Incluye detalle de algoritmos evaluados en IEEE CEC, arquitectura de backend, experiencia en J.E.J. Ingeniería y liderazgo en Dunkin'.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 flex-shrink-0">
          <a
            href="/cv-felipe-riquelme.pdf"
            download="CV-Felipe-Riquelme-Salvo.pdf"
            class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-tech font-mono text-xs font-bold text-telemetry-dark bg-telemetry hover:bg-telemetry-hover shadow-glow-cyan transition-all duration-140 hover:-translate-y-0.5"
            title="Descargar CV en formato PDF listo para ATS (8.7 KB)"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span>Descargar PDF (ATS)</span>
          </a>
          <a
            href="/cv"
            class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-tech font-mono text-xs font-semibold text-slate-200 bg-canvas-surface hover:bg-canvas-raised border border-canvas-border hover:border-slate-500 transition-all duration-140 hover:-translate-y-0.5"
            title="Ver versión web interactiva y amigable con ATS"
          >
            <span>Ver versión web</span>
            <svg class="w-3.5 h-3.5 text-telemetry" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
