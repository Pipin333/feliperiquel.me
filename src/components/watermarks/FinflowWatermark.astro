---
// src/components/watermarks/FinflowWatermark.astro
---

<svg class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-[45%] group-hover:translate-x-[40%] h-[125%] w-[340px] pointer-events-none select-none z-0 text-emerald-400 opacity-[0.08] group-hover:opacity-[0.24] transition-all duration-300" viewBox="0 0 240 420" fill="none" stroke="currentColor" aria-hidden="true">
  <!-- Eje vertical central milimetrado -->
  <line x1="120" y1="10" x2="120" y2="410" stroke-width="0.75" stroke-dasharray="3,3" class="text-emerald-500/30" />

  <!-- Dial de Ciclo de Facturacion Superior (Corte vs Vencimiento de Pago) -->
  <g transform="translate(120, 75)">
    <circle cx="0" cy="0" r="54" stroke-width="1.25" class="text-emerald-300" />
    <circle cx="0" cy="0" r="44" stroke-width="0.75" stroke-dasharray="3,3" class="text-teal-400/40" />
    <circle cx="0" cy="0" r="26" stroke-width="1" class="text-emerald-400" />
    <circle cx="0" cy="0" r="6" fill="currentColor" class="text-emerald-300" />
    
    <!-- Marcas de dias del mes (Rayos y cotas) -->
    <line x1="0" y1="-54" x2="0" y2="-44" stroke-width="2" class="text-emerald-200" />
    <text x="4" y="-46" font-family="monospace" font-size="6.5" fill="currentColor" class="text-emerald-200">CORTE (D12)</text>
    
    <line x1="44" y1="0" x2="54" y2="0" stroke-width="2" class="text-teal-200" />
    <text x="18" y="14" font-family="monospace" font-size="6.5" fill="currentColor" class="text-teal-200">PAGO (D26)</text>

    <line x1="-38" y1="-38" x2="-31" y2="-31" stroke-width="0.75" />
    <line x1="38" y1="-38" x2="31" y2="-31" stroke-width="0.75" />
    <line x1="38" y1="38" x2="31" y2="31" stroke-width="0.75" />
    <line x1="-38" y1="38" x2="-31" y2="31" stroke-width="0.75" />
  </g>

  <!-- Tarjeta de Credito / Cuenta Inteligente en Seccion Tecnica (ISO/IEC 7810 ID-1) -->
  <g transform="translate(30, 150)">
    <!-- Contorno de la tarjeta con radio de curvatura estandar -->
    <rect x="0" y="0" width="180" height="114" rx="10" stroke-width="1.5" class="text-emerald-300" />
    <rect x="5" y="5" width="170" height="104" rx="7" stroke-width="0.5" stroke-dasharray="2,3" class="text-teal-300/40" />

    <!-- Chip EMV inteligente con microcontactos -->
    <g transform="translate(20, 28)">
      <rect x="0" y="0" width="34" height="28" rx="4" stroke-width="1.25" class="text-teal-200" />
      <line x1="0" y1="14" x2="34" y2="14" stroke-width="0.75" class="text-emerald-400" />
      <line x1="17" y1="0" x2="17" y2="28" stroke-width="0.75" class="text-emerald-400" />
      <circle cx="17" cy="14" r="4.5" stroke-width="0.75" class="text-emerald-300" />
    </g>

    <!-- Ondas Contactless / NFC -->
    <path d="M64,34 Q70,42 64,50" stroke-width="1.25" class="text-emerald-400" />
    <path d="M70,30 Q78,42 70,54" stroke-width="1.25" class="text-emerald-400" />
    <path d="M76,26 Q86,42 76,58" stroke-width="1.25" class="text-emerald-400" />

    <!-- Mascara de PAN y Datos Financieros -->
    <text x="20" y="78" font-family="monospace" font-size="7.5" fill="currentColor" letter-spacing="2" class="text-emerald-200">•••• •••• •••• 8842</text>
    <text x="20" y="94" font-family="monospace" font-size="6" fill="currentColor" class="text-teal-300/70">VAL 10/29 • CLP LIQUID</text>

    <!-- Circulos Interconectados de Red Financiera -->
    <circle cx="140" cy="85" r="14" stroke-width="1" class="text-emerald-400/50" />
    <circle cx="154" cy="85" r="14" stroke-width="1" class="text-teal-300/50" />
  </g>

  <!-- Barra de Desglose de Cuotas y Amortizacion de Deuda -->
  <g transform="translate(30, 280)">
    <rect x="0" y="0" width="180" height="58" rx="6" stroke-width="1" class="text-emerald-400/50" />
    <text x="12" y="18" font-family="monospace" font-size="7" fill="currentColor" class="text-emerald-300">CUOTAS SIN INTERES • 3 / 6</text>
    
    <!-- Barra de progreso segmentada -->
    <rect x="12" y="26" width="156" height="7" rx="3.5" stroke-width="0.75" class="text-emerald-500/40" />
    <rect x="12" y="26" width="78" height="7" rx="3.5" fill="currentColor" class="text-emerald-300/50" />

    <text x="12" y="46" font-family="monospace" font-size="6" fill="currentColor" class="text-teal-200">AMORTIZADO: 50%</text>
    <text x="108" y="46" font-family="monospace" font-size="6" fill="currentColor" class="text-emerald-300">TASA: 0.0%</text>
  </g>

  <!-- Anotaciones de arquitectura de software y privacidad -->
  <text x="20" y="365" font-family="monospace" font-size="7.5" fill="currentColor" class="text-emerald-300/70">FIG. II : CHARTA CREDITI &amp; CICLUS</text>
  <text x="20" y="380" font-family="monospace" font-size="6.5" fill="currentColor" class="text-emerald-400/50">ISO/IEC 7810 ID-1 • LOCALSTORAGE</text>
  <text x="20" y="395" font-family="monospace" font-size="6.5" fill="currentColor" class="text-teal-300/40">OFFLINE-FIRST PWA • ZERO-SERVERS</text>
  <text x="20" y="408" font-family="monospace" font-size="6.5" fill="currentColor" class="text-emerald-500/40">CLIENT STORAGE • PRIVATE VAULT</text>
</svg>
