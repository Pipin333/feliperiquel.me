---
// src/components/ContactGateway.astro
import Icon from './Icon.astro';
---

<section id="contacto" class="py-20 relative overflow-hidden bg-canvas">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-end">
      <!-- Left column: Info & Value -->
      <div class="lg:col-span-5">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-tech border border-canvas-border bg-canvas-surface text-telemetry font-mono text-xs uppercase tracking-wider mb-4">
          <Icon name="envelope-paper" class="w-3.5 h-3.5" />
          <span>Canales Directos</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-display font-extrabold text-white tracking-tight mb-4">
          ¿Tienes una idea, desafío técnico o quieres colaborar?
        </h2>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-8">
          Conversemos. Ya sea para proponer un proyecto de software, colaborar en código abierto o explorar un problema de ingeniería, puedes contactarme por cualquiera de estos canales.
        </p>

        <!-- Direct channels -->
        <div class="space-y-3.5">
          <!-- WhatsApp Card -->
          <a
            href="https://wa.me/56975200121?text=Hola%20Felipe,%20estuve%20viendo%20tu%20portafolio%20y%20el%20Lab%20en%20feliperiquel.me"
            target="_blank"
            rel="noopener noreferrer"
            class="spotlight-card flex items-center gap-4 p-4 rounded-tech hover:border-domain-audio transition-colors group"
          >
            <span class="w-10 h-10 rounded-tech bg-canvas border border-canvas-border text-domain-audio flex items-center justify-center flex-shrink-0 group-hover:border-domain-audio transition-colors">
              <Icon name="whatsapp" class="w-5 h-5" />
            </span>
            <div class="flex-1 min-w-0">
              <span class="font-mono text-[10px] font-semibold text-domain-audio uppercase tracking-wider block">Chat Directo</span>
              <span class="text-sm font-bold text-white group-hover:text-domain-audio transition-colors">Hablar por WhatsApp</span>
              <span class="text-xs text-slate-400 block mt-0.5 truncate">Respuesta directa para consultas o proyectos</span>
            </div>
            <svg class="w-4 h-4 text-slate-500 group-hover:text-domain-audio transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <!-- Email Card with Copy button -->
          <div class="spotlight-card flex items-center justify-between gap-3 p-4 rounded-tech">
            <div class="flex items-center gap-3.5 min-w-0">
              <span class="w-10 h-10 rounded-tech bg-canvas border border-canvas-border text-telemetry flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </span>
              <div class="min-w-0">
                <span class="font-mono text-[10px] font-semibold text-slate-400 uppercase tracking-wider block">Correo Institucional</span>
                <a
                  href="mailto:f.riquelmesalvo@uandresbello.edu"
                  class="font-mono text-xs font-bold text-white hover:text-telemetry transition-colors truncate block"
                >
                  f.riquelmesalvo@uandresbello.edu
                </a>
                <span class="text-xs text-slate-400 block mt-0.5">Contacto profesional y académico</span>
              </div>
            </div>
            <button
              type="button"
              id="copy-email-btn"
              class="px-2.5 py-1.5 rounded-tech-sm bg-canvas border border-canvas-border hover:border-telemetry font-mono text-[11px] font-medium text-slate-300 transition-colors flex items-center gap-1 flex-shrink-0"
              aria-label="Copiar correo electrónico al portapapeles"
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <span id="copy-email-text">Copiar</span>
            </button>
          </div>

          <!-- GitHub Card -->
          <a
            href="https://github.com/Pipin333"
            target="_blank"
            rel="noopener noreferrer"
            class="spotlight-card flex items-center gap-4 p-4 rounded-tech hover:border-telemetry transition-colors group"
          >
            <span class="w-10 h-10 rounded-tech bg-canvas border border-canvas-border text-slate-200 flex items-center justify-center flex-shrink-0 group-hover:border-telemetry transition-colors">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
              </svg>
            </span>
            <div class="flex-1 min-w-0">
              <span class="font-mono text-[10px] font-semibold text-slate-400 uppercase tracking-wider block">Repositorios de Código</span>
              <span class="text-sm font-bold text-white group-hover:text-telemetry transition-colors">GitHub (@Pipin333)</span>
              <span class="text-xs text-slate-400 block mt-0.5 truncate">Revisa el código y commits de mis proyectos</span>
            </div>
            <svg class="w-4 h-4 text-slate-500 group-hover:text-telemetry transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Right column: Direct Message Form -->
      <div class="lg:col-span-7 w-full lg:self-end">
        <form
          id="contact-form"
          action="/api/contact"
          method="POST"
          class="spotlight-card p-6 sm:p-8 rounded-tech relative"
        >
          <!-- Anti-spam honeypot -->
          <input type="text" name="botcheck" class="hidden" style="display: none;" tabindex="-1" autocomplete="off" />

          <h3 class="text-xl font-display font-bold text-white mb-1">Enviar Mensaje Directo</h3>
          <p class="text-xs sm:text-sm text-slate-400 mb-6 font-sans">
            Si prefieres dejar un mensaje aquí, te responderé directamente a tu correo.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
            <div>
              <label for="contact-name" class="block font-mono text-[11px] font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
                Tu Nombre <span class="text-rose-400">*</span>
              </label>
              <input
                type="text"
                id="contact-name"
                name="name"
                required
                placeholder="Ej. Martín González"
                class="w-full px-3.5 py-2.5 rounded-tech-sm bg-canvas border border-canvas-border text-white placeholder-slate-600 focus-visible:ring-2 focus-visible:ring-telemetry text-sm transition-colors"
              />
            </div>
            <div>
              <label for="contact-email" class="block font-mono text-[11px] font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
                Correo Electrónico <span class="text-rose-400">*</span>
              </label>
              <input
                type="email"
                id="contact-email"
                name="email"
                required
                placeholder="martin@ejemplo.com"
                class="w-full px-3.5 py-2.5 rounded-tech-sm bg-canvas border border-canvas-border text-white placeholder-slate-600 focus-visible:ring-2 focus-visible:ring-telemetry text-sm transition-colors"
              />
            </div>
          </div>

          <div class="mb-4">
            <label for="contact-subject" class="block font-mono text-[11px] font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              Motivo o Asunto <span class="text-rose-400">*</span>
            </label>
            <input
              type="text"
              id="contact-subject"
              name="topic"
              required
              placeholder="Ej. Consulta sobre Whatsarr / Proyecto de software"
              class="w-full px-3.5 py-2.5 rounded-tech-sm bg-canvas border border-canvas-border text-white placeholder-slate-600 focus-visible:ring-2 focus-visible:ring-telemetry text-sm transition-colors"
            />
          </div>

          <div class="mb-5">
            <label for="contact-message" class="block font-mono text-[11px] font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              Mensaje o Detalles <span class="text-rose-400">*</span>
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="4"
              required
              placeholder="Cuéntame en qué consiste tu idea, propuesta o consulta..."
              class="w-full px-3.5 py-2.5 rounded-tech-sm bg-canvas border border-canvas-border text-white placeholder-slate-600 focus-visible:ring-2 focus-visible:ring-telemetry text-sm transition-colors resize-y font-sans"
            ></textarea>
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            id="submit-btn"
            class="w-full py-3 rounded-tech font-mono text-xs font-bold text-telemetry-dark bg-telemetry hover:bg-telemetry-hover shadow-glow-cyan transition-all duration-140 flex items-center justify-center gap-2 group"
          >
            <span>Enviar Mensaje</span>
            <svg class="w-4 h-4 transition-transform duration-140 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>

          <!-- Status Message Area -->
          <div id="form-status" class="mt-3 text-center font-mono text-xs font-medium hidden" role="status" aria-live="polite"></div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  // Copy email button logic
  const copyBtn = document.getElementById('copy-email-btn');
  const copyText = document.getElementById('copy-email-text');
  const emailToCopy = 'f.riquelmesalvo@uandresbello.edu';

  if (copyBtn && copyText) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(emailToCopy);
        const originalText = copyText.textContent;
        copyText.textContent = '¡Copiado!';
        copyBtn.classList.add('text-domain-audio', 'border-domain-audio');
        setTimeout(() => {
          copyText.textContent = originalText;
          copyBtn.classList.remove('text-domain-audio', 'border-domain-audio');
        }, 2500);
      } catch (e) {
        window.location.href = `mailto:${emailToCopy}`;
      }
    });
  }

  // Handle accessible form submission via fetch to /api/contact
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const statusDiv = document.getElementById('form-status');
  const submitBtn = document.getElementById('submit-btn');

  if (form && statusDiv && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      statusDiv.classList.remove('hidden', 'text-domain-audio', 'text-rose-400');
      statusDiv.classList.add('text-slate-300');
      statusDiv.textContent = 'Enviando mensaje y registrando telemetría...';
      submitBtn.setAttribute('disabled', 'true');

      const formData = new FormData(form);
      const payload = {
        name: formData.get('name'),
        email: formData.get('email'),
        topic: formData.get('topic'),
        message: formData.get('message'),
        botcheck: formData.get('botcheck')
      };

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify(payload)
        });

        const contentType = response.headers.get('content-type') || '';
        let data: any = {};
        if (contentType.includes('application/json')) {
          data = await response.json();
        } else {
          const rawText = await response.text();
          data = { error: rawText || 'Respuesta no valida del servidor' };
        }

        if (response.ok && data.success) {
          statusDiv.classList.remove('text-slate-300');
          statusDiv.classList.add('text-domain-audio');
          statusDiv.textContent = data.message || 'Mensaje recibido con exito. Te respondere a la brevedad.';
          form.reset();
        } else {
          throw new Error(data.error || 'Error al procesar el mensaje');
        }
      } catch (err: any) {
        statusDiv.classList.remove('text-slate-300');
        statusDiv.classList.add('text-rose-400');
        statusDiv.textContent = err.message || 'No se pudo enviar automaticamente. Por favor escribeme directamente a f.riquelmesalvo@uandresbello.edu o por WhatsApp.';
      } finally {
        submitBtn.removeAttribute('disabled');
      }
    });
  }
</script>
