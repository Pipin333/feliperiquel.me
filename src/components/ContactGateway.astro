---
// src/components/ContactGateway.astro
---

<section id="contacto" class="py-24 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Left column: Info & Value -->
      <div class="lg:col-span-5">
        <h2 class="text-xs uppercase tracking-widest font-bold text-brand-400 mb-3">Hablemos</h2>
        <h3 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-6">
          ¿Listo para renovar o crear tu sitio web?
        </h3>
        <p class="text-slate-300 text-base leading-relaxed mb-8">
          Cuéntame sobre tu proyecto o déjame el link de tu web actual para darte un diagnóstico sincero y sin compromiso. Respondo habitualmente en menos de 24 horas.
        </p>

        <!-- Direct channels -->
        <div class="space-y-4 mb-8">
          <a
            href="https://wa.me/?text=Hola%20Felipe,%20vi%20tu%20sitio%20feliperiquel.me%20y%20me%20gustar%C3%ADa%20cotizar%20una%20web"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-4 p-4 rounded-2xl bg-emerald-950/40 border border-emerald-800/40 hover:border-emerald-600 transition-colors group"
          >
            <span class="w-12 h-12 rounded-xl bg-emerald-900/60 text-emerald-400 flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2zm5.78 14.15c-.24.68-1.39 1.3-1.92 1.38-.49.08-1.12.11-3.23-.76-2.69-1.11-4.43-3.83-4.57-4.01-.13-.19-1.1-1.46-1.1-2.79 0-1.33.7-1.98.95-2.25.25-.26.54-.33.72-.33.18 0 .36 0 .52.01.17.01.4.06.6.53.22.5.75 1.83.82 1.96.07.14.12.3.02.48-.09.19-.15.31-.29.48-.15.17-.31.38-.44.51-.15.15-.3.32-.13.62.17.3 75 1.24 1.62 2.01 1.11.99 2.04 1.3 2.34 1.44.3.15.48.13.66-.07.18-.21.78-.91.99-1.22.21-.31.42-.26.71-.15.29.11 1.83.86 2.14 1.02.31.15.52.23.6.36.08.13.08.77-.16 1.45z"/>
              </svg>
            </span>
            <div>
              <span class="text-xs font-semibold text-emerald-400 uppercase tracking-wider block">Canal Directo</span>
              <span class="text-sm font-bold text-white group-hover:text-emerald-300 transition-colors">Chat por WhatsApp</span>
              <span class="text-xs text-slate-400 block mt-0.5">Respuesta inmediata en horario laboral</span>
            </div>
          </a>

          <div class="flex items-center gap-4 p-4 rounded-2xl bg-slate-900/40 border border-slate-800">
            <span class="w-12 h-12 rounded-xl bg-slate-800 text-brand-400 flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </span>
            <div>
              <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block">Correo Electrónico</span>
              <span class="text-sm font-bold text-white">contacto@feliperiquel.me</span>
              <span class="text-xs text-slate-400 block mt-0.5">Para solicitudes formales o licitaciones</span>
            </div>
          </div>
        </div>

        <!-- Safe Transaction Guarantee -->
        <div class="p-4 rounded-2xl bg-brand-950/30 border border-brand-500/20 text-xs text-slate-300 flex items-start gap-3">
          <svg class="w-5 h-5 text-brand-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span>
            <strong>Garantía de Satisfacción:</strong> Todo proyecto incluye etapa de revisión de maquetas y garantía de soporte técnico post-lanzamiento.
          </span>
        </div>
      </div>

      <!-- Right column: Accessible Contact Form -->
      <div class="lg:col-span-7">
        <form
          id="contact-form"
          action="https://api.web3forms.com/submit"
          method="POST"
          class="bg-slate-900/60 border border-slate-800 rounded-3xl p-6 sm:p-10 shadow-2xl relative"
        >
          <!-- Hidden Access Key (configured via .env or Web3Forms) -->
          <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY_HERE" />
          <input type="hidden" name="subject" value="Nueva cotización desde feliperiquel.me" />
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

          <h4 class="text-xl font-bold text-white mb-6">Formulario de Cotización</h4>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-5">
            <div>
              <label for="contact-name" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
                Tu Nombre o Empresa <span class="text-rose-400">*</span>
              </label>
              <input
                type="text"
                id="contact-name"
                name="name"
                required
                placeholder="Ej. Camila Morales"
                class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 focus-visible:ring-2 focus-visible:ring-brand-400 text-sm transition-colors"
              />
            </div>
            <div>
              <label for="contact-email" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
                Correo Electrónico <span class="text-rose-400">*</span>
              </label>
              <input
                type="email"
                id="contact-email"
                name="email"
                required
                placeholder="ejemplo@empresa.com"
                class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 focus-visible:ring-2 focus-visible:ring-brand-400 text-sm transition-colors"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-5">
            <div>
              <label for="contact-phone" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
                Teléfono / WhatsApp
              </label>
              <input
                type="tel"
                id="contact-phone"
                name="phone"
                placeholder="+56 9 ..."
                class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 focus-visible:ring-2 focus-visible:ring-brand-400 text-sm transition-colors"
              />
            </div>
            <div>
              <label for="contact-website" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
                Sitio Web Actual (si quieres renovación)
              </label>
              <input
                type="url"
                id="contact-website"
                name="current_website"
                placeholder="https://tuempresa.com"
                class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 focus-visible:ring-2 focus-visible:ring-brand-400 text-sm transition-colors"
              />
            </div>
          </div>

          <div class="mb-5">
            <label for="contact-service" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
              Tipo de Servicio Requerido
            </label>
            <select
              id="contact-service"
              name="service_type"
              class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white focus-visible:ring-2 focus-visible:ring-brand-400 text-sm transition-colors"
            >
              <option value="renovacion">Renovación / Rediseño de sitio existente</option>
              <option value="landing">Landing Page nueva (1 página)</option>
              <option value="corporativo">Sitio Web Corporativo completo</option>
              <option value="pagos-stripe">Catálogo o Cobros en línea (Stripe)</option>
              <option value="auditoria">Auditoría de velocidad y SEO</option>
              <option value="otro">Otro proyecto a medida</option>
            </select>
          </div>

          <div class="mb-6">
            <label for="contact-message" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
              Cuéntame detalles de lo que necesitas <span class="text-rose-400">*</span>
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="4"
              required
              placeholder="¿Qué objetivos tienes? ¿Tienes alguna fecha límite o referencia visual que te guste?"
              class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 focus-visible:ring-2 focus-visible:ring-brand-400 text-sm transition-colors resize-y"
            ></textarea>
          </div>

          <!-- Status Message Alert (5 UI states) -->
          <div id="form-status" class="hidden mb-6 p-4 rounded-xl text-sm" role="status"></div>

          <button
            type="submit"
            id="submit-btn"
            class="w-full inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl font-bold text-base text-white bg-gradient-to-r from-brand-600 to-indigo-600 hover:from-brand-500 hover:to-indigo-500 shadow-glow transition-all duration-300 hover:scale-[1.01] active:scale-[0.99]"
          >
            <span id="btn-text">Enviar solicitud de cotización</span>
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>

          <p class="text-center text-xs text-slate-500 mt-4">
            🔒 Tu información es 100% confidencial y solo se usará para responder a tu cotización.
          </p>
        </form>
      </div>
    </div>
  </div>

  <!-- Floating WhatsApp Action Button for Mobile & Desktop -->
  <a
    href="https://wa.me/?text=Hola%20Felipe,%20estoy%20en%20feliperiquel.me%20y%20me%20gustar%C3%ADa%20hacerte%20una%20consulta%20web"
    target="_blank"
    rel="noopener noreferrer"
    class="fixed bottom-6 right-6 z-40 p-3.5 rounded-full bg-emerald-500 text-white shadow-2xl hover:bg-emerald-400 hover:scale-110 active:scale-95 transition-all duration-300 focus-visible:ring-2 focus-visible:ring-emerald-300"
    aria-label="Abrir conversación de WhatsApp"
  >
    <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
      <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2zm5.78 14.15c-.24.68-1.39 1.3-1.92 1.38-.49.08-1.12.11-3.23-.76-2.69-1.11-4.43-3.83-4.57-4.01-.13-.19-1.1-1.46-1.1-2.79 0-1.33.7-1.98.95-2.25.25-.26.54-.33.72-.33.18 0 .36 0 .52.01.17.01.4.06.6.53.22.5.75 1.83.82 1.96.07.14.12.3.02.48-.09.19-.15.31-.29.48-.15.17-.31.38-.44.51-.15.15-.3.32-.13.62.17.3 75 1.24 1.62 2.01 1.11.99 2.04 1.3 2.34 1.44.3.15.48.13.66-.07.18-.21.78-.91.99-1.22.21-.31.42-.26.71-.15.29.11 1.83.86 2.14 1.02.31.15.52.23.6.36.08.13.08.77-.16 1.45z"/>
    </svg>
  </a>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const statusDiv = document.getElementById('form-status') as HTMLDivElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text') as HTMLSpanElement;

  if (form && statusDiv && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // UI State: Loading
      submitBtn.disabled = true;
      if (btnText) btnText.textContent = 'Enviando solicitud...';
      statusDiv.classList.add('hidden');
      statusDiv.className = 'mb-6 p-4 rounded-xl text-sm hidden';

      const formData = new FormData(form);

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: { 'Accept': 'application/json' }
        });

        if (response.ok) {
          // UI State: Success
          statusDiv.className = 'mb-6 p-4 rounded-xl text-sm bg-emerald-950/80 border border-emerald-500/50 text-emerald-200 block';
          statusDiv.innerHTML = '<strong>¡Mensaje recibido con éxito!</strong> Me pondré en contacto contigo a la brevedad para coordinar tu cotización.';
          form.reset();
        } else {
          throw new Error('Respuesta no exitosa');
        }
      } catch (err) {
        // UI State: Error Reintentable
        statusDiv.className = 'mb-6 p-4 rounded-xl text-sm bg-rose-950/80 border border-rose-500/50 text-rose-200 block';
        statusDiv.innerHTML = '<strong>Hubo un problema al enviar el formulario.</strong> Por favor contáctame directamente por <a href="https://wa.me/?text=Hola%20Felipe,%20estoy%20interesado%20en%20una%20web" class="underline font-bold">WhatsApp haciendo clic aquí</a> o escribe a contacto@feliperiquel.me.';
      } finally {
        submitBtn.disabled = false;
        if (btnText) btnText.textContent = 'Enviar solicitud de cotización';
      }
    });
  }
</script>
